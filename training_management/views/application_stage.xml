<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="application_stage_view_tree" model="ir.ui.view">
            <field name="name">application_stage_view_tree</field>
            <field name="model">application.stage</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="is_default"/>
                    <field name="is_draft"/>
                    <field name="is_approved"/>
                    <field name="is_cancelled"/>
                </tree>
            </field>
        </record>
        <record id="application_stage_view_form" model="ir.ui.view">
            <field name="name">application_stage_view_form</field>
            <field name="model">application.stage</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                           <group>
                               <field name="name"/>
                               <field name="is_default"/>
                               <field name="is_draft"/>
                           </group>
                           <group>
                               <field name="is_approved"/>
                               <field name="is_cancelled"/>
                           </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="application_stage_action" model="ir.actions.act_window">
            <field name="name">Application Stage</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">application.stage</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="application_stage_menu" name="Application Stage"
                  parent="training_config_menu" action="application_stage_action" sequence="1"/>
    </data>
</odoo>