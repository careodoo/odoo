<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="training_application_line_view_tree" model="ir.ui.view">
            <field name="name">training_application_line_view_tree</field>
            <field name="model">training.application.line</field>
            <field name="arch" type="xml">
                <tree create="0" edit="0" delete="0">
                    <field name="application_id"/>
                    <field name="employee_id"/>
                    <field name="responsible_id"/>
                    <field name="project_id"/>
                    <field name="date"/>
                    <field name="course_id"/>
                    <field name="description" optional="show"/>
                    <field name="training_center_id" optional="show"/>
                    <field name="training_room_id" optional="show"/>
                    <field name="date_start" optional="show"/>
                    <field name="date_end" optional="show"/>
                </tree>
            </field>
        </record>
        <record id="training_application_line_view_form" model="ir.ui.view">
            <field name="name">training_application_line_view_form</field>
            <field name="model">training.application.line</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="application_id"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="training_center_id"/>
                                <field name="course_id"/>
                                <field name="date"/>
                                <field name="project_id"/>
                            </group>
                            <group>
                                <field name="responsible_id"/>
                                <field name="training_room_id" optional="show"/>
                                <field name="content_ids" widget="many2many_tags"/>
                                <field name="date_start" optional="show"/>
                                <field name="date_end" optional="show"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="description" string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="training_application_line_calendar" model="ir.ui.view">
            <field name="name">training_application_line_calendar</field>
            <field name="model">training.application.line</field>
            <field name="arch" type="xml">
                <calendar date_start="date_start" date_stop="date_end" string="Employee Trainings" mode="week" quick_add="false" color="application_id">
                    <field name="application_id"/>
                    <field name="employee_id"/>
                </calendar>
            </field>
        </record>
        <record id="training_application_line_pivot" model="ir.ui.view">
            <field name="name">training_application_line_pivot</field>
            <field name="model">training.application.line</field>
            <field name="arch" type="xml">
                <pivot string="Employee Trainings" sample="1">
                    <field name="application_id" type="row"/>
                </pivot>
            </field>
        </record>
        <record id="training_application_line_graph" model="ir.ui.view">
            <field name="name">training_application_line_graph</field>
            <field name="model">training.application.line</field>
            <field name="arch" type="xml">
                <graph string="Employee Trainings" sample="1">
                    <field name="application_id"/>
                </graph>
            </field>
        </record>
        <record id="training_application_line_action" model="ir.actions.act_window">
            <field name="name">Employee Trainings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">training.application.line</field>
            <field name="view_mode">tree,form,calendar,pivot,graph</field>
        </record>
        <menuitem id="training_application_line_menu" name="Employee Trainings"
                  parent="training_menu" action="training_application_line_action" sequence="2"/>
    </data>
</odoo>