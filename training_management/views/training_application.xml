<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="training_application_search" model="ir.ui.view">
           <field name="name">training_application_search</field>
           <field name="model">training.application</field>
            <field name="arch" type="xml">
                <search>
                    <group expand="0" string="Group By">
                        <filter string="Create Date" name="order_month" domain="[]" context="{'group_by': 'date'}"/>
                        <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}"/>
                        <filter string="Project" name="project" domain="[]" context="{'group_by': 'project_id'}"/>
                        <filter string="Stage" name="stage" domain="[]" context="{'group_by': 'stage_id'}"/>
                        <filter string="Responsible" name="responsible" domain="[]" context="{'group_by': 'responsible_id'}"/>
                        <filter string="Employee" name="employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                        <filter string="Start Date" name="start_date" domain="[]" context="{'group_by': 'date_start'}"/>
                        <filter string="End Date" name="end_date" domain="[]" context="{'group_by': 'date_end'}"/>
                    </group>
                </search>
           </field>
        </record>
        <record id="training_application_view_tree" model="ir.ui.view">
            <field name="name">training_application_view_tree</field>
            <field name="model">training.application</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="application_name"/>
                    <field name="training_name"/>
                    <field name="date"/>
                    <field name="project_id"/>
                    <field name="responsible_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    <field name="stage_id"/>
                </tree>
            </field>
        </record>
        <record id="training_application_view_form" model="ir.ui.view">
            <field name="name">training_application_view_form</field>
            <field name="model">training.application</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="is_approved" invisible="1"/>
                        <button name="button_create_tasks" type="object" string="Create Tasks" class="oe_highlight"
                            attrs="{'invisible': [('is_approved', '=', False)]}"/>
                        <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" icon="fa-pencil-square-o" name="action_view_tasks" type="object"  attrs="{'invisible': [('task_count','&lt;=',0)]}">
                                <field name="task_count" widget="statinfo" string="Tasks"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="application_name"/>
                                <field name="training_name"/>
                                <field name="responsible_id"/>
                                <field name="project_id"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="lines" string="Employee Trainings">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="course_id"/>
                                        <field name="content_ids" widget="many2many_tags"/>
                                        <field name="description"/>
                                        <field name="training_center_id"/>
                                        <field name="training_room_id"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="description" string="Description">
                                <field name="description" placeholder="Description..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="hr_kanban_view_training_application" model="ir.ui.view">
           <field name="name">training.application.kanban</field>
           <field name="model">training.application</field>
           <field name="arch" type="xml">
               <kanban class="o_hr_employee_kanban">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="training_name"/>
                   <templates>
                       <t t-name="kanban-box">
                       <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                            <div class="oe_kanban_details">
                               <div class="o_kanban_record_top">
                                   <div class="o_kanban_record_headings">
                                       <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                       </strong>
                                   </div>
                               </div>
                               <ul>
                                   <li t-if="record.training_name.raw_value">
                                       <strong>Training Name: </strong><field name="training_name" />
                                   </li>
                                   <li t-if="record.employee_id.raw_value">
                                       <strong>Employee: </strong><field name="employee_id" />
                                   </li>
                               </ul>
                           </div>
                       </div>
                       </t>
                   </templates>
               </kanban>
            </field>
        </record>
        <record id="training_application_calendar" model="ir.ui.view">
            <field name="name">training_application_calendar</field>
            <field name="model">training.application</field>
            <field name="arch" type="xml">
                <calendar date_start="date_start" date_stop="date_end" string="Application" mode="week" quick_add="false" color="name">
                    <field name="name"/>
                    <field name="employee_id"/>
                </calendar>
            </field>
        </record>
        <record id="training_application_action" model="ir.actions.act_window">
            <field name="name">Applications</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">training.application</field>
            <field name="view_mode">kanban,tree,form,calendar</field>
            <field name="search_view_id" ref="training_management.training_application_search"/>
        </record>
        <!--menus-->
        <menuitem id="training_root" name="Training" sequence="50"/>
        <menuitem id="training_menu" name="Trainings" parent="training_root" sequence="1"/>
        <menuitem id="trainer_menu" name="Trainers" parent="training_root" sequence="3"/>
        <menuitem id="course_menu" name="Courses and Subjects" parent="training_root" sequence="4"/>
        <menuitem id="training_config_menu" name="Configurations" parent="training_root" sequence="99"/>
        <menuitem id="training_application_menu" name="Applications" parent="training_menu"
                  action="training_application_action" sequence="1"/>
    </data>
</odoo>