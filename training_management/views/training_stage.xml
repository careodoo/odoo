<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="training_stage_view_tree" model="ir.ui.view">
            <field name="name">training_stage_view_tree</field>
            <field name="model">training.stage</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="is_default"/>
                </tree>
            </field>
        </record>
        <record id="training_stage_view_form" model="ir.ui.view">
            <field name="name">training_stage_view_form</field>
            <field name="model">training.stage</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="is_default"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="training_stage_action" model="ir.actions.act_window">
            <field name="name">Employee Training Stages</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">training.stage</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="training_stage_menu" name="Employee Training Stages"
                  parent="training_config_menu" action="training_stage_action" sequence="2"/>
    </data>
</odoo>