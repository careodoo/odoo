<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agency_form" model="ir.ui.view">
        <field name="name">care.recruitment.agency.form</field>
        <field name="model">care.recruitment.agency</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="اسم الوكالة..."/></h1></div>
                    <group>
                        <group>
                            <field name="country_id"/>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group string="مؤشرات الأداء">
                            <field name="total_supplied"/>
                            <field name="total_arrived"/>
                            <field name="total_absconded"/>
                            <field name="retention_rate" widget="percentage"/>
                            <field name="absconding_rate" widget="percentage"/>
                            <field name="score"/>
                            <field name="rating" widget="badge"
                                   decoration-success="rating=='a'" decoration-info="rating=='b'"
                                   decoration-warning="rating=='c'" decoration-danger="rating=='d'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="دفعات الاستقدام">
                            <field name="supply_ids">
                                <tree editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="date"/><field name="country_id"/><field name="profession"/>
                                    <field name="qty"/><field name="arrived"/><field name="absconded"/>
                                    <field name="rejected"/><field name="success_rate" widget="percentage"/>
                                    <field name="cost"/><field name="cost_per_worker"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="view_agency_tree" model="ir.ui.view">
        <field name="name">care.recruitment.agency.tree</field>
        <field name="model">care.recruitment.agency</field>
        <field name="arch" type="xml">
            <tree decoration-success="rating=='a'" decoration-danger="rating=='d'">
                <field name="name"/><field name="country_id"/>
                <field name="total_supplied"/><field name="total_arrived"/><field name="total_absconded"/>
                <field name="retention_rate" widget="percentage"/>
                <field name="score"/><field name="rating" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="action_agency" model="ir.actions.act_window">
        <field name="name">وكالات الاستقدام</field>
        <field name="res_model">care.recruitment.agency</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_agency_supply_tree" model="ir.ui.view">
        <field name="name">care.agency.supply.tree</field>
        <field name="model">care.agency.supply</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/><field name="agency_id"/><field name="date"/>
                <field name="country_id"/><field name="qty"/><field name="arrived"/>
                <field name="absconded"/><field name="success_rate" widget="percentage"/>
                <field name="cost_per_worker"/><field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="action_agency_supply" model="ir.actions.act_window">
        <field name="name">دفعات الاستقدام</field>
        <field name="res_model">care.agency.supply</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
