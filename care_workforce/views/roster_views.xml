<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shift templates -->
    <record id="view_shift_template_tree" model="ir.ui.view">
        <field name="name">care.shift.template.tree</field>
        <field name="model">care.shift.template</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/><field name="code"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="hours" widget="float_time"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>
    <record id="action_shift_template" model="ir.actions.act_window">
        <field name="name">قوالب الورديات</field>
        <field name="res_model">care.shift.template</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Roster -->
    <record id="view_roster_form" model="ir.ui.view">
        <field name="name">care.roster.form</field>
        <field name="model">care.roster</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fill_department" type="object" string="تعبئة عمال القسم"
                            invisible="state not in ('draft',)"/>
                    <button name="action_confirm" type="object" string="اعتماد" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="تم التنفيذ" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="إلغاء" invisible="state in ('cancelled','done')"/>
                    <button name="action_draft" type="object" string="مسودة" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="scheduled_count"/>
                            <field name="reserve_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الجدول">
                            <field name="line_ids">
                                <tree editable="bottom" decoration-info="assignment=='reserve'"
                                      decoration-muted="assignment in ('leave','off')"
                                      decoration-danger="assignment=='absent'">
                                    <field name="employee_id"/>
                                    <field name="work_date"/>
                                    <field name="shift_id"/>
                                    <field name="assignment"/>
                                    <field name="backup_for_id" invisible="assignment!='reserve'"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="ملاحظات"><field name="note" nolabel="1"/></page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="view_roster_tree" model="ir.ui.view">
        <field name="name">care.roster.tree</field>
        <field name="model">care.roster</field>
        <field name="arch" type="xml">
            <tree decoration-success="state=='done'" decoration-muted="state=='cancelled'">
                <field name="name"/><field name="department_id"/>
                <field name="date_from"/><field name="date_to"/>
                <field name="scheduled_count"/><field name="reserve_count"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="action_roster" model="ir.actions.act_window">
        <field name="name">جداول الورديات</field>
        <field name="res_model">care.roster</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
