<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="permission_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">permission_res_config_settings_view_form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[@name='employees_setting_container']" position="after">
                        <block title="Permission Request" name="permission_request_setting_container">
                        <setting string="Permission Request Hours" help="Permission Request Hours">
                            <field name="permission_request_hours"/>
                        </setting>
                        <setting string="Permission Request HR" help="Permission Request HR">
                            <field name="permission_request_user_id"/>
                        </setting>
                        </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>