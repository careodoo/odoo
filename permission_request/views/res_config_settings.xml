<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="permission_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">permission_res_config_settings_view_form</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="11"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="permission_request" string="Permission Request" data-key="permission_request">
                        <h2>Permission Request</h2>
                        <div class="row mt16 o_settings_container" name="permission_request_setting_container">
                            <div class="col-12 col-lg-6 o_setting_box" id="permission_request">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Permission Request Hours</span>
                                    <div class="text-muted">
                                        <field name="permission_request_hours"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box" id="permission_request_user">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Permission Request HR</span>
                                    <div class="text-muted">
                                        <field name="permission_request_user_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </xpath>
            </field>
        </record>
        <record id="action_permission_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="permission_res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'permission_request'}</field>
    </record>

    <menuitem id="menu_permission_general_settings"
        name="Settings"
        parent="permission_request_config_menu"
        sequence="1"
        action="action_permission_config_settings"
        groups="base.group_system"/>
    </data>
</odoo>