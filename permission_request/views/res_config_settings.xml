<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="permission_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">permission_res_config_settings_view_form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[@name='employees_setting_container']" position="after">
                        <block title="Permission Request" name="permission_request_setting_container">
                            <setting string="Permission Request Hours" help="Permission Request Hours">
                                <field name="permission_request_hours"/>
                            </setting>
                            <setting string="Permission Request HR" help="Permission Request HR">
                                <field name="permission_request_user_id"/>
                            </setting>
                        </block>
                </xpath>
            </field>
        </record>

        <record id="action_permission_request_config_settings" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_id" ref="permission_res_config_settings_view_form"/>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'hr'}</field>
        </record>

        <menuitem id="menu_employee_shift_general_settings"
        name="Settings"
        parent="permission_request.permission_request_root"
        sequence="20"
        action="action_permission_request_config_settings"
        groups="base.group_system"/>
    </data>
</odoo>