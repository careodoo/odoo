<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="permission_request_view_tree" model="ir.ui.view">
            <field name="name">permission_request_view_tree</field>
            <field name="model">permission.request</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="active" invisible="1"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="position"/>
                    <field name="type"/>
                    <field name="permission_from"/>
                    <field name="permission_to"/>
                    <field name="reason"/>
                </tree>
            </field>
        </record>
        <record id="permission_request_view_form" model="ir.ui.view">
            <field name="name">permission_request_view_form</field>
            <field name="model">permission.request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="request_more_hours" type="object" string="Request More Hours" class="oe_highlight"
                                invisible="state != 'draft' or not need_more_hours or extra_hour_count > 0"/>
                        <button name="button_submit" type="object" string="Submit" invisible="state != 'draft'" class="oe_highlight"/>
                        <button name="button_approve" type="object" string="Approve" class="oe_highlight"
                                invisible="approver_ids not in [uid] or state != 'submitted'"/>
                        <button name="button_reject" type="object" string="Reject" class="btn-danger"
                                invisible="approver_ids not in [uid] or state != 'submitted'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <field name="qr_image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="employee_id" name="model_name_label"/>
                            <h1>
                                <field name="employee_id" required="1" readonly="state != 'draft'"/>
                            </h1>
                        </div>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="need_more_hours" invisible="1"/>
                            <field name="extra_hour_count" invisible="1"/>
                            <field name="barcode" readonly="state != 'draft'"/>
                            <field name="employee_barcode"/>
                            <field name="department_id"/>
                            <field name="approver_ids" widget="many2many_tags"/>
                            <field name="position"/>
                            <field name="type" readonly="state != 'draft'"/>
                            <field name="permission_from" readonly="state != 'draft'"/>
                            <field name="permission_hours" readonly="state != 'draft'"/>
                            <field name="permission_to"/>
                            <field name="reason" readonly="state != 'draft'"/>
                            <field name="total_hours"/>
                            <field name="total_extra_hours"/>
                            <field name="used_hours"/>
                            <field name="remaining_hours"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="permission_request_action" model="ir.actions.act_window">
            <field name="name">Permission Requests</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">permission.request</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="permission_request_root" name="Permission Requests" sequence="50"/>
        <menuitem id="permission_request_menu" name="Permission Requests" parent="permission_request_root"
                  action="permission_request_action" sequence="1"/>
        <menuitem id="permission_request_config_menu" name="Configurations" parent="permission_request_root" sequence="99"/>
    </data>
</odoo>