<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="permission_request_view_tree" model="ir.ui.view">
            <field name="name">permission_request_view_tree</field>
            <field name="model">permission.request</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="position"/>
                    <field name="type"/>
                    <field name="permission_from"/>
                    <field name="permission_to"/>
                    <field name="reason"/>
                </tree>
            </field>
        </record>
        <record id="permission_request_view_form" model="ir.ui.view">
            <field name="name">permission_request_view_form</field>
            <field name="model">permission.request</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="qr_image" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <label for="employee_id" name="model_name_label"/>
                            <h1>
                                <field name="employee_id" required="1"/>
                            </h1>
                        </div>
                        <group>
                            <field name="barcode"/>
                            <field name="employee_barcode"/>
                            <field name="department_id"/>
                            <field name="position"/>
                            <field name="type"/>
                            <field name="permission_from"/>
                            <field name="permission_to"/>
                            <field name="reason"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="permission_request_action" model="ir.actions.act_window">
            <field name="name">Permission Requests</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">permission.request</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="permission_request_root" name="Permission Requests" sequence="50"/>
        <menuitem id="permission_request_menu" name="Permission Requests" parent="permission_request_root"
                  action="permission_request_action" sequence="1"/>
    </data>
</odoo>