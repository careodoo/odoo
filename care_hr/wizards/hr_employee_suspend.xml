<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_employee_suspend_view_form" model="ir.ui.view">
            <field name="name">hr_employee_suspend_view_form</field>
            <field name="model">hr.employee.suspend</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="unsuspend" invisible="1"/>
                            <field name="employee_id" readonly="1" force_save="1"/>
                            <field name="date" required="not unsuspend" invisible="unsuspend"/>
                            <field name="can_print_reports" required="not unsuspend" invisible="unsuspend"/>
                            <field name="can_edit" required="not unsuspend" invisible="unsuspend"/>
                            <field name="reason" required="not unsuspend" invisible="unsuspend"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="button_suspend" type="object" string="Suspend" class="oe_highlight" invisible="unsuspend"/>
                        <button name="button_suspend" type="object" string="Unuspend" class="oe_highlight" invisible="not unsuspend"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>