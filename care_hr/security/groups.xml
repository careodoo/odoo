<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--Care HR senior approver (Top Management) for allowances/OT-->
        <record model="ir.module.category" id="module_care_hr">
            <field name="name">Care HR</field>
        </record>
        <record id="group_care_senior_approver" model="res.groups">
            <field name="name">Senior Approver (Top Management)</field>
            <field name="category_id" ref="module_care_hr"/>
        </record>

        <!--Joining-->
        <record model="ir.module.category" id="module_hr_joining">
            <field name="name">HR Joining</field>
        </record>

        <record id="group_hr_joining_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_hr_joining"/>
        </record>
        <record id="group_hr_joining_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="category_id" ref="module_hr_joining"/>
        </record>

        <record id="hr_joining_rule_user_own" model="ir.rule">
            <field name="name">User own HR Joining</field>
            <field ref="care_hr.model_hr_action_joining" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_joining_user'))]"/>
        </record>
        <record id="hr_joining_rule_manager" model="ir.rule">
            <field name="name">All HR Joining</field>
            <field ref="care_hr.model_hr_action_joining" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_joining_approver'))]"/>
        </record>
        <!--Absence-->
        <record model="ir.module.category" id="module_hr_absence">
            <field name="name">HR Absence</field>
        </record>

        <record id="group_hr_absence_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_hr_absence"/>
        </record>
        <record id="group_hr_absence_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="category_id" ref="module_hr_absence"/>
        </record>

        <record id="hr_absence_rule_user_own" model="ir.rule">
            <field name="name">User own HR Absence</field>
            <field ref="care_hr.model_hr_action_absence" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_absence_user'))]"/>
        </record>
        <record id="hr_absence_rule_manager" model="ir.rule">
            <field name="name">All HR Absence</field>
            <field ref="care_hr.model_hr_action_absence" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_absence_approver'))]"/>
        </record>
        <!--clearance-->
        <record model="ir.module.category" id="module_hr_clearance">
            <field name="name">HR Clearance</field>
        </record>

        <record id="group_hr_clearance_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_hr_clearance"/>
        </record>
        <record id="group_hr_clearance_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="category_id" ref="module_hr_clearance"/>
        </record>

        <record id="hr_clearance_rule_user_own" model="ir.rule">
            <field name="name">User own HR Clearance</field>
            <field ref="care_hr.model_hr_action_clearance" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_clearance_user'))]"/>
        </record>
        <record id="hr_clearance_rule_manager" model="ir.rule">
            <field name="name">All HR Clearance</field>
            <field ref="care_hr.model_hr_action_clearance" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_clearance_approver'))]"/>
        </record>
        <!--leave_return-->
        <record model="ir.module.category" id="module_hr_leave_return">
            <field name="name">HR Leave Return</field>
        </record>

        <record id="group_hr_leave_return_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_hr_leave_return"/>
        </record>
        <record id="group_hr_leave_return_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="category_id" ref="module_hr_leave_return"/>
        </record>

        <record id="hr_leave_return_rule_user_own" model="ir.rule">
            <field name="name">User own HR Leave Return</field>
            <field ref="care_hr.model_hr_action_leave_return" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_leave_return_user'))]"/>
        </record>
        <record id="hr_leave_return_rule_manager" model="ir.rule">
            <field name="name">All HR Leave Return</field>
            <field ref="care_hr.model_hr_action_leave_return" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_leave_return_approver'))]"/>
        </record>
        <!--quick hr leave-->
        <record model="ir.module.category" id="module_quick_hr_leave">
            <field name="name">Quick Time Off</field>
        </record>

        <record id="group_quick_hr_leave_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_quick_hr_leave"/>
        </record>
        <record model="ir.module.category" id="module_hr_suspend">
            <field name="name">HR Suspend</field>
        </record>

        <record id="group_hr_suspend_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_hr_suspend"/>
        </record>

        <!-- HR 360 Dashboard: members land on the dashboard as their home
             screen; non-members get the normal menu. Implies HR Officer so
             the dashboard can read employee/leave data. -->
        <record model="ir.module.category" id="module_hr_dashboard">
            <field name="name">HR Dashboard</field>
        </record>
        <record id="group_hr_dashboard" model="res.groups">
            <field name="name">Dashboard User</field>
            <field name="category_id" ref="module_hr_dashboard"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
    </data>
</odoo>