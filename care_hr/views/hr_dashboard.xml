<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hr_dashboard" model="ir.actions.client">
        <field name="name">لوحة الموارد البشرية</field>
        <field name="tag">care_hr_dashboard</field>
    </record>

    <!-- Top-level app menu, visible only to the dashboard group. Also serves
         as the Home Action target set on those users (see res_users.py). -->
    <menuitem id="menu_hr_dashboard_root"
              name="HR Dashboard"
              web_icon="care_hr,static/src/img/logo.jpeg"
              sequence="1"
              groups="care_hr.group_hr_dashboard"/>
    <menuitem id="menu_hr_dashboard"
              name="لوحة الموارد البشرية"
              parent="menu_hr_dashboard_root"
              action="action_hr_dashboard"
              sequence="1"
              groups="care_hr.group_hr_dashboard"/>
</odoo>
