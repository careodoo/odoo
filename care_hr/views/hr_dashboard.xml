<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hr_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">care_hr_dashboard</field>
    </record>

    <!-- Dashboard is the FIRST page inside the Employees app (not a separate
         external app, and not forced as the login Home Action). -->
    <menuitem id="menu_hr_dashboard"
              name="Dashboard"
              parent="hr.menu_hr_root"
              action="action_hr_dashboard"
              sequence="-5"
              groups="hr.group_hr_user"/>

    <function model="res.users" name="_clear_all_dashboard_home"/>
</odoo>
