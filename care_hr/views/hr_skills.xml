<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="care_hr_employee_skill_type_view_form" model="ir.ui.view">
            <field name="name">care_hr_employee_skill_type_view_form</field>
            <field name="model">hr.skill.type</field>
            <field name="inherit_id" ref="hr_skills.hr_employee_skill_type_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='skill_ids']/tree" position="inside">
                    <field name="employee_count"/>
                    <button name="action_view_employees" type="object" string="View Employees" class="oe_highlight"/>
                </xpath>
            </field>
        </record>
        <record id="care_employee_skill_level_view_tree" model="ir.ui.view">
            <field name="name">care_employee_skill_level_view_tree</field>
            <field name="model">hr.skill.level</field>
            <field name="inherit_id" ref="hr_skills.employee_skill_level_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree/field[@name='name']" position="after">
                    <field name="employee_count"/>
                    <button name="action_view_employees" type="object" string="View Employees" class="oe_highlight"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>