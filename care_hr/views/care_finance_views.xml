<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Bonus ===== -->
    <record id="view_care_bonus_tree" model="ir.ui.view">
        <field name="name">care.bonus.tree</field>
        <field name="model">care.bonus</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'done'" decoration-info="state == 'approved'"
                  decoration-muted="state == 'refused'">
                <field name="name"/><field name="date"/><field name="employee_id"/>
                <field name="bonus_type"/><field name="payment_method"/><field name="amount"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-info="state == 'approved'"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="view_care_bonus_form" model="ir.ui.view">
        <field name="name">care.bonus.form</field>
        <field name="model">care.bonus</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted'" groups="hr.group_hr_user"/>
                    <button name="action_mark_cash_paid" type="object" string="Mark Cash Paid"
                            invisible="state != 'approved' or payment_method != 'cash'"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state in ('done','refused')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group><field name="employee_id"/><field name="bonus_type"/>
                            <field name="payment_method"/></group>
                        <group><field name="date"/><field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="payslip_id" readonly="1"/></group>
                    </group>
                    <field name="reason" placeholder="Reason..."/>
                </sheet>
                <div class="oe_chatter"><field name="message_follower_ids"/>
                    <field name="activity_ids"/><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="action_care_bonus" model="ir.actions.act_window">
        <field name="name">Bonus</field>
        <field name="res_model">care.bonus</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ===== EOS Liability ===== -->
    <record id="view_care_eos_liab_tree" model="ir.ui.view">
        <field name="name">care.eos.liability.tree</field>
        <field name="model">care.eos.liability</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/><field name="department_id"/>
                <field name="join_date"/><field name="service_years"/>
                <field name="basic_wage"/><field name="provision_days"/>
                <field name="provision_amount" sum="Total Provision"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="view_care_eos_liab_pivot" model="ir.ui.view">
        <field name="name">care.eos.liability.pivot</field>
        <field name="model">care.eos.liability</field>
        <field name="arch" type="xml">
            <pivot string="EOS Liability">
                <field name="department_id" type="row"/>
                <field name="provision_amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_care_eos_liab" model="ir.actions.act_window">
        <field name="name">EOS Liability</field>
        <field name="res_model">care.eos.liability</field>
        <field name="view_mode">tree,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run the scan to compute the EOS provision</p>
        </field>
    </record>
    <record id="action_eos_liab_scan_server" model="ir.actions.server">
        <field name="name">Refresh EOS Liability</field>
        <field name="model_id" ref="model_care_eos_liability"/>
        <field name="state">code</field>
        <field name="code">action = model.action_run_scan()</field>
    </record>

    <menuitem id="menu_care_bonus" name="Bonus"
              parent="care_hr.menu_care_hr_payroll_root" action="action_care_bonus" sequence="4"/>
    <menuitem id="menu_care_eos_liab" name="EOS Liability"
              parent="care_hr.menu_care_hr_payroll_root" action="action_care_eos_liab" sequence="5"/>
    <menuitem id="menu_care_eos_liab_scan" name="↻ Refresh EOS Liability"
              parent="care_hr.menu_care_hr_payroll_root" action="action_eos_liab_scan_server"
              sequence="6" groups="hr.group_hr_manager"/>
</odoo>
