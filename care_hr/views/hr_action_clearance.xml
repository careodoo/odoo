<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="clearance_view_form" model="ir.ui.view">
            <field name="name">clearance_view_form</field>
            <field name="model">hr.action.clearance</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="button_submit" type="object" string="Submit" class="oe_highlight" states="draft"/>
                        <button name="button_approve" type="object" string="Approve" class="oe_highlight" states="submit"
                                groups="care_hr.group_hr_absence_approver"/>
                        <button name="button_print_report" type="object" string="Print" class="oe_highlight" states="approved"/>
                        <button name="button_print_report_header" type="object" string="Print with Header" class="oe_highlight" states="approved"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <field name="qr_image" widget="image" class="oe_avatar"/>
                        <field name="image_1920" widget="image" class="oe_avatar" style="margin-right:20px;"/>
                        <div class="oe_title">
                            <label for="employee_id" name="model_name_label"/>
                            <h1>
                                <field name="employee_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </h1>
                        </div>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="barcode"/>
                            <field name="employee_barcode"/>
                            <field name="department_id"/>
                        </group>
                        <notebook>
                            <page name="lines" string="Lines">
                                <field name="line_ids">
                                    <tree create="0" delete="0" editable="bottom">
                                        <field name="sequence" invisible="1"/>
                                        <field name="name" readonly="1" force_save="1"/>
                                        <field name="remarks"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="clearance_view_tree" model="ir.ui.view">
            <field name="name">clearance_view_tree</field>
            <field name="model">hr.action.clearance</field>
            <field name="arch" type="xml">
                <tree string="joining_tree">
                    <field name="active" invisible="1"/>
                    <field name="employee_id"/>
                    <field name="employee_barcode"/>
                    <field name="state" widget="badge"
                        decoration-muted="state == 'draft'"
                        decoration-warning="state == 'submit'"
                        decoration-success="state == 'approved'"/>
                </tree>
            </field>
        </record>
        <record id="clearance_action" model="ir.actions.act_window">
            <field name="name">Clearance</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.action.clearance</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="clearance_root" name="Clearance" sequence="71"/>
        <menuitem id="clearance_menu" name="Clearance" parent="clearance_root" action="clearance_action" sequence="1"/>
    </data>
</odoo>