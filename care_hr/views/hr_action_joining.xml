<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="joining_view_form" model="ir.ui.view">
            <field name="name">joining_view_form</field>
            <field name="model">hr.action.joining</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="button_submit" type="object" string="Submit" class="oe_highlight" states="draft"/>
                        <button name="button_approve" type="object" string="Approve" class="oe_highlight"
                                groups="care_hr.group_hr_joining_approver" states="submit"/>
                        <button name="button_print_report" type="object" string="Print" class="oe_highlight" states="approved"/>
                        <button name="button_print_report_header" type="object" string="Print with Header" class="oe_highlight" states="approved"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <field name="qr_image" widget="image" class="oe_avatar"/>
                        <field name="image_1920" widget="image" class="oe_avatar" style="margin-right:20px;"/>
                        <div class="oe_title">
                            <label for="employee_id" name="model_name_label"/>
                            <h1>
                                <field name="employee_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </h1>
                        </div>
                        <group>
                            <field name="barcode"/>
                            <field name="job_title"/>
                            <field name="employee_barcode"/>
                            <field name="join_date"/>
                            <field name="department_id"/>
                            <field name="delay"/>
                            <field name="salary_date"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="joining_view_tree" model="ir.ui.view">
            <field name="name">joining_view_tree</field>
            <field name="model">hr.action.joining</field>
            <field name="arch" type="xml">
                <tree string="joining_tree">
                    <field name="employee_id"/>
                    <field name="job_title"/>
                    <field name="barcode"/>
                    <field name="join_date"/>
                    <field name="department_id"/>
                    <field name="state" widget="badge"
                        decoration-muted="state == 'draft'"
                        decoration-warning="state == 'submit'"
                        decoration-success="state == 'approved'"/>
                </tree>
            </field>
        </record>
        <record id="joining_action" model="ir.actions.act_window">
            <field name="name">Joining</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.action.joining</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="joining_root" name="Joining" sequence="70"/>
        <menuitem id="joining_menu" name="Joining" parent="joining_root" action="joining_action" sequence="1"/>
    </data>
</odoo>