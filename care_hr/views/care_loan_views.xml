<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_care_loan_tree" model="ir.ui.view">
        <field name="name">care.loan.tree</field>
        <field name="model">care.loan</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'paid'" decoration-info="state == 'ongoing'"
                  decoration-muted="state == 'refused'" decoration-warning="state == 'submitted'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="loan_type"/>
                <field name="date"/>
                <field name="amount" sum="Total" widget="monetary"/>
                <field name="installments"/>
                <field name="installment_amount" widget="monetary"/>
                <field name="paid_amount" widget="monetary"/>
                <field name="balance" widget="monetary" sum="Outstanding"/>
                <field name="state" widget="badge" decoration-success="state == 'paid'"
                       decoration-info="state == 'ongoing'" decoration-warning="state == 'submitted'"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="view_care_loan_form" model="ir.ui.view">
        <field name="name">care.loan.form</field>
        <field name="model">care.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'submitted'" groups="hr.group_hr_user"/>
                    <button name="action_start" type="object" string="Start Deduction"
                            invisible="state != 'approved'"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state in ('paid','refused')"/>
                    <button name="action_reset" type="object" string="Reset to Draft"
                            invisible="state in ('draft','paid')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="loan_type"/>
                            <field name="date"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="installments"/>
                            <field name="installment_amount" widget="monetary" readonly="1"/>
                            <field name="start_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Repayment">
                        <group>
                            <field name="paid_amount" widget="monetary" readonly="1"/>
                            <field name="balance" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="approved_by" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_care_loan_search" model="ir.ui.view">
        <field name="name">care.loan.search</field>
        <field name="model">care.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="ongoing" string="Deducting" domain="[('state','=','ongoing')]"/>
                <filter name="to_approve" string="To Approve" domain="[('state','=','submitted')]"/>
                <filter name="outstanding" string="Outstanding" domain="[('balance','&gt;',0),('state','in',('approved','ongoing'))]"/>
                <group expand="0" string="Group By">
                    <filter name="g_emp" string="Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="g_type" string="Type" context="{'group_by':'loan_type'}"/>
                    <filter name="g_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_care_loan" model="ir.actions.act_window">
        <field name="name">Loans &amp; Advances</field>
        <field name="res_model">care.loan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_care_loan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Employee loans &amp; salary advances</p>
            <p>Installments are auto-deducted on the payslip.</p>
        </field>
    </record>

    <menuitem id="menu_care_loan" name="Loans &amp; Advances"
              parent="care_hr.menu_care_hr_payroll_root" action="action_care_loan" sequence="36"/>
</odoo>
