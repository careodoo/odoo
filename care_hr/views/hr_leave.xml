<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="care_hr_leave_view_tree" model="ir.ui.view">
            <field name="name">care_hr_leave_view_tree</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_to']" position="after">
                    <field name="returned" widget="badge" decoration-success="returned == '1'"/>
                </xpath>
            </field>
        </record>
        <record id="care_hr_leave_view_form" model="ir.ui.view">
            <field name="name">care_hr_leave_view_form</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/div[1]" position="before">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leave_return" type="object" class="oe_stat_button" icon="fa-pencil-square-o" attrs="{'invisible': [('leave_return_count', '=', 0)]}">
                            <field name="leave_return_count" widget="statinfo" string="Leave Return"/>
                        </button>
                    </div>
                </xpath>
            </field>
        </record>
        <record id="barcode_hr_leave_view_form_manager" model="ir.ui.view">
            <field name="name">barcode_hr_leave_view_form_manager</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
            <field name="arch" type="xml">
                <xpath expr="//label[@for='number_of_days']" position="before">
                    <field name="original_return_date" readonly="1" force_save="1"/>
                </xpath>
                <xpath expr="//div[@name='title']" position="before">
                    <field name="qr_image" widget="image" class="oe_avatar"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="before">
                    <field name="barcode"/>
                </xpath>
            </field>
        </record>
        <record id="quick_hr_leave_view_form" model="ir.ui.view">
            <field name="name">quick_hr_leave_view_form</field>
            <field name="model">hr.leave</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="available_department_ids" widget="many2many_tags" invisible="1"/>
                            <field name="self_time_off"/>
                            <field name="hr_department_id" attrs="{'invisible': [('self_time_off', '=', True)],'required': [('self_time_off', '=', False)]}"/>
                            <field name="hr_employee_id" required="1" attrs="{'readonly': ['|', ('hr_department_id', '=', False), ('self_time_off', '=', True)]}"/>
                            <field name="holiday_status_id" attrs="{'readonly': [('hr_department_id', '=', False), ('self_time_off', '=', False)]}"/>
                            <field name="employee_ids" widget="many2many_tags" invisible="1"/>
                            <field name="employee_id" invisible="1"/>
                            <field name="request_date_from" string="From" required="1" attrs="{'readonly': [('hr_department_id', '=', False), ('self_time_off', '=', False)]}"/>
                            <field name="request_date_to" string="To" required="1" attrs="{'readonly': [('hr_department_id', '=', False), ('self_time_off', '=', False)]}"/>
                            <field name="number_of_days" attrs="{'readonly': [('hr_department_id', '=', False)]}"/>
                            <field name="name"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="care_hr_leave_action" model="ir.actions.act_window">
            <field name="name">Quick Time Off</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.leave</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('hr_holidays.hr_leave_view_tree_my')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('care_hr.quick_hr_leave_view_form')}),
                          ]"/>
        </record>
        <menuitem id="care_hr_leave_menu" name="Quick Time Off" action="care_hr_leave_action"
                  sequence="55" groups="care_hr.group_quick_hr_leave_user"/>
    </data>
</odoo>