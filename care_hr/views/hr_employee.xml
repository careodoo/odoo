<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="care_view_employee_form" model="ir.ui.view">
            <field name="name">care_view_employee_form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="attributes">
                    <attribute name="class" add="o_employee_chatter_bottom" separator=" "/>
                </xpath>
                <xpath expr="//field[@name='work_email']" position="after">
                    <field name="joining_date"/>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="button_suspend" type="object" string="Suspend" invisible="suspend_date != False" groups="care_hr.group_hr_suspend_user"/>
                    <button name="button_unsuspend" type="object" string="Unsuspend" invisible="suspend_date == False" groups="care_hr.group_hr_suspend_user"/>
                    <field name="worker_status" widget="statusbar" options="{'clickable': '1'}"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_manpower_file" type="object"
                            class="oe_stat_button" icon="fa-id-card"
                            invisible="not manpower_file_id">
                        <div class="o_stat_info">
                            <span class="o_stat_value"><field name="manpower_file_available"/></span>
                            <span class="o_stat_text">File Quota Left</span>
                        </div>
                    </button>
                    <button name="action_view_device_attendance" type="object"
                            class="oe_stat_button" icon="fa-clock-o">
                        <div class="o_stat_info">
                            <span class="o_stat_value"><field name="device_attendance_count"/></span>
                            <span class="o_stat_text">Attendance</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="device_attendance" string="Attendance Records">
                        <group>
                            <field name="present_days_month" readonly="1"/>
                            <field name="device_attendance_count" readonly="1"/>
                        </group>
                        <field name="device_attendance_ids" readonly="1">
                            <tree create="false" delete="false">
                                <field name="timestamp"/>
                                <field name="attendance_state_id"/>
                                <field name="status"/>
                                <field name="device_id"/>
                            </tree>
                        </field>
                        <p class="text-muted">
                            Latest 300 punches shown. Click the <b>Attendance</b> button above for the full history.
                        </p>
                    </page>
                    <page name="worker_file" string="Worker File (360°)">
                        <group>
                            <group string="Classification">
                                <field name="job_grade_id"/>
                                <field name="manpower_file_id"/>
                                <field name="manpower_file_authority"/>
                                <field name="manpower_file_available"/>
                            </group>
                            <group string="Housing">
                                <field name="hostel_id"/>
                            </group>
                        </group>
                    </page>
                    <page name="passports" string="Passports">
                        <group>
                            <group>
                                <field name="passport_no"/>
                                <field name="release_date" string="Passport Issue Date"/>
                                <field name="end_date" string="Passport Expiry Date"/>
                            </group>
                            <group>
                                <field name="passport_status" readonly="1"/>
                            </group>
                        </group>
                        <field name="passport_ids" readonly="1">
                            <tree>
                                <field name="name"/>
                                <field name="passport_no"/>
                                <field name="expiry_date"/>
                                <field name="state"/>
                                <field name="holder_id"/>
                                <field name="shelf_location"/>
                            </tree>
                        </field>
                    </page>
                    <page name="suspend" string="Suspend">
                        <group>
                            <field name="suspend_date" readonly="1" force_save="1"/>
                            <field name="suspend_reason" readonly="1" force_save="1"/>
                            <field name="suspend_by" readonly="1" force_save="1"/>
                            <field name="can_print_reports" readonly="1" force_save="1"/>
                            <field name="can_edit" readonly="1" force_save="1"/>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//widget[@name='web_ribbon']" position="after">
                    <widget name="web_ribbon" title="Suspended" bg_color="bg-danger" invisible="suspend_date == False"/>
                </xpath>
                <xpath expr="//field[@name='department_id']" position="after">
                    <field name="barcode"/>
                </xpath>
            </field>
        </record>
        <record id="care_hr_kanban_view_employees" model="ir.ui.view" >
            <field name="name">care_hr_kanban_view_employees</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban/templates/t/div" position="inside">
                    <field name="suspend_date" invisible="1"/>
                    <field name="hostel_id" invisible="1"/>
                    <widget name="web_ribbon" title="Suspended" bg_color="bg-danger" invisible="suspend_date == False"/>
                </xpath>
                <xpath expr="//li[hasclass('hr_tags')]" position="before">
                    <li class="hr_tags">
                        <field name="worker_status" widget="label_selection"
                               options="{'classes': {'new': 'info', 'active': 'success', 'on_leave': 'warning', 'suspended': 'danger', 'absconding': 'danger', 'eos': 'secondary'}}"/>
                    </li>
                    <li class="hr_tags">
                        <field name="hostel_id" />
                    </li>
                </xpath>
            </field>
        </record>
    </data>
</odoo>