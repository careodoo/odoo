                                                    <div class="col-4">
                                                        إجازة سنوية
                                                    </div>
                                                    <div class="col-2">
                                                        <span class="fa fa-2x fa-square-o"/>
                                                    </div>
                                                    <div class="col-4">
                                                        إجازة زواج
                                                    </div>
                                                    <div class="col-2">
                                                        <span class="fa fa-2x fa-square-o"/>
                                                    </div>
                                                </div>
                                                <div class="row rtl-row">
                                                    <div class="col-4">
                                                        إجازة وضع
                                                    </div>
                                                    <div class="col-2">
                                                        <span class="fa fa-2x fa-square-o"/>
                                                    </div>
                                                    <div class="col-4">
                                                        إجازة لحالة وفاة
                                                    </div>
                                                    <div class="col-2">
                                                        <span class="fa fa-2x fa-square-o"/>
                                                    </div>
                                                </div>
