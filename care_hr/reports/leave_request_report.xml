                                        <tr>
                                            <td>Department / Project</td>
                                            <td class="rtl-row">القسم / المشروع</td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="row">
                                                    <div class="col-4">
                                                        Name
                                                    </div>
                                                    <div class="col-8">
                                                        : <span t-field="doc.employee_id.english_name"/>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-4">
                                                        Employee No.
                                                    </div>
                                                    <div class="col-8">
                                                        : <span t-field="doc.employee_id.barcode"/>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-4">
                                                        Position
                                                    </div>
                                                    <div class="col-8">
                                                        : <span t-field="doc.employee_id.job_title"/>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-4">
                                                        Department
                                                    </div>
                                                    <div class="col-8">
                                                        : <span t-field="doc.employee_id.department_id"/>
                                                    </div>
                                                </div>
