                                                    <div class="col-4">
                                                        Maternity Leave
                                                    </div>
                                                    <div class="col-2">
                                                        <span class="fa fa-2x fa-square-o"/>
                                                    </div>
                                                    <div class="col-4">
                                                        Funeral Leave
                                                    </div>
                                                    <div class="col-2">
                                                        <span class="fa fa-2x fa-square-o"/>
                                                    </div>
                                                </div>
