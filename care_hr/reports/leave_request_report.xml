        <record model="ir.actions.report" id="action_leave_request_header_report">
            <field name="name">Leave Request Report Header</field>
            <field name="model">hr.leave</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">care_hr.leave_request_header_report</field>
            <field name="report_file">care_hr.leave_request_header_report</field>
            <field name="binding_model_id" ref="hr_holidays.model_hr_leave"/>
			<field name="binding_type">report</field>
			<field name="binding_view_types">form</field>
        </record>
