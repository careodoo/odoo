                                                    <div class="col-3">
                                                        الاسم
                                                    </div>
                                                    <div class="col-9">: <span t-field="doc.employee_id"/></div>
                                                </div>
                                                <div class="row rtl-row">
                                                    <div class="col-3">
                                                        الرقم
                                                    </div>
                                                    <div class="col-9">: <span t-field="doc.employee_id.barcode"/></div>
                                                </div>
