            <field name="name">Leave Request Report</field>
            <field name="model">hr.leave</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">care_hr.leave_request_report</field>
            <field name="report_file">care_hr.leave_request_report</field>
            <field name="binding_model_id" ref="hr_holidays.model_hr_leave"/>
