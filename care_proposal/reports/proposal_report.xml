<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.actions.report" id="action_proposal_pdf_report">
            <field name="name">Pricing</field>
            <field name="model">proposal.proposal</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">care_proposal.proposal_pdf_report</field>
            <field name="report_file">care_proposal.proposal_pdf_report</field>
            <field name="binding_model_id" ref="model_proposal_proposal"/>
			<field name="binding_type">report</field>
			<field name="binding_view_types">form</field>
        </record>
        <template id="proposal_pdf_report">
			<t t-call="web.html_container">
				<t t-call="web.basic_layout">
                    <div class="page" style="font-family:Arial,Helvetica,sans-serif !important;">
                        <style>
                        table.GeneratedTable {
                            width: 100%;
                            background-color: #ffffff;
                            border-collapse: collapse;
                            border-width: 1px;
                            border-color: #000000;
                            border-style: solid;
                            font-size: 12px;
                            color: #000000;
                        }

                        table.GeneratedTable td, table.GeneratedTable th {
                            border-width: 1px;
                            border-color: #000000;
                            border-style: solid;
                            padding: 3px;
                            font-weight: bold;
                            margin:3px;
                        }

                        table.GeneratedTable thead {
                            background-color: #a3a3a3;
                        }
                        .bordered-row{
                            border-bottom:1px solid black;padding-left:10px;padding-right:10px;
                        }
                        .rtl-row{
                            text-align: right !important;direction: rtl !important;
                        }
                    </style>
                        <t t-foreach="docs" t-as="doc">
                            <div class="row">
                                <div class="col-2">
							        <img t-if="doc.logo" t-att-src="image_data_uri(doc.logo)" class="float-left" alt="Logo" style="width:80px;height:80px"/>
                                </div>
                                <div class="col-3">
                                    <center>
                                        <img t-if="doc.barcode" t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %('Code128',doc.barcode,180,50)" />
                                        <div t-esc="doc.barcode"/>
                                    </center>
                                </div>
                                <div class="col-2">
                                    <center>
                                        <strong>Service Pricing</strong>
                                    </center>
                                </div>
                                <div class="col-3">
                                    <center>
                                        <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', doc.qr_url + str(doc.id), 600, 50)" style="width:100px;height:60px;"/>
                                    </center>
                                </div>
                                <div class="col-2">
                                    <center>
                                        <strong><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></strong>
                                    </center>
                                </div>
                            </div>
                            <p class="text-center">Pricing for Provide Cleaning Services For <span t-field="doc.partner_id"/></p>
                            <h4 class="text-center">Services</h4>
                            <t t-foreach="doc.service_ids" t-as="service_line">
                                <table class="GeneratedTable">
                                    <colgroup>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='10%'/>
                                    </colgroup>
                                    <tbody>
                                        <tr>
                                            <td colspan="11" class="text-center" style="background-color:#d4d4d4">
                                                <span t-field="service_line.proposal_service_id"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-center" style="background-color:#d9d9d9">Type</td>
                                            <td class="text-center"><span t-field="service_line.proposal_service_id.type"/></td>
                                            <td class="text-center" style="background-color:#d9d9d9">Daily Hours</td>
                                            <td class="text-center"><span t-field="service_line.daily_hours"/></td>
                                            <td class="text-center" style="background-color:#d9d9d9">Weekly D</td>
                                            <td class="text-center"><span t-field="service_line.weekly_days"/></td>
                                            <td class="text-center" style="background-color:#d9d9d9">Monthly D</td>
                                            <td class="text-center"><span t-field="service_line.monthly_days"/></td>
                                            <td class="text-center" style="background-color:#d9d9d9">Unit</td>
                                            <td class="text-center"><span t-field="service_line.unit_id"/></td>
                                            <td class="text-center"></td>
                                        </tr></tbody>
                                </table>

                                <table class="GeneratedTable" style="margin-top:10px">
                                    <colgroup>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='9%'/>
                                        <col width='10%'/>
                                    </colgroup>

                                    <tbody>
                                        <tr>
                                            <td class="text-center" style="background-color:#d4d4d4">QTY</td>
                                            <td class="text-center" style="background-color:#d4d4d4">Salary</td>
                                            <td class="text-center" style="background-color:#d4d4d4">Residency</td>
                                            <td class="text-center" style="background-color:#d4d4d4">Host</td>
                                            <td class="text-center" style="background-color:#d4d4d4">Uniform</td>
                                            <td class="text-center" style="background-color:#d4d4d4">L &amp; I</td>
                                            <td class="text-center" style="background-color:#d4d4d4">Insurance</td>
                                            <td class="text-center" style="background-color:#d4d4d4">Bank Fees</td>
                                            <td class="text-center" style="background-color:#96F97B">Cost</td>
                                            <td class="text-center" style="background-color:#96F97B">Sales</td>
                                            <td class="text-center" style="background-color:#96F97B">Profit</td>
                                        </tr>
                                        <tr>
                                            <t t-set="service" t-value="service_line.proposal_service_id"/>
                                            <td class="text-center"><span t-field="service_line.quantity"/></td>
                                            <td class="text-center"><span t-esc="service.get_service_item_cost('salary')"/></td>
                                            <td class="text-center"><span t-esc="service.get_service_item_cost('residency')"/></td>
                                            <td class="text-center"><span t-esc="service.get_service_item_cost('accommodation')"/></td>
                                            <td class="text-center"><span t-esc="service.get_service_item_cost('uniform')"/></td>
                                            <td class="text-center"><span t-esc="service.get_service_item_cost('leave')"/></td>
                                            <td class="text-center"><span t-esc="service.get_service_item_cost('insurance')"/></td>
                                            <td class="text-center"><span t-esc="service.get_service_item_cost('bank_charge')"/></td>
                                            <td class="text-center" rowspan="3" style="vertical-align : middle;text-align:center;"><span t-esc="service_line.get_service_cost('cost')"/></td>
                                            <td class="text-center" rowspan="3" style="vertical-align : middle;text-align:center;"><span t-esc="service_line.get_service_cost('sales')"/></td>
                                            <td class="text-center" rowspan="3" style="vertical-align : middle;text-align:center;"><span t-esc="service_line.get_service_cost('sales') - service_line.get_service_cost('cost')"/></td>
                                        </tr>
                                        <tr>
                                            <td class="text-center" style="background-color:#d4d4d4">Material</td>
                                            <td class="text-center" style="background-color:#d4d4d4">Equipment</td>
                                            <td class="text-center" colspan="2" style="background-color:#d4d4d4">Transportation</td>
                                            <td class="text-center" colspan="2" style="background-color:#d4d4d4">Medical Certificate</td>
                                            <td class="text-center" style="background-color:#d4d4d4">Other</td>
                                            <td class="text-center" style="background-color:#d4d4d4">Commission</td>
                                        </tr>
                                        <tr>
                                            <td class="text-center"><span t-esc="service_line.get_service_cost('material')"/></td>
                                            <td class="text-center"><span t-esc="service_line.get_service_cost('equipment')"/></td>
                                            <td class="text-center" colspan="2"><span t-esc="service_line.get_service_cost('transportation')"/></td>
                                            <td class="text-center" colspan="2"><span t-esc="service.get_service_item_cost('medical')"/></td>
                                            <td class="text-center"><span t-esc="service.get_service_item_cost('other')"/></td>
                                            <td class="text-center"><span t-esc="service.get_service_item_cost('other')"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <br/>
                            </t>
                            <br/>
                            <table class="GeneratedTable" style="page-break-inside: avoid;">
                                <colgroup>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='10%'/>
                                </colgroup>
                                <tbody>
                                    <tr>
                                        <td colspan="11" class="text-center" style="background-color:#d4d4d4">Pricing</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center" style="background-color:#d4d4d4">#</td>
                                        <td class="text-center" colspan="3" style="background-color:#d4d4d4">Service Name</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Cost</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Total Cost</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Sales</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Total Sales</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Profit</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Total Profit</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Profit %</td>
                                    </tr>
                                    <t t-set="sequence" t-value="0"/>
                                    <tr t-foreach="doc.pricing_ids" t-as="pricing_line">
                                        <t t-set="sequence" t-value="sequence + 1"/>
                                        <td class="text-center"><span t-esc="sequence"/></td>
                                        <td class="text-center" colspan="3"><span t-field="pricing_line.service_id.proposal_service_id.short_code"/></td>
                                        <td class="text-center"><span t-esc="round(pricing_line.individual_cost, 2)"/></td>
                                        <td class="text-center"><span t-field="pricing_line.cost"/></td>
                                        <td class="text-center"><span t-field="pricing_line.individual_sales_price"/></td>
                                        <td class="text-center"><span t-field="pricing_line.sales_price"/></td>
                                        <td class="text-center"><span t-field="pricing_line.individual_profit_amount"/></td>
                                        <td class="text-center"><span t-field="pricing_line.profit_amount"/></td>
                                        <td class="text-center"><span t-esc="(pricing_line.individual_profit_amount / pricing_line.sales_price)*100"/>%</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center" colspan="3" style="background-color:#d4d4d4">Totals</td>
                                        <td class="text-center" style="background-color:#d4d4d4"><span t-esc="sum(doc.pricing_ids.mapped('individual_cost'))"/></td>
                                        <td class="text-center" style="background-color:#d4d4d4"><span t-esc="sum(doc.pricing_ids.mapped('cost'))"/></td>
                                        <td class="text-center" style="background-color:#d4d4d4"><span t-esc="sum(doc.pricing_ids.mapped('individual_sales_price'))"/></td>
                                        <td class="text-center" style="background-color:#d4d4d4"><span t-esc="sum(doc.pricing_ids.mapped('sales_price'))"/></td>
                                        <td class="text-center" style="background-color:#d4d4d4"></td>
                                        <td class="text-center" style="background-color:#d4d4d4"><span t-esc="sum(doc.pricing_ids.mapped('individual_profit_amount'))"/></td>
                                        <td class="text-center" style="background-color:#d4d4d4"><span t-esc="sum(doc.pricing_ids.mapped('profit_amount'))"/></td>
                                        <td class="text-center" style="background-color:#d4d4d4"><span t-esc="sum(doc.pricing_ids.mapped('profit_amount'))"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <br/>
                            <table class="GeneratedTable" style="page-break-inside: avoid;">
                                <colgroup>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='9%'/>
                                    <col width='10%'/>
                                </colgroup>
                                <tbody>
                                    <tr>
                                        <td colspan="11" class="text-center" style="background-color:#d4d4d4">Summary</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center" style="background-color:#d4d4d4">Manpower</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Salary</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Residency</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Host</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Uniform</td>
                                        <td class="text-center" style="background-color:#d4d4d4">L&amp;I</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Insurance</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Bank Fees</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Material</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Equipment</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Transportation</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center"><span t-field="doc.manpower_quantity"/></td>
                                        <td class="text-center"><span t-field="doc.salary_amount"/></td>
                                        <td class="text-center"><span t-field="doc.residency_amount"/></td>
                                        <td class="text-center"><span t-field="doc.accommodation_amount"/></td>
                                        <td class="text-center"><span t-field="doc.uniform_amount"/></td>
                                        <td class="text-center"><span t-field="doc.leave_amount"/></td>
                                        <td class="text-center"><span t-field="doc.insurance_amount"/></td>
                                        <td class="text-center"><span t-field="doc.fee_amount"/></td>
                                        <td class="text-center"><span t-field="doc.material_amount"/></td>
                                        <td class="text-center"><span t-field="doc.equipment_amount"/></td>
                                        <td class="text-center"><span t-field="doc.transportation_amount"/></td>
                                    </tr>
                                    <tr>
                                        <td class="text-center" colspan="2" style="background-color:#d4d4d4">Medical Cert.</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Commission</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Period</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Other</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Mode</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Services Qty</td>
                                        <td class="text-center" style="background-color:#d4d4d4">Profit %</td>
                                        <td class="text-center" style="background-color:#96F97B">Net Profit</td>
                                        <td class="text-center" style="background-color:#96F97B">Total Cost</td>
                                        <td class="text-center" style="background-color:#96F97B">Total Sales</td>
                                    </tr>
                                    <tr>
                                        <td class="text-center"><span t-field="doc.medical_amount"/></td>
                                        <td class="text-center"><span t-esc="round(sum(doc.pricing_ids.mapped('commission_amount')), 2)"/></td>
                                        <td class="text-center"><span t-field="doc.proposal_period"/></td>
                                        <td class="text-center"><span t-field="doc.other_amount"/></td>
                                        <td class="text-center"><span t-field="doc.mode"/></td>
                                        <td class="text-center"><span t-field="doc.service_quantity"/></td>
                                        <td class="text-center"><span t-field="doc.margin_percentage"/></td>
                                        <td class="text-center"><span t-field="doc.margin_amount"/></td>
                                        <td class="text-center"><span t-field="doc.total_pricing_cost"/></td>
                                        <td class="text-center"><span t-field="doc.total_amount"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <br/>
                            <div class="row">
                                <div class="col-4">
                                    <table class="GeneratedTable" style="page-break-inside: avoid;">
                                        <tbody>
                                            <tr>
                                                <td class="text-center">Notes</td>
                                            </tr>
                                            <tr>
                                                <td class="text-center">
                                                    <t t-if="doc.notes">
                                                        <span t-field="doc.notes"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span>&#160;</span>
                                                    </t>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col-2"></div>
                                <div class="col-6">
                                    <table class="GeneratedTable" style="page-break-inside: avoid;">
                                        <colgroup>
                                            <col width='33%'/>
                                            <col width='33%'/>
                                            <col width='34%'/>
                                        </colgroup>
                                        <tbody>
                                            <tr>
                                                <td class="text-center">Prepared By</td>
                                                <td class="text-center">Approved By</td>
                                                <td class="text-center">CEO Approval</td>
                                            </tr>
                                            <tr>
                                                <td class="text-center"><span t-field="doc.create_uid"/></td>
                                                <td class="text-center"><span t-esc="','.join(doc.approval_ids.filtered(lambda l: l.approved).mapped('user_id').mapped('name'))"/></td>
                                                <td class="text-center"></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>