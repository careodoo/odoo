<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.actions.report" id="action_proposal_report">
            <field name="name">Customer Proposal</field>
            <field name="model">proposal.proposal</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">care_proposal.customer_proposal_report</field>
            <field name="report_file">care_proposal.customer_proposal</field>
            <field name="binding_model_id" ref="model_proposal_proposal"/>
			<field name="binding_type">report</field>
			<field name="binding_view_types">form</field>
        </record>
        <template id="customer_proposal_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.basic_layout">
                        <div class="header">
                            <div class="row" style="margin-top: 20px;">
                                <div class="col-6">
                                    <img src="/care_proposal/static/src/img/care_header_logo_1.png" atl="header.png" class="w-100"/>
                                </div>
                                <div class="col-6">
                                    <img src="/care_proposal/static/src/img/care_header_logo_2.png" atl="header.png" class="w-100"/>
                                </div>
                            </div>
                        </div>
                        <div class="page">
                            <t t-if="doc.print_cover">
                                <br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/><br/>
                                <div>
                                     <div class="row">
                                         <div class="col-4" style="background-color:#ff0014;color:white;padding-top:20px;padding-bottom:20px;">
                                             <h2 class="text-center"><strong>SERVICE</strong></h2>
                                             <h2 class="text-center"><strong>PROPOSAL</strong></h2>
                                         </div>
                                         <div class="col-8" style="background-color:#e4e2e2;padding-top:20px;padding-bottom:20px;">
                                             <h2><strong>PROPOSAL # <span t-field="doc.ref"/></strong></h2>
                                             <h2><strong>PROVIDE CLEANING SERVICES</strong></h2>
                                         </div>
                                     </div>
                                     <br/>
                                     <div class="row">
                                         <div class="col-7">
                                             <h5><strong>Prepared for: </strong></h5>
                                             <ul class="list-unstyled">
                                                <li><h5><i class="fa fa-building"/><strong> Co. Name: </strong><span t-field="doc.partner_id.name"/></h5></li>
                                                <li><h5><i class="fa fa-address-card"/><strong> Address: </strong><span t-field="doc.partner_id.contact_address"/></h5></li>
                                                <li><h5><i class="fa fa-user"/><strong> Contact: </strong><span t-field="doc.partner_id.name"/></h5></li>
                                                <li><h5><i class="fa fa-phone-square"/><strong> Telephone: </strong><span t-esc="doc.partner_id.phone or doc.partner_id.mobile"/></h5></li>
                                                <li><h5><i class="fa fa-envelope"/><strong> Email: </strong><span t-field="doc.partner_id.email"/></h5></li>
                                             </ul>
                                         </div>
                                         <div class="col-5">
                                             <ul class="list-unstyled">
                                                <li><h5><strong> Proposal Issued: </strong><span t-field="doc.proposal_date"/></h5></li>
                                                <li><h5><strong> Valid To: </strong><span t-field="doc.expire_date"/></h5></li>
                                             </ul>
                                         </div>
                                     </div>
                                     <br/><br/><br/><br/><br/>
                                     <div class="row">
                                         <div class="col-4">
                                             <h4><strong>STATEMENT OF</strong></h4>
                                             <h4><strong>CONFIDENTIALITY</strong></h4>
                                         </div>
                                         <div class="col-8">
                                             <p>This proposal and supporting materials contain confidential and proprietary business information of CARE Company. These materials may be printed or photocopied for use in evaluating the proposed project but are not to be shared with other parties.</p>
                                         </div>
                                     </div>
                                </div>
                                <p style="page-break-after:always !important;"/>
                            </t>
                            <t t-if="doc.print_about">
                                <br/>
                                <h3 class="text-center"><strong> About Us</strong></h3>
                                <br/>
                                <p><strong>Care for Buildings &amp; Cities Cleaning Contracting Co. “Care Cleaning Co.” is one of the leading premier cleaning companies in Kuwait. Established in 1991, Care Cleaning Co. has achieved vigorous triumph in building a reputable portfolio highlighting 3 decades of experience, innovation, and quality.</strong></p>
                                <div class="row">
                                    <div class="col-6">
                                        <p>Care Cleaning Co. was able to gain a large number of tenders and execute hundreds of projects and it is listed and approved by the Municipality of Kuwait and the Central Tender Committee. Care Cleaning focuses on standards, quality, and client satisfaction. The Company is accredited by the Central Agency for Public Tenders, BICS (The British Institute of Cleaning Science), ISO 9001 (Quality Management System), and ISSA (International Sanitary Supply Association). These Certificates gave us the honor to serve our customers with the cooperation of both the Private and Governmental sectors.</p>
                                    </div>
                                    <div class="col-6">
                                        <p>During the last 30 years, Care Cleaning has strengthened its presence and services in the cleaning of cities, roads, buildings, ministries, and airports. Our services range anywhere from housekeeping, general cleaning, handling, waste management, etc. Recently, Care Cleaning Co. has expanded its operations to offer additional services such as ground operations, landscaping, and pest control.</p>
                                    </div>
                                </div>
                                <br/>
                                <div class="row">
                                    <div class="col-1"><i class="fa fa-2x fa-quote-left"/></div>
                                    <div class="col-11">
                                        <p class="font-italic"><strong>Our ethical commitment and strong relations with our stakeholder are our prior and core values, while always seeking to provide healthy &amp; safe working conditions, transparent communication, as well as efficient and accountable operations.</strong></p>
                                    </div>
                                </div>
                                <br/>
                                <table class="table table-bordered">
                                    <colgroup>
                                        <col width='50%'/>
                                        <col width='50%'/>
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="background-color:#ff0014;color:white;">WHO WE ARE</th>
                                            <th class="text-center" style="background-color:#ff0014;color:white;">WHAT WE DO</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Care Cleaning Co. holds a large and honorable portfolio with over 30 years in the industry. Our clients vary from private entities and companies to large governmental facilities and ground operations at the Airport. Our clients include major entities both from the public and private sectors in Kuwait, such as, but not limited.</td>
                                            <td>At Care, a well-trained staff alongside our specialized equipment’s and products are the key to our success which inevitably leads to customer satisfaction and loyalty. Our general cleaning, security, other services, and janitorial staff undergo extensive training and development to ensure the quality criteria.</td>
                                        </tr>
                                    </tbody>
                                </table>
                                <p style="page-break-after:always !important;"/>
                            </t>
                            <t t-if="doc.print_scope">
                                <br/>
                                <h2 class="text-center">SCOPE OF WORK</h2>
                                <p class="text-center">After our site visit for the work locations we suggest the below scope</p>
                                <table class="table table-bordered">
                                    <colgroup>
                                        <col width='80%'/>
                                        <col width='20%'/>
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th style="background-color:#ff0014;color:white;">Scope</th>
                                            <th style="background-color:#ff0014;color:white;">Schedule</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="doc.scope_ids" t-as="scope">
                                            <td>
                                                <span t-field="scope.proposal_scope_id"/>
                                            </td>
                                            <td>
                                                <span t-field="scope.schedule"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <p style="page-break-after:always !important;"/>
                            </t>
                            <t t-if="doc.print_quotation">
                                <br/>
                                <h2 class="text-center">Project Prices</h2>
                                <p>We visited the site of <span t-field="doc.partner_id"/></p>
                                <p>and after a discussion with the site directors, we determined the site requirements, and we will mention them in the following Proposal in detail.</p>
