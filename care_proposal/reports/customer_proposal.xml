                                            <th style="background-color:#ff0014;color:white;">Hours/Day</th>
                                            <th style="background-color:#ff0014;color:white;">Unit</th>
                                            <th style="background-color:#ff0014;color:white;">Quantity</th>
                                            <th style="background-color:#ff0014;color:white;">Price</th>
                                            <th style="background-color:#ff0014;color:white;">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="sequence" t-value="0"/>
                                        <tr t-foreach="doc.service_ids" t-as="service">
                                            <t t-set="sequence" t-value="sequence + 1"/>
                                            <td><span t-esc="sequence"/></td>
                                            <td>Overall</td>
                                            <td><span t-field="service.proposal_service_id"/></td>
                                            <td><span t-field="service.weekly_days"/></td>
                                            <td><span t-field="service.daily_hours"/></td>
                                            <td><span t-esc="service.get_manpower_unit()"/></td>
                                            <td><span t-esc="service.get_manpower_unit()"/></td>
                                            <td><span t-esc="service.get_manpower_unit()"/></td>
                                            <td><span t-esc="service.get_manpower_unit()"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <br/>
                                <h3 class="w-100" style="background-color:#ff0014;color:white;">Our Offer</h3>
                                <div class="row" style="background-color:#e4e2e2">
                                    <div class="col-4">
                                        <p><strong>Mode</strong> Monthly</p>
                                    </div>
                                    <div class="col-3">
                                        <p><strong>Monthly Invoice</strong></p>
                                        <h1 style="font-weight:bold;font-size:50px"><strong>12345</strong></h1>
                                        <h5 class="text-right" style="font-weight:bold"><strong>KD</strong></h5>
                                    </div>
                                    <div class="col-4">
                                        <table class="table table-bordered">
                                            <tbody>
                                                <tr>
                                                    <div><td rowspan="2" style="vertical-align : bottom;text-align:center;transform: rotate(270deg); -webkit-transform: rotate(270deg);">Quantity</td></div>
                                                    <td>Staff</td>
                                                    <td>148</td>
                                                </tr>
                                                <tr>
                                                    <td>Supervisor</td>
                                                    <td>0</td>
                                                </tr>
                                                <tr>
                                                    <div><td rowspan="2" style="vertical-align : bottom;text-align:center;transform: rotate(270deg); -webkit-transform: rotate(270deg);">Duty</td></div>
                                                    <td>Weekly</td>
                                                    <td>Daily</td>
                                                </tr>
                                                <tr>
                                                    <td>6 Days</td>
                                                    <td>8 Hours</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="col-1"/>
                                </div>
                                <br/>
                                <div class="row">
                                    <div class="col-1"><i class="fa fa-2x fa-quote-left"/></div>
                                    <div class="col-11">
                                        <p class="font-italic"><strong>We present to you our total price offer, which Proposal Totals is from a study of the tender documents and for your needs, as well as the number of manpower at the site, in addition to the costs of uniform, accomodation and transportation for every manpower.</strong></p>
                                    </div>
                                </div>
                                <br/>
                                <t t-if="doc.term_ids">
                                    <h5><strong>Terms: </strong></h5>
                                    <t t-set="terms" t-value="doc.term_ids[:3]"/>
                                    <ol>
                                        <li t-foreach="terms" t-as="term">
                                            <p t-field="term.term_id"/>
                                        </li>
                                     </ol>
                                </t>
                                <p style="page-break-after:always !important;"/>

                            </t>
                            <t t-if="doc.print_list">
                                <br/>
                                <h3 class="text-center"><strong> List Of Material, Equipments and Machines</strong></h3>
                                <br/>
                                <p class="text-center">Our Price dosn't include the materials or equipments or any machineries, we will provide you with list of most used items for the cleaning services with prices for each one to choose which one you will add to your contract to be able customize the price and contract.</p>
                                <br/>
                                <table class="table table-bordered">
                                    <colgroup>
                                        <col width='5%'/>
                                        <col width='45%'/>
                                        <col width='15%'/>
                                        <col width='15%'/>
                                        <col width='10%'/>
                                        <col width='10%'/>
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="background-color:#ff0014;color:white;">#</th>
                                            <th class="text-center" style="background-color:#ff0014;color:white;">item name</th>
                                            <th class="text-center" style="background-color:#ff0014;color:white;">Unit</th>
                                            <th class="text-center" style="background-color:#ff0014;color:white;">Quantity</th>
                                            <th class="text-center" style="background-color:#ff0014;color:white;">Price</th>
                                            <th class="text-center" style="background-color:#ff0014;color:white;">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="sequence" t-value="0"/>
                                        <tr t-foreach="doc.material_ids" t-as="material">
                                            <t t-set="sequence" t-value="sequence + 1"/>
                                            <td><span t-esc="sequence"/></td>
                                            <td><span t-field="material.product_id"/></td>
                                            <td><span t-field="material.product_id.uom_id"/></td>
                                            <td><span t-field="material.quantity"/></td>
                                            <td><span t-field="material.cost"/></td>
                                            <td><span t-field="material.total_amount"/></td>
                                        </tr>
                                        <tr t-foreach="doc.equipment_ids" t-as="equipment">
                                            <t t-set="sequence" t-value="sequence + 1"/>
                                            <td><span t-esc="sequence"/></td>
                                            <td><span t-field="equipment.product_id"/></td>
                                            <td><span t-field="equipment.product_id.uom_id"/></td>
                                            <td><span t-field="equipment.quantity"/></td>
                                            <td><span t-field="equipment.cost"/></td>
                                            <td><span t-field="equipment.total_amount"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <br/>
                                <div class="row">
                                    <div class="col-1"><i class="fa fa-2x fa-quote-left"/></div>
                                    <div class="col-11">
                                        <p class="font-italic"><strong>Feel free and control your payment, what you need what you pay</strong></p>
                                    </div>
                                </div>
                                <p style="page-break-after:always !important;"/>
                            </t>
                            <t t-if="doc.print_terms">
                                <br/>
                                <h3 class="text-center"><strong> TERMS AND POLICY</strong></h3>
                                <br/>
                                <h5 class="text-center">Our Price doesn't include materials or equipments and machiners. We provided you with list of the most used items for the cleaning services with individual unit price allowing you to choose your preferred items and customize your cost</h5>
                                <br/>
                                <table class="table table-bordered">
                                    <colgroup>
                                        <col width='5%'/>
                                        <col width='95%'/>
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th class="text-center" style="background-color:#ff0014;color:white;">#</th>
                                            <th class="text-center" style="background-color:#ff0014;color:white;">Term</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="sequence" t-value="0"/>
                                        <tr t-foreach="doc.term_ids" t-as="term">
                                            <t t-set="sequence" t-value="sequence + 1"/>
                                            <td><span t-esc="sequence"/></td>
                                            <td><span t-field="term.term_id"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <br/>
                                <div class="row">
                                    <div class="col-1"><i class="fa fa-2x fa-quote-left"/></div>
                                    <div class="col-11">
                                        <p class="font-italic"><strong>Feel free and control your payment, what you need what you pay</strong></p>
                                    </div>
                                </div>
                                <p style="page-break-after:always !important;"/>
                            </t>
                            <t t-if="doc.print_acceptance">
                                <br/>
                                <h3 class="text-center"><strong>Acceptance of Quote</strong></h3>
                                <br/>
                                <h4 class="w-100 text-center" style="background-color:#ff0014;color:white;padding-top:10px;padding-bottom:10px;"><strong>PROPOSAL # <span t-field="doc.ref"/> Provide Handling Services</strong></h4>
                                <div class="row" style="background-color:#e4e2e2">
                                    <div class="col-7">
                                        <ul class="list-unstyled">
                                            <li><h5><i class="fa fa-building"/><strong> Company Name: </strong><span t-field="doc.partner_id.name"/></h5></li>
                                            <li><h5><i class="fa fa-address-card"/><strong> Address: </strong><span t-field="doc.partner_id.contact_address"/></h5></li>
                                            <li><h5><i class="fa fa-user"/><strong> Contact: </strong><span t-field="doc.partner_id.name"/></h5></li>
                                            <li><h5><i class="fa fa-phone-square"/><strong> Telephone: </strong><span t-esc="doc.partner_id.phone or doc.partner_id.mobile"/></h5></li>
                                            <li><h5><i class="fa fa-envelope"/><strong> Email: </strong><span t-field="doc.partner_id.email"/></h5></li>
                                         </ul>
                                    </div>
                                    <div class="col-5">
                                        <ul class="list-unstyled">
                                            <li><h5><strong> Project Due: </strong><span t-esc="(doc.expire_date - doc.proposal_date).days"/> Days</h5></li>
                                            <li><h5><strong> Proposal Date: </strong><span t-field="doc.proposal_date"/></h5></li>
                                        </ul>
                                    </div>
                                 </div>
                                <br/>
                                <div class="row" style="background-color:#e4e2e2">
                                    <div class="col-3"/>
                                    <div class="col-4">
                                        <ul class="list-unstyled">
                                            <li><h5><strong>Service Type: </strong></h5></li>
                                            <li><h5><strong>Cleaner Service Per Month</strong></h5></li>
                                            <li><h5><strong>Cleaning Supervision Per Month</strong></h5></li>
                                         </ul>
                                    </div>
                                    <div class="col-2">
                                        <ul class="list-unstyled">
                                            <li><h5><strong>Total Price: </strong></h5></li>
                                            <li><h5><strong>12345</strong></h5></li>
                                            <li><h5><strong>0</strong></h5></li>
                                            <li><h5><strong>Total: 0</strong></h5></li>
                                         </ul>
                                    </div>
                                    <div class="col-3"/>
                                 </div>
                                <br/>
                                <table class="table table-bordered">
                                    <colgroup>
                                        <col width='25%'/>
                                        <col width='75%'/>
                                    </colgroup>
                                    <tbody>
                                        <tr>
                                            <td style="background-color:#e4e2e2"><h5><strong>Print name</strong></h5></td>
                                            <td/>
                                        </tr>
                                        <tr>
                                            <td style="background-color:#e4e2e2"><h5><strong>Position</strong></h5></td>
                                            <td/>
                                        </tr>
                                        <tr>
                                            <td style="background-color:#e4e2e2"><h5><strong>Approval Sign</strong></h5></td>
                                            <td/>
                                        </tr>
                                    </tbody>
                                </table>
