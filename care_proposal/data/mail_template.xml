<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_proposal" model="mail.template">
            <field name="name">Sales Proposal: Send By Email</field>
            <field name="model_id" ref="care_proposal.model_proposal_proposal"/>
            <field name="subject">Sale Proposal (Ref {{ object.name or 'n/a' }})</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="body_html" type="html">
<t t-set="cfg" t-value="object._email_settings()"/>
<div style="font-family:Arial,Helvetica,sans-serif;color:#1f2733;max-width:640px;margin:0 auto;font-size:14px;line-height:1.55;">
    <t t-if="cfg['show_header']">
        <div style="text-align:center;padding:0 0 10px 0;">
            <img t-attf-src="#{cfg['base_url']}/care_proposal/static/src/img/care_header_logo_1.png" style="max-width:100%;max-height:90px;"/>
        </div>
    </t>
    <div style="border:1px solid #e6e9f0;border-radius:10px;padding:24px;">
        <p style="margin:0 0 12px 0;">Dear <t t-out="object.partner_id.name or 'Customer'"/><t t-if="object.partner_id.parent_id"> (<t t-out="object.partner_id.parent_id.name"/>)</t>,</p>
        <div style="white-space:pre-line;color:#46505f;" t-out="cfg['intro']"/>
        <t t-if="cfg['show_summary']">
            <h3 t-attf-style="color:#{cfg['accent']};margin:20px 0 8px 0;font-size:16px;">Quotation Summary</h3>
            <table style="width:100%;border-collapse:collapse;font-size:13px;">
                <tr><td style="padding:7px 10px;border:1px solid #e6e9f0;background:#f7f8fb;width:45%;">Reference</td><td style="padding:7px 10px;border:1px solid #e6e9f0;" t-out="object.name or '-'"/></tr>
                <tr><td style="padding:7px 10px;border:1px solid #e6e9f0;background:#f7f8fb;">Service Type</td><td style="padding:7px 10px;border:1px solid #e6e9f0;" t-out="object.service_type_id.name or '-'"/></tr>
                <tr><td style="padding:7px 10px;border:1px solid #e6e9f0;background:#f7f8fb;">Site / Location</td><td style="padding:7px 10px;border:1px solid #e6e9f0;" t-out="object.service_site or '-'"/></tr>
                <tr><td style="padding:7px 10px;border:1px solid #e6e9f0;background:#f7f8fb;">Start Date</td><td style="padding:7px 10px;border:1px solid #e6e9f0;" t-out="object.mobilization_date or '-'"/></tr>
                <tr><td style="padding:7px 10px;border:1px solid #e6e9f0;background:#f7f8fb;">Duration</td><td style="padding:7px 10px;border:1px solid #e6e9f0;"><t t-out="object.proposal_period or '-'"/></td></tr>
                <tr><td style="padding:7px 10px;border:1px solid #e6e9f0;background:#f7f8fb;">Valid Until</td><td style="padding:7px 10px;border:1px solid #e6e9f0;" t-out="object.expire_date or '-'"/></tr>
                <tr><td style="padding:9px 10px;border:1px solid #e6e9f0;background:#f7f8fb;font-weight:bold;">Total Price</td><td t-attf-style="padding:9px 10px;border:1px solid #e6e9f0;font-weight:bold;color:#{cfg['accent']};font-size:15px;"><t t-out="cfg['total']"/> <t t-out="cfg['currency']"/></td></tr>
            </table>
        </t>
        <p style="margin:16px 0 0 0;">Please find the full proposal attached for your kind review.</p>
        <div style="white-space:pre-line;margin-top:12px;color:#46505f;" t-out="cfg['footer']"/>
        <p style="margin:14px 0 0 0;font-weight:bold;" t-out="cfg['signature']"/>
    </div>
</div></field>
            <field name="report_template_ids" eval="[(4, ref('care_proposal.action_proposal_report'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="email_template_proposal_won" model="mail.template">
            <field name="name">Sales Proposal</field>
            <field name="model_id" ref="care_proposal.model_proposal_proposal"/>
            <field name="subject">Sale Proposal (Ref {{ object.name or 'n/a' }})</field>
            <field name="email_to">{{ object.receiver_users_str }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear  Mr. <t t-out="ctx.get('name_to')"/>,
        <br/><br/>
        <p t-if="ctx.get('won_email', False)">
            I am pleased to inform you that the proposal has been approved. Please proceed with the necessary actions to implement the approved proposal.
            Thank you for your attention to this matter.
        </p>
        <p t-else="">Can you please find the attached file for your kind review and approval.</p>
        <br/><br/>
        <table class="table table-bordered">
            <tr>
                <td>Client Name</td>
                <td><t t-out="object.partner_id.name or ''"></t></td>
            </tr>
            <tr>
                <td>Type of Contract</td>
                <td><t t-out="object.partner_id.name or ''"></t></td>
            </tr>
            <tr>
                <td>Type of Service</td>
                <td><t t-out="object.service_type_id.name or ''"></t></td>
            </tr>
            <tr>
                <td>Labor Quantity</td>
                <td><t t-out="object.manpower_quantity or ''"></t></td>
            </tr>
            <tr>
                <td>Contract Period</td>
                <td><t t-out="object.proposal_period or ''"></t></td>
            </tr>
            <tr>
                <td>Payment Terms</td>
                <td><t t-out="object.mode or ''"></t></td>
            </tr>
            <tr>
                <td>Start Date</td>
                <td><t t-out="object.mobilization_date or ''"></t></td>
            </tr>
            <tr>
                <td>Contract Value</td>
                <td><t t-out="object.total_sales or ''"></t></td>
            </tr>
            <tr>
                <td>Net Profit %</td>
                <td><t t-out="round(object.margin_percentage, 2) or ''"></t></td>
            </tr>
            <tr>
                <td>Monthly Profit</td>
                <td><t t-out="round(object.margin_amount, 2) or ''"></t></td>
            </tr>
            <tr>
                <td>Referred By</td>
                <td><t t-out="object.lead_id.user_id.name or ''"></t></td>
            </tr>
        </table>
    </p>
    <div t-if="object.qr_url and not ctx.get('won_email', False)" style="padding: 16px 8px 16px 8px;">
        <center>
            <a t-att-href="object.qr_url"
                style="background-color: #875a7b; text-decoration: none; color: #fff; padding: 8px 16px 8px 16px; border-radius: 5px;">Proposal Approval</a>
        </center>
    </div>
</div></field>
            <field name="report_template_ids" eval="[(4, ref('care_proposal.action_proposal_pdf_report'))]"/>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
