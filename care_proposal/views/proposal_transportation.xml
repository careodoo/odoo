<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="proposal_transportation_view_tree" model="ir.ui.view">
            <field name="name">proposal_transportation_view_tree</field>
            <field name="model">proposal.transportation</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="cost"/>
                    <field name="type"/>
                    <field name="period"/>
                </tree>
            </field>
        </record>
        <record id="proposal_transportation_view_form" model="ir.ui.view">
            <field name="name">proposal_transportation_view_form</field>
            <field name="model">proposal.transportation</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <field name="cost"/>
                            <field name="type"/>
                            <field name="period"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="proposal_transportation_action" model="ir.actions.act_window">
            <field name="name">Transportations</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">proposal.transportation</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="proposal_transportation_menu" name="Transportations" parent="proposal_root_menu"
                  action="proposal_transportation_action" sequence="3"/>
    </data>
</odoo>