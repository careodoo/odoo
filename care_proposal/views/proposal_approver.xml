<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="proposal_approver_view_tree" model="ir.ui.view">
            <field name="name">proposal_approver_view_tree</field>
            <field name="model">proposal.approver</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="user_id"/>
                </tree>
            </field>
        </record>
        <record id="proposal_approver_action" model="ir.actions.act_window">
            <field name="name">Approvers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">proposal.approver</field>
            <field name="view_mode">tree</field>
        </record>
        <menuitem id="proposal_config" name="Configurations" parent="proposal_root_menu" sequence="99"/>
        <menuitem id="proposal_approver_menu" name="Approvers" parent="proposal_config"
                  action="proposal_approver_action" sequence="1"/>
    </data>
</odoo>