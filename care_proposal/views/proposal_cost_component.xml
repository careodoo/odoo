<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="proposal_cost_component_view_tree" model="ir.ui.view">
      <field name="name">proposal.cost.component.tree</field>
      <field name="model">proposal.cost.component</field>
      <field name="arch" type="xml">
        <tree editable="bottom">
          <field name="sequence" widget="handle"/>
          <field name="name"/>
          <field name="code"/>
          <field name="active" widget="boolean_toggle"/>
          <field name="company_id" groups="base.group_multi_company"/>
        </tree>
      </field>
    </record>

    <record id="proposal_cost_component_view_form" model="ir.ui.view">
      <field name="name">proposal.cost.component.form</field>
      <field name="model">proposal.cost.component</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="sequence"/>
              <field name="active"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids"/>
            <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>

    <record id="proposal_cost_component_action" model="ir.actions.act_window">
      <field name="name">Cost Components</field>
      <field name="res_model">proposal.cost.component</field>
      <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="proposal_cost_component_menu" name="Cost Components"
      parent="proposal_config" action="proposal_cost_component_action"
      sequence="40" groups="care_proposal.group_proposal_cost_admin"/>
  </data>
</odoo>
