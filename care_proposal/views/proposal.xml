<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="proposal_view_tree" model="ir.ui.view">
      <field name="name">proposal_view_tree</field>
      <field name="model">proposal.proposal</field>
      <field name="arch" type="xml">
        <tree>
          <field name="active" invisible="1" />
          <field name="name" />
          <field name="company_id" />
          <field name="ref" />
          <field name="partner_id" />
          <field name="country_id" optional="show" />
          <field name="city" optional="show" />
          <field name="phone" optional="show" />
          <field name="proposal_date" optional="show" />
          <field name="expire_date" optional="show" />
          <field name="total_amount" optional="show" />
          <field name="margin_amount" optional="show" />
          <field name="margin_percentage" optional="show" />
          <field name="service_type_id" optional="show" />
          <field name="service_site" optional="show" />
          <field name="mobilization_date" optional="show" />
          <field name="proposal_period" optional="show" />
          <field name="state" widget="badge" decoration-danger="state in ['reject', 'cancel']"
            decoration-success="state in ['approve', 'won', 'contracted']"
            decoration-warning="state == 'submit'" decoration-primary="state == 'waiting'" />
        </tree>
      </field>
    </record>
    <record id="proposal_view_form" model="ir.ui.view">
      <field name="name">proposal_view_form</field>
      <field name="model">proposal.proposal</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <field name="approver_id" invisible="1" force_save="1" />
            <field name="approver_users" invisible="1" force_save="1" />
            <field name="user_confirmed" invisible="1" force_save="1" />
            <button name="action_send_email" string="Send by Email" type="object"
              class="oe_highlight" />
            <button name="button_submit" type="object" string="Submit" class="oe_highlight"
              invisible="state != 'draft'" />
            <button name="button_cancel" type="object" string="Cancel" invisible="state == 'cancel'" />
            <button name="button_draft" type="object" string="Reset to Draft"
              invisible="state == 'draft'" />

            <button name="button_approve" type="object" string="Approve" class="oe_highlight"
              invisible="uid not in approver_users or user_confirmed or state not in ['submit', 'waiting']" />
            <button name="button_reject" type="object" string="Reject" class="btn btn-danger"
              confirm="Are you sure you want to reject this proposal?"
              invisible="uid not in approver_users or user_confirmed or state not in ['submit', 'waiting']" />

            <button name="generate_pricing" type="object" string="Generate Pricing"
              class="oe_highlight"
              invisible="state not in ['draft','submit']"/>
            <button name="button_won" type="object" string="Won" class="oe_highlight"
              invisible="uid not in approver_users or state != 'approve'" />
            <field name="state" widget="statusbar" statusbar_visible="draft,submit,approve" />
          </header>
          <sheet>
            <div class="oe_button_box" name="button_box" />
            <field name="qr_image" widget="image" class="oe_avatar" invisible="1" />
            <field name="logo" widget="image" class="oe_avatar" />
            <div class="oe_title" style="width: 100%">
              <label for="name" />
              <h1>
                <field name="name" />
              </h1>
            </div>
            <group>
              <group>
                <field name="company_id" readonly="state != 'draft'" />
                <field name="ref" readonly="state != 'draft'" />
                <field name="partner_id" readonly="state != 'draft'" />
                <field name="proposal_date" readonly="state != 'draft'" />
                <field name="expire_date" readonly="state != 'draft'" />
                <field name="total_amount" readonly="state != 'draft'" />
                <field name="total_pricing_cost" readonly="state != 'draft'" />
                <field name="margin_amount" />
                <field name="margin_percentage" />
                <field name="apply_commission" readonly="state != 'draft'" />
                <field name="commission_type" readonly="state != 'draft'"
                  invisible="apply_commission == False" required="apply_commission == True" />
                <field name="commission_rate" readonly="state != 'draft'"
                  invisible="apply_commission == False" />
                <field name="commission_amount" invisible="apply_commission == False" />

              </group>
              <group>
                <field name="barcode" />
                <field name="qr_url" invisible="1" />
                <field name="active" invisible="1" />
                <field name="service_type_id" readonly="state != 'draft'" />
                <field name="country_id" />
                <field name="city" />
                <field name="phone" />
                <field name="service_site" readonly="state != 'draft'" />
                <field name="mobilization_date" readonly="state != 'draft'" />
                <field name="proposal_period" readonly="state != 'draft'" />
                <field name="mode" readonly="state != 'draft'" />
                <field name="lead_id" readonly="state != 'draft'" />
                <field name="approver_users" widget="many2many_tags" invisible="1" force_save="1" />
                <field name="receiver_users" widget="many2many_tags" invisible="1" force_save="1" />
                <field name="receiver_users_str" invisible="0" />
              </group>
            </group>
            <field name="notes" placeholder="Type down your notes here..." />
            <notebook>
              <page name="summary" string="Summary">
                <group>
                  <group>
                    <field name="service_quantity" />
                    <field name="manpower_quantity" />
                    <field name="material_amount" />
                    <field name="equipment_amount" />
                    <field name="transportation_amount" />
                    <field name="salary_amount" />
                    <field name="uniform_amount" />
                    <field name="accommodation_amount" />
                    <field name="residency_amount" />
                  </group>
                  <group>
                    <field name="leave_amount" />
                    <field name="insurance_amount" />
                    <field name="fee_amount" />
                    <field name="gate_amount" />
                    <field name="total_commission_amount" />
                    <field name="medical_amount" />
                    <field name="total_pricing_cost" />
                    <field name="total_sales" />
                  </group>
                </group>
              </page>
              <page name="pricing" string="Pricing">
                <field name="pricing_ids" readonly="state != 'draft'">
                  <tree editable="bottom">
                    <field name="name" invisible="1" />
                    <field name="service_id" readonly="1" force_save="1" />
                    <field name="service_quantity" readonly="1" force_save="1" />
                    <field name="service_individual_cost" optional="show" readonly="1"
                      force_save="1" />
                    <field name="service_total_cost" optional="show" readonly="1" force_save="1" />
                    <field name="material_cost" optional="show" readonly="1" force_save="1" />
                    <field name="equipment_cost" optional="show" readonly="1" force_save="1" />
                    <field name="transportation_cost" optional="show" readonly="1" force_save="1" />
                    <field name="individual_cost" sum="total individual cost" optional="show"
                      readonly="1" force_save="1" />
                    <field name="commission_amount" optional="show" readonly="1" force_save="1" />
                    <field name="individual_cost_after_commission" />
                    <field name="cost" sum="total cost" optional="show" readonly="1" force_save="1" />
                    <field name="individual_sales_price" optional="show" />
                    <field name="profit_percentage" optional="show" />
                    <field name="individual_profit_amount" optional="show" />
                    <field name="profit_amount" optional="show" />
                    <field name="sales_price" sum="total sales price" />
                  </tree>
                </field>
              </page>
              <page name="services" string="Services">
                <field name="service_ids" readonly="state != 'draft'">
                  <tree editable="bottom">
                    <field name="proposal_service_id" />
                    <field name="location_id" />
                    <field name="unit_id" />
                    <field name="daily_hours" />
                    <field name="weekly_days" />
                    <field name="monthly_days" />
                    <field name="quantity" />
                    <field name="total_cost" sum="subtotal" />
                    <field name="total" sum="total" />
                  </tree>
                </field>
              </page>
              <page name="scopes" string="Scopes">
                <field name="scope_ids" readonly="state != 'draft'">
                  <tree editable="bottom">
                    <field name="proposal_scope_id" />
                    <field name="schedule" />
                  </tree>
                </field>
              </page>
              <page name="manpower" string="Manpower">
                <field name="manpower_ids" readonly="state != 'draft'">

                  <tree editable="bottom">
                    <field name="proposal_manpower_id" />
                    <field name="nationality" />
                    <field name="gender" />
                    <field name="quantity" />
                    <field name="service_ids" widget="many2many_tags" invisible="1" />
                    <field name="service_id" />
                    <field name="salary" />
                    <field name="total_salary" />
                  </tree>
                </field>
              </page>
              <page name="material" string="Material">
                <field name="material_ids" readonly="state != 'draft'">
                  <tree editable="bottom">
                    <field name="product_id" />
                    <field name="quantity" />
                    <field name="uom_id" options="{'no_edit': True, 'no_create': True}" />
                    <field name="cost" sum="total cost" />
                    <field name="total_amount" sum="total amount" />
                  </tree>
                </field>
                <group>
                  <field name="material_service_ids" widget="many2many_tags"
                    options="{'no_edit': True, 'no_create': True}"
                    required="material_ids != []" />
                </group>
              </page>
              <page name="equipments" string="Equipments">
               <field name="equipment_ids" readonly="state != 'draft'">
                  <tree editable="bottom">
                    <field name="product_id" />
                    <field name="quantity" />
                    <field name="uom_id" options="{'no_edit': True, 'no_create': True}" />
                    <field name="cost" sum="total cost" />
                    <field name="total_amount" sum="total amount" />
                  </tree>
                </field>
                <group>
     <field name="equipment_service_ids" widget="many2many_tags"
       options="{'no_edit': True, 'no_create': True}"
       required="equipment_ids != []"/>
                </group>
              </page>
              <page name="transportation" string="Transportation">
               <field name="transportation_ids" readonly="state != 'draft'">
                  <tree editable="bottom">
                    <field name="proposal_id" invisible="1" />
                    <field name="transportation_id" />
                    <field name="service_ids" widget="many2many_tags"
                      options="{'no_edit': True, 'no_create': True}" />
                    <field name="cost" sum="total cost" />
                    <field name="type" />
                    <field name="period" />
                  </tree>
                </field>
              </page>
              <page name="terms" string="Terms">
                <field name="term_ids" readonly="state != 'draft'">
                  <tree editable="bottom">
                    <field name="term_id" />
                  </tree>
                </field>
              </page>
              <page name="approval" string="Approvals">
                <field name="approval_ids">
                  <tree create="0" edit="0" delete="0" editable="bottom">
                    <field name="user_id" readonly="1" force_save="1" />
                    <field name="approved" readonly="1" force_save="1" />
                    <field name="date_approved" readonly="1" force_save="1" />
                    <button name="send_approve_request" type="object" string="Request For Approve"
                    class="oe_highlight" invisible="approved == True"/>
                  </tree>
                </field>
              </page>
              <page name="commission" string="Commission">
                <field name="commission_ids">
                  <tree editable="bottom">
                    <field name="proposal_id" invisible="1" />
                    <field name="commission" />
                    <field name="service_ids" widget="many2many_tags"
                      options="{'no_edit': True, 'no_create': True}" />
                    <field name="commission_type" />
                    <field name="commission_rate" />
                  </tree>
                </field>
              </page>
              <page name="print" string="Print Options">
                <group>
                  <group>
                    <field name="print_cover" />
                    <field name="print_about" />
                    <field name="print_scope" />
                    <field name="print_quotation" />
                  </group>
                  <group>
                    <field name="print_list" />
                    <field name="print_terms" />
                    <field name="print_acceptance" />
                    <field name="include_material" />
                    <field name="list_text" />
                    <field name="list_footer" />
                    <field name="term_text" />
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" />
            <field name="activity_ids" />
            <field name="message_ids" />
          </div>
        </form>
      </field>
    </record>
    <record id="proposal_action" model="ir.actions.act_window">
      <field name="name">Proposals</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">proposal.proposal</field>
      <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="proposal_root_menu" name="Proposals" sequence="55" />
    <menuitem id="proposal_menu" name="Proposals" parent="proposal_root_menu"
      action="proposal_action" sequence="1" />
  </data>
</odoo>