<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="seq_valet_ticket" model="ir.sequence">
      <field name="name">تذكرة فاليه</field>
      <field name="code">care.valet.ticket</field>
      <field name="prefix">VLT/%(year)s/</field>
      <field name="padding">5</field>
    </record>
    <record id="seq_valet_shift" model="ir.sequence">
      <field name="name">Valet Shift</field>
      <field name="code">care.valet.shift</field>
      <field name="prefix">VSH/%(year)s/</field>
      <field name="padding">4</field>
    </record>
    <record id="section_valet" model="care.cafm.portal.section">
      <field name="name">Valet Parking</field>
      <field name="code">valet</field>
      <field name="always_on" eval="True"/>
    </record>
  </data>
</odoo>
