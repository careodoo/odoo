<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
  <record id="seq_tank_cleaning" model="ir.sequence">
    <field name="name">Tank cleaning</field><field name="code">care.tank.cleaning</field>
    <field name="prefix">TNK/%(year)s/</field><field name="padding">5</field>
  </record>
  <record id="seq_tank_cert" model="ir.sequence">
    <field name="name">شهادة تنظيف خزان</field><field name="code">care.tank.certificate</field>
    <field name="prefix">CERT/TNK/%(year)s/</field><field name="padding">4</field>
  </record>
  <record id="cron_tank_due" model="ir.cron">
    <field name="name">خزانات المياه: تنبيه الدورات المستحقة</field>
    <field name="model_id" ref="model_care_tank_tank"/><field name="state">code</field>
    <field name="code">model._cron_due()</field>
    <field name="interval_number">1</field><field name="interval_type">days</field>
    <field name="numbercall">-1</field><field name="active" eval="True"/>
  </record>
</data></odoo>
