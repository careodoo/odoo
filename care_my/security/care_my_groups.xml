<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every internal user becomes a Permission-Request user, so each employee
         can submit their own استئذان and see only their own (module rule = own records). -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('permission_request.group_hr_permission_request_user'))]"/>
    </record>

    <!-- Each internal user may read ONLY their own payslips. Payroll Officer/Administrator
         keep their existing broader group-rules (record rules OR-combine → this only widens). -->
    <record id="rule_my_payslip_own" model="ir.rule">
        <field name="name">My Payslips (own only)</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
