<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_my_attendance_tree" model="ir.ui.view">
        <field name="name">my.attendance.tree</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <tree string="سجل حضوري" create="false" edit="false" delete="false" default_order="check_in desc">
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time" sum="إجمالي الساعات"/>
            </tree>
        </field>
    </record>

    <record id="view_my_attendance_search" model="ir.ui.view">
        <field name="name">my.attendance.search</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <search string="حضوري">
                <filter name="this_month" string="هذا الشهر"
                        domain="[('check_in','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="g_month" string="الشهر" context="{'group_by':'check_in:month'}"/>
            </search>
        </field>
    </record>
</odoo>
