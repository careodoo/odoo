<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_my_payslip_tree" model="ir.ui.view">
        <field name="name">my.payslip.tree</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <tree string="قسائم رواتبي" create="false" edit="false" delete="false">
                <field name="number"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="basic_wage" sum="الأساسي"/>
                <field name="net_wage" sum="الصافي"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'" decoration-info="state == 'verify'"
                       decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <record id="view_my_payslip_form" model="ir.ui.view">
        <field name="name">my.payslip.form</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <form string="قسيمة الراتب" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="basic_wage" readonly="1"/>
                            <field name="net_wage" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="act_my_payslips" model="ir.actions.server">
        <field name="name">قسائم رواتبي</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
emp = env['hr.employee'].sudo().search([('user_id', '=', env.uid)], limit=1)
if not emp:
    raise UserError('لا يوجد ملف موظف مرتبط بحسابك.')
action = {
    'type': 'ir.actions.act_window',
    'name': 'قسائم رواتبي',
    'res_model': 'hr.payslip',
    'view_mode': 'tree,form',
    'views': [
        (env.ref('care_my.view_my_payslip_tree').id, 'tree'),
        (env.ref('care_my.view_my_payslip_form').id, 'form'),
    ],
    'domain': [('employee_id', '=', emp.id)],
    'context': {'create': False, 'edit': False},
    'target': 'current',
}
]]></field>
    </record>
</odoo>
