<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="care_approvals_view_order_form" model="ir.ui.view">
            <field name="name">care_approvals_view_order_form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="approval_request_id" invisible="1"/>
                    <button class="oe_stat_button" name="action_view_approval_request" type="object" icon="fa-credit-card"
                            invisible="approval_request_id == False">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Approval Request</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>