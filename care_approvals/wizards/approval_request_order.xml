<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="approval_request_order_view_form" model="ir.ui.view">
            <field name="name">approval_request_order_view_form</field>
            <field name="model">approval.request.order</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="request_id" invisible="1"/>
                            <field name="type" invisible="1"/>
                        </group>
                        <notebook>
                            <page name="lines" string="Lines">
                                <field name="line_ids">
                                    <tree editable="bottom" create="0">
                                        <field name="product_line_id" invisible="1"/>
                                        <field name="product_id"/>
                                        <field name="description"/>
                                        <field name="quantity"/>
                                        <field name="product_uom_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="button_create_so" type="object" string="Create Sale Order" class="oe_highlight" attrs="{'invisible': [('type', '!=', 'so')]}"/>
                        <button name="button_create_po" type="object" string="Create Purchase Order" class="oe_highlight" attrs="{'invisible': [('type', '!=', 'po')]}"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>