<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="approval_request_order_view_form" model="ir.ui.view">
            <field name="name">approval_request_order_view_form</field>
            <field name="model">approval.request.order</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="request_id" invisible="1"/>
                            <field name="type" invisible="1"/>
                            <field name="partner_id"/>
                            <field name="department_id"/>
                        </group>
                        <notebook>
                            <page name="products" string="Products">
                                <field name="product_ids">
                                    <tree editable="bottom">
                                        <field name="company_id" column_invisible="1"/>
                                        <field name="department_product_ids" column_invisible="1"/>
                                        <field name="product_id" readonly="1"/>
                                        <field name="description" readonly="1"/>
                                        <field name="qoh_available" readonly="1"/>
                                        <field name="foh_available" readonly="1"/>
                                        <field name="quantity" readonly="1"/>
                                        <field name="product_uom_id" groups="uom.group_uom" options="{'no_create': True, 'no_open': True}" readonly="1"/>
                                        <field name="request_uom_id" groups="uom.group_uom"/>
                                        <field name="product_uom_category_id" column_invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="button_create_so" type="object" string="Create Sale Order" class="oe_highlight" invisible="type != 'so'"/>
                        <button name="button_create_po" type="object" string="Create Purchase Order" class="oe_highlight" invisible="type != 'po'"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>