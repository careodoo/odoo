<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_asset_category_view_tree" model="ir.ui.view">
            <field name="name">account_asset_category_view_tree</field>
            <field name="model">account.asset.category</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="account_asset_category_action" model="ir.actions.act_window">
            <field name="name">Asset Categories</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">account.asset.category</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="account_asset_category_menu" name="Asset Categories" parent="care_asset.asset_config_menu"
                  action="account_asset_category_action" sequence="1"/>
    </data>
</odoo>