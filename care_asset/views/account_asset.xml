<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="care_view_account_asset_model_search" model="ir.ui.view">
            <field name="name">care_view_account_asset_model_search</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_model_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="barcode"/>
                </xpath>
            </field>
        </record>
        <record id="care_view_account_asset_form" model="ir.ui.view">
            <field name="name">care_view_account_asset_form</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="button_print_label" type="object" string="Print Label" icon="fa-barcode"/>
                    <button name="transfer_asset" type="object" string="Transfer Asset"
                            invisible="state not in ['open', 'paused'] or department_id == False"/>
                </xpath>
                <xpath expr="//div[hasclass('oe_title')]" position="before">
                    <field name="qr_image" widget="image" class="oe_avatar"/>
                </xpath>
                <xpath expr="//field[@name='acquisition_date']" position="after">
                    <field name="category_id" readonly="state != 'draft'"/>
                    <field name="barcode"/>
                    <field name="purchase_order_id" readonly="state != 'draft'"/>
                    <field name="department_id" readonly="state != 'draft'"/>
                    <field name="qr_url" invisible="0"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="transfer" string="Asset Transfer">
                        <field name="transfer_ids">
                            <tree create="0" edit="0" delete="0">
                                <field name="old_department_id"/>
                                <field name="new_department_id"/>
                                <field name="create_date"/>
                                <field name="create_uid"/>
                                <field name="state" widget="badge" decoration-success="state == 'confirm'"
                                    decoration-info="state in ['draft', 'sent']"/>
                            </tree>
                        </field>
                    </page>
                    <page name="image" string="Images">
                        <field name="image" widget="image" options='{"size": [220, 150]}'/>
                    </page>
                </xpath>
                <xpath expr="//notebook" position="after">
                    <notebook invisible="state != 'draft'">
                        <page name="image" string="Images">
                            <field name="image" widget="image" options='{"size": [220, 150]}'/>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
        
        <record model="ir.actions.act_window" id="care_action_account_asset_model_form">
            <field name="name">Asset Models</field>
            <field name="res_model">account.asset</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('account_asset.view_account_asset_model_tree')}),
                (0, 0, {'view_mode': 'kanban'}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('account_asset.view_account_asset_form')})]"/>
            <field name="search_view_id" ref="account_asset.view_account_asset_model_search"/>
<!--            <field name="domain">[('asset_type', '=', 'purchase'), ('parent_id', '=', False)]</field>-->
<!--            <field name="context">{'asset_type': 'purchase', 'default_asset_type': 'purchase'}</field>-->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create new asset model
                </p>
            </field>
        </record>
        <menuitem id="asset_root_menu" name="Assets" sequence="55" groups="account.group_account_readonly"/>
        <menuitem id="asset_config_menu" parent="asset_root_menu" name="Configurations" sequence="99"
                   groups="account.group_account_manager"/>
        <menuitem id="care_asset_menu" parent="asset_root_menu" name="Assets" sequence="1"
                  action="care_action_account_asset_model_form" groups="account.group_account_readonly"/>
    </data>
</odoo>