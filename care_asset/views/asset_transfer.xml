<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="asset_transfer_view_form" model="ir.ui.view">
            <field name="name">asset_transfer_view_form</field>
            <field name="model">asset.transfer</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="signature_users" invisible="1"/>
                                <field name="user_confirmed" invisible="1"/>
                                <field name="old_department_id" readonly="1"/>
                                <field name="create_date"/>
                            </group>
                            <group>
                                <field name="new_department_id" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="create_uid"/>
                            </group>
                        </group>
                        <group>
                            <field name="note"/>
                        </group>
                        <notebook>
                            <page string="Signatures">
                                <field name="signature_lines" readonly="1">
                                    <tree editable="bottom" create="0" edit="0" delete="0">
                                        <field name="employee_id"/>
                                        <field name="employee_title"/>
                                        <field name="signature"/>
                                        <field name="confirm" readonly="1" force_save="1"/>
                                        <field name="date_confirm" readonly="1" force_save="1"/>
                                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button string="Confirm" type="object" class="oe_highlight" name="button_confirm"
                                attrs="{'invisible': &quot;['|','|', ('signature_users', 'not in', [uid]), ('state', '!=', 'sent'), ('user_confirmed', '=', True)]&quot;}"/>
                        <button string="Request for Approvals" type="object" class="oe_highlight" name="button_request_approval" states="draft"/>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>