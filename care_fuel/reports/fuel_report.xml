<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_fuel_entry" model="ir.actions.report">
        <field name="name">إيصال تعبئة وقود</field>
        <field name="model">care.fuel.entry</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">care_fuel.report_fuel_entry_doc</field>
        <field name="report_file">care_fuel.report_fuel_entry_doc</field>
        <field name="binding_model_id" ref="model_care_fuel_entry"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_fuel_entry_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family:Tahoma,Arial,sans-serif;direction:rtl;color:#1d2433;padding:10px 20px;">
                        <div style="display:flex;align-items:center;border-bottom:3px solid #15213b;padding-bottom:10px;margin-bottom:14px;">
                            <div style="flex:1;">
                                <span style="color:#f0663c;font-weight:bold;font-size:26px;">CARE</span>
                                <div style="color:#8a93a8;font-size:12px;font-weight:bold;">فور كير المعتمد · إدارة الوقود</div>
                            </div>
                            <div style="text-align:left;">
                                <div style="background:#15213b;color:#fff;padding:6px 14px;border-radius:6px;font-weight:bold;font-size:14px;">إيصال تعبئة وقود</div>
                                <div style="font-size:12px;margin-top:4px;"><t t-out="doc.name"/></div>
                            </div>
                        </div>
                        <table style="width:100%;border-collapse:collapse;font-size:13px;">
                            <tr>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;background:#f6f8fc;font-weight:bold;width:25%;">التاريخ</td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;"><t t-out="doc.date"/></td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;background:#f6f8fc;font-weight:bold;width:25%;">المشروع</td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;"><t t-out="doc.project_id.name or '—'"/></td>
                            </tr>
                            <tr>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;background:#f6f8fc;font-weight:bold;">المركبة</td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;"><t t-out="doc.vehicle_id.name or '—'"/></td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;background:#f6f8fc;font-weight:bold;">السائق</td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;"><t t-out="doc.driver_id.name or '—'"/></td>
                            </tr>
                            <tr>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;background:#f6f8fc;font-weight:bold;">طريقة الدفع</td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;">
                                    <span t-field="doc.method"/>
                                    <t t-if="doc.method=='card' and doc.card_id"> — <t t-out="doc.card_id.name"/></t>
                                </td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;background:#f6f8fc;font-weight:bold;">قراءة العدّاد</td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;"><t t-out="doc.odometer"/></td>
                            </tr>
                            <tr>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;background:#f6f8fc;font-weight:bold;">اللترات</td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;"><t t-out="doc.liters"/></td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;background:#f6f8fc;font-weight:bold;">سعر اللتر</td>
                                <td style="padding:6px 10px;border:1px solid #e4e8f0;"><t t-out="'%.3f' % doc.price_per_liter"/></td>
                            </tr>
                            <tr>
                                <td style="padding:8px 10px;border:1px solid #e4e8f0;background:#15213b;color:#fff;font-weight:bold;">المبلغ الإجمالي</td>
                                <td style="padding:8px 10px;border:1px solid #e4e8f0;font-weight:bold;font-size:15px;" colspan="3">
                                    <t t-out="doc.amount"/> <t t-out="doc.currency_id.name"/>
                                </td>
                            </tr>
                        </table>
                        <div t-if="doc.note" style="margin-top:10px;border:1px solid #e4e8f0;border-radius:6px;padding:8px 10px;font-size:12px;color:#555;">
                            <t t-out="doc.note"/>
                        </div>
                        <div t-if="doc.receipt" style="margin-top:14px;text-align:center;">
                            <div style="font-weight:bold;font-size:12px;margin-bottom:6px;color:#15213b;">صورة الإيصال</div>
                            <img t-att-src="'data:image/png;base64,%s' % doc.receipt.decode()" style="max-width:60%;max-height:340px;border:1px solid #e4e8f0;border-radius:6px;"/>
                        </div>
                        <table style="width:100%;margin-top:34px;font-size:13px;text-align:center;">
                            <tr>
                                <td style="width:50%;padding:0 20px;">
                                    <div style="border-top:1px solid #333;padding-top:6px;font-weight:bold;">سجّلها</div>
                                    <div style="color:#8a93a8;font-size:12px;"><t t-out="doc.created_by.name or ''"/></div>
                                </td>
                                <td style="width:50%;padding:0 20px;">
                                    <div style="border-top:1px solid #333;padding-top:6px;font-weight:bold;">اعتماد الإدارة</div>
                                    <div style="color:#8a93a8;font-size:11px;">التوقيع / التاريخ</div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
