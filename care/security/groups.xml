        <!--    Custody    -->
        <record model="ir.module.category" id="module_custody">
            <field name="name">Custody</field>
        </record>

        <record id="group_custody_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_custody"/>
        </record>

        <record id="group_custody_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_custody"/>
            <field name="implied_ids" eval="[(4, ref('care.group_custody_user'))]"/>
        </record>

        <record id="custody_rule_user_own" model="ir.rule">
            <field name="name">User own custody</field>
            <field ref="care.model_custody" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('care.group_custody_user'))]"/>
        </record>

        <record id="custody_rule_manager" model="ir.rule">
            <field name="name">All custody</field>
            <field ref="care.model_custody" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('care.group_custody_manager'))]"/>
        </record>
