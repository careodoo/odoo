<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_order_form_custody" model="ir.ui.view">
            <field name="name">purchase.order.form.custody</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_ref']" position="after">
                    <field name="from_custody"/>
                    <field name="custody" invisible="not from_custody" required="from_custody"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>