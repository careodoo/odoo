<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_notify_services_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.services.notify</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="fleet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='end_contract_setting']" position="after">
                <h2>Next Service Date Reminder Days</h2>
                <div class="row mt16 o_settings_container" id="services_next_service_date_notify_reminder">
                    <div class="col-12 col-lg-6 o_setting_box" name="services_next_service_date_notify_reminder">
                        <div class="o_setting_right_pane">
                            <field name="services_next_service_date_notify_reminder"/>
                            <div class="text-mute">
                                Number Of Days System Will Notify You Before by E-mails.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
