<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hostel_bed_view_tree" model="ir.ui.view">
        <field name="name">hostel_bed_view_tree</field>
        <field name="model">hostel.bed</field>
        <field name="arch" type="xml">
            <tree string="hostel_bed_tree">
                <field name="active" invisible="1"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="hostel_id"/>
                <field name="floor_id"/>
                <field name="flat_id"/>
                <field name="room_id"/>
                <field name="vacation"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
            </tree>
        </field>
    </record>
    
    <record id="hostel_bed_view_form" model="ir.ui.view">
        <field name="name">hostel_bed_view_form</field>
        <field name="model">hostel.bed</field>
        <field name="arch" type="xml">
            <form string="hostel_bed_form">
                <sheet>
                    <div class="oe_title mb24">
                        <h1>
                            <field name="name" class="o_text_overflow" default_focus="1" placeholder="Bed Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="is_available" invisible="1" force_save="1"/>
                            <field name="employee_id" readonly="1" force_save="1"/>
                            <field name="hostel_id"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="floor_id"/>
                            <field name="start_date" invisible="vacation == 'VA'" required="vacation == True"/>
                        </group>
                        <group>
                            <field name="flat_id"/>
                            <field name="room_id"/>
                            <field name="vacation"/>
                            <field name="end_date" invisible="vacation == 'VA'" required="vacation == True"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="hostel_bed_action" model="ir.actions.act_window">
        <field name="name">Hostel Beds</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hostel.bed</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="hostel_bed_menu" name="Beds" parent="care.menu_root" action="hostel_bed_action" sequence="6"/>

</odoo>