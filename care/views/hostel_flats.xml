<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hostel_flat_view_tree" model="ir.ui.view">
        <field name="name">hostel_flat_view_tree</field>
        <field name="model">hostel.flat</field>
        <field name="arch" type="xml">
            <tree string="hostel_flat_tree">
                <field name="active" invisible="1"/>
                <field name="name"/>
                <field name="hostel_id"/>
                <field name="floor_id"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
            </tree>
        </field>
    </record>
    
    <record id="hostel_flat_view_form" model="ir.ui.view">
        <field name="name">hostel_flat_view_form</field>
        <field name="model">hostel.flat</field>
        <field name="arch" type="xml">
            <form string="hostel_flat_form">
                <sheet>
                    <div class="oe_title mb24">
                        <h1>
                            <field name="name" class="o_text_overflow" default_focus="1" placeholder="Flat Number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="hostel_id"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="floor_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="employees" string="Employees">
                            <field name="employee_line">
                                <tree editable="top">
                                    <field name="employee_id"/>
                                    <field name="hostel_id"/>
                                    <field name="floor_id"/>
                                    <field name="flat_id"/>
                                    <field name="room_id"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="hostel_flat_action" model="ir.actions.act_window">
        <field name="name">Hostel Flats</field>
        <field name="res_model">hostel.flat</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="hostel_flat_menu" name="Flats" parent="care.menu_root" action="hostel_flat_action" sequence="1"/>

</odoo>