<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_letter_incoming" model="ir.sequence">
            <field name="name">Letter Incoming</field>
            <field name="code">letter.file.incoming</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

        <record id="config_overdue_days" model="ir.config_parameter">
            <field name="key">care_letter.overdue_days</field>
            <field name="value">7</field>
        </record>
    </data>
</odoo>
