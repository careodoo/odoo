<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== ACTIONS (bind our own views, overriding Studio priority) ===== -->
    <record id="action_letter_outgoing" model="ir.actions.act_window">
        <field name="name">الصادر</field>
        <field name="res_model">letter.file</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('direction','=','outgoing')]</field>
        <field name="context">{'default_direction': 'outgoing'}</field>
        <field name="search_view_id" ref="view_letter_search_care"/>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'sequence':1,'view_mode':'tree','view_id':ref('view_letter_tree_care')}),
            (0,0,{'sequence':2,'view_mode':'kanban','view_id':ref('view_letter_kanban_care')}),
            (0,0,{'sequence':3,'view_mode':'form','view_id':ref('view_letter_form_care')})]"/>
    </record>

    <record id="action_letter_incoming" model="ir.actions.act_window">
        <field name="name">الوارد</field>
        <field name="res_model">letter.file</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('direction','=','incoming')]</field>
        <field name="context">{'default_direction': 'incoming'}</field>
        <field name="search_view_id" ref="view_letter_search_care"/>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'sequence':1,'view_mode':'tree','view_id':ref('view_letter_tree_care')}),
            (0,0,{'sequence':2,'view_mode':'kanban','view_id':ref('view_letter_kanban_care')}),
            (0,0,{'sequence':3,'view_mode':'form','view_id':ref('view_letter_form_care')})]"/>
    </record>

    <record id="action_letter_delivery" model="ir.actions.act_window">
        <field name="name">سجل التسليم والمتابعة</field>
        <field name="res_model">letter.file</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('letter_state','in',['with_delegate','delivered','acknowledged'])]</field>
        <field name="search_view_id" ref="view_letter_search_care"/>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'sequence':1,'view_mode':'tree','view_id':ref('view_letter_tree_care')}),
            (0,0,{'sequence':2,'view_mode':'kanban','view_id':ref('view_letter_kanban_care')}),
            (0,0,{'sequence':3,'view_mode':'form','view_id':ref('view_letter_form_care')})]"/>
    </record>

    <record id="action_letter_overdue" model="ir.actions.act_window">
        <field name="name">المتأخرات</field>
        <field name="res_model">letter.file</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_overdue','=',True)]</field>
        <field name="search_view_id" ref="view_letter_search_care"/>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'sequence':1,'view_mode':'tree','view_id':ref('view_letter_tree_care')}),
            (0,0,{'sequence':2,'view_mode':'form','view_id':ref('view_letter_form_care')})]"/>
    </record>

    <record id="action_letter_delegates" model="ir.actions.act_window">
        <field name="name">أداء المندوبين</field>
        <field name="res_model">letter.delegate.stat</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_letter_delegate_stat_kanban"/>
        <field name="search_view_id" eval="False"/>
    </record>

    <record id="action_letter_quality" model="ir.actions.act_window">
        <field name="name">فحص الجودة</field>
        <field name="res_model">letter.file</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">['|','|',('deli_date','=',False),('image_letter','=',False),('partner_id','=',False)]</field>
        <field name="search_view_id" ref="view_letter_search_care"/>
        <field name="view_ids" eval="[(5,0,0),
            (0,0,{'sequence':1,'view_mode':'tree','view_id':ref('view_letter_tree_care')}),
            (0,0,{'sequence':2,'view_mode':'form','view_id':ref('view_letter_form_care')})]"/>
    </record>

    <!-- OWL dashboard client action (KPIs + charts, all clickable) -->
    <record id="action_letter_dashboard_client" model="ir.actions.client">
        <field name="name">لوحة المراسلات</field>
        <field name="tag">letter_dashboard</field>
    </record>

    <!-- ===== MENUS: consolidate everything under the EXISTING Letters app ===== -->
    <!-- Rename the vendor root the user already opens (also enforced in apply_ar) -->
    <record id="sp_letter_v15.letter_file_parent" model="ir.ui.menu">
        <field name="name">المراسلات</field>
        <field name="sequence">55</field>
    </record>
    <!-- Hide the vendor's duplicate children (replaced by our menus below) -->
    <record id="sp_letter_v15.letter_file_child" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="sp_letter_v15.configuration_letter_file" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem id="menu_letter_dashboard" name="لوحة المراسلات" parent="sp_letter_v15.letter_file_parent"
              action="action_letter_dashboard_client" sequence="1"/>
    <menuitem id="menu_letter_outgoing" name="الصادر" parent="sp_letter_v15.letter_file_parent"
              action="action_letter_outgoing" sequence="10"/>
    <menuitem id="menu_letter_incoming" name="الوارد" parent="sp_letter_v15.letter_file_parent"
              action="action_letter_incoming" sequence="20"/>
    <menuitem id="menu_letter_delivery" name="سجل التسليم" parent="sp_letter_v15.letter_file_parent"
              action="action_letter_delivery" sequence="30"/>
    <menuitem id="menu_letter_overdue" name="المتأخرات" parent="sp_letter_v15.letter_file_parent"
              action="action_letter_overdue" sequence="40"/>
    <menuitem id="menu_letter_delegates" name="أداء المندوبين" parent="sp_letter_v15.letter_file_parent"
              action="action_letter_delegates" sequence="50"/>
    <menuitem id="menu_letter_quality" name="فحص الجودة" parent="sp_letter_v15.letter_file_parent"
              action="action_letter_quality" sequence="60"/>

    <menuitem id="menu_letter_config" name="الإعدادات" parent="sp_letter_v15.letter_file_parent" sequence="90"/>
    <menuitem id="menu_letter_templates" name="القوالب" parent="menu_letter_config"
              action="action_letter_template" sequence="1"/>
    <menuitem id="menu_letter_classifications" name="التصنيفات" parent="menu_letter_config"
              action="action_letter_classification" sequence="2"/>
    <menuitem id="menu_letter_stages" name="المراحل" parent="menu_letter_config"
              action="sp_letter_v15.outgoing_stage_action" sequence="3"/>
    <menuitem id="menu_letter_tags" name="الوسوم" parent="menu_letter_config"
              action="sp_letter_v15.outgoing_tag_action" sequence="4"/>
</odoo>
