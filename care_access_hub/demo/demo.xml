<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- طلب صلاحية تجريبي: منح مسمّى مؤقّت -->
        <record id="demo_access_req_role" model="care.access.request">
            <field name="user_id" ref="base.user_admin"/>
            <field name="request_type">role</field>
            <field name="role_ids" eval="[(4, ref('care_access_hub.role_hr_mgr'))]"/>
            <field name="duration_type">temporary</field>
            <field name="date_from" eval="(DateTime.today()).strftime('%Y-%m-%d')"/>
            <field name="date_to" eval="(DateTime.today() + relativedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="reason">تغطية إجازة مدير الموارد البشرية لمدّة شهر (طلب تجريبي).</field>
        </record>

        <!-- طلب صلاحية تجريبي: إظهار قائمة -->
        <record id="demo_access_req_emergency" model="care.access.request">
            <field name="user_id" ref="base.user_admin"/>
            <field name="request_type">emergency</field>
            <field name="group_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="duration_type">temporary</field>
            <field name="date_from" eval="(DateTime.today()).strftime('%Y-%m-%d')"/>
            <field name="date_to" eval="(DateTime.today() + relativedelta(days=2)).strftime('%Y-%m-%d')"/>
            <field name="reason">وصول طوارئ عاجل لمعالجة عطل إنتاجي (طلب تجريبي).</field>
        </record>
    </data>
</odoo>
