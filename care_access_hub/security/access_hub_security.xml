<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_access_hub" model="ir.module.category">
            <field name="name">منظومة الصلاحيات</field>
        </record>

        <record id="group_access_manager" model="res.groups">
            <field name="name">مدير منظومة الصلاحيات</field>
            <field name="category_id" ref="module_category_access_hub"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- كل مستخدم يرى/يعدّل تفضيلات إشعاراته فقط -->
        <record id="rule_notify_pref_own" model="ir.rule">
            <field name="name">إشعاراتي: الخاصة بالمستخدم فقط</field>
            <field name="model_id" ref="model_care_user_notify_pref"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
        <record id="rule_notify_pref_mgr" model="ir.rule">
            <field name="name">إشعاراتي: مدير المنظومة يرى الكل</field>
            <field name="model_id" ref="model_care_user_notify_pref"/>
            <field name="groups" eval="[(4, ref('group_access_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- التفويضات: كل مستخدم يدير تفويضاته التي يمنحها (أو يرى ما فُوّض إليه) -->
        <record id="rule_delegation_own" model="ir.rule">
            <field name="name">تفويضاتي الخاصة</field>
            <field name="model_id" ref="model_care_user_delegation"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('delegator_id', '=', user.id), ('delegate_id', '=', user.id)]</field>
        </record>
        <record id="rule_delegation_mgr" model="ir.rule">
            <field name="name">التفويضات: المدير يرى الكل</field>
            <field name="model_id" ref="model_care_user_delegation"/>
            <field name="groups" eval="[(4, ref('group_access_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="rule_delegation_line_own" model="ir.rule">
            <field name="name">بنود التفويض الخاصة</field>
            <field name="model_id" ref="model_care_user_delegation_line"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('delegation_id.delegator_id', '=', user.id), ('delegation_id.delegate_id', '=', user.id)]</field>
        </record>

        <!-- طلبات الصلاحية: المستخدم يرى طلباته (قدّمها أو هو هدفها)، المدير يرى الكل -->
        <record id="rule_access_request_own" model="ir.rule">
            <field name="name">طلبات صلاحيتي</field>
            <field name="model_id" ref="model_care_access_request"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('requester_id', '=', user.id), ('user_id', '=', user.id)]</field>
        </record>
        <record id="rule_access_request_mgr" model="ir.rule">
            <field name="name">طلبات الصلاحية: المدير يرى الكل</field>
            <field name="model_id" ref="model_care_access_request"/>
            <field name="groups" eval="[(4, ref('group_access_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
