<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_menu_access_tree" model="ir.ui.view">
        <field name="name">care.menu.access.tree</field>
        <field name="model">care.menu.access</field>
        <field name="arch" type="xml">
            <tree string="وصول القوائم" editable="bottom">
                <field name="menu_id" options="{'no_create': True}"/>
                <field name="menu_path" optional="show"/>
                <field name="allow_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="hide_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </tree>
        </field>
    </record>

    <record id="action_menu_access" model="ir.actions.act_window">
        <field name="name">وصول القوائم (لكل مستخدم)</field>
        <field name="res_model">care.menu.access</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">لا قيود قوائم بعد</p>
            <p>لكل قائمة: «حصر على» (بيضاء) أو «إخفاء عن» (سوداء). المكان الموحّد لرؤية القوائم.</p>
        </field>
    </record>

    <record id="action_migrate_menu_perm_srv" model="ir.actions.server">
        <field name="name">⟲ ترحيل قيود القوائم القديمة (care_menu_perm)</field>
        <field name="model_id" ref="model_care_menu_access"/>
        <field name="state">code</field>
        <field name="code">n = env['care.menu.access'].migrate_from_menu_perm()
action = {'type': 'ir.actions.client', 'tag': 'display_notification',
          'params': {'title': 'ترحيل القوائم', 'message': 'رُحِّل %s سطر إلى النظام الموحّد.' % n,
                     'type': 'success', 'sticky': False}}</field>
    </record>

    <menuitem id="menu_menu_access" name="📋 وصول القوائم"
              parent="menu_access_hub_root" action="action_menu_access" sequence="25"/>
    <menuitem id="menu_migrate_menu_perm" name="⟲ ترحيل القوائم القديمة"
              parent="menu_access_migration" action="action_migrate_menu_perm_srv" sequence="7"/>
</odoo>
