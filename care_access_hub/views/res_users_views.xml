<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- إضافة تبويب منظومة الصلاحيات إلى نموذج المستخدم -->
    <record id="view_users_form_access_hub" model="ir.ui.view">
        <field name="name">res.users.form.access.hub</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="منظومة الصلاحيات" name="care_access_hub">
                    <group>
                        <field name="care_role_label" readonly="1"/>
                    </group>
                    <group string="المسمّيات الوظيفية">
                        <field name="care_role_ids" nolabel="1" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <div class="mt-2">
                        <button name="action_apply_roles" type="object"
                                string="تطبيق المسمّيات (إضافة آمنة)" class="btn-primary"
                                icon="fa-check"/>
                        <button name="action_preview_effective" type="object"
                                string="معاينة الصلاحية الفعلية" class="btn-secondary ms-2"
                                icon="fa-search"/>
                    </div>
                    <separator string="🏢 نطاق الشركات"/>
                    <div>
                        <button name="action_preview_company_scope" type="object"
                                string="معاينة الشركات من المسمّيات" class="btn-secondary"
                                icon="fa-building"/>
                        <button name="action_apply_company_scope" type="object"
                                string="تطبيق نطاق الشركات" class="btn-primary ms-2"
                                icon="fa-check"
                                confirm="سيُضبط «الشركات المسموح بها» لهذا المستخدم من نطاق شركات مسمّياته (مع إبقاء شركته الحالية). متابعة؟"/>
                    </div>
                    <separator string="🔔 إشعارات الاعتماد (التي تصل هذا المستخدم)"/>
                    <button name="action_sync_notify_prefs" type="object"
                            string="🔄 تحميل/تحديث" class="btn-secondary mb-2" icon="fa-refresh"/>
                    <field name="notify_pref_ids" nolabel="1">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="channel_icon" readonly="1" string=""/>
                            <field name="channel_name" readonly="1"/>
                            <field name="channels_label" readonly="1" string="القنوات"/>
                            <field name="mandatory" readonly="1"/>
                            <field name="enabled" widget="boolean_toggle" readonly="mandatory"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- لوحة «إشعاراتي» في التفضيلات الشخصية للمستخدم -->
    <record id="view_users_pref_notify" model="ir.ui.view">
        <field name="name">res.users.preferences.notify</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="🔔 إشعاراتي" name="my_notify">
                    <div class="alert alert-info" role="alert">
                        تظهر هنا <b>كل أنواع الاعتماد التي تصلك إشعاراتها</b> (حسب صلاحياتك ومسمّياتك). فعّل/عطّل ما تريد.
                        الإشعارات الإلزامية 🔒 تصل دائمًا ولا يمكن تعطيلها.
                    </div>
                    <button name="action_sync_notify_prefs" type="object"
                            string="🔄 تحميل / تحديث إشعاراتي" class="btn-primary mb-2" icon="fa-refresh"/>
                    <field name="notify_pref_ids" nolabel="1">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="channel_icon" readonly="1" string=""/>
                            <field name="channel_name" readonly="1"/>
                            <field name="channels_label" readonly="1" string="القنوات"/>
                            <field name="mandatory" readonly="1"/>
                            <field name="enabled" widget="boolean_toggle" readonly="mandatory"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
