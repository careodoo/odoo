<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- إضافة تبويب منظومة الصلاحيات إلى نموذج المستخدم -->
    <record id="view_users_form_access_hub" model="ir.ui.view">
        <field name="name">res.users.form.access.hub</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="منظومة الصلاحيات" name="care_access_hub"
                      groups="care_access_hub.group_access_manager">
                    <group>
                        <field name="care_role_label" readonly="1"/>
                    </group>
                    <group string="المسمّيات الوظيفية">
                        <field name="care_role_ids" nolabel="1" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <div class="mt-2">
                        <button name="action_apply_roles" type="object"
                                string="تطبيق المسمّيات (إضافة آمنة)" class="btn-primary"
                                icon="fa-check"/>
                        <button name="action_preview_effective" type="object"
                                string="معاينة الصلاحية الفعلية" class="btn-secondary ms-2"
                                icon="fa-search"/>
                        <button name="action_print_access" type="object"
                                string="🖨️ تقرير الصلاحيات (PDF)" class="btn-secondary ms-2"
                                icon="fa-file-pdf-o"/>
                    </div>
                    <separator string="🏢 نطاق الشركات"/>
                    <div>
                        <button name="action_preview_company_scope" type="object"
                                string="معاينة الشركات من المسمّيات" class="btn-secondary"
                                icon="fa-building"/>
                        <button name="action_apply_company_scope" type="object"
                                string="تطبيق نطاق الشركات" class="btn-primary ms-2"
                                icon="fa-check"
                                confirm="سيُضبط «الشركات المسموح بها» لهذا المستخدم من نطاق شركات مسمّياته (مع إبقاء شركته الحالية). متابعة؟"/>
                    </div>
                    <separator string="🙈 القوائم المخفية عن هذا المستخدم"/>
                    <div class="alert alert-info" role="alert">
                        القوائم المحدّدة هنا <b>لن تظهر</b> لهذا المستخدم في الواجهة (دون المساس بالمجموعات).
                        هذا هو المكان الموحّد للإخفاء لكل مستخدم — بديل شاشة «وصول القوائم» القديمة.
                    </div>
                    <field name="menu_hide_ids" nolabel="1" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </page>
                <page string="🔔 إشعارات الاعتماد" name="care_notify_prefs">
                    <div class="alert alert-info" role="alert">
                        أنواع الاعتماد التي تصل هذا المستخدم (حسب صلاحياته). فعّل/عطّل القنوات لكلّ نوع.
                    </div>
                    <button name="action_sync_notify_prefs" type="object"
                            string="🔄 تحميل/تحديث" class="btn-secondary mb-2" icon="fa-refresh"/>
                    <field name="notify_pref_ids" nolabel="1">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="channel_icon" readonly="1" string=""/>
                            <field name="channel_name" readonly="1"/>
                            <field name="use_app" widget="boolean_toggle" string="📱 تطبيق" readonly="mandatory"/>
                            <field name="use_odoo" widget="boolean_toggle" string="🔔 أودو" readonly="mandatory"/>
                            <field name="use_email" widget="boolean_toggle" string="📧 بريد" readonly="mandatory"/>
                            <field name="mandatory" readonly="1"/>
                        </tree>
                    </field>
                </page>
                <page string="🔁 التفويضات" name="my_delegations">
                    <div class="alert alert-info" role="alert">
                        فوّض زميلًا في اعتماداتك — <b>كل الموديولات</b> أو <b>مخصّص</b> — بين تاريخين وبحدّ مبلغ.
                        المفوَّض إليه يعتمد <b>بتوقيعه هو</b> ويظهر أنه «مفوّض من قبلك».
                    </div>
                    <field name="delegation_ids" nolabel="1" context="{'default_delegator_id': id}">
                        <tree>
                            <field name="delegate_id"/>
                            <field name="scope"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="amount_limit"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-info="state == 'sched'"
                                   decoration-muted="state in ('off','expired')"/>
                            <field name="active" widget="boolean_toggle"/>
                        </tree>
                        <form>
                            <group>
                                <group>
                                    <field name="delegate_id" options="{'no_create': True}"/>
                                    <field name="scope" widget="radio" options="{'horizontal': True}"/>
                                    <field name="active"/>
                                </group>
                                <group>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="amount_limit"/>
                                </group>
                            </group>
                            <div invisible="scope != 'custom'">
                                <button name="action_load_types" type="object" class="btn-primary mb-2"
                                        string="🔄 تحميل الأنواع" icon="fa-refresh"/>
                                <field name="line_ids" nolabel="1">
                                    <tree editable="bottom" create="false" delete="false">
                                        <field name="type_name" readonly="1"/>
                                        <field name="enabled" widget="boolean_toggle" string="مفوَّض ✓"/>
                                    </tree>
                                </field>
                            </div>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- لوحة «إشعاراتي» + الخدمة الذاتية في التفضيلات الشخصية للمستخدم -->
    <record id="view_users_pref_notify" model="ir.ui.view">
        <field name="name">res.users.preferences.notify</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="🗝️ طلبات الصلاحية" name="my_access_requests">
                    <div class="alert alert-info" role="alert">
                        اطلب صلاحية إضافية لنفسك أو لزميل (مسمّى وظيفي / مجموعة دقيقة / إظهار قائمة / طوارئ) —
                        مؤقّتة أو دائمة. يعتمدها <b>مدير الصلاحيات</b> فتُطبَّق تلقائيًّا، وتُسحب تلقائيًّا بانتهاء مدّتها.
                    </div>
                    <button name="%(care_access_hub.action_my_access_request)d" type="action"
                            string="➕ طلب صلاحية جديد" class="btn-primary mb-2" icon="fa-plus"/>
                    <field name="my_access_request_ids" nolabel="1" readonly="1">
                        <tree create="false" delete="false"
                              decoration-info="state == 'submitted'" decoration-success="state == 'applied'"
                              decoration-muted="state in ('rejected','revoked','expired')">
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="summary"/>
                            <field name="duration_type"/>
                            <field name="date_to" optional="show"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'submitted'" decoration-success="state == 'applied'"
                                   decoration-danger="state == 'rejected'"/>
                        </tree>
                    </field>
                </page>
                <page string="🔔 إشعاراتي" name="my_notify">
                    <div class="alert alert-info" role="alert">
                        تظهر هنا <b>كل أنواع الاعتماد التي تصلك إشعاراتها</b> (حسب صلاحياتك ومسمّياتك). فعّل/عطّل ما تريد.
                        الإشعارات الإلزامية 🔒 تصل دائمًا ولا يمكن تعطيلها.
                    </div>
                    <button name="action_sync_notify_prefs" type="object"
                            string="🔄 تحميل / تحديث إشعاراتي" class="btn-primary mb-2" icon="fa-refresh"/>
                    <field name="notify_pref_ids" nolabel="1">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="channel_icon" readonly="1" string=""/>
                            <field name="channel_name" readonly="1"/>
                            <field name="use_app" widget="boolean_toggle" string="📱 تطبيق" readonly="mandatory"/>
                            <field name="use_odoo" widget="boolean_toggle" string="🔔 أودو" readonly="mandatory"/>
                            <field name="use_email" widget="boolean_toggle" string="📧 بريد" readonly="mandatory"/>
                            <field name="mandatory" readonly="1"/>
                        </tree>
                    </field>
                </page>
                <page string="🔁 التفويضات" name="my_delegations">
                    <div class="alert alert-info" role="alert">
                        فوّض زميلًا في اعتماداتك — <b>كل الموديولات</b> أو <b>مخصّص</b> — بين تاريخين وبحدّ مبلغ.
                        المفوَّض إليه يعتمد <b>بتوقيعه هو</b> ويظهر أنه «مفوّض من قبلك».
                    </div>
                    <field name="delegation_ids" nolabel="1" context="{'default_delegator_id': id}">
                        <tree>
                            <field name="delegate_id"/>
                            <field name="scope"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="amount_limit"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-info="state == 'sched'"
                                   decoration-muted="state in ('off','expired')"/>
                            <field name="active" widget="boolean_toggle"/>
                        </tree>
                        <form>
                            <group>
                                <group>
                                    <field name="delegate_id" options="{'no_create': True}"/>
                                    <field name="scope" widget="radio" options="{'horizontal': True}"/>
                                    <field name="active"/>
                                </group>
                                <group>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="amount_limit"/>
                                </group>
                            </group>
                            <div invisible="scope != 'custom'">
                                <button name="action_load_types" type="object" class="btn-primary mb-2"
                                        string="🔄 تحميل الأنواع" icon="fa-refresh"/>
                                <field name="line_ids" nolabel="1">
                                    <tree editable="bottom" create="false" delete="false">
                                        <field name="type_name" readonly="1"/>
                                        <field name="enabled" widget="boolean_toggle" string="مفوَّض ✓"/>
                                    </tree>
                                </field>
                            </div>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
