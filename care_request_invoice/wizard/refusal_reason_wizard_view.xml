<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="request_invoice_refusal_wizard_view_form" model="ir.ui.view">
            <field name="name">request.invoice.refusal.wizard.view.form</field>
            <field name="model">request.invoice.refusal.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <field name="text"/>
                    <footer>
                        <button string="Confirm" type="object"
                            name="action_refuse" class="btn-primary"
                            data-hotkey="q" invisible="not context.get('refuse')"/>

                        <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>