<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="invoice_request_view_form" model="ir.ui.view">
            <field name="name">request.invoice.form</field>
            <field name="model">request.invoice</field>
            <field name="arch" type="xml">
                <form string="Invoice Request">
                    <header>

                        <button name="action_submit" data-hotkey="s"
                            string="Submit" type="object"
                            groups="care_request_invoice.group_create_request_invoice"
                            invisible="state != 'draft'"/>

                        <button name="action_convert_to_invoice" data-hotkey="q"
                            string="Convert To Invoice" type="object"
                            groups="care_request_invoice.group_convert_to_invoice"
                            invisible="state != 'submitted'"/>

                        <button name="action_cancel" type="object" string="Cancel" groups="care_request_invoice.group_create_request_invoice" invisible="state in ['draft', 'cancel', 'invoiced']" data-hotkey="x"/>
                        <button name="action_draft" type="object" string="Reset to Draft" groups="care_request_invoice.group_create_request_invoice" invisible="state != 'cancel'" data-hotkey="r"/>
                        <button name="action_refuse" type="object" string="Reject Request" groups="care_request_invoice.group_convert_to_invoice" invisible="state != 'submitted'" data-hotkey="r"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,invoiced"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" groups="care_request_invoice.group_convert_to_invoice" invisible="invoice_count == 0">
                                <field name="invoice_count" widget="statinfo" string="Invoices"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" readonly="state != 'draft'"/>
                                <field name="project_id" readonly="state != 'draft'"/>
                                <field name="department_id" readonly="state != 'draft'"/>
                                <field name="labor_service" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="invoice_date" readonly="state != 'draft'"/>
                                <field name="company_id" invisible="1"/>
                                <field name="has_active_pricelist" invisible="1"/>
                                <field name="show_update_pricelist" invisible="1"/>
                                <label for="pricelist_id" groups="product.group_product_pricelist" invisible="not has_active_pricelist"/>
                                <div class="o_row" invisible="not has_active_pricelist">
                                    <field name="pricelist_id" options="{'no_open':True,'no_create': True}" readonly="state != 'draft'"/>
                                    <button name="action_update_prices" type="object" string=" Update Prices" help="Recompute all prices based on this pricelist" class="btn-link mb-1 px-0" icon="fa-refresh" confirm="This will update the unit price of all products based on the new pricelist." invisible="not show_update_pricelist or state in ['invoiced', 'cancel']"/>
                                </div>
                                <field name="proposal_id" />
                                <field name="contract_id" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Invoice Lines" name="invoice_lines">
                                <field name="request_invoice_id" widget="section_and_note_one2many" readonly="state != 'draft'">
                                    <tree string="Request Invoice Lines" editable="bottom">
                                        <field name="request_id" column_invisible="1" />
                                        <field name="product_id" />
                                        <field name="display_type" column_invisible="1" />
                                        <field name="label" />
                                        <field name="quantity" />
                                        <field name="days" />
                                        <field name="product_uom_id" />
                                        <field name="price" />
                                        <field name="price_subtotal"/>
                                        <field name="company_id" column_invisible="1" />
                                        <field name="currency_id" column_invisible="1" />
                                    </tree>
                                </field>
                                <group col="12" class="oe_invoice_lines_tab">
                                    <group colspan="8">
                                    </group>
                                    <group colspan="4">
                                        <group class="oe_subtotal_footer">
                                            <field name="currency_id" invisible="1"/>
                                            <field name="amount_total"/>
                                        </group>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="invoice_request_view_tree" model="ir.ui.view">
            <field name="name">request.invoice.tree</field>
            <field name="model">request.invoice</field>
            <field name="arch" type="xml">
                <tree string="Invoice Requests">
                    <field name="name"/>
                    <field name="partner_id" />
                    <field name="project_id" />
                    <field name="department_id" />
                    <field name="invoice_date" />
                    <field name="currency_id" column_invisible="1"/>
                    <field name="amount_total"/>
                    <field name="state" widget="badge" decoration-success="state == 'invoiced'" decoration-danger="state == 'cancel'" decoration-warning="state == 'submitted'" />
                </tree>
            </field>
        </record>

        <record id="action_invoice_request" model="ir.actions.act_window">
            <field name="name">Invoice Requests</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">request.invoice</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create New Invoice Request
                </p>
            </field>
        </record>
        <menuitem id="invoice_request_menu_root"
            name="Invoice Requests"
            web_icon="care_request_invoice,static/description/icon.png"
            groups="care_request_invoice.group_create_request_invoice,care_request_invoice.group_convert_to_invoice"
            action="action_invoice_request"
            sequence="35" />

        <menuitem id="invoice_request_menu"
            action="action_invoice_request"
            parent="invoice_request_menu_root"
            groups="care_request_invoice.group_create_request_invoice,care_request_invoice.group_convert_to_invoice"
            name="Invoice Request"
            sequence="10" />
    </data>

</odoo>