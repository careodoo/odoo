<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
    
        <record id="product_pricelist_view_inherit_add_proposal" model="ir.ui.view">
            <field name="name">product.pricelist.view.form.inherit</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view"/>
            <field name="arch" type="xml">
                <xpath expr="//group//group[@name='pricelist_settings']" position="inside">
                    <field name="proposal_id" />
                </xpath>
            </field>
        </record>
    
    </data>
    
</odoo>