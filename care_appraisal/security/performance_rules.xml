<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employees see only their own performance events -->
    <record id="rule_perf_log_own" model="ir.rule">
        <field name="name">Performance: own events</field>
        <field name="model_id" ref="model_care_performance_log"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- HR sees everything (OR-combined so HR is never restricted by the own rule) -->
    <record id="rule_perf_log_hr" model="ir.rule">
        <field name="name">Performance: HR all</field>
        <field name="model_id" ref="model_care_performance_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
</odoo>
