<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_patrol_complete_confirm_form" model="ir.ui.view">
        <field name="name">security.patrol.confirm.form</field>
        <field name="model">security.patrol.confirm</field>
        <field name="arch" type="xml">
            <form string="Complete Patrol">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <field name="message" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <field name="patrol_id" invisible="1"/>
                        <field name="guard_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="reason" placeholder="Please provide a reason for completing the patrol with missing points..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Complete Anyway" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
