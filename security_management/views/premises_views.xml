<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Premise Form View -->
    <record id="view_security_premise_form" model="ir.ui.view">
        <field name="name">security.premise.form</field>
        <field name="model">security.premise</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_floors" type="object" class="oe_stat_button" icon="fa-building">
                            <field name="floor_count" string="Floors" widget="statinfo"/>
                        </button>
                        <button name="action_generate_qr_code" type="object" class="oe_stat_button" icon="fa-qrcode">
                            <span>Generate QR</span>
                        </button>
                        <button name="action_register_patrol_point" type="object" class="oe_stat_button" icon="fa-map-marker">
                            <field name="patrol_point_count" string="Patrol Points" widget="statinfo"/>
                        </button>
                    </div>
                    <!-- No image field in the model -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Premise Name"/>
                        </h1>
                        <field name="code" placeholder="Premise Code"/>
                    </div>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="address"/>
                            <field name="barcode"/>
                            <field name="qr_code" widget="image" class="oe_avatar"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Floors" name="floors">
                            <field name="floor_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="number"/>
                                    <field name="unit_count"/>
                                    <field name="patrol_point_count"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Patrol Points" name="patrol_points">
                            <field name="patrol_point_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="code"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Premise list View -->
    <record id="view_security_premise_list" model="ir.ui.view">
        <field name="name">security.premise.list</field>
        <field name="model">security.premise</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="client_id"/>
                <field name="address"/>
                <field name="barcode"/>
                <field name="floor_count"/>
                <field name="patrol_point_count"/>
            </tree>
        </field>
    </record>

    <!-- Premise Search View -->
    <record id="view_security_premise_search" model="ir.ui.view">
        <field name="name">security.premise.search</field>
        <field name="model">security.premise</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="client_id"/>
                <field name="address"/>
                <field name="barcode"/>
                <field name="qr_code"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Client" name="group_by_client" context="{'group_by': 'client_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Premise Action -->
    <record id="action_security_premise" model="ir.actions.act_window">
        <field name="name">Premises</field>
        <field name="res_model">security.premise</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new premise
            </p>
            <p>
                Create premises for your clients where security services will be provided.
            </p>
        </field>
    </record>

    <!-- Floor Action -->
    <record id="action_security_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">security.floor</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new floor
            </p>
            <p>
                Create floors for your premises to organize units and patrol points.
            </p>
        </field>
    </record>

    <!-- Unit Action -->
    <record id="action_security_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">security.unit</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new unit
            </p>
            <p>
                Create units within floors to organize your premises structure.
            </p>
        </field>
    </record>
</odoo>
