<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Checklist Item Form View -->
    <record id="view_security_task_checklist_item_form" model="ir.ui.view">
        <field name="name">security.task.checklist.item.form</field>
        <field name="model">security.task.checklist.item</field>
        <field name="arch" type="xml">
            <form string="Checklist Item">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="task_id"/>
                        <field name="sequence"/>
                        <field name="is_completed"/>
                        <field name="completed_by" readonly="1" invisible="is_completed == False"/>
                        <field name="completion_date" readonly="1" invisible="is_completed == False"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Checklist Item list View -->
    <record id="view_security_task_checklist_item_list" model="ir.ui.view">
        <field name="name">security.task.checklist.item.list</field>
        <field name="model">security.task.checklist.item</field>
        <field name="arch" type="xml">
            <tree string="Checklist Items" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_completed"/>
                <field name="completed_by" readonly="1"/>
                <field name="completion_date" readonly="1"/>
                <field name="notes"/>
                <button name="action_mark_completed" type="object"
                        string="Complete" icon="fa-check"
                        invisible="is_completed == True"/>
                <button name="action_mark_incomplete" type="object"
                        string="Undo" icon="fa-undo"
                        invisible="is_completed == False"/>
            </tree>
        </field>
    </record>

    <!-- Checklist Item Search View -->
    <record id="view_security_task_checklist_item_search" model="ir.ui.view">
        <field name="name">security.task.checklist.item.search</field>
        <field name="model">security.task.checklist.item</field>
        <field name="arch" type="xml">
            <search string="Search Checklist Items">
                <field name="name"/>
                <field name="task_id"/>
                <field name="completed_by"/>
                <filter string="Completed" name="completed" domain="[('is_completed', '=', True)]"/>
                <filter string="Not Completed" name="not_completed" domain="[('is_completed', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Task" name="group_by_task" context="{'group_by': 'task_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'is_completed'}"/>
                    <filter string="Completed By" name="group_by_completed_by" context="{'group_by': 'completed_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Checklist Item Action -->
    <record id="action_security_task_checklist_item" model="ir.actions.act_window">
        <field name="name">Checklist Items</field>
        <field name="res_model">security.task.checklist.item</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_security_task_checklist_item_search"/>
        <field name="context">{'search_default_not_completed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first checklist item
            </p>
            <p>
                Checklist items help you track the progress of tasks by breaking them down into smaller, manageable steps.
            </p>
        </field>
    </record>

    <!-- Task Checklist Template Form View -->
    <record id="view_security_task_checklist_template_form" model="ir.ui.view">
        <field name="name">security.task.checklist.template.form</field>
        <field name="model">security.task.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description"/>
                        <field name="task_type_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <notebook>
                        <page string="Checklist Items">
                            <field name="item_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="is_required"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task Checklist Template list View -->
    <record id="view_security_task_checklist_template_list" model="ir.ui.view">
        <field name="name">security.task.checklist.template.list</field>
        <field name="model">security.task.checklist.template</field>
        <field name="arch" type="xml">
            <tree string="Checklist Templates">
                <field name="name"/>
                <field name="task_type_id"/>
                <field name="item_count" string="Items"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Task Checklist Template Search View -->
    <record id="view_security_task_checklist_template_search" model="ir.ui.view">
        <field name="name">security.task.checklist.template.search</field>
        <field name="model">security.task.checklist.template</field>
        <field name="arch" type="xml">
            <search string="Search Checklist Templates">
                <field name="name"/>
                <field name="task_type_id"/>
                <group expand="0" string="Group By">
                    <filter string="Task Type" name="group_by_task_type" context="{'group_by': 'task_type_id'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Task Checklist Template Action -->
    <record id="action_security_task_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">security.task.checklist.template</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_security_task_checklist_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first checklist template
            </p>
            <p>
                Checklist templates help you standardize task checklists across your security operations.
            </p>
        </field>
    </record>

</odoo>
