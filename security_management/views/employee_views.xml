<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Employee Form View -->
    <record id="view_security_employee_form" model="ir.ui.view">
        <field name="name">security.employee.form</field>
        <field name="model">security.employee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_security_guard" string="Create Security Guard" type="object" class="oe_highlight"/>
                    <field name="security_rank" widget="statusbar" statusbar_visible="guard,supervisor,manager,director"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="active_task_count" string="Active Tasks" widget="statinfo"/>
                        </button>
                        <button name="action_view_patrols" type="object" class="oe_stat_button" icon="fa-map-marker">
                            <field name="patrol_count" string="Patrols" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Employee Name"/>
                        </h1>
                        <field name="employee_code" placeholder="Employee Code"/>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="badge_number"/>
                            <field name="is_team_leader"/>
                            <field name="role_id"/>
                            <field name="security_rank"/>
                        </group>
                        <group>
                            <field name="license_number"/>
                            <field name="license_expiry"/>
                            <field name="team_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Skills and Certifications" name="skills_certifications">
                            <group>
                                <group string="Skills">
                                    <field name="skill_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <group string="Certifications">
                                <field name="certification_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="certification_number"/>
                                        <field name="issue_date"/>
                                        <field name="expiry_date"/>
                                        <field name="issuing_authority"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Shift Assignments" name="shift_assignments">
                            <field name="shift_assignment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="shift_id"/>
                                    <field name="client_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="client_id"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Patrol Logs" name="patrol_logs">
                            <field name="patrol_log_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="premise_id"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="point_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Security Employee list View -->
    <record id="view_security_employee_list" model="ir.ui.view">
        <field name="name">security.employee.list</field>
        <field name="model">security.employee</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_code"/>
                <field name="name"/>
                <field name="team_ids" widget="many2many_tags"/>
                <field name="security_rank"/>
                <field name="badge_number"/>
                <field name="license_number"/>
                <field name="license_expiry"/>
            </list>
        </field>
    </record>

    <!-- Security Employee Kanban View -->
    <record id="view_security_employee_kanban" model="ir.ui.view">
        <field name="name">security.employee.kanban</field>
        <field name="model">security.employee</field>
        <field name="arch" type="xml">
            <kanban sample="1" class="o_security_employee_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="employee_code"/>
                <field name="badge_number"/>
                <field name="security_rank"/>
                <field name="employee_id"/>
                <field name="team_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image_fill_left d-none d-md-block" 
                                 t-att-style="'background-color: #7C7BAD;'"/>
                            <div class="oe_kanban_details d-flex flex-column">
                                <strong class="o_kanban_record_title text-truncate">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle text-muted text-truncate">
                                    <field name="employee_code"/>
                                </div>
                                <div class="o_kanban_tags_section mt-1">
                                    <span class="badge text-bg-primary" t-if="record.security_rank.raw_value">
                                        <t t-out="record.security_rank.value"/>
                                    </span>
                                    <t t-if="record.team_ids.raw_value &amp;&amp; record.team_ids.raw_value.length">
                                        <span class="badge text-bg-info ms-1">
                                            <t t-out="record.team_ids.raw_value.length"/> Teams
                                        </span>
                                    </t>
                                </div>
                                <div class="o_kanban_record_bottom mt-auto">
                                    <div class="oe_kanban_bottom_left">
                                        <span t-if="record.badge_number.raw_value">
                                            Badge: <field name="badge_number"/>
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="badge text-bg-success" t-if="record.employee_id.raw_value">
                                            HR Linked
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Security Employee Action -->
    <record id="action_security_employee" model="ir.actions.act_window">
        <field name="name">Security Employees</field>
        <field name="res_model">security.employee</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new security employee
            </p>
            <p>
                Create security employees and assign them to security teams.
            </p>
        </field>
    </record>
</odoo>
