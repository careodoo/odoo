<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Floor Form View -->
    <record id="view_security_floor_form" model="ir.ui.view">
        <field name="name">security.floor.form</field>
        <field name="model">security.floor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_units" type="object" class="oe_stat_button" icon="fa-building-o">
                            <field name="unit_count" string="Units" widget="statinfo"/>
                        </button>
                        <button name="action_generate_qr_code" type="object" class="oe_stat_button" icon="fa-qrcode">
                            <span>Generate QR</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Floor Name"/>
                        </h1>
                        <h2>
                            <field name="number" placeholder="Floor Number"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="premise_id" options="{'no_create': True}"/>
                            <field name="client_id" options="{'no_create': True}" readonly="1"/>
                        </group>
                        <group>
                            <field name="barcode" readonly="1"/>
                            <field name="qr_code" readonly="1" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Add a description for this floor..."/>
                        </page>
                        <page string="Units" name="units">
                            <field name="unit_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="unit_number"/>
                                    <field name="unit_type"/>
                                    <field name="key_count"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Patrol Points" name="patrol_points">
                            <field name="patrol_point_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="point_type"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Floor list View -->
    <record id="view_security_floor_list" model="ir.ui.view">
        <field name="name">security.floor.list</field>
        <field name="model">security.floor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="number"/>
                <field name="premise_id"/>
                <field name="client_id"/>
                <field name="unit_count"/>
                <field name="patrol_point_count"/>
            </tree>
        </field>
    </record>

    <!-- Floor Search View -->
    <record id="view_security_floor_search" model="ir.ui.view">
        <field name="name">security.floor.search</field>
        <field name="model">security.floor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="number"/>
                <field name="premise_id"/>
                <field name="client_id"/>
                <field name="barcode"/>
                <field name="qr_code"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Premise" name="group_by_premise" context="{'group_by': 'premise_id'}"/>
                    <filter string="Client" name="group_by_client" context="{'group_by': 'client_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
