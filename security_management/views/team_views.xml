<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Team Form View -->
    <record id="view_security_team_form" model="ir.ui.view">
        <field name="name">security.team.form</field>
        <field name="model">security.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_members" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="member_count" string="Members" widget="statinfo"/>
                        </button>
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" string="Tasks" widget="statinfo"/>
                        </button>
                        <button name="action_view_schedules" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="schedule_count" string="Schedules" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Team Name"/>
                        </h1>
                        <div>
                            <field name="code" placeholder="Team Code"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="leader_id" options="{'no_create': True}"/>
                            <field name="client_id" options="{'no_create': True}"/>
                            <field name="premise_id" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="team_type"/>
                            <field name="shift_type_id" options="{'no_create': True}"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Team Members">
                            <field name="member_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="role_id"/>
                                    <field name="employee_id"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="is_available"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Schedules">
                            <field name="schedule_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="assignment_count"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Add any additional notes about this team..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Security Team list View -->
    <record id="view_security_team_list" model="ir.ui.view">
        <field name="name">security.team.list</field>
        <field name="model">security.team</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="leader_id"/>
                <field name="client_id"/>
                <field name="premise_id"/>
                <field name="team_type"/>
                <field name="member_count"/>
            </tree>
        </field>
    </record>

    <!-- Security Team Search View -->
    <record id="view_security_team_search" model="ir.ui.view">
        <field name="name">security.team.search</field>
        <field name="model">security.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="leader_id"/>
                <field name="client_id"/>
                <field name="premise_id"/>
                <separator/>
                <filter string="Regular Teams" name="regular_teams" domain="[('team_type', '=', 'regular')]"/>
                <filter string="Special Teams" name="special_teams" domain="[('team_type', '=', 'special')]"/>
                <filter string="Response Teams" name="response_teams" domain="[('team_type', '=', 'response')]"/>
                <group expand="0" string="Group By">
                    <filter string="Leader" name="group_by_leader" context="{'group_by': 'leader_id'}"/>
                    <filter string="Client" name="group_by_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Premise" name="group_by_premise" context="{'group_by': 'premise_id'}"/>
                    <filter string="Team Type" name="group_by_type" context="{'group_by': 'team_type'}"/>
                    <filter string="Shift Type" name="group_by_shift" context="{'group_by': 'shift_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Security Team Kanban View -->
    <record id="view_security_team_kanban" model="ir.ui.view">
        <field name="name">security.team.kanban</field>
        <field name="model">security.team</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="leader_id"/>
                <field name="client_id"/>
                <field name="premise_id"/>
                <field name="team_type"/>
                <field name="member_count"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click" t-att-style="{borderLeft: '5px solid ' + (record.color.raw_value || '#ccc')}">
                            <div class="row mb-1">
                                <div class="col-6">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="col-6 text-right">
                                    <span class="badge badge-secondary"><field name="code"/></span>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-12">
                                    <i class="fa fa-user mr-1"/><field name="leader_id"/>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-12">
                                    <i class="fa fa-building-o mr-1"/><field name="client_id"/>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-12">
                                    <i class="fa fa-map-marker mr-1"/><field name="premise_id"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <span t-att-class="['badge', 'badge-' + (record.team_type.raw_value == 'regular' ? 'primary' : (record.team_type.raw_value == 'special' ? 'success' : 'warning'))]">
                                        <field name="team_type"/>
                                    </span>
                                </div>
                                <div class="col-6 text-right">
                                    <span class="badge badge-info">
                                        <i class="fa fa-users mr-1"/><field name="member_count"/> Members
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Security Guard Form View -->
    <record id="view_security_guard_form" model="ir.ui.view">
        <field name="name">security.guard.form</field>
        <field name="model">security.guard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_patrols" type="object" class="oe_stat_button" icon="fa-route">
                            <field name="patrol_count" string="Patrols" widget="statinfo"/>
                        </button>
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" string="Tasks" widget="statinfo"/>
                        </button>
                        <button name="action_view_schedules" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="schedule_count" string="Schedules" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" force_save="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="security_employee_id" options="{'no_create': True}"/>
                            <field name="security_employee_role_id" options="{'no_create': True}"/>
                            <field name="security_employee_team_ids" options="{'no_create': True}" widget="many2many_tags"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="badge_number"/>
                            <field name="license_number"/>
                            <field name="license_expiry"/>
                            <field name="is_available"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="years_experience"/>
                            <field name="join_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Skills &amp; Certifications">
                            <field name="skill_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Schedule">
                            <field name="schedule_assignment_ids" context="{'default_guard_id': id, 'default_security_employee_id': security_employee_id}">
                                <tree>
                                    <field name="schedule_id"/>
                                    <field name="shift_id"/>
                                    <field name="date"/>
                                    <field name="start_datetime"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Add any additional notes about this guard..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Security Guard list View -->
    <record id="view_security_guard_list" model="ir.ui.view">
        <field name="name">security.guard.list</field>
        <field name="model">security.guard</field>
        <field name="arch" type="xml">
            <tree decoration-success="is_available == True" decoration-danger="is_available == False">
                <field name="name"/>
                <field name="badge_number"/>
                <field name="security_employee_role_id"/>
                <field name="security_employee_team_ids" widget="many2many_tags"/>
                <field name="phone"/>
                <field name="license_number"/>
                <field name="license_expiry"/>
                <field name="is_available"/>
            </tree>
        </field>
    </record>

    <!-- Security Guard Search View -->
    <record id="view_security_guard_search" model="ir.ui.view">
        <field name="name">security.guard.search</field>
        <field name="model">security.guard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="badge_number"/>
                <field name="security_employee_role_id"/>
                <field name="security_employee_team_ids" widget="many2many_tags"/>
                <field name="license_number"/>
                <separator/>
                <filter string="Available" name="available_guards" domain="[('is_available', '=', True)]"/>
                <filter string="Unavailable" name="unavailable_guards" domain="[('is_available', '=', False)]"/>
                <filter string="License Expiring" name="license_expiring" domain="[('license_expiry', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d')), ('license_expiry', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="License Expired" name="license_expired" domain="[('license_expiry', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Team" name="group_by_team" context="{'group_by': 'security_employee_team_ids'}"/>
                    <filter string="Role" name="group_by_role" context="{'group_by': 'security_employee_role_id'}"/>
                    <filter string="Availability" name="group_by_availability" context="{'group_by': 'is_available'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Security Guard Kanban View -->
    <record id="view_security_guard_kanban" model="ir.ui.view">
        <field name="name">security.guard.kanban</field>
        <field name="model">security.guard</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="badge_number"/>
                <field name="security_employee_role_id"/>
                <field name="security_employee_team_ids" widget="many2many_tags"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="is_available"/>
                <field name="image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('security.guard', 'image', record.id.raw_value)" alt="Guard Image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="row mb-1">
                                    <div class="col-6">
                                        <strong><field name="name"/></strong>
                                    </div>
                                    <div class="col-6 text-right">
                                        <span t-if="record.is_available.raw_value" class="badge badge-success">Available</span>
                                        <span t-if="!record.is_available.raw_value" class="badge badge-danger">Unavailable</span>
                                    </div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-12">
                                        <span class="badge badge-secondary"><field name="badge_number"/></span>
                                        <span class="badge badge-info"><field name="security_employee_role_id"/></span>
                                    </div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-12">
                                        <i class="fa fa-users mr-1"/><field name="security_employee_team_ids"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <i class="fa fa-phone mr-1"/><field name="phone"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Security Role Form View -->
    <record id="view_security_role_form" model="ir.ui.view">
        <field name="name">security.role.form</field>
        <field name="model">security.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Role Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="is_leadership"/>
                            <field name="min_experience"/>
                            <field name="required_license"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe this role..."/>
                        </page>
                        <page string="Required Skills">
                            <field name="required_skill_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="min_proficiency"/>
                                    <field name="certification_required"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Guards with this Role">
                            <field name="guard_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="badge_number"/>
                                    <field name="security_employee_team_ids" widget="many2many_tags"/>
                                    <field name="years_experience"/>
                                    <field name="is_available"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Security Role list View -->
    <record id="view_security_role_list" model="ir.ui.view">
        <field name="name">security.role.list</field>
        <field name="model">security.role</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_leadership"/>
                <field name="min_experience"/>
                <field name="required_license"/>
            </tree>
        </field>
    </record>

    <!-- Security Role Search View -->
    <record id="view_security_role_search" model="ir.ui.view">
        <field name="name">security.role.search</field>
        <field name="model">security.role</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Leadership Roles" name="leadership_roles" domain="[('is_leadership', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Leadership" name="group_by_leadership" context="{'group_by': 'is_leadership'}"/>
                    <filter string="Required License" name="group_by_license" context="{'group_by': 'required_license'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Shift Type Form View -->
    <record id="view_security_shift_type_form" model="ir.ui.view">
        <field name="name">security.shift.type.form</field>
        <field name="model">security.shift.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Shift Type Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="duration" widget="float_time"/>
                            <field name="is_night_shift"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe this shift type..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Shift Type list View -->
    <record id="view_security_shift_type_list" model="ir.ui.view">
        <field name="name">security.shift.type.list</field>
        <field name="model">security.shift.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="duration" widget="float_time"/>
                <field name="is_night_shift"/>
            </tree>
        </field>
    </record>

    <!-- Shift Type Search View -->
    <record id="view_security_shift_type_search" model="ir.ui.view">
        <field name="name">security.shift.type.search</field>
        <field name="model">security.shift.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Night Shifts" name="night_shifts" domain="[('is_night_shift', '=', True)]"/>
                <filter string="Day Shifts" name="day_shifts" domain="[('is_night_shift', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Night Shift" name="group_by_night" context="{'group_by': 'is_night_shift'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Security Team Role Form View -->
    <record id="view_security_team_role_form" model="ir.ui.view">
        <field name="name">security.team.role.form</field>
        <field name="model">security.team.role</field>
        <field name="arch" type="xml">
            <form string="Team Role">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Role Name"/>
                        </h1>
                        <h2>
                            <field name="code" placeholder="Role Code"/>
                        </h2>
                    </div>
                    <group>
                        <field name="description"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Security Team Role list View -->
    <record id="view_security_team_role_list" model="ir.ui.view">
        <field name="name">security.team.role.list</field>
        <field name="model">security.team.role</field>
        <field name="arch" type="xml">
            <tree string="Team Roles">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Security Team Role Search View -->
    <record id="view_security_team_role_search" model="ir.ui.view">
        <field name="name">security.team.role.search</field>
        <field name="model">security.team.role</field>
        <field name="arch" type="xml">
            <search string="Search Team Roles">
                <field name="name"/>
                <field name="code"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Security Team Role Action -->
    <record id="action_security_team_role" model="ir.actions.act_window">
        <field name="name">Team Roles</field>
        <field name="res_model">security.team.role</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_security_team_role_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first team role
            </p>
            <p>
                Team roles define the responsibilities and permissions of security team members.
            </p>
        </field>
    </record>

    <record id="action_security_guard" model="ir.actions.act_window">
        <field name="name">Security Guards</field>
        <field name="res_model">security.guard</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_security_guard_search"/>
        <field name="context">{'search_default_available_guards': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first security guard!
            </p>
            <p>
                Security guards are personnel assigned to security teams.
                Each guard has a role and can be assigned to tasks and patrols.
            </p>
        </field>
    </record>

    <record id="action_security_role" model="ir.actions.act_window">
        <field name="name">Security Roles</field>
        <field name="res_model">security.role</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_security_role_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first security role!
            </p>
            <p>
                Security roles define the responsibilities and requirements for security guards.
                Each role can specify required skills and experience levels.
            </p>
        </field>
    </record>

    <record id="action_security_shift_type" model="ir.actions.act_window">
        <field name="name">Shift Types</field>
        <field name="res_model">security.shift.type</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_security_shift_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first shift type!
            </p>
            <p>
                Shift types define the working hours for security teams.
                Each shift type specifies start and end times, and whether it's a night shift.
            </p>
        </field>
    </record>
    
    <!-- Security Team Action - THIS WAS MISSING -->
    <record id="action_security_team" model="ir.actions.act_window">
        <field name="name">Security Teams</field>
        <field name="res_model">security.team</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_security_team_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first security team!
            </p>
            <p>
                Security teams are groups of guards assigned to clients and premises.
                Each team has a leader and can be scheduled for shifts and tasks.
            </p>
        </field>
    </record>
</odoo>
