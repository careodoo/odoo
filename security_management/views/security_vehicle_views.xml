<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View security.vehicle View List -->
    <record id="view_security_vehicle_list" model="ir.ui.view">
        <field name="name">view.security.vehicle.list</field>
        <field name="model">security.vehicle</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- View security.vehicle form -->
    <record id="view_security_vehicle_form" model="ir.ui.view">
        <field name="name">view.security.vehicle.form</field>
        <field name="model">security.vehicle</field>
        <field name="arch" type="xml">
            <form string="Security Vehicle">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View security.vehicle search -->
    <record id="view_security_vehicle_search" model="ir.ui.view">
        <field name="name">view.security.vehicle.search</field>
        <field name="model">security.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action security.vehicle -->
    <record id="action_security_vehicle" model="ir.actions.act_window">
        <field name="name">Security Vehicle</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">security.vehicle</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Security Vehicle.
            </p>
        </field>
    </record>

</odoo>
