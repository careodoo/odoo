<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security Dashboard Client Action -->
    <record id="action_security_dashboard" model="ir.actions.client">
        <field name="name">Security Dashboard</field>
        <field name="tag">security_management.security_dashboard</field>
    </record>
    

    <!-- Patrol Dashboard Action -->
    <record id="action_patrol_dashboard" model="ir.actions.client">
        <field name="name">Patrol Dashboard</field>
        <field name="tag">security_manager.patrol_dashboard</field>
    </record>

    <!-- Key Management Dashboard Action -->
    <record id="action_key_management_dashboard" model="ir.actions.client">
        <field name="name">Key Management Dashboard</field>
        <field name="tag">security_management.key_management_dashboard</field>
    </record>

    <!-- Incident Reporting Dashboard Action -->
    <record id="action_incident_reporting_dashboard" model="ir.actions.client">
        <field name="name">Incident Reporting Dashboard</field>
        <field name="tag">security_management.incident_reporting_dashboard</field>
    </record>

    <!-- Gate Pass Component Action -->
    <record id="action_gate_pass_component" model="ir.actions.client">
        <field name="name">Gate Pass</field>
        <field name="tag">security_management.gate_pass_component</field>
    </record>

    <!-- The template content has been moved to static/src/xml/security_dashboard.xml -->
    <!-- This empty template is kept for backward compatibility -->
    <template id="security_dashboard_template"/>
</odoo>
