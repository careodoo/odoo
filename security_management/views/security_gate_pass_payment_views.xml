<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="security_gate_pass_payment_view_tree" model="ir.ui.view">
        <field name="name">security.gate.pass.payment.tree</field>
        <field name="model">security.gate.pass.payment</field>
        <field name="arch" type="xml">
            <tree string="Gate Pass Payments" decoration-info="state=='draft'" decoration-muted="state=='cancelled'" decoration-success="state=='posted'">
                <field name="name"/>
                <field name="gate_pass_id"/>
                <field name="client_id"/>
                <field name="visitor_name"/>
                <field name="payment_date"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="payment_method"/>
                <field name="cashier_id"/>
                <field name="gate_id"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-info="state == 'draft'" decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="security_gate_pass_payment_view_form" model="ir.ui.view">
        <field name="name">security.gate.pass.payment.form</field>
        <field name="model">security.gate.pass.payment</field>
        <field name="arch" type="xml">
            <form string="Gate Pass Payment">
                <header>
                    <button name="action_post" string="Post" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state != 'cancelled'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'posted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_print_receipt" type="object" class="oe_stat_button" icon="fa-print" string="Print Receipt" invisible="receipt_printed"/>
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" string="Invoice" invisible="not move_id"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="gate_pass_id"/>
                            <field name="client_id"/>
                            <field name="visitor_id" invisible="not visitor_id"/>
                            <field name="visitor_name"/>
                            <field name="visitor_company"/>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                            <field name="days_valid"/>
                        </group>
                        <group>
                            <field name="payment_date"/>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="payment_method"/>
                            <field name="payment_reference" invisible="payment_method == 'cash'" required="payment_method != 'cash'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Cashier Information">
                        <field name="cashier_id"/>
                        <field name="shift_id"/>
                        <field name="gate_id"/>
                    </group>
                    <group string="Receipt Information">
                        <field name="receipt_printed"/>
                        <field name="receipt_number"/>
                    </group>
                    <group string="Access Information">
                        <field name="access_granted"/>
                        <field name="access_time" invisible="not access_granted"/>
                        <field name="access_notes"/>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Add notes here..."/>
                        </page>
                        <page string="Journal Entry" invisible="not move_id">
                            <group>
                                <field name="move_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="security_gate_pass_payment_view_search" model="ir.ui.view">
        <field name="name">security.gate.pass.payment.search</field>
        <field name="model">security.gate.pass.payment</field>
        <field name="arch" type="xml">
            <search string="Gate Pass Payments">
                <field name="name" string="Receipt Reference"/>
                <field name="gate_pass_id"/>
                <field name="client_id"/>
                <field name="visitor_name"/>
                <field name="visitor_company"/>
                <field name="payment_reference"/>
                <field name="cashier_id"/>
                <field name="gate_id"/>
                <field name="receipt_number"/>
                <filter string="My Payments" name="my_payments" domain="[('cashier_id.user_id', '=', uid)]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="Today" name="today" domain="[('payment_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('payment_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('payment_date', '>=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Access Granted" name="access_granted" domain="[('access_granted', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Gate Pass" name="group_by_gate_pass" context="{'group_by': 'gate_pass_id'}"/>
                    <filter string="Client" name="group_by_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Payment Date" name="group_by_date" context="{'group_by': 'payment_date'}"/>
                    <filter string="Payment Method" name="group_by_method" context="{'group_by': 'payment_method'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Cashier" name="group_by_cashier" context="{'group_by': 'cashier_id'}"/>
                    <filter string="Gate" name="group_by_gate" context="{'group_by': 'gate_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Kanban View -->
    <record id="security_gate_pass_payment_view_kanban" model="ir.ui.view">
        <field name="name">security.gate.pass.payment.kanban</field>
        <field name="model">security.gate.pass.payment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="gate_pass_id"/>
                <field name="client_id"/>
                <field name="visitor_name"/>
                <field name="payment_date"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="payment_method"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <span><t t-esc="record.name.value"/></span>
                                    </strong>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-toggle="dropdown" title="Actions" aria-label="Actions">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Edit</a></t>
                                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><strong>Gate Pass: </strong><field name="gate_pass_id"/></div>
                                <div><strong>Visitor: </strong><field name="visitor_name"/></div>
                                <div><strong>Amount: </strong><field name="amount" widget="monetary"/></div>
                                <div><strong>Method: </strong><field name="payment_method"/></div>
                                <div><strong>Date: </strong><field name="payment_date"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span t-attf-class="badge #{record.state.raw_value == 'draft' ? 'bg-info' : record.state.raw_value == 'posted' ? 'bg-success' : 'bg-danger'}">
                                        <t t-esc="record.state.value"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Calendar View -->
    <record id="security_gate_pass_payment_view_calendar" model="ir.ui.view">
        <field name="name">security.gate.pass.payment.calendar</field>
        <field name="model">security.gate.pass.payment</field>
        <field name="arch" type="xml">
            <calendar string="Payment Calendar" date_start="payment_date" color="state" mode="month">
                <field name="name"/>
                <field name="gate_pass_id"/>
                <field name="visitor_name"/>
                <field name="amount"/>
                <field name="payment_method"/>
            </calendar>
        </field>
    </record>
    
    <!-- Graph View -->
    <record id="security_gate_pass_payment_view_graph" model="ir.ui.view">
        <field name="name">security.gate.pass.payment.graph</field>
        <field name="model">security.gate.pass.payment</field>
        <field name="arch" type="xml">
            <graph string="Payment Analysis" sample="1">
                <field name="payment_date" interval="day"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    
    <!-- Pivot View -->
    <record id="security_gate_pass_payment_view_pivot" model="ir.ui.view">
        <field name="name">security.gate.pass.payment.pivot</field>
        <field name="model">security.gate.pass.payment</field>
        <field name="arch" type="xml">
            <pivot string="Payment Analysis" sample="1">
                <field name="payment_date" type="row"/>
                <field name="payment_method" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_security_gate_pass_payment" model="ir.actions.act_window">
        <field name="name">Gate Pass Payments</field>
        <field name="res_model">security.gate.pass.payment</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="security_gate_pass_payment_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first gate pass payment
            </p>
            <p>
                Manage gate pass payments for visitors entering your premises.
            </p>
        </field>
    </record>
    
</odoo>
