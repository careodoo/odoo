<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Schedule Form View -->
    <record id="view_security_schedule_form" model="ir.ui.view">
        <field name="name">security.schedule.form</field>
        <field name="model">security.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm Schedule" type="object"
                            invisible="state != 'draft'" class="btn_primary"/>
                    <button name="action_start" string="Start Schedule" type="object"
                            invisible="state != 'confirmed'" class="btn_success"/>
                    <button name="action_complete" string="Complete Schedule" type="object"
                            invisible="state != 'in_progress'" class="btn_success"/>
                    <button name="action_cancel" string="Cancel Schedule" type="object"
                            invisible="state in ('completed', 'cancelled')" class="btn_danger"/>
                    <button name="action_reset" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'" groups="base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-calendar-check-o">
                            <field name="assignment_count" string="Assignments" widget="statinfo"/>
                        </button>
                        <button name="action_view_shifts" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="shift_count" string="Shifts" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Schedule Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="team_id" options="{'no_create': True}"/>
                            <field name="client_id" options="{'no_create': True}"/>
                            <field name="premise_id" options="{'no_create': True}" domain="[('client_id', '=', client_id)]"/>
                            <field name="created_by" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration_days" readonly="1"/>
                            <field name="is_recurring"/>
                            <field name="recurrence_interval" invisible="is_recurring == False" required="is_recurring == True"/>
                            <field name="recurrence_type" invisible="is_recurring == False" required="is_recurring == True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shifts">
                            <field name="shift_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="shift_type_id"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="duration" widget="float_time"/>
                                    <field name="min_guards"/>
                                    <field name="max_guards"/>
                                    <field name="assigned_count"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Assignments">
                            <field name="assignment_ids">
                                <tree>
                                    <field name="guard_id"/>
                                    <field name="shift_id"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Add any additional notes about this schedule..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Schedule list View -->
    <record id="view_security_schedule_list" model="ir.ui.view">
        <field name="name">security.schedule.list</field>
        <field name="model">security.schedule</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'"
                  decoration-danger="state == 'in_progress'" decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="team_id"/>
                <field name="client_id"/>
                <field name="premise_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="assignment_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Schedule Search View -->
    <record id="view_security_schedule_search" model="ir.ui.view">
        <field name="name">security.schedule.search</field>
        <field name="model">security.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="team_id"/>
                <field name="client_id"/>
                <field name="premise_id"/>
                <separator/>
                <filter string="Draft" name="draft_schedules" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed_schedules" domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Progress" name="in_progress_schedules" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed_schedules" domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="cancelled_schedules" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Recurring" name="recurring_schedules" domain="[('is_recurring', '=', True)]"/>
                <filter string="Current Week" name="current_week" domain="[
                    '|',
                    '&amp;', ('start_date', '&lt;=', (context_today() + datetime.timedelta(days=6)).strftime('%Y-%m-%d')),
                         ('start_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                    '&amp;', ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                         ('start_date', '&lt;=', context_today().strftime('%Y-%m-%d'))
                ]"/>
                <group expand="0" string="Group By">
                    <filter string="Team" name="group_by_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Client" name="group_by_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Premise" name="group_by_premise" context="{'group_by': 'premise_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Start Date" name="group_by_start_date" context="{'group_by': 'start_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Schedule Calendar View -->
    <record id="view_security_schedule_calendar" model="ir.ui.view">
        <field name="name">security.schedule.calendar</field>
        <field name="model">security.schedule</field>
        <field name="arch" type="xml">
            <calendar string="Schedules" date_start="start_date" date_stop="end_date" color="team_id" mode="month">
                <field name="name"/>
                <field name="team_id"/>
                <field name="client_id"/>
                <field name="premise_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Schedule Kanban View -->
    <record id="view_security_schedule_kanban" model="ir.ui.view">
        <field name="name">security.schedule.kanban</field>
        <field name="model">security.schedule</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="team_id"/>
                <field name="client_id"/>
                <field name="premise_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="assignment_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="row mb-1">
                                <div class="col-6">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="col-6 text-right">
                                    <span t-attf-class="badge badge-#{record.state.raw_value == 'draft' ? 'info' :
                                                                       record.state.raw_value == 'confirmed' ? 'warning' :
                                                                       record.state.raw_value == 'in_progress' ? 'danger' :
                                                                       record.state.raw_value == 'completed' ? 'success' : 'secondary'}">
                                        <field name="state"/>
                                    </span>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-12">
                                    <i class="fa fa-users mr-1"/><field name="team_id"/>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-12">
                                    <i class="fa fa-building-o mr-1"/><field name="client_id"/>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-12">
                                    <i class="fa fa-map-marker mr-1"/><field name="premise_id"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-6">
                                    <i class="fa fa-calendar mr-1"/>
                                    <field name="start_date"/>
                                </div>
                                <div class="col-6 text-right">
                                    <span class="badge badge-info">
                                        <i class="fa fa-users mr-1"/><field name="assignment_count"/> Assignments
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Shift Form View -->
    <record id="view_security_shift_form" model="ir.ui.view">
        <field name="name">security.shift.form</field>
        <field name="model">security.shift</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="assigned_count" string="Guards" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Shift Name"/>
                        </h1>
                        <h2>
                            <field name="code" placeholder="Shift Code" class="oe_inline"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="schedule_id" options="{'no_create': True}"/>
                            <field name="shift_type_id" options="{'no_create': True}"/>
                            <field name="color" widget="color_picker"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="start_time" widget="float_time" required="1"/>
                            <field name="end_time" widget="float_time" required="1"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                            <field name="min_guards"/>
                            <field name="max_guards"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Guards" name="assigned_guards">
                            <field name="assignment_ids" context="{'default_shift_id': id, 'default_schedule_id': schedule_id}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="guard_id"/>
                                    <field name="security_employee_id" readonly="1"/>
                                    <field name="date" required="1"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="client_id"/>
                                    <field name="attendance_id"/>
                                    <field name="state" decoration-success="state == 'completed'" decoration-info="state == 'checked_in'" decoration-warning="state == 'scheduled'" decoration-danger="state == 'missed' or state == 'cancelled'"/>
                                </tree>
                            </field>
                            <chatter/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add any additional notes about this shift..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Shift list View -->
    <record id="view_security_shift_list" model="ir.ui.view">
        <field name="name">security.shift.list</field>
        <field name="model">security.shift</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="schedule_id"/>
                <field name="shift_type_id"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="duration" widget="float_time"/>
                <field name="assigned_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Shift Search View -->
    <record id="view_security_shift_search" model="ir.ui.view">
        <field name="name">security.shift.search</field>
        <field name="model">security.shift</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="schedule_id"/>
                <field name="shift_type_id"/>
                <separator/>
                <filter string="Draft" name="draft_shifts" domain="[('state', '=', 'draft')]"/>
                <filter string="Assigned" name="assigned_shifts" domain="[('state', '=', 'assigned')]"/>
                <filter string="In Progress" name="in_progress_shifts" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed_shifts" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Schedule" name="group_by_schedule" context="{'group_by': 'schedule_id'}"/>
                    <filter string="Shift Type" name="group_by_shift_type" context="{'group_by': 'shift_type_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Assignment Form View -->
    <record id="view_security_assignment_form" model="ir.ui.view">
        <field name="name">security.assignment.form</field>
        <field name="model">security.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm Assignment" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_start" string="Start Assignment" type="object"
                            invisible="state != 'confirmed'" class="btn-success"/>
                    <button name="action_complete" string="Complete Assignment" type="object"
                            invisible="state != 'in_progress'" class="btn-success"/>
                    <button name="action_cancel" string="Cancel Assignment" type="object"
                            invisible="state in ('completed', 'cancelled')" class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="schedule_id" options="{'no_create': True}"/>
                            <field name="shift_id" options="{'no_create': True}" domain="[('schedule_id', '=', schedule_id)]"/>
                            <field name="guard_id" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="check_in" readonly="1" invisible="check_in == False"/>
                            <field name="check_out" readonly="1" invisible="check_out == False"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Add any additional notes about this assignment..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Assignment list View -->
    <record id="view_security_assignment_list" model="ir.ui.view">
        <field name="name">security.assignment.list</field>
        <field name="model">security.assignment</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'"
                  decoration-danger="state == 'in_progress'" decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="schedule_id"/>
                <field name="shift_id"/>
                <field name="guard_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Assignment Search View -->
    <record id="view_security_assignment_search" model="ir.ui.view">
        <field name="name">security.assignment.search</field>
        <field name="model">security.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="schedule_id"/>
                <field name="shift_id"/>
                <field name="guard_id"/>
                <separator/>
                <filter string="Draft" name="draft_assignments" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed_assignments" domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Progress" name="in_progress_assignments" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed_assignments" domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="cancelled_assignments" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Today" name="today_assignments" domain="[
                    '|',
                    '&amp;', ('start_datetime', '&lt;=', context_today().strftime('%Y-%m-%d')),
                         ('end_datetime', '&gt;=', context_today().strftime('%Y-%m-%d')),
                    ('start_datetime', '=', context_today().strftime('%Y-%m-%d'))
                ]"/>
                <group expand="0" string="Group By">
                    <filter string="Schedule" name="group_by_schedule" context="{'group_by': 'schedule_id'}"/>
                    <filter string="Shift" name="group_by_shift" context="{'group_by': 'shift_id'}"/>
                    <filter string="Guard" name="group_by_guard" context="{'group_by': 'guard_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Start Date" name="group_by_start_datetime" context="{'group_by': 'start_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Assignment Calendar View -->
    <record id="view_security_assignment_calendar" model="ir.ui.view">
        <field name="name">security.assignment.calendar</field>
        <field name="model">security.assignment</field>
        <field name="arch" type="xml">
            <calendar string="Assignments" date_start="start_datetime" date_stop="end_datetime" color="guard_id" mode="week">
                <field name="name"/>
                <field name="guard_id"/>
                <field name="shift_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_security_schedule" model="ir.actions.act_window">
        <field name="name">Schedules</field>
        <field name="res_model">security.schedule</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="search_view_id" ref="view_security_schedule_search"/>
        <field name="context">{'search_default_current_week': 1, 'group_by': 'state'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first security schedule!
            </p>
            <p>
                Schedules help you organize shifts and assignments for security teams.
                You can assign guards to shifts and track their progress.
            </p>
        </field>
    </record>

    <record id="action_security_shift" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">security.shift</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_security_shift_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first security shift!
            </p>
            <p>
                Shifts define specific time periods within schedules.
                You can assign guards to shifts and track their progress.
            </p>
        </field>
    </record>

    <record id="action_security_assignment" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">security.assignment</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="search_view_id" ref="view_security_assignment_search"/>
        <field name="context">{'search_default_today_assignments': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first guard assignment!
            </p>
            <p>
                Assignments link guards to specific shifts in a schedule.
                You can track check-in and check-out times for each assignment.
            </p>
        </field>
    </record>
</odoo>
