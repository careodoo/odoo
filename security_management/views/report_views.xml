<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Patrol Report Action -->
    <record id="action_security_patrol_report" model="ir.actions.act_window">
        <field name="name">Patrol Reports</field>
        <field name="res_model">security.patrol.log</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="context">{'search_default_group_by_date': 1, 'search_default_group_by_patrol_point': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No patrol reports found
            </p>
            <p>
                View and analyze patrol activity across your premises.
            </p>
        </field>
    </record>

    <!-- Key Report Action -->
    <record id="action_security_key_report" model="ir.actions.act_window">
        <field name="name">Key Reports</field>
        <field name="res_model">security.key.log</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="context">{'search_default_group_by_date': 1, 'search_default_group_by_key': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No key reports found
            </p>
            <p>
                View and analyze key usage and handovers.
            </p>
        </field>
    </record>

    <!-- Inspection Report Action -->
    <record id="action_security_inspection_report" model="ir.actions.act_window">
        <field name="name">Inspection Reports</field>
        <field name="res_model">security.inspection</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="context">{'search_default_group_by_date': 1, 'search_default_group_by_premise': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No inspection reports found
            </p>
            <p>
                View and analyze inspection results across your premises.
            </p>
        </field>
    </record>

    <!-- Incident Report Summary Action -->
    <record id="action_security_incident_report_summary" model="ir.actions.act_window">
        <field name="name">Incident Summary</field>
        <field name="res_model">security.incident.report</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="context">{'search_default_group_by_date': 1, 'search_default_group_by_type': 1, 'search_default_group_by_premise': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No incident reports found
            </p>
            <p>
                View and analyze security incidents by type, location, and time.
            </p>
        </field>
    </record>

    <!-- Schedule Report Action -->
    <record id="action_security_schedule_report" model="ir.actions.act_window">
        <field name="name">Schedule Reports</field>
        <field name="res_model">security.schedule</field>
        <field name="view_mode">pivot,graph,tree,form</field>
        <field name="context">{'search_default_group_by_date': 1, 'search_default_group_by_team': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No schedule reports found
            </p>
            <p>
                View and analyze security team scheduling and coverage.
            </p>
        </field>
    </record>

    <!-- Incident Report Action -->
    <record id="action_security_incident_report" model="ir.actions.act_window">
        <field name="name">Incident Reports</field>
        <field name="res_model">security.incident.report</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No incident reports found
            </p>
            <p>
                Create and manage security incident reports.
            </p>
        </field>
    </record>
</odoo>
