<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task Form View -->
    <record id="view_security_task_form" model="ir.ui.view">
        <field name="name">security.task.form</field>
        <field name="model">security.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_progress" string="Start Task" type="object"
                            invisible="state != 'assigned'" class="btn-primary"/>
                    <button name="action_complete" string="Complete" type="object"
                            invisible="state != 'in_progress'" class="btn-success"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('completed', 'cancelled')" class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_subtasks" type="object" class="oe_stat_button" icon="fa-tasks"
                                invisible="subtask_count == 0">
                            <field name="subtask_count" string="Subtasks" widget="statinfo"/>
                        </button>
                        <button name="action_view_parent" type="object" class="oe_stat_button" icon="fa-level-up"
                                invisible="parent_id == False">
                            <span>Parent Task</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Task Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="task_type_id" options="{'no_create': True}"/>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="premise_id" options="{'no_create': True}"/>
                            <field name="client_id" options="{'no_create': True}"/>
                            <field name="team_id" options="{'no_create': True}"/>
                            <field name="assigned_to" options="{'no_create': True}"/>
                            <field name="priority" widget="priority"/>
                            <field name="parent_id" options="{'no_create': True}" invisible="subtask_count > 0"/>
                        </group>
                        <group>
                            <field name="deadline"/>
                            <field name="planned_date"/>
                            <field name="start_date" readonly="1" invisible="start_date == False"/>
                            <field name="completion_date" readonly="1" invisible="completion_date == False"/>
                            <field name="duration" widget="float_time" readonly="1" invisible="duration == 0"/>
                            <field name="progress" widget="progressbar" invisible="state in ('draft', 'assigned')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe the task in detail..."/>
                        </page>
                        <page string="Subtasks" invisible="subtask_ids == []">
                            <field name="subtask_ids" context="{'default_parent_id': id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="assigned_to"/>
                                    <field name="deadline"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="state"/>
                                    <field name="progress" widget="progressbar"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Checklist">
                            <field name="checklist_item_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="is_completed" widget="boolean_toggle"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Add any additional notes or observations..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Task list View -->
    <record id="view_security_task_list" model="ir.ui.view">
        <field name="name">security.task.list</field>
        <field name="model">security.task</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-warning="state == 'assigned'"
                  decoration-danger="state == 'in_progress'" decoration-success="state == 'completed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="task_type_id"/>
                <field name="premise_id"/>
                <field name="client_id"/>
                <field name="assigned_to"/>
                <field name="deadline"/>
                <field name="priority" widget="priority"/>
                <field name="state"/>
                <field name="progress" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <!-- Task Search View -->
    <record id="view_security_task_search" model="ir.ui.view">
        <field name="name">security.task.search</field>
        <field name="model">security.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="task_type_id"/>
                <field name="premise_id"/>
                <field name="client_id"/>
                <field name="team_id"/>
                <field name="assigned_to"/>
                <separator/>
                <filter string="Draft" name="draft_tasks" domain="[('state', '=', 'draft')]"/>
                <filter string="Assigned" name="assigned_tasks" domain="[('state', '=', 'assigned')]"/>
                <filter string="In Progress" name="in_progress_tasks" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed_tasks" domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="cancelled_tasks" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="High Priority" name="high_priority" domain="[('priority', '=', '3')]"/>
                <filter string="My Tasks" name="my_tasks" domain="[('assigned_to', '=', uid)]"/>
                <filter string="My Team's Tasks" name="team_tasks" domain="[('team_id.member_ids', 'in', uid)]"/>
                <filter string="Overdue" name="overdue_tasks" domain="[('deadline', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ['completed', 'cancelled'])]"/>
                <filter string="Today's Deadline" name="today_deadline" domain="[('deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Task Type" name="group_by_type" context="{'group_by': 'task_type_id'}"/>
                    <filter string="Premise" name="group_by_premise" context="{'group_by': 'premise_id'}"/>
                    <filter string="Client" name="group_by_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Team" name="group_by_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Assigned To" name="group_by_assigned" context="{'group_by': 'assigned_to'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="group_by_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Deadline" name="group_by_deadline" context="{'group_by': 'deadline:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Task Calendar View -->
    <record id="view_security_task_calendar" model="ir.ui.view">
        <field name="name">security.task.calendar</field>
        <field name="model">security.task</field>
        <field name="arch" type="xml">
            <calendar string="Tasks" date_start="planned_date" date_stop="deadline" color="assigned_to" mode="month">
                <field name="name"/>
                <field name="task_type_id"/>
                <field name="premise_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Task Kanban View -->
    <record id="view_security_task_kanban" model="ir.ui.view">
        <field name="name">security.task.kanban</field>
        <field name="model">security.task</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="task_type_id"/>
                <field name="premise_id"/>
                <field name="client_id"/>
                <field name="assigned_to"/>
                <field name="deadline"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="progress"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="row mb-1">
                                <div class="col-6">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="col-6 text-right">
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-12">
                                    <i class="fa fa-tasks mr-1"/><field name="task_type_id"/>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-12">
                                    <i class="fa fa-building-o mr-1"/><field name="premise_id"/>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-12">
                                    <i class="fa fa-user mr-1"/><field name="assigned_to"/>
                                </div>
                            </div>
                            <div class="row mb-1">
                                <div class="col-6">
                                    <i class="fa fa-calendar mr-1"/>
                                    <field name="deadline"/>
                                </div>
                                <div class="col-6 text-right">
                                    <span t-attf-class="badge badge-#{record.state.raw_value == 'draft' ? 'info' :
                                                                       record.state.raw_value == 'assigned' ? 'warning' :
                                                                       record.state.raw_value == 'in_progress' ? 'danger' :
                                                                       record.state.raw_value == 'completed' ? 'success' : 'secondary'}">
                                        <field name="state"/>
                                    </span>
                                </div>
                            </div>
                            <div class="row" t-if="record.progress.raw_value > 0">
                                <div class="col-12">
                                    <div class="progress">
                                        <div class="progress-bar" role="progressbar"
                                             t-attf-style="width: #{record.progress.raw_value}%;"
                                             t-attf-aria-valuenow="#{record.progress.raw_value}"
                                             aria-valuemin="0" aria-valuemax="100">
                                            <t t-esc="record.progress.raw_value"/>%
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Task Type Form View -->
    <record id="view_security_task_type_form" model="ir.ui.view">
        <field name="name">security.task.type.form</field>
        <field name="model">security.task.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Task Type Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="color"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="default_deadline_days"/>
                            <field name="requires_approval"/>
                            <field name="approver_id" invisible="requires_approval == False" required="requires_approval == True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe this task type..."/>
                        </page>
                        <page string="Default Checklist Items">
                            <field name="default_checklist_item_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Task Type list View -->
    <record id="view_security_task_type_list" model="ir.ui.view">
        <field name="name">security.task.type.list</field>
        <field name="model">security.task.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="default_deadline_days"/>
                <field name="requires_approval"/>
                <field name="approver_id"/>
            </tree>
        </field>
    </record>

    <!-- Task Type Search View -->
    <record id="view_security_task_type_search" model="ir.ui.view">
        <field name="name">security.task.type.search</field>
        <field name="model">security.task.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Requires Approval" name="requires_approval" domain="[('requires_approval', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Approver" name="group_by_approver" context="{'group_by': 'approver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Tasks -->
    <record id="action_security_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">security.task</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="search_view_id" ref="view_security_task_search"/>
        <field name="context">{'search_default_assigned_tasks': 1, 'search_default_in_progress_tasks': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first security task!
            </p>
            <p>
                Tasks are used to track security-related work items.
                You can assign tasks to team members, track progress, and manage deadlines.
            </p>
        </field>
    </record>

    <!-- Action for My Tasks -->
    <record id="action_security_my_task" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">security.task</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="search_view_id" ref="view_security_task_search"/>
        <field name="domain">[('assigned_to', '=', uid)]</field>
        <field name="context">{'search_default_assigned_tasks': 1, 'search_default_in_progress_tasks': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                You have no assigned tasks!
            </p>
            <p>
                Tasks will appear here when they are assigned to you.
                You can track your progress and mark tasks as completed.
            </p>
        </field>
    </record>

    <!-- Action for Task Types -->
    <record id="action_security_task_type" model="ir.actions.act_window">
        <field name="name">Task Types</field>
        <field name="res_model">security.task.type</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_security_task_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first task type!
            </p>
            <p>
                Task types help categorize different kinds of security tasks.
                You can define default checklist items and approval requirements.
            </p>
        </field>
    </record>

</odoo>
