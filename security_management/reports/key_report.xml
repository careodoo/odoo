<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_key_qrcode_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <div class="page">
                <div class="oe_structure"/>

                <!-- Modern Card Design for QR Code -->
                <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
                    <!-- Header with Company Logo and Title -->
                    <div class="card-header bg-primary text-white text-center py-3" style="border-radius: 12px 12px 0 0;">
                        <h2 class="mb-0">Key Information</h2>
                    </div>

                    <div class="card-body p-4">
                        <div class="row">
                            <!-- QR Code Section - Larger and more prominent -->
                            <div class="col-5 d-flex align-items-center justify-content-center">
                                <div class="text-center">
                                    <div t-if="o.qr_code">
                                        <strong>QR Code</strong>
                                        <br/>
                                        <img t-att-src="image_data_uri(o.qr_code)" style="max-height: 150px; max-width: 150px; margin: 10px auto;"/>
                                        <p class="text-muted mt-1" t-if="o.name">
                                            <small t-field="o.name"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Key Information Section -->
                            <div class="col-7">
                                <div class="mb-3">
                                    <h3 class="text-primary mb-3">
                                        <t t-esc="o.name"/>
                                    </h3>

                                    <div class="row mb-2">
                                        <div class="col-5">
                                            <strong class="text-muted">Key Number:</strong>
                                        </div>
                                        <div class="col-7">
                                            <span t-field="o.name"/>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-5">
                                            <strong class="text-muted">Status:</strong>
                                        </div>
                                        <div class="col-7">
                                            <span t-field="o.state" t-options="{'widget': 'badge'}"/>
                                        </div>
                                    </div>

                                    <div class="row mb-2" t-if="o.key_type">
                                        <div class="col-5">
                                            <strong class="text-muted">Key Type:</strong>
                                        </div>
                                        <div class="col-7">
                                            <span t-field="o.key_type"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Description if available -->
                                <div t-if="o.description" class="mt-3 p-2 bg-light" style="border-radius: 6px;">
                                    <small class="text-muted">Description:</small>
                                    <p class="mb-0 small">
                                        <t t-esc="o.description"/>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- QR Code Content Information -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="alert alert-secondary py-2 mb-2" style="font-size: 12px;">
                                    <strong>Key ID:</strong>
                                    <span t-field="o.name"/>
                                </div>
                            </div>
                        </div>

                        <!-- Scan Instructions -->
                        <div class="row mt-2">
                            <div class="col-12 text-center">
                                <div class="alert alert-info py-2 mb-0">
                                    <i class="fa fa-info-circle mr-2"></i>
                                    Scan this QR code to check in/out this key
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer with Last Check Information -->
                    <div class="card-footer bg-light p-3" style="border-radius: 0 0 12px 12px;">
                        <div class="row text-center">
                            <div class="col-6" t-if="o.create_date">
                                <small class="text-muted d-block">Created On</small>
                                <strong>
                                    <t t-esc="o.create_date" t-options="{'widget': 'datetime', 'format': 'dd MMM yyyy HH:mm'}"/>
                                </strong>
                            </div>
                            <div class="col-6" t-if="o.write_date">
                                <small class="text-muted d-block">Last Updated</small>
                                <strong>
                                    <t t-esc="o.write_date" t-options="{'widget': 'datetime', 'format': 'dd MMM yyyy HH:mm'}"/>
                                </strong>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_key_qrcode">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="security_management.report_key_qrcode_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_key_qrcode" model="ir.actions.report">
        <field name="name">Key QR Code</field>
        <field name="model">security.key</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">security_management.report_key_qrcode</field>
        <field name="report_file">security_management.report_key_qrcode</field>
        <field name="print_report_name">'Key QR Code - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_security_key"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
