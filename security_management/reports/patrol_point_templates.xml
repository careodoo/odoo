<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_patrol_point_qrcode_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <div class="page">
                <div class="oe_structure"/>

                <!-- Modern Card Design for QR Code -->
                <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
                    <!-- Header with Company Logo and Title -->
                    <div class="card-header bg-primary text-white text-center py-3" style="border-radius: 12px 12px 0 0;">
                        <h2 class="mb-0">Patrol Checkpoint</h2>
                    </div>

                    <div class="card-body p-4">
                        <div class="row">
                            <!-- QR Code Section - Larger and more prominent -->
                            <div class="col-5 d-flex align-items-center justify-content-center">
                                <div class="text-center">
                                    <div t-if="o.qr_code">
                                        <strong>QR Code</strong>
                                        <br/>
                                        <img t-att-src="image_data_uri(o.qr_code)" style="max-height: 150px; max-width: 150px; margin: 10px auto;"/>
                                        <p class="text-muted mt-1">
                                            <small t-field="o.qr_code_text"/>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Checkpoint Information Section -->
                            <div class="col-7">
                                <div class="mb-3">
                                    <h3 class="text-primary mb-3">
                                        <t t-esc="o.name"/>
                                    </h3>

                                    <div class="row mb-2">
                                        <div class="col-5">
                                            <strong class="text-muted">Point ID:</strong>
                                        </div>
                                        <div class="col-7">
                                            <span t-field="o.code"/>
                                        </div>
                                    </div>

                                    <div class="row mb-2" t-if="o.point_type">
                                        <div class="col-5">
                                            <strong class="text-muted">Type:</strong>
                                        </div>
                                        <div class="col-7">
                                            <span t-field="o.point_type" t-options="{'widget': 'badge'}"/>
                                        </div>
                                    </div>

                                    <div class="row mb-2" t-if="o.premise_id">
                                        <div class="col-5">
                                            <strong class="text-muted">Premise:</strong>
                                        </div>
                                        <div class="col-7">
                                            <span t-field="o.premise_id.name"/>
                                        </div>
                                    </div>

                                    <div class="row mb-2" t-if="o.floor_id">
                                        <div class="col-5">
                                            <strong class="text-muted">Floor:</strong>
                                        </div>
                                        <div class="col-7">
                                            <span t-field="o.floor_id.name"/>
                                        </div>
                                    </div>

                                    <div class="row mb-2" t-if="o.unit_id">
                                        <div class="col-5">
                                            <strong class="text-muted">Unit:</strong>
                                        </div>
                                        <div class="col-7">
                                            <span t-field="o.unit_id.name"/>
                                        </div>
                                    </div>

                                    <div class="row mb-2" t-if="o.location_id">
                                        <div class="col-5">
                                            <strong class="text-muted">Location:</strong>
                                        </div>
                                        <div class="col-7">
                                            <span t-field="o.location_id.name"/>
                                        </div>
                                    </div>

                                    <div class="row mb-2" t-if="o.sequence">
                                        <div class="col-5">
                                            <strong class="text-muted">Sequence:</strong>
                                        </div>
                                        <div class="col-7">
                                            <span t-field="o.sequence"/>
                                        </div>
                                    </div>

                                    <!-- Company information (respecting multi-company pattern) -->
                                    <div class="row mb-2" t-if="o.company_id">
                                        <div class="col-5">
                                            <strong class="text-muted">Company:</strong>
                                        </div>
                                        <div class="col-7">
                                            <span t-field="o.company_id.name"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Location Description if available -->
                                <div t-if="o.location_description" class="mt-3 p-2 bg-light" style="border-radius: 6px;">
                                    <small class="text-muted">Location Notes:</small>
                                    <p class="mb-0 small">
                                        <t t-esc="o.location_description"/>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- QR Code Content Information -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="alert alert-secondary py-2 mb-2" style="font-size: 12px;">
                                    <strong>QR Code ID:</strong>
                                    <span t-field="o.code"/>
                                </div>
                            </div>
                        </div>

                        <!-- Scan Instructions -->
                        <div class="row mt-2">
                            <div class="col-12 text-center">
                                <div class="alert alert-info py-2 mb-0">
                                    <i class="fa fa-info-circle mr-2"></i>
                                    Scan this QR code with your patrol app to verify checkpoint
                                </div>
                            </div>
                        </div>

                        <!-- Additional Notes if available -->
                        <div class="row mt-3" t-if="o.notes">
                            <div class="col-12">
                                <div class="p-3 bg-light" style="border-radius: 6px;">
                                    <h6 class="text-muted mb-2">Notes:</h6>
                                    <p class="mb-0 small">
                                        <t t-esc="o.notes"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer with Last/Next Check Information -->
                    <div class="card-footer bg-light p-3" style="border-radius: 0 0 12px 12px;">
                        <div class="row text-center">
                            <div class="col-6" t-if="o.last_check_time">
                                <small class="text-muted d-block">Last Checked</small>
                                <strong>
                                    <t t-esc="o.last_check_time" t-options="{'widget': 'datetime', 'format': 'dd MMM yyyy HH:mm'}"/>
                                </strong>
                            </div>
                            <div class="col-6" t-if="o.next_check_time">
                                <small class="text-muted d-block">Next Check Due</small>
                                <strong>
                                    <t t-esc="o.next_check_time" t-options="{'widget': 'datetime', 'format': 'dd MMM yyyy HH:mm'}"/>
                                </strong>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_patrol_point_qrcode">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="security_management.report_patrol_point_qrcode_document"/>
            </t>
        </t>
    </template>
</odoo>
