<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Gate Pass Receipt Report -->
        <record id="action_report_gate_pass_receipt" model="ir.actions.report">
            <field name="name">Gate Pass Receipt</field>
            <field name="model">security.gate.pass.payment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">security_management.report_gate_pass_receipt</field>
            <field name="report_file">security_management.report_gate_pass_receipt</field>
            <field name="binding_model_id" ref="model_security_gate_pass_payment"/>
            <field name="binding_type">report</field>
        </record>
        
        <!-- Receipt Template -->
        <template id="report_gate_pass_receipt">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h2 class="text-center">Gate Pass Payment Receipt</h2>
                            <div class="row mt-4">
                                <div class="col-6">
                                    <strong>Receipt Number:</strong> <span t-field="o.name"/>
                                </div>
                                <div class="col-6 text-right">
                                    <strong>Date:</strong> <span t-field="o.payment_date"/>
                                </div>
                            </div>
                            
                            <div class="row mt-3">
                                <div class="col-6">
                                    <strong>Gate Pass:</strong> <span t-field="o.gate_pass_id.name"/>
                                </div>
                                <div class="col-6">
                                    <strong>Status:</strong> <span t-field="o.state"/>
                                </div>
                            </div>
                            
                            <div class="row mt-3">
                                <div class="col-6">
                                    <strong>Visitor:</strong> <span t-field="o.visitor_name"/>
                                </div>
                                <div class="col-6">
                                    <strong>Company:</strong> <span t-field="o.visitor_company"/>
                                </div>
                            </div>
                            
                            <div class="row mt-3">
                                <div class="col-6">
                                    <strong>Valid From:</strong> <span t-field="o.valid_from"/>
                                </div>
                                <div class="col-6">
                                    <strong>Valid Until:</strong> <span t-field="o.valid_until"/>
                                </div>
                            </div>
                            
                            <div class="row mt-3">
                                <div class="col-6">
                                    <strong>Payment Method:</strong> <span t-field="o.payment_method"/>
                                </div>
                                <div class="col-6">
                                    <strong>Reference:</strong> <span t-field="o.payment_reference"/>
                                </div>
                            </div>
                            
                            <div class="row mt-5">
                                <div class="col-12 text-center">
                                    <h3>Amount Paid: <span t-field="o.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></h3>
                                </div>
                            </div>
                            
                            <div class="row mt-5" t-if="o.notes">
                                <div class="col-12">
                                    <strong>Notes:</strong>
                                    <p t-field="o.notes"/>
                                </div>
                            </div>
                            
                            <div class="row mt-5">
                                <div class="col-6">
                                    <div class="text-center">
                                        <p>_________________________</p>
                                        <p>Received By</p>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="text-center">
                                        <p>_________________________</p>
                                        <p>Authorized Signature</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
