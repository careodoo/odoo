<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record model="ir.module.category" id="module_tender">
      <field name="name">Tender</field>
    </record>

    <record id="group_tender_user" model="res.groups">
      <field name="name">User</field>
      <field name="category_id" ref="module_tender" />
    </record>

    <!-- Granular roles (part of the access matrix) -->
    <record id="group_tender_contract" model="res.groups">
      <field name="name">Contract Officer</field>
      <field name="category_id" ref="module_tender" />
      <field name="comment">إدارة الترسية والتعاقد وإنشاء العقد ورؤية المستندات المالية.</field>
    </record>

    <record id="group_tender_notify_admin" model="res.groups">
      <field name="name">Notification Admin</field>
      <field name="category_id" ref="module_tender" />
      <field name="comment">ضبط قوائم مستلمي الإشعارات لكل نوع.</field>
    </record>

    <record id="group_tender_manager" model="res.groups">
      <field name="name">Manager</field>
      <field name="category_id" ref="module_tender" />
      <field name="implied_ids" eval="[(4, ref('purchase_tender.group_tender_user')), (4, ref('purchase_tender.group_tender_contract')), (4, ref('purchase_tender.group_tender_notify_admin'))]" />
    </record>

    <record id="tender_rule_user_own" model="ir.rule">
      <field name="name">User own tender</field>
      <field ref="purchase_tender.model_purchase_tender" name="model_id" />
      <field name="domain_force">[('create_uid','=',user.id)]</field>
      <field name="groups" eval="[(4, ref('purchase_tender.group_tender_user'))]" />
    </record>

    <record id="tender_rule_manager" model="ir.rule">
      <field name="name">All tenders</field>
      <field ref="purchase_tender.model_purchase_tender" name="model_id" />
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="groups" eval="[(4, ref('purchase_tender.group_tender_manager'))]" />
    </record>

  </data>
</odoo>