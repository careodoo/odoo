<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="care_experience_view_form" model="ir.ui.view">
            <field name="name">care_experience_view_form</field>
            <field name="model">care.experience</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" clickable="1"/>
                    </header>
                    <sheet string="Experience">
                        <field name="kanban_state" widget="state_selection"/>
                        <widget name="web_ribbon" text="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Name..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="contract_amount"/>
                                <field name="period"/>
                                <field name="labor_quantity"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="expire_date"/>
                                <field name="contract_type"/>
                            </group>
                        </group>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="start_date"/>
                                <field name="expire_date"/>
                                <field name="period"/>
                            </tree>
                        </field>
                        <group>
                            <field name="notes" placeholder="Type down your notes here..." nolabel="1"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter" name="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                        <field name="activity_ids"/>
                  </div>
                </form>
            </field>
        </record>
        <record id="care_experience_view_tree" model="ir.ui.view">
            <field name="name">care_experience_view_tree</field>
            <field name="model">care.experience</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="active" invisible="1"/>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="contract_amount"/>
                    <field name="period"/>
                    <field name="labor_quantity"/>
                    <field name="start_date"/>
                    <field name="expire_date"/>
                    <field name="contract_type"/>
                    <field name="state" widget="badge" decoration-danger="state == 'expired'" decoration-success="state == 'valid'"/>
                </tree>
            </field>
        </record>
        <record id="care_experience_action" model="ir.actions.act_window">
            <field name="name">Experiences</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">care.experience</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="care_experience_menu" name="Experiences" action="care_experience_action" sequence="55"/>
    </data>
</odoo>