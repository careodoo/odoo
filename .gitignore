# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Generated platform folders (recreated by `flutter create` / CI)
# NOTE: android/ IS tracked — it carries hand-made config that `flutter create`
# would NOT regenerate (release signingConfigs, url_launcher <queries>, app id).
# Its secrets stay out via the "release signing" rules at the bottom.
/linux/
/macos/
/windows/
/web/

# ios: the project IS tracked (bundle id care.app, Info.plist permission
# strings, push background mode) — only its build output and pods are not.
/ios/build/
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Flutter/flutter_export_environment.sh
/ios/Runner/GoogleService-Info.plist

# android build output / local machine paths (never the config itself)
/android/.gradle/
/android/app/build/
/android/build/
/android/local.properties
/android/.cxx/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store

# built artifacts we DO want on GitHub
!dist/
dist/*.keep

# release signing (keep secret)
android/key.properties
android/care-release.jks
RELEASE_KEYSTORE_B64.txt
android/.kotlin/
ci/care_release.keystore
ci/*.keystore
