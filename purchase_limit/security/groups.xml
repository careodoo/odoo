<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_purchase_limit">
            <field name="name">Set Purchase Limit</field>
        </record>

        <record id="group_set_purchase_limit" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_purchase_limit"/>
        </record>

        <record model="ir.module.category" id="module_cost_center">
            <field name="name">Cost Center</field>
        </record>
        <record id="group_cost_center_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_cost_center"/>
        </record>
        <record id="group_cost_center_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_cost_center"/>
            <field name="implied_ids" eval="[(4, ref('group_cost_center_user'))]"/>
        </record>
    </data>
</odoo>