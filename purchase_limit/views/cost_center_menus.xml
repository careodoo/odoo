<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============ لوحة كانبان احترافية لمراكز التكلفة (مؤشّرات الميزانية) ============ -->
        <record id="view_cost_center_kanban" model="ir.ui.view">
            <field name="name">cost.center.kanban</field>
            <field name="model">cost.center</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_dashboard" create="true">
                    <field name="name"/>
                    <field name="type"/>
                    <field name="dash_total"/>
                    <field name="dash_used"/>
                    <field name="dash_remaining"/>
                    <field name="dash_usage"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click" style="padding:14px;border-radius:14px">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong style="font-size:15px" t-esc="record.name.value"/>
                                    <span class="badge rounded-pill text-bg-secondary" t-esc="record.type.value"/>
                                </div>
                                <div class="progress" style="height:8px;border-radius:6px">
                                    <div class="progress-bar"
                                         t-attf-style="width:#{Math.min(record.dash_usage.raw_value or 0,100)}%;background:#{(record.dash_usage.raw_value or 0) >= 90 ? '#DC2626' : (record.dash_usage.raw_value or 0) >= 70 ? '#F59E0B' : '#16A34A'}"/>
                                </div>
                                <div class="text-muted mt-1" style="font-size:12px">
                                    <t t-esc="record.dash_usage.value"/>% مستهلك
                                </div>
                                <div class="row mt-2 text-center">
                                    <div class="col-4">
                                        <div style="font-size:11px;color:#888">الإجمالي</div>
                                        <strong style="color:#2563EB" t-esc="record.dash_total.value"/>
                                    </div>
                                    <div class="col-4">
                                        <div style="font-size:11px;color:#888">المستهلك</div>
                                        <strong style="color:#DC2626" t-esc="record.dash_used.value"/>
                                    </div>
                                    <div class="col-4">
                                        <div style="font-size:11px;color:#888">المتبقّي</div>
                                        <strong style="color:#16A34A" t-esc="record.dash_remaining.value"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- إضافة الكانبان كواجهة أولى لفعل مراكز التكلفة -->
        <record id="purchase_report.cost_center_action" model="ir.actions.act_window">
            <field name="view_mode">kanban,tree,form</field>
        </record>

        <!-- ============ أفعال الموديولات الفرعية لمركز التكلفة ============ -->
        <record id="action_cost_center_month" model="ir.actions.act_window">
            <field name="name">الميزانيات الشهرية</field>
            <field name="res_model">cost.center.month</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_group_cost_center': 1}</field>
        </record>

        <record id="action_cost_center_extra" model="ir.actions.act_window">
            <field name="name">الميزانيات الإضافية</field>
            <field name="res_model">cost.center.extra.budget</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_cost_center_transfer" model="ir.actions.act_window">
            <field name="name">تحويلات الميزانية</field>
            <field name="res_model">cost.center.transfer.budget</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_default_cost_center_sign" model="ir.actions.act_window">
            <field name="name">المعتمِدون الافتراضيون</field>
            <field name="res_model">default.cost.center.sign</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ============ تطبيق مستقلّ منظّم: مراكز التكلفة ============ -->
        <menuitem id="menu_cost_center_root" name="💰 مراكز التكلفة"
                  sequence="53" groups="purchase_limit.group_cost_center_user"/>

        <!-- العمليات -->
        <menuitem id="menu_cost_center_ops" name="العمليات"
                  parent="menu_cost_center_root" sequence="10"/>
        <menuitem id="menu_cc_centers" name="🏢 مراكز التكلفة"
                  parent="menu_cost_center_ops" sequence="10"
                  action="purchase_report.cost_center_action"/>
        <menuitem id="menu_cc_month" name="📅 الميزانيات الشهرية"
                  parent="menu_cost_center_ops" sequence="20"
                  action="action_cost_center_month"/>
        <menuitem id="menu_cc_extra" name="➕ الميزانيات الإضافية"
                  parent="menu_cost_center_ops" sequence="30"
                  action="action_cost_center_extra"/>
        <menuitem id="menu_cc_transfer" name="🔄 تحويلات الميزانية"
                  parent="menu_cost_center_ops" sequence="40"
                  action="action_cost_center_transfer"/>

        <!-- الإعداد (للمديرين) -->
        <menuitem id="menu_cost_center_config" name="الإعداد"
                  parent="menu_cost_center_root" sequence="90"
                  groups="purchase_limit.group_cost_center_manager"/>
        <menuitem id="menu_cc_default_sign" name="✍️ المعتمِدون الافتراضيون"
                  parent="menu_cost_center_config" sequence="10"
                  action="action_default_cost_center_sign"/>
    </data>
</odoo>
