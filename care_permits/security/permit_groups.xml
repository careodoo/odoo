<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_care_permits_category" model="ir.module.category">
        <field name="name">Project Permits</field>
    </record>

    <record id="group_permit_user" model="res.groups">
        <field name="name">تصاريح المشروع</field>
        <field name="category_id" ref="module_care_permits_category"/>
    </record>

    <record id="group_permit_manager" model="res.groups">
        <field name="name">إدارة التصاريح</field>
        <field name="category_id" ref="module_care_permits_category"/>
        <field name="implied_ids" eval="[(4, ref('group_permit_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_erp_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('care_permits.group_permit_manager'))]"/>
    </record>
</odoo>
