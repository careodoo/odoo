<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="project_task_forward_view_tree" model="ir.ui.view">
            <field name="name">project_task_forward_view_tree</field>
            <field name="model">project.task.forward</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="active" invisible="1"/>
                    <field name="task_id" invisible="1"/>
                    <field name="create_date"/>
                    <field name="project_id"/>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="date_deadline"/>
                    <field name="confirm_date"/>
                    <field name="stage_id" widget="badge"/>
                    <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-danger="state == 'rejected'"/>
                    <button name="button_confirm_forward" type="object" string="Confirm" class="oe_highlight"
                            attrs="{'invisible': &quot;['|', ('state', '!=', 'draft'), ('user_id', '!=', uid)]&quot;}"/>
                    <button name="button_reject_forward" type="object" string="Reject" class="btn-danger"
                            attrs="{'invisible': &quot;['|', ('state', '!=', 'draft'), ('user_id', '!=', uid)]&quot;}"/>
                </tree>
            </field>
        </record>
        <record id="project_task_forward_view_form" model="ir.ui.view">
            <field name="name">project_task_forward_view_form</field>
            <field name="model">project.task.forward</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="task_id" readonly="1" force_save="1"/>
                            <field name="user_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="project_task_forward_action" model="ir.actions.act_window">
            <field name="name">Incoming</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.task.forward</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="project_task_forward_action2" model="ir.actions.act_window">
            <field name="name">Incoming</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.task.forward</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="project_task_forward_menu" name="Incoming" parent="care_task.my_tasks_root"
                  action="project_task_forward_action" sequence="3"
                  groups="care_task.group_task_forward_user,care_task.group_task_forward_manager"/>
        <menuitem id="project_task_forward_menu2" name="Incoming" parent="project.menu_main_pm"
                  action="project_task_forward_action2" sequence="3"
                  groups="care_task.group_task_forward_user,care_task.group_task_forward_manager"/>
    </data>
</odoo>