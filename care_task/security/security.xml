<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_task_forward">
            <field name="name">Task Forward</field>
        </record>

        <record id="group_task_forward_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_task_forward"/>
        </record>
        <record id="group_task_forward_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_task_forward"/>
        </record>

        <record id="task_forward_rule_user_own" model="ir.rule">
            <field name="name">User own Task Forward</field>
            <field ref="care_task.model_project_task_forward" name="model_id"/>
            <field name="domain_force">['|', ('user_id','=',user.id), ('task_id.user_ids','in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('group_task_forward_user'))]"/>
        </record>
        <record id="task_forward_rule_manager" model="ir.rule">
            <field name="name">All Task Forward</field>
            <field ref="care_task.model_project_task_forward" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_task_forward_manager'))]"/>
        </record>
    </data>
</odoo>