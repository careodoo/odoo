<?xml version="1.0" encoding="utf-8"?>
<!--
    Odoo 17 migration of the face-recognition QWeb templates.

    REMOVED from the legacy file: the `t-extend` / `t-jquery` / `t-operation`
    inheritance blocks that patched `KanbanView.buttons` and
    `HrAttendanceMyMainMenu`. Legacy jQuery-QWeb `t-extend` is NOT supported by
    Odoo 17's OWL QWeb compiler, and both target templates were removed in the
    v17 web/attendance OWL rewrite, so those blocks have no host to extend and
    would break the asset bundle. They are dropped here (see DOCUMENTATION.md
    §10 — re-implement as OWL components if the in-view buttons are needed).

    KEPT (as standalone v17 OWL templates): the recognition dialog body and the
    image-overlay snippet, which a future OWL dialog/field component can render.
-->
<templates xml:space="preserve">

    <t t-name="hr_attendance_face_recognition_pro.WebCamDialogFaceRecognition">
        <div id="WebCamDialogFaceRecognition">
            <div id="live_webcam" style="display:none"/>
            <canvas id="ocr_canvas" width="400" height="400"/>
        </div>
    </t>

    <t t-name="hr_attendance_face_recognition_pro.ImageRecognition-img">
        <button
            class="btn btn-secondary o-kanban-button-hide-face-recognition badge-warning"
            type="button" style="position:absolute">
            <span class="only-descriptor">Hide faces on images</span>
            <span class="only-descriptor" style="display:none">Show faces on images</span>
        </button>
        <img
            style="border-radius: 45px;"
            class="img"
            t-att-width="face_width"
            t-att-height="face_height"
            alt="Binary file"
            t-att-src="url"/>
    </t>

</templates>
