<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_inherit" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//table//tr/th[1]" position="after">
                <th><strong>On Hand</strong></th>
                <th><strong>Forecasted</strong></th>
        </xpath>
        <xpath expr="//t[@t-foreach='o.order_line']//td[@id='product']" position="after">
            <td><span t-field="line.qoh_available"/></td>
            <td><span t-field="line.foh_available"/></td>
        </xpath>
    </template>
</odoo>
