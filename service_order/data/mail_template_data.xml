<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="1">
    <record id="mail_template_trip_report" model="mail.template">
      <field name="name">Service Trip Mail</field>
      <field name="model_id" ref="service_order.model_service_trip"/>
      <field name="subject">{{ object.reference }}</field>
      <field name="email_from">{{ object.project_id.company_id.email }}</field>
      <field name="email_to">{{ object.contact_id.email }}</field>
      <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
  Hello,
</div>
      </field>
      <field name="report_template" ref="service_order.action_report_service_trip_pdf"/>
      <field name="report_name">{{ object.reference }}</field>
      <field name="lang">{{ object.contact_id.lang }}</field>
      <field name="auto_delete" eval="True"/>
  </record>
  </data>
</odoo>