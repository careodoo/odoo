<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data noupdate="0">
  <!-- =========================================================== -->
    <record id="mail_template_trip_report" model="mail.template">
      <field name="name">Service Trip Mail</field>
      <field name="model_id" ref="service_order.model_service_trip" />
      <field name="subject">{{ object.sequence }} Order No. {{object.states}}</field>
      <field name="email_from">{{ object.project_id.company_id.email }}</field>
      <field name="email_to"> {{ ','.join(object.project_id.assign_user_ids.partner_id.mapped('email')) }}</field>
      <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
          Dear <t t-out="object.contact_id.name"/>,<br/>
          <br/>
          We’re excited to inform you that your order No.  <t t-out="object.sequence"/> has been completed!
          <br/>
          We hope you enjoy our service. If you have any questions or concerns, please let us know.
</div>
      </field>
      <field name="report_template_ids" eval="[(4, ref('service_order.action_report_service_trip_pdf'))]"/>
    </record>
    <!-- ================== state template ====================== -->
    <record id="mail_template_trip_upadte_state" model="mail.template">
      <field name="name">Service Trip State</field>
      <field name="model_id" ref="service_order.model_service_trip" />
      <field name="subject">{{ object.sequence }} Order No. {{object.states}}</field>
      <field name="email_from">{{ object.project_id.company_id.email }}</field>
      <field name="email_to"> {{ ','.join(object.project_id.assign_user_ids.partner_id.mapped('email')) }}</field>
      <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
          Dear <t t-out="object.contact_id.name"/>,<br/>
          <br/>
          We inform you that your order No.  <t t-out="object.sequence"/> has been  <t t-out="object.states"/>
</div>
      </field>
    </record>
<!-- ============================================================================== -->
    <!-- new service oorder created -->
    <record id="mail_template_service_order" model="mail.template">
      <field name="name">Service Order</field>
      <field name="model_id" ref="service_order.model_service_order" />
      <field name="subject">Service Order No. {{object.serial}}</field>
      <field name="email_from">{{ object.project_id.company_id.email }}</field>
      <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
          New order created [ <t t-out="object.serial"/> ] .
</div>
      </field>
    </record>
  </data>
</odoo>