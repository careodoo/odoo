<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="service_report_layout">
    <t t-if="not o" t-set="o" t-value="doc" />
    <div class="header">
      <img src="/service_order/static/src/img/header.png" atl="header.png" class="w-100" />
    </div>
    <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
      t-att-data-oe-lang="o and o.env.context.get('lang')">
      <t t-raw="0" />
    </div>
    <div t-attf-class="footer o_standard_footer">
      <div class="row">
        <img src="/service_order/static/src/img/footer.png" atl="header.png" class="w-100" />
      </div>
    </div>
  </template>
  <template id="service_trip_report" name="service_trip_report">
    <!-- add css file -->
    <t t-call="web.html_container">
      <t t-call="service_order.service_report_layout">
        <t t-foreach="docs" t-as="doc">
          <div class="page">
            <h2 class="text-center">Service Report</h2>
            <div class="row">
              <div class="col-6">
                <table class="table table-sm table-bordered service_trip_table">
                  <tr>
                    <td>Client Name</td>
                    <td>
                      <t t-esc="doc.contact_id.name" />
                    </td>
                  </tr>
                  <tr>
                    <td>Contract No</td>
                    <td>
                      <t t-esc="doc.project_id.experience_id.x_studio_contract_no" />
                    </td>
                  </tr>
                  <tr>
                    <td>Trip No</td>
                    <td>
                      <t t-esc="doc.sequence" />
                    </td>
                  </tr>
                  <tr>
                    <td>Trip Date</td>
                    <td>
                      <t t-esc="doc.trip_date" />
                    </td>
                  </tr>
                </table>
              </div>
              <div class="col-6">
                <table class="table table-sm table-bordered service_trip_table">
                  <tr>
                    <td>Pick-up Time</td>
                    <td>
                      <t t-esc="doc.pickuped_datetime" />
                    </td>
                  </tr>
                  <tr>
                    <td>Total Weight (KG)</td>
                    <td>
                      <t t-esc="doc.total_weight" />
                    </td>
                  </tr>
                  <tr>
                    <td>Total Quantity</td>
                    <td>
                      <t t-esc="doc.total_quantity" />
                    </td>
                  </tr>
                  <tr>
                    <td>State</td>
                    <td t-attf-class="#{doc.states}-state">
                      <span>
                        <t t-esc="doc.states" />
                      </span>
                    </td>
                  </tr>

                </table>
              </div>
            </div>
            <h3 class="text-center mt-5">Details</h3>

            <!-- trip lines -->
            <div class="mt-5">
              <table class="table service_trip_table">
                <tbody>
                  <tr style="background-color:lightgray">
                    <th>Type</th>
                    <th>Quantity</th>
                    <th>AV/Weight</th>
                    <th>Total Weight</th>
                    <th>Total Pickup</th>
                    <th>Remarks</th>
                  </tr>
                  <t t-foreach="doc.trip_line_ids" t-as="line">
                    <tr>
                      <td>
                        <t t-esc="line.item_id.name" />
                      </td>
                      <td>
                        <t t-esc="line.quantity" />
                      </td>
                      <td>
                        <t t-esc="line.weight" />
                      </td>
                      <td>
                        <t t-esc="line.quantity * line.weight" />
                      </td>
                      <td>
                        <t t-esc="line.quantity * line.weight" />
                      </td>
                      <td>
                      </td>
                    </tr>
                  </t>
                </tbody>
              </table>

            </div>
            <div class="row mb-5">
              <div class="col-4"> PHOTOS AND VIDEOS <div t-if="doc.order_id" class="col-3 mt-1">
                  <a t-att-href="'service_order/%s/' % doc.order_id.id">
                    <img
                      t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %('QR', doc.order_id.qr_url, 500, 500)"
                      style="max-height: 155px" />
                  </a>
                </div>
              </div>
              <div class="col-4"></div>
              <div class="col-4">
                CARE STAMP
              </div>
            </div>
            <div name="notes" class="mt-5">
              All above Items collected from Talabat Company has been terminated by CARE Company
              and
              delivered to the government waste incinerators.
            </div>
          </div>

        </t>

      </t>
    </t>
  </template>

  <record id="action_report_service_trip_xlsx" model="ir.actions.report">
    <field name="name">Print Trip xlsx</field>
    <field name="model">service.trip</field>
    <field name="report_type">xlsx</field>
    <field name="report_name">service_order.service_trip_xlsx_report</field>
    <field name="report_file">service_order.service_trip_xlsx_report</field>
    <field name="print_report_name">'%s' % object.reference</field>
    <field name="binding_model_id" ref="service_order.model_service_trip" />
    <field name="binding_type">report</field>
  </record>
  <record id="action_report_service_trip_pdf" model="ir.actions.report">
    <field name="name">Print Trip pdf</field>
    <field name="model">service.trip</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">service_order.service_trip_report</field>
    <field name="report_file">service_order.service_trip_report</field>
    <field name="print_report_name">'%s' % object.reference</field>
    <field name="binding_model_id" ref="service_order.model_service_trip" />
    <field name="binding_type">report</field>
  </record>

</odoo>