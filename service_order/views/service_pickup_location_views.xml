<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- service pickup location form view -->
  <record id="view_service_pickup_location_form" model="ir.ui.view">
    <field name="name">service.pickup.location.form</field>
    <field name="model">service.pickup.location</field>
    <field name="arch" type="xml">
      <form string="Service Pickup Location">
        <sheet>
          <group>
            <field name="name" />
            <field name="address" />
            <field name="state" />
            <field name="pickup_location_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            <field name="project_ids" widget="many2many_tags" />
          </group>
        </sheet>
      </form>
    </field>
  </record>


  <!-- service pickup location tree view -->
  <record id="view_service_pickup_location_tree" model="ir.ui.view">
    <field name="name">service.pickup.location.tree</field>
    <field name="model">service.pickup.location</field>
    <field name="arch" type="xml">
      <tree string="Service Pickup Location">
        <field name="name" />
        <field name="address" />
        <field name="state" />
        <field name="pickup_location_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
        <field name="project_ids" widget="many2many_tags" />
      </tree>
    </field>
  </record>

  <!-- service pickup location action -->
  <record id="action_service_pickup_location" model="ir.actions.act_window">
    <field name="name">Service Pickup Location</field>
    <field name="res_model">service.pickup.location</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- service pickup location menu -->
  <menuitem id="menu_service_pickup_location" name="Service Pickup Location"
    parent="service_order.menu_service_order"
    action="action_service_pickup_location" />


</odoo>