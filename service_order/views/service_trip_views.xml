<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- service trip form view  -->
  <record id="view_service_trip_form" model="ir.ui.view">
    <field name="name">service.trip.form</field>
    <field name="model">service.trip</field>
    <field name="arch" type="xml">
      <form string="Service Trip">
        <header>
          <button groups="service_order.service_trip_to_pickuped" name="action_to_pickuped"
            string="Pickuped" type="object" class="oe_highlight" />

          <button groups="service_order.service_trip_to_arrived" name="action_to_arrived"
            string="Arrived" type="object" class="oe_highlight" />

          <button groups="service_order.service_trip_to_processing" name="action_to_processing"
            string="Process" type="object" class="oe_highlight" />

          <button groups="service_order.service_trip_to_delivered" name="action_to_delivered"
            string="Delivered" type="object" class="oe_highlight" />

          <button groups="service_order.service_trip_to_completed" name="action_to_completed"
            string="Complete" type="object"
            class="oe_highlight" />

          <button groups="service_order.service_trip_to_cancel" name="action_to_cancelled"
            string="Cancel" type="object"
            class="oe_highlight" />

          <button groups="service_order.service_trip_to_draft" name="action_to_draft"
            string="Reset to Draft" type="object"
            class="oe_highlight" />
          <button name="action_send_email"
            string="SEND BY EMAIL" type="object"
          />

          <field name="states" widget="statusbar" />
        </header>
        <sheet>
          <group>
            <group>
              <field name="sequence" />
              <field name="reference" />
              <field name="pickup_location_id" domain="[('project_ids','in',[project_id])]"
                readonly="states == 'completed'" />
              <field name="center_id" readonly="states == 'completed'" />
              <field name="trip_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                readonly="states == 'completed'" />
              <field name="order_id" readonly="states == 'completed'" />
            </group>
            <group>
              <field name="type_id" readonly="states == 'completed'" />
              <field name="project_id" readonly="states == 'completed'" />
              <field name="pickuped_datetime" readonly="states == 'completed'" />
              <!-- <field name="create_date" readonly="states == 'completed'" /> -->
              <field name="contact_id" readonly="states == 'completed'" />
              <field name="team_id" readonly="states == 'completed'" />
              <field name="trip_date" readonly="states == 'completed'" />
            </group>
            <group string="Totals">
              <!-- <field name="total_weight" /> -->
              <field name="total_quantity" />
              <field name="total_qty_weight" />
            </group>
          </group>
          <notebook>
            <page name="items" string="Items">
              <field name="trip_line_ids" readonly="states == 'completed'">
                <tree editable="bottom">
                  <field name="item_id" />
                  <field name="quantity" />
                  <field name="width" />
                  <field name="height" />
                  <field name="weight" />
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <!-- chatetr -->
        <div class="oe_chatter">
          <field name="message_follower_ids" widget="mail_followers" groups="base.group_user" />
          <field name="message_ids" widget="mail_thread" />
        </div>
      </form>
    </field>
  </record>

  <!-- service trip tree view  -->
  <record id="view_service_trip_tree" model="ir.ui.view">
    <field name="name">service.trip.tree</field>
    <field name="model">service.trip</field>
    <field name="arch" type="xml">
      <tree string="Service Trips">
        <field name="sequence" />
        <field name="reference" />
        <field name="pickup_location_id" />
        <field name="center_id" />
        <field name="type_id" />
        <field name="trip_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
        <field name="project_id" />
        <field name="pickuped_datetime" />
        <field name="contact_id" />
        <field name="states"
          widget="badge"
          decoration-muted="states == 'draft'"
          decoration-info="states == 'pickuped'"
          decoration-warning="states in ['arrived','processing','delivered']"
          decoration-danger="states == 'cancelled'"
          decoration-success="states == 'completed'"
        />
      </tree>
    </field>
  </record>

  <!-- service trip action -->
  <record id="action_service_trip" model="ir.actions.act_window">
    <field name="name">Service Trips</field>
    <field name="res_model">service.trip</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- service trip menu -->
  <menuitem id="menu_service_trip" name="Service Trips"
    parent="service_order.menu_service_order"
    sequence="2"
    action="action_service_trip" />


</odoo>