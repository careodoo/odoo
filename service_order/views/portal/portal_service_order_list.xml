<odoo>
  <!-- popup template -->
  <template id="cancel_order" name="Cancel Order">
    <div class="row">
      <div class="modal fade" t-att-id="'cancel_order_%s' % order.id" role="dialog">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h3 class="modal-title">Cancel order <t t-esc="order.serial" /></h3>
              <button type="button" class="close" data-dismiss="modal" aria-label="Close">×</button>
            </div>
            <div class="modal-body">
              <div class="alert alert-danger">
                <strong>Are you sure from cancel this order?</strong>
                <br />
              </div>
              <a t-att-href="'service_order/%s/cancel' % order.id">
                <button class="btn btn-danger">yes, cancel this order</button>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </template>

  <!-- service order list -->
  <template id="portal_service_orders" name="Service Orders">
    <t t-call="portal.portal_layout">
      <t t-set="pager" t-value="pager" />
      <t t-set="breadcrumbs_searchbar" t-value="True" />
      <t t-call="portal.portal_searchbar">
        <t t-set="title">Service Orders</t>
      </t>
      <t t-set="wrapwrap_classes" t-value="'o_portal_bg_dark'" />
      <!-- ===== Statistics dashboard (parity with the mobile app) ===== -->
      <t t-if="waste_stats">
        <div class="row g-2 mb-3" id="waste_stats_kpis">
          <div class="col-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm" style="border-left:4px solid #0E3A5F !important;border-left-width:4px !important">
              <div class="card-body py-2 px-3">
                <div class="text-muted small">📋 إجمالي الطلبات</div>
                <div class="h4 mb-0 fw-bold" style="color:#0E3A5F"><t t-esc="waste_stats['total_orders']"/></div>
              </div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body py-2 px-3">
                <div class="text-muted small">✅ المكتملة</div>
                <div class="h4 mb-0 fw-bold" style="color:#16A34A"><t t-esc="waste_stats['completed']"/></div>
              </div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body py-2 px-3">
                <div class="text-muted small">⚖️ الوزن (كجم)</div>
                <div class="h4 mb-0 fw-bold" style="color:#0891B2"><t t-esc="waste_stats['total_weight']"/></div>
              </div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body py-2 px-3">
                <div class="text-muted small">📦 إجمالي الكمية</div>
                <div class="h4 mb-0 fw-bold" style="color:#6366F1"><t t-esc="waste_stats['total_quantity']"/></div>
              </div>
            </div>
          </div>
        </div>
        <div class="row g-2 mb-3">
          <div class="col-md-7" t-if="waste_stats['by_month']">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-body">
                <h6 class="fw-bold mb-3" style="color:#0E3A5F">📈 حسب الشهر</h6>
                <t t-foreach="waste_stats['by_month'][-8:]" t-as="m">
                  <div class="d-flex align-items-center mb-2">
                    <div style="width:64px" class="small fw-bold text-nowrap"><t t-esc="m['month']"/></div>
                    <div class="flex-grow-1 mx-2" style="background:#eef2f6;border-radius:6px;height:20px;position:relative">
                      <div t-attf-style="width:#{m['pct']}%;height:20px;border-radius:6px;background:linear-gradient(90deg,#16A34A,#15803D)"/>
                    </div>
                    <div class="small text-muted text-nowrap" style="width:110px"><t t-esc="m['orders']"/> طلب · <t t-esc="m['weight']"/>kg</div>
                  </div>
                </t>
              </div>
            </div>
          </div>
          <div class="col-md-5" t-if="waste_stats['by_item']">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-body">
                <h6 class="fw-bold mb-3" style="color:#0E3A5F">🏆 أكثر الأصناف</h6>
                <t t-foreach="waste_stats['by_item']" t-as="it">
                  <div class="d-flex align-items-center mb-2">
                    <img t-if="it['item_id']" t-attf-src="/api/v1/waste/item/#{it['item_id']}/image" style="width:34px;height:34px;object-fit:cover;border-radius:8px" class="me-2"/>
                    <span t-else="" class="me-2" style="font-size:20px">📦</span>
                    <div class="flex-grow-1 small fw-bold"><t t-esc="it['name']"/></div>
                    <span class="badge rounded-pill" style="background:#16A34A"><t t-esc="it['qty']"/></span>
                  </div>
                </t>
              </div>
            </div>
          </div>
        </div>
      </t>
      <div class="row " id="print_list_report">
        <div class="col-8 btn-group  flex-grow-1 me-1 mb-1">
          <a style="max-width:150px;min-width:70px"
            class=" btn btn-secondary btn-block o_download_btn" href="/service_order/create"
            title="Service Order">
            <i class="fa fa-plus" /> Create order </a>
          <div  class="d-flex">
            <button  
              id="print_report_btn"
              style="max-width:150px;min-width:130px"
              type="button"
              class=" btn btn-primary btn-block o_download_btn mx-2"
              title="Service Order">
              <i class="fa fa-print" /> Print report
            </button>
              <label class="mx-2" for="order_datetime">From:</label>
              <input type="date"
              class="form-control mx-2"
              step="1"
              id="date_from" name="date_from"
              required="True" />
              <label for="order_datetime">To:</label>
              <input type="date"
              class="form-control mx-2"
              step="1"
              id="date_to" name="date_to"
              required="True" />
          </div>
        </div>
        <!-- ===================================== -->
        <!-- ===================================== -->
      </div>
      <t t-if="service_orders" t-call="portal.portal_table">
        <thead>
          <tr>
            <th>Serial</th>
            <th>Pickup Location</th>
            <th>Order Date</th>
            <th> Reference</th>
            <th>Trip Date</th>
            <th>Weight</th>
            <th>Qty</th>
            <th>State</th>
            <th>Edit</th>
            <th>Cancel</th>
          </tr>
        </thead>
        <tbody>
          <t t-set="total_qty" t-value="0" />
          <t t-set="total_weight" t-value="0" />
          <t t-foreach="service_orders" t-as="order">
            <t t-set="total_qty" t-value="total_qty + order.trip_id.total_quantity" />
            <t t-set="total_weight" t-value="total_weight + order.trip_id.total_qty_weight" />
            <t t-set="order" t-value="order" />
            <t t-call="service_order.cancel_order" />
            <tr>
              <td>
                <a t-attf-href="/service_order/{{order.id}}">
                  <t t-esc="order.serial" />
                </a>
              </td>
              <td>
                <t t-esc="order.pickup_location_id.name" />
              </td>
              <td class="text-wrap">
                <t t-options="{'widget': 'datetime', 'format': 'Y-M-d hh:mm:ss'}"
                  t-esc="order.request_datetime  " />
              </td>
              <td>
                <t t-esc="order.trip_id.sequence" />
              </td>
              <td class="text-wrap">
                <span
                  t-esc="order.order_datetime + relativedelta(hours=timzone_offset) if order.order_datetime else ''" />

              </td>
              <td>
                  <span t-field="order.trip_id.total_qty_weight" />
              </td>
              <td>
                  <span t-field="order.trip_id.total_quantity" />
              </td>
              <td>
                <span t-attf-class="state-badge #{order.states}-state">
                  <t t-esc="order.states" />
                </span>
              </td>
              <td>
                <a t-attf-href="/service_order/{{order.id}}/update">
                  <button
                    t-attf-class="btn btn-info fa fa-edit #{'d-none' if order.states not in ['draft', 'scheduled'] else ''}">
                  </button>
                </a>
              </td>
              <td>
                <a>
                  <button id="cancel_order_btn"
                    data-toggle="modal"
                    t-attf-class="btn btn-danger fa fa-trash #{'d-none' if order.states  not in ['draft', 'scheduled'] else ''}"
                    t-att-data-target="'#cancel_order_%s' % order.id"
                  >
                  </button>
                </a>
              </td>
            </tr>
          </t>
          <tr>
            <td class="font-weight-bold" colspan="5">Total</td>
            <td class="font-weight-bold">
              <t t-esc="round(total_weight, 4)" />
            </td>
            <td class="font-weight-bold">
              <t t-esc="int(total_qty)" />
            </td>
            <td></td>
            <td></td>
          </tr>
        </tbody>
      </t>
      <!-- <div>
        <t t-call="portal.pager" />
      </div> -->
    </t>
  </template>

</odoo>