<odoo>
  <template id="portal_my_home" name="service_service_portal" inherit_id="portal.portal_my_home">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
      <t t-if="request.env['service.order'].check_access_rights('read', raise_exception=False)">
        <t t-call="portal.portal_docs_entry">
          <t t-set="title">Service Order</t>
          <t t-set="url" t-value="'/service_orders'" />
          <t t-set="placeholder_count" t-value="'service_orders_count'" />
        </t>
      </t>
    </xpath>
  </template>

  <template id="portal_my_service_order" name="Portal layout : service orders"
    inherit_id="portal.portal_breadcrumbs" priority="100">
    <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
      <li t-if="page_name == 'service_orders' or service_order "
        t-attf-class="breadcrumb-item active">
        <a t-if="service_order" t-attf-href="/service_orders?{{ keep_query() }}">Service Orders</a>
        <t t-else="">Service Orders</t>
      </li>
      <li t-if="page_name == 'order_create'"
        class="breadcrumb-item active">
        <a t-attf-href="/service_orders?{{ keep_query() }}">Service Orders</a>
      </li>
      <li t-if="service_order" class="breadcrumb-item active">
        <span t-field="service_order.serial" />
      </li>
    </xpath>
  </template>

  <record id="menu_service_orders" model="website.menu">
    <field name="name">Service Orders</field>
    <field name="url">/service_orders</field>
    <field name="parent_id" ref="website.main_menu" />
    <field name="sequence" type="int">8</field>
  </record>


</odoo>