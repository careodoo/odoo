<odoo>
  <!-- service order create -->
  <template id="portal_service_order_update" name="Create Service Order">
    <t t-call="portal.portal_layout">
      <t t-set="wrapwrap_classes" t-value="'o_portal_bg_dark'" />
      <div class="o_portal_html_view shadow p-3">
        <!-- form -->
        <form class="o_portal_form" method="post"
          t-attf-action="/service_order/submit/#{service_order.id}">
          <div class="form-group">
            <label for="project_id">Project</label>
            <select class="form-control" id="project_id" name="project_id">
              <t t-foreach="projects" t-as="project_id">
                <t t-if="service_order.project_id.name == project_id[1]">
                  <option name="project_id" selected="selected"
                    t-att-value="service_order.project_id.id"
                    t-esc="service_order.project_id.name" />
                </t>
                <t t-else="">
                  <option name="project_id" t-att-value="project_id[0]" t-esc="project_id[1]" />
                </t>
              </t>
            </select>
          </div>
          <div class="form-group">
            <label for="type_id">Type</label>
            <select class="form-control" id="type_id" name="type_id">
              <t t-foreach="types" t-as="type">
                <t t-if="service_order.type_id.name == type[1]">
                  <option name="project" selected="selected"
                    t-att-value="service_order.type_id.id"
                    t-esc="service_order.type_id.name" />
                </t>
                <t t-else="">
                  <option name="type" t-att-value="type[0]" t-esc="type[1]" />
                </t>
              </t>
            </select>
          </div>
          <div class="form-group">
            <label for="pickup_location_id">Pickup Location</label>
            <select class="form-control" id="pickup_location_id" name="pickup_location_id">
              <t t-foreach="pickup_locations" t-as="pickup_location">
                <t t-if="service_order.pickup_location_id.name == pickup_location[1]">
                  <option name="project" selected="selected"
                    t-att-value="service_order.pickup_location_id.id"
                    t-esc="service_order.pickup_location_id.name" />
                </t>
                <t t-else="">
                  <option name="pickup_location" t-att-value="pickup_location[0]"
                    t-esc="pickup_location[1]" />
                </t>
              </t>
            </select>
          </div>
          <div class="form-group">
            <label for="order_datetime">Order Date</label>
            <input t-att-value="service_order.order_datetime" type="datetime-local"
              class="form-control"
              id="order_datetime" name="order_datetime"
              required="True" />
          </div>
          <div class="form-group">
            <label for="notes">Notes</label>
            <textarea class="form-control" id="notes" name="notes">
              <t t-esc="order_notes" />
            </textarea>
          </div>
          <button type="submit" class="btn btn-success">save changes</button>
        </form>
      </div>
    </t>
  </template>


</odoo>