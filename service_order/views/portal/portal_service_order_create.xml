<odoo>
  <!-- service order create -->
  <template id="portal_service_order_create" name="Create Service Order">
    <t t-call="portal.portal_layout">
      <div class="row justify-content-center my-4">
        <div class="col-lg-8">
          <div class="card border-0 shadow-sm" style="border-radius:18px;overflow:hidden">
            <!-- gradient hero header -->
            <div class="p-4 text-white" style="background:linear-gradient(120deg,#115E4B,#16A34A)">
              <div class="d-flex align-items-center">
                <span style="font-size:32px" class="me-3">♻️</span>
                <div>
                  <h3 class="mb-0 fw-bold">طلب نقل جديد</h3>
                  <div style="opacity:.9;font-size:13px">اطلب نقل ومعالجة المخلفات من موقعك</div>
                </div>
              </div>
            </div>
            <div class="card-body p-4">
              <form class="o_portal_form" method="post" action="/service_order/submit">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label for="project_id" class="form-label fw-bold small text-muted">🗂️ المشروع</label>
                    <select class="form-select" id="project_id" name="project_id">
                      <t t-foreach="projects" t-as="project_id">
                        <option name="project_id" t-att-value="project_id[0]" t-esc="project_id[1]"/>
                      </t>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label for="type_id" class="form-label fw-bold small text-muted">📋 نوع الطلب</label>
                    <select class="form-select" id="type_id" name="type_id">
                      <t t-foreach="types" t-as="type">
                        <option name="type" t-att-value="type[0]" t-esc="type[1]"/>
                      </t>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label for="pickup_location_id" class="form-label fw-bold small text-muted">📍 موقع الالتقاط</label>
                    <select class="form-select" id="pickup_location_id" name="pickup_location_id">
                      <t t-foreach="pickup_locations" t-as="pickup_location">
                        <option name="pickup_location" t-att-value="pickup_location[0]" t-esc="pickup_location[1]"/>
                      </t>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label for="request_datetime" class="form-label fw-bold small text-muted">📅 تاريخ ووقت الطلب</label>
                    <input type="datetime-local" class="form-control" id="request_datetime" name="request_datetime" required="True"/>
                  </div>
                  <div class="col-12">
                    <label for="notes" class="form-label fw-bold small text-muted">📝 ملاحظات</label>
                    <textarea class="form-control" id="notes" name="notes" rows="3" placeholder="أي تفاصيل إضافية عن الطلب…"></textarea>
                  </div>
                  <div class="col-12 d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-lg text-white fw-bold flex-grow-1" style="background:linear-gradient(120deg,#115E4B,#16A34A);border-radius:12px">
                      <i class="fa fa-paper-plane me-2"/> إرسال الطلب
                    </button>
                    <a href="/service_orders" class="btn btn-lg btn-outline-secondary" style="border-radius:12px">إلغاء</a>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>


</odoo>