<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- service center form view -->
  <record id="view_service_center_form" model="ir.ui.view">
    <field name="name">service.center.form</field>
    <field name="model">service.center</field>
    <field name="arch" type="xml">
      <form string="Service Center">
        <sheet>
          <group>
            <field name="company_id" />
            <field name="center_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            <field name="name" />
          </group>
        </sheet>
      </form>
    </field>
  </record>


  <!-- service center tree view -->
  <record id="view_service_center_tree" model="ir.ui.view">
    <field name="name">service.center.tree</field>
    <field name="model">service.center</field>
    <field name="arch" type="xml">
      <tree string="Service Center">
        <field name="name" />
        <field name="company_id" />
        <field name="center_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
      </tree>
    </field>
  </record>


  <!-- service center action -->
  <record id="action_service_center" model="ir.actions.act_window">
    <field name="name">Service Center</field>
    <field name="res_model">service.center</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- service center menu -->
  <menuitem id="menu_service_center" name="Service Center"
    parent="service_order.menu_service_order"
    action="action_service_center" />


</odoo>