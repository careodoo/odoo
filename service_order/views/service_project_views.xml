<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- form view -->
  <record id="view_service_project_form" model="ir.ui.view">
    <field name="name">service.project.form</field>
    <field name="model">service.project</field>
    <field name="arch" type="xml">
      <form string="Service Project">
        <header>
          <button name="project_to_draft" string="Reset To Draft" type="object" class="oe_highlight"
          />
          <button name="project_to_valid" string="Valid" type="object" class="btn btn-secondary"
          />
          <button name="project_to_expired" string="Expire" type="object"
          />
          <field name="state" widget="statusbar" statusbar_visible="draft,valid,expired" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="open_locations" type="object"
              string="Locations"
              class="oe_stat_button" icon="fa-bars">
              <field name="pickup_location_ids_count" />

            </button>
            <!-- ========================== -->
            <button name="open_teams" type="object"
              string="Teams"
              class="oe_stat_button" icon="fa-bars">
              <field name="team_ids_count" />
            </button>
            <!-- ========================== -->
            <button name="open_trips" type="object"
              string="Trips"
              class="oe_stat_button" icon="fa-bars">
              <field name="trip_ids_count" />
            </button>


          </div>
          <group>
            <field name="sequence" />
            <field name="name" />
            <field name="contact_id" />
            <field name="experience_id" />
            <field name="assign_user_ids" widget="many2many_tags"/>
            <field name="company_id" />
            <field name="start_date" />
            <field name="end_date" />
            <field name="image" widget="image" />
            <field name="notes" />
          </group>
        </sheet>
        <!-- Chatter -->
        <div class="oe_chatter">
          <field name="message_follower_ids" groups="base.group_user" />
          <field name="message_ids" />
        </div>
      </form>
    </field>
  </record>

  <!-- tree view -->
  <record id="view_service_project_tree" model="ir.ui.view">
    <field name="name">service.project.tree</field>
    <field name="model">service.project</field>
    <field name="arch" type="xml">
      <tree string="Service Project">
        <field name="sequence" />
        <field name="name" />
        <field name="contact_id" />
        <field name="assign_user_ids" />
        <field name="company_id" />
        <field name="start_date" />
        <field name="end_date" />
        <field name="state" 
          widget="badge" 
          decoration-info="state == 'draft'"
          decoration-danger="state == 'expired'"
          decoration-success="state == 'valid'" />
      </tree>
    </field>
  </record>

  <!-- action -->
  <record id="action_service_project" model="ir.actions.act_window">
    <field name="name">Service Project</field>
    <field name="res_model">service.project</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- menuitem -->
  <menuitem id="menu_service_project" name="Projects"
    parent="service_order.menu_service_order"
    sequence="1"
    action="action_service_project" />

</odoo>