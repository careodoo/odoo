<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- form view -->
  <record id="view_service_project_form" model="ir.ui.view">
    <field name="name">service.project.form</field>
    <field name="model">service.project</field>
    <field name="arch" type="xml">
      <form string="Service Project">
        <header>
          <button name="project_to_draft" string="Reset To Draft" type="object" class="oe_highlight"
          />
          <button name="project_to_valid" string="Valid" type="object" class="btn btn-secondary"
          />
          <button name="project_to_expired" string="Cancel" type="object"
          />
          <field name="state" widget="statusbar" statusbar_visible="draft,valid,expired" />
        </header>
        <sheet>
          <group>
            <field name="sequence" />
            <field name="name" />
            <field name="contact_id" />
            <field name="assign_user_id" />
            <field name="company_id" />
            <field name="start_date" />
            <field name="end_date" />
            <field name="image" widget="image"/>
            <field name="notes" />
          </group>
        </sheet>
        <!-- Chatter -->
        <div class="oe_chatter">
          <field name="message_follower_ids" groups="base.group_user" />
          <field name="message_ids" />
        </div>
      </form>
    </field>
  </record>

  <!-- tree view -->
  <record id="view_service_project_tree" model="ir.ui.view">
    <field name="name">service.project.tree</field>
    <field name="model">service.project</field>
    <field name="arch" type="xml">
      <tree string="Service Project">
        <field name="sequence" />
        <field name="name" />
        <field name="contact_id" />
        <field name="assign_user_id" />
        <field name="company_id" />
        <field name="start_date" />
        <field name="end_date" />
        <field name="state" />
      </tree>
    </field>
  </record>

  <!-- action -->
  <record id="action_service_project" model="ir.actions.act_window">
    <field name="name">Service Project</field>
    <field name="res_model">service.project</field>
    <field name="view_mode">tree,form</field>
  </record>

  <!-- menuitem -->
  <menuitem id="menu_service_project" name="Projects"
    parent="service_order.menu_service_order"
    sequence="1"
    action="action_service_project" />

</odoo>