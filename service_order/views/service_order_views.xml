<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- service order views -->
  <record id="service_order_form_view" model="ir.ui.view">
    <field name="name">service.order.form</field>
    <field name="model">service.order</field>
    <field name="arch" type="xml">
      <form string="Service Order">
        <header>
          <button attrs="{'invisible':[('states','!=','draft')]}" name="convert_to_trip" string="Convert to trip" type="object" class="oe_highlight" />
          <field name="states" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <field name="active" invisible="1"/>
            <field name="serial" />
            <field name="project_id" />
            <field name="type_id" />
            <field name="pickup_location_id" />
            <field name="order_datetime" />
            <field name="trip_id" />
            <field name="notes" />
          </group>
          <notebook>
            <page name="lines" string="Lines">
              <field name="order_line_ids">
                <tree editable="bottom">
                  <field name="item_id" />
                  <field name="quantity" />
                  <field name="width" />
                  <field name="height" />
                  <field name="weight" />
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <!-- chatetr -->
         <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
            <field name="message_ids" widget="mail_thread"/>
        </div>
      </form>

    </field>
  </record>



  <record id="service_order_tree_view" model="ir.ui.view">
    <field name="name">service.order.tree</field>
    <field name="model">service.order</field>
    <field name="arch" type="xml">
      <tree string="Service Orders">

        <field name="serial" />
        <field name="project_id" />
        <field name="type_id" />
        <field name="pickup_location_id" />
        <field name="order_datetime" />
        <field name="notes" />
        <field name="states" 
        widget="badge" 
        decoration-muted="states == 'draft'"
        decoration-info="states in ['pickuped','scheduled']"
        decoration-warning="states in ['arrived','processing','delivered']"
        decoration-danger="states == 'cancelled'"
        decoration-success="states == 'completed'"/>
      </tree>
    </field>
  </record>

  <record id="service_order_action" model="ir.actions.act_window">
    <field name="name">Service Orders</field>
    <field name="res_model">service.order</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="service_order_menu" name="Service Orders"
   parent="service_order.menu_service_order"
    sequence="3"
    action="service_order_action" />

</odoo>