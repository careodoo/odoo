<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_document_expiry" model="ir.cron">
        <field name="name">CARE: document expiry alert (HR digest)</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model.cron_document_expiry_alert()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
