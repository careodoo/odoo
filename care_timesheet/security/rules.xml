<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.rule" id="care_timesheet_comp_rule">
            <field name="name">Care Timesheet multi-company</field>
            <field name="model_id" ref="model_care_timesheet"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

        <record id="care_timesheet_rule_user_own" model="ir.rule">
            <field name="name">User own HR Care Timesheet</field>
            <field ref="care_timesheet.model_care_timesheet" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_care_timesheet_user'))]"/>
        </record>
        <record id="care_timesheet_rule_manager" model="ir.rule">
            <field name="name">All Care Timesheet</field>
            <field ref="care_timesheet.model_care_timesheet" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_care_timesheet_approver'))]"/>
        </record>

    </data>
</odoo>