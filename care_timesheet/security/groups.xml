<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_care_timesheet">
            <field name="name">Care Timesheet</field>
        </record>

        <record id="group_care_timesheet_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_care_timesheet"/>
        </record>
        <record id="group_care_timesheet_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="category_id" ref="module_care_timesheet"/>
            <field name="implied_ids" eval="[(4, ref('care_timesheet.group_care_timesheet_user'))]"/>
        </record>
    </data>
</odoo>