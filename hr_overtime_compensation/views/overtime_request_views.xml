<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="overtime_request_view_tree" model="ir.ui.view">
        <field name="name">overtime.request.view.tree</field>
        <field name="model">overtime.request</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="project_id"/>
                <field name="project_manager_id"/>
                <field name="request_date"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'submit'"
                       decoration-warning="state == 'waiting'"
                       decoration-success="state == 'approve'"
                       decoration-danger="state == 'reject'"
                />
            </tree>
        </field>
    </record>
    <record id="overtime_request_view_form" model="ir.ui.view">
        <field name="name">overtime.request.view.form</field>
        <field name="model">overtime.request</field>
        <field name="arch" type="xml">
            <form string="Request">
                <header>
                    <field name="approver_users" invisible="1" force_save="1"/>
                    <field name="user_confirmed" invisible="1" force_save="1"/>
                    <button name="button_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="button_cancel" type="object" string="Cancel" invisible="state == 'cancel'"/>
                    <button name="button_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <button name="button_approve" type="object" string="Approve" class="oe_highlight"
                            invisible="approver_users not in [uid] or user_confirmed or state not in ['submit', 'waiting']"/>
                    <button name="button_reject" type="object" string="Reject" class="btn btn-danger"
                            invisible="approver_users not in [uid] or user_confirmed or state not in ['submit', 'waiting']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit,approve"/>
                </header>
                <sheet>
                    <group>
                        <field name="project_id" readonly="state != 'draft'"/>
                        <field name="project_manager_id" readonly="state != 'draft'"/>
                        <field name="request_date" readonly="state != 'draft'"/>
                        <field name="barcode"/>
                    </group>
                    <notebook>
                        <page name="request_lines" string="Employees">
                            <field name="request_line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="project_id" column_invisible="1"/>
                                    <field name="barcode"/>
                                    <field name="employee_ids" widget="many2many_tags" column_invisible="1"/>
                                    <field name="employee_id"/>
                                    <field name="job_title"/>
                                    <field name="num_hours"/>
                                    <field name="compensation_value"/>
                                    <field name="overtime_reason"/>
                                </tree>
                            </field>
                        </page>
                        <page name="approval" string="Approvals">
                            <field name="approval_ids">
                                <tree create="0" edit="0" delete="0" editable="bottom">
                                    <field name="user_id" readonly="1" force_save="1"/>
                                    <field name="approved" readonly="1" force_save="1"/>
                                    <field name="date_approved" readonly="1" force_save="1"/>
                                    <field name="rejected" readonly="1" force_save="1"/>
                                    <field name="date_rejected" readonly="1" force_save="1"/>
                                    <field name="reject_reason" readonly="1" force_save="1"/>
                                    <button name="send_approve_request" type="object" string="Request For Approve"
                                            class="oe_highlight" invisible="approved"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="hr_kanban_view_hr_overtime" model="ir.ui.view">
        <field name="name">hr_kanban_view_hr_overtime</field>
        <field name="model">overtime.request</field>
        <field name="arch" type="xml">
            <kanban class="o_hr_employee_kanban">
                <field name="project_id"/>
                <field name="project_manager_id"/>
                <field name="request_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="project_id"/>
                                        </strong>
                                    </div>
                                </div>
                                <ul>
                                    <li t-if="record.project_manager_id.raw_value">
                                        <strong>Project Manager:</strong>
                                        <field name="project_manager_id"/>
                                    </li>
                                    <li t-if="record.request_date.raw_value">
                                        <strong>Request Date:</strong>
                                        <field name="request_date"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_overtime_request" model="ir.actions.act_window">
        <field name="name">Overtime Requests</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">overtime.request</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>
</odoo>
