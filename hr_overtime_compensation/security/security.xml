<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_hr_overtime">
            <field name="name">Overtime</field>
        </record>

        <record id="group_hr_overtime_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_hr_overtime"/>
        </record>

        <record id="hr_overtime_rule_user_own" model="ir.rule">
            <field name="name">User own Overtime</field>
            <field ref="hr_overtime_compensation.model_overtime_request" name="model_id"/>
            <field name="domain_force">['|', ('create_uid','=',user.id), ('approver_users','in', user.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="hr_overtime_rule_manager_all" model="ir.rule">
            <field name="name">Manager ALl Overtime</field>
            <field ref="hr_overtime_compensation.model_overtime_request" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('hr_overtime_compensation.group_hr_overtime_manager'))]"/>
        </record>

    </data>
</odoo>