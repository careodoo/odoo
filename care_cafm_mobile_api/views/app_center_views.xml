<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ==================== SETTINGS / CONTROL CENTRE ==================== -->
  <record id="view_app_settings_form" model="ir.ui.view">
    <field name="name">care.app.settings.form</field>
    <field name="model">care.app.settings</field>
    <field name="arch" type="xml">
      <form string="مركز التطبيق">
        <header>
          <button name="action_test_fcm" type="object" string="🔌 اختبار الاتصال بـ Firebase" class="btn-primary"/>
          <button name="action_push_test_me" type="object" string="🔔 أرسل إشعارًا تجريبيًا لي"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_devices" type="object" class="oe_stat_button" icon="fa-mobile">
              <field name="device_count" widget="statinfo" string="الأجهزة"/>
            </button>
            <button name="action_view_devices" type="object" class="oe_stat_button" icon="fa-signal">
              <field name="online_count" widget="statinfo" string="نشطة (أسبوع)"/>
            </button>
            <button name="action_view_sessions" type="object" class="oe_stat_button" icon="fa-key">
              <field name="session_count" widget="statinfo" string="الجلسات"/>
            </button>
          </div>
          <div class="oe_title"><h1>📱 <field name="name" readonly="1"/></h1></div>

          <group>
            <group string="🔔 الإشعارات (Firebase)">
              <field name="fcm_ready" invisible="1"/>
              <field name="fcm_status" readonly="1"
                     decoration-success="fcm_ready" decoration-danger="not fcm_ready"/>
              <field name="fcm_project_id" readonly="1" invisible="not fcm_project_id"/>
              <field name="fcm_credentials" password="True"
                     placeholder="الصق محتوى ملف Service Account JSON هنا…"/>
            </group>
            <group string="🚀 التحديث الإجباري">
              <field name="min_version" placeholder="2.14.0"/>
              <field name="force_update"/>
              <field name="update_message" invisible="not min_version"/>
              <field name="android_url" invisible="not min_version"/>
              <field name="ios_url" invisible="not min_version"/>
              <field name="outdated_count" readonly="1" invisible="not min_version"/>
            </group>
          </group>
          <group string="🛠️ الصيانة">
            <field name="maintenance"/>
            <field name="maintenance_message" invisible="not maintenance"/>
          </group>
          <div class="alert alert-info" role="alert">
            مفتاح Firebase يُحفظ مشفَّرًا في إعدادات النظام، ولا يظهر في التطبيق إطلاقًا.
            اضغط «اختبار الاتصال» بعد لصقه لتتأكد أن Google تقبله قبل الاعتماد عليه.
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_app_settings" model="ir.actions.server">
    <field name="name">إعدادات التطبيق</field>
    <field name="model_id" ref="model_care_app_settings"/>
    <field name="state">code</field>
    <field name="code">action = model.open_settings()</field>
  </record>

  <!-- ==================== DEVICES ==================== -->
  <record id="view_app_device_tree" model="ir.ui.view">
    <field name="name">care.cafm.device.tree</field>
    <field name="model">care.cafm.device</field>
    <field name="arch" type="xml">
      <tree decoration-muted="not active" decoration-success="online">
        <field name="user_id"/>
        <field name="platform"/>
        <field name="app_version"/>
        <field name="device_name"/>
        <field name="last_seen"/>
        <field name="online" widget="boolean_toggle" readonly="1"/>
        <field name="active" widget="boolean_toggle"/>
      </tree>
    </field>
  </record>
  <record id="view_app_device_search" model="ir.ui.view">
    <field name="name">care.cafm.device.search</field>
    <field name="model">care.cafm.device</field>
    <field name="arch" type="xml">
      <search>
        <field name="user_id"/><field name="app_version"/><field name="device_name"/>
        <filter name="f_online" string="نشطة خلال أسبوع" domain="[('online','=',True)]"/>
        <filter name="f_android" string="Android" domain="[('platform','=','android')]"/>
        <filter name="f_ios" string="iOS" domain="[('platform','=','ios')]"/>
        <separator/>
        <filter name="g_version" string="إصدار التطبيق" context="{'group_by':'app_version'}"/>
        <filter name="g_platform" string="المنصة" context="{'group_by':'platform'}"/>
        <filter name="g_user" string="المستخدم" context="{'group_by':'user_id'}"/>
      </search>
    </field>
  </record>
  <record id="action_app_devices" model="ir.actions.act_window">
    <field name="name">📱 الأجهزة المسجّلة</field>
    <field name="res_model">care.cafm.device</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_g_version': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">لا أجهزة مسجّلة بعد</p>
      <p>يظهر الجهاز هنا فور تثبيت التطبيق وتسجيل الدخول — مع إصداره وآخر ظهور له.</p>
    </field>
  </record>

  <!-- ==================== SESSIONS ==================== -->
  <record id="view_app_token_tree" model="ir.ui.view">
    <field name="name">care.cafm.mobile.token.tree</field>
    <field name="model">care.cafm.mobile.token</field>
    <field name="arch" type="xml">
      <tree decoration-muted="not active" create="false">
        <field name="user_id"/>
        <field name="device"/>
        <field name="last_used"/>
        <field name="expiry"/>
        <field name="active" widget="boolean_toggle"/>
      </tree>
    </field>
  </record>
  <record id="action_app_sessions" model="ir.actions.act_window">
    <field name="name">🔑 جلسات الدخول</field>
    <field name="res_model">care.cafm.mobile.token</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">لا جلسات</p>
      <p>كل تسجيل دخول من التطبيق يظهر هنا. أوقف التفعيل لإنهاء جلسة جهاز مفقود فورًا.</p>
    </field>
  </record>

  <!-- ==================== MENU ==================== -->
  <menuitem id="menu_app_center_root" name="📱 مركز التطبيق" web_icon="care_cafm_mobile_api,static/description/icon.png" sequence="52"/>
  <menuitem id="menu_app_center_settings" name="⚙️ الإعدادات والتحكم" parent="menu_app_center_root"
            action="action_app_settings" sequence="5"/>
  <menuitem id="menu_app_center_devices" name="📱 الأجهزة" parent="menu_app_center_root"
            action="action_app_devices" sequence="10"/>
  <menuitem id="menu_app_center_sessions" name="🔑 الجلسات" parent="menu_app_center_root"
            action="action_app_sessions" sequence="15"/>

</odoo>
