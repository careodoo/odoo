<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_training" name="بورتال التدريب">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="True"/>
            <div class="o_care_training">
                <style>
                    .o_care_training{padding:8px 4px 40px}
                    .o_care_training .ct-head{display:flex;align-items:center;gap:12px;margin-bottom:14px}
                    .o_care_training .ct-badge{width:46px;height:46px;border-radius:13px;background:linear-gradient(135deg,#5B4B8A,#2d2547);display:flex;align-items:center;justify-content:center;font-size:22px}
                    .o_care_training h3{margin:0;font-weight:800}
                    .o_care_training .ct-stats{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
                    .o_care_training .ct-stat{flex:1;min-width:110px;background:#fff;border:1px solid #eef0f4;border-radius:14px;padding:12px 16px}
                    .o_care_training .ct-stat .n{font-size:22px;font-weight:800}
                    .o_care_training .ct-stat .l{font-size:12px;color:#8a94a6}
                    .o_care_training .ct-chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
                    .o_care_training .ct-chip{border:1px solid #e3e6ec;border-radius:20px;padding:5px 14px;font-size:13px;text-decoration:none;color:#444;background:#fff}
                    .o_care_training .ct-chip.active{background:#5B4B8A;color:#fff;border-color:#5B4B8A}
                    .o_care_training .ct-card{background:#fff;border:1px solid #eef0f4;border-radius:14px;padding:14px;margin-bottom:10px;box-shadow:0 2px 8px rgba(0,0,0,.03);border-inline-start:4px solid #5B4B8A}
                    .o_care_training .ct-meta{color:#8a94a6;font-size:12.5px;display:flex;flex-wrap:wrap;gap:14px;margin-top:6px}
                    .o_care_training .ct-stage{font-size:11px;padding:2px 10px;border-radius:20px;font-weight:700}
                </style>
                <t t-if="not available">
                    <div class="alert alert-info">موديول التدريب غير مثبّت.</div>
                </t>
                <t t-else="">
                    <div class="ct-head">
                        <div class="ct-badge">🎓</div>
                        <div><h3>التدريب</h3><div style="color:#8a94a6;font-size:13px">طلبات التدريب والدورات والمهام</div></div>
                    </div>
                    <div class="ct-stats">
                        <div class="ct-stat"><div class="n" style="color:#5B4B8A"><t t-esc="stats['applications']"/></div><div class="l">الطلبات</div></div>
                        <div class="ct-stat"><div class="n" style="color:#F59E0B"><t t-esc="stats['in_progress']"/></div><div class="l">قيد التنفيذ</div></div>
                        <div class="ct-stat"><div class="n" style="color:#2563EB"><t t-esc="stats['approved']"/></div><div class="l">معتمَدة</div></div>
                        <div class="ct-stat"><div class="n" style="color:#16A34A"><t t-esc="stats['completed']"/></div><div class="l">مكتملة</div></div>
                        <div class="ct-stat"><div class="n" style="color:#0EA5A4"><t t-esc="stats['tasks']"/></div><div class="l">المهام</div></div>
                    </div>

                    <div class="ct-chips">
                        <a class="ct-chip #{not current_stage and 'active' or ''}" href="/my/training">الكل</a>
                        <t t-foreach="stages" t-as="s">
                            <a t-attf-class="ct-chip #{current_stage == s['id'] and 'active' or ''}"
                               t-attf-href="/my/training?stage=#{s['id']}">
                                <t t-esc="s['name']"/> (<t t-esc="s['count']"/>)
                            </a>
                        </t>
                    </div>

                    <t t-if="not apps"><div class="text-muted text-center py-5">لا طلبات تدريب.</div></t>
                    <t t-foreach="apps" t-as="a">
                        <div class="ct-card" t-attf-style="border-inline-start-color:#{'#16A34A' if a['is_completed'] else '#2563EB' if a['is_approved'] else '#F59E0B'}">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong t-esc="a['training_name'] or a['name']"/>
                                <span class="ct-stage" t-attf-style="background:#{'#16A34A22' if a['is_completed'] else '#2563EB22' if a['is_approved'] else '#F59E0B22'};color:#{'#16A34A' if a['is_completed'] else '#2563EB' if a['is_approved'] else '#B45309'}" t-esc="a['stage'] or ''"/>
                            </div>
                            <div style="color:#8a94a6;font-size:12px" t-esc="a['name'] + ' · ' + (a['application_name'] or '')"/>
                            <div class="ct-meta">
                                <span>👤 <t t-esc="a['employee'] or '—'"/></span>
                                <span>🛠 <t t-esc="a['responsible'] or '—'"/></span>
                                <span>📅 <t t-esc="a['date_start'] or ''"/> → <t t-esc="a['date_end'] or ''"/></span>
                                <span>📚 <t t-esc="a['lines_count']"/> دورة</span>
                                <span>✅ <t t-esc="a['task_count']"/> مهمة</span>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_training_menu" inherit_id="portal.portal_my_home" name="التدريب في حسابي" priority="83">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">التدريب</t>
                <t t-set="text">طلبات التدريب والدورات والمهام</t>
                <t t-set="url" t-value="'/my/training'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>
</odoo>
