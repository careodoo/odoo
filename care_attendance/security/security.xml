<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_bulk_attendance">
            <field name="name">Bulk Attendance</field>
        </record>

        <record id="group_bulk_attendance_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_bulk_attendance"/>
            <field name="implied_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
        </record>
        <record id="group_bulk_attendance_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="category_id" ref="module_bulk_attendance"/>
        </record>

        <record id="bulk_attendance_rule_user_own" model="ir.rule">
            <field name="name">User own Bulk Attendance</field>
            <field ref="care_attendance.model_bulk_attendance" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_bulk_attendance_user'))]"/>
        </record>
        <record id="bulk_attendance_rule_manager" model="ir.rule">
            <field name="name">All Bulk Attendance</field>
            <field ref="care_attendance.model_bulk_attendance" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_bulk_attendance_approver'))]"/>
        </record>
        <record model="ir.module.category" id="module_delete_employee">
            <field name="name">Delete Employee</field>
        </record>

        <record id="group_delete_employee_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_delete_employee"/>
        </record>

    </data>
</odoo>