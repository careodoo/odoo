<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="care_attendance_xlsx_view_form" model="ir.ui.view">
            <field name="name">care_attendance_xlsx_view_form</field>
            <field name="model">hr.attendance.xlsx</field>
            <field name="arch" type="xml">
                <form string="care_attendance_xlsx_form">
                    <sheet>
                        <group>
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                            <field name="department_ids" widget="many2many_tags"/>
                        </group>
                        <footer>
                            <button name="print_report" class="oe_highlight" type="object" string="Print"/>
                            <button string="Cancel" class="btn-default" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="care_attendance_xlsx_action" model="ir.actions.act_window">
            <field name="name">Export Attendance</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.attendance.xlsx</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="care_attendance_xlsx_menu" name="Export Attendance" parent="hr_attendance.menu_hr_attendance_root" action="care_attendance_xlsx_action" sequence="55"/>
    </data>
</odoo>