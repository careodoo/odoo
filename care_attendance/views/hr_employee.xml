<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employee_form_extra_dept" model="ir.ui.view">
            <field name="name">view.employee.form.extra.dept</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Extra Departments" name="extra_dept">
                        <field name="extra_department_ids">
                            <tree editable="bottom">
                                <field name="employee_id" invisible="1"/>
                                <field name="employee_department_id" invisible="1"/>
                                <field name="employee_calendar_id" invisible="1"/>
                                <field name="department_id"/>
                                <field name="calendar_id"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="extra_dept_view_form" model="ir.ui.view">
            <field name="name">extra_dept_view_form</field>
            <field name="model">hr.employee.extra.department</field>
            <field name="arch" type="xml">
                <form string="extra_dept_form">
                    <sheet>
                        <group>
                            <field name="employee_id"/>
                            <field name="employee_calendar_id" invisible="1"/>
                            <field name="employee_department_id" invisible="1"/>
                            <field name="department_id"/>
                            <field name="calendar_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="extra_dept_view_tree" model="ir.ui.view">
            <field name="name">extra_dept_view_tree</field>
            <field name="model">hr.employee.extra.department</field>
            <field name="arch" type="xml">
                <tree string="extra_dept_tree">
                    <field name="employee_id"/>
                    <field name="employee_calendar_id" invisible="1"/>
                    <field name="employee_department_id" invisible="1"/>
                    <field name="department_id"/>
                    <field name="calendar_id"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>