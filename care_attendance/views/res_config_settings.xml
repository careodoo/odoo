<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_care" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.care.attendance</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='overtime_settings']" position="before">
                    <block title="Bulk Attendance" name="bulk_attendance">
                        <setting string="Bulk Attendance Approver">
                            <field name="bulk_attendance_approval" class="w-75"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>