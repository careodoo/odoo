<odoo>
    <data>
        <record id="hr_kanban_view_bulk_attendance" model="ir.ui.view">
           <field name="name">employee.bulk.attendance.kanban</field>
           <field name="model">bulk.attendance</field>
           <field name="priority">10</field>
           <field name="arch" type="xml">
               <kanban class="o_hr_employee_kanban" sample="1">
                   <field name="id"/>
                   <field name="name"/>
                   <field name="type"/>
                   <field name="department_manager"/>
                   <field name="state"/>
                   <field name="employee_ids"/>
                   <field name="absent_employee_ids"/>
                   <field name="department_ids"/>
                   <templates>
                       <t t-name="kanban-box">
                       <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                            <div class="oe_kanban_details">
                               <div class="o_kanban_record_top">
                                   <div class="o_kanban_record_headings">
                                       <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                       </strong>
                                   </div>
                               </div>
                               <ul>
                                   <li class="o_text_overflow">
                                       <strong class="o_kanban_record_title">
                                           Type: <field name="type" />
                                       </strong>
                                   </li>
                                   <li class="o_force_ltr">
                                           <strong class="o_kanban_record_title">
                                                <field name="department_ids" widget="many2many_tags"/>
                                           </strong>
                                   </li>
                                   <li>
                                       <strong class="o_kanban_record_title">
                                           <span class="badge badge-pill">
                                                <t t-esc="record.state.value"/>
                                           </span>
                                       </strong>
                                   </li>
                               </ul>
                           </div>
                       </div>
                       </t>
                   </templates>
               </kanban>
            </field>
        </record>
        <record id="bulk_attendance_view_tree" model="ir.ui.view">
            <field name="name">bulk_attendance_view_tree</field>
            <field name="model">bulk.attendance</field>
            <field name="priority" eval="1"/>
            <field name="arch" type="xml">
                <tree string="bulk_attendance_tree">
                    <field name="active" invisible="1"/>
                    <field name="name"/>
                    <field name="department_ids" widget="many2many_tags"/>
                    <field name="bulk_date"/>
                    <field name="state" decoration-success="state in ['approved']"
                           decoration-info="state in ['draft', 'confirm']"
                           decoration-danger="state in ['refuse']" widget="badge" optional="show"/>
                </tree>
            </field>
        </record>
        <record id="absence_view_tree" model="ir.ui.view">
            <field name="name">absence_view_tree</field>
            <field name="model">bulk.attendance</field>
            <field name="priority" eval="2"/>
            <field name="arch" type="xml">
                <tree string="absence_tree">
                    <field name="active" invisible="1"/>
                    <field name="name"/>
                    <field name="department_ids" widget="many2many_tags"/>
                    <field name="bulk_date"/>
                    <field name="absent_employee_ids" widget="many2many_tags"/>
                    <field name="state" decoration-success="state in ['approved']"
                           decoration-info="state in ['draft', 'confirm']"
                           decoration-danger="state in ['refuse']" widget="badge" optional="show"/>
                </tree>
            </field>
        </record>
        <record id="bulk_attendance_view_form" model="ir.ui.view">
            <field name="name">bulk_attendance_view_form</field>
            <field name="model">bulk.attendance</field>
            <field name="arch" type="xml">
                <form string="bulk_attendance_tree">
                    <header>
                        <button name="button_confirm" type="object" string="Submit" class="oe_highlight"
                            invisible="department_manager != uid or state != 'draft'"
                            groups="care_attendance.group_bulk_attendance_user"/>
                        <button name="button_approve" type="object" string="Approve" class="oe_highlight"
                            invisible="approver != uid or state not in ['draft', 'confirm']"/>
                        <button name="button_refuse" type="object" string="Refuse" class="btn btn-danger"
                            invisible="approver != uid or state not in ['draft', 'confirm']"/>
                        <button name="button_draft" type="object" string="Reset to Draft"
                            invisible="approver != uid or state != 'confirm'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="type" readonly="state != 'draft'"/>
                            <field name="approver" invisible="1"/>
                            <field name="department_manager" invisible="1"/>
                            <field name="original_department_ids" widget="many2many_tags" invisible="1"/>
                            <field name="department_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}" readonly="state != 'draft'"/>
                            <field name="bulk_date" readonly="state != 'draft'" invisible="0"/>
                            <field name="refuse_reason" invisible="state != 'refuse'" readonly="1" force_save="1"/>
                        </group>
                        <notebook>
                            <page name="attend" string="Attendance" invisible="type != 'attendance'">
                                <field name="employee_ids" widget="many2many" readonly="state != 'draft'"/>
                            </page>
                            <page name="absent" string="Absence" invisible="type != 'absence'">
                                <field name="absent_employee_ids" widget="many2many" readonly="state != 'draft'"/>
                            </page>
                            <page string="Extra Departments">
                                <field name="extra_department_ids" widget="many2many" readonly="state != 'draft'"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="bulk_attendance_action" model="ir.actions.act_window">
            <field name="name">Bulk Attendance</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">bulk.attendance</field>
            <field name="view_mode">tree,kanban,form</field>
        </record>

        <record id="wait_bulk_attendance_action" model="ir.actions.act_window">
            <field name="name">Bulk Attendance Waiting Approval</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">bulk.attendance</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="domain">[('approver', '=', uid),('state', '=', 'confirm')]</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                   (0, 0, {'view_mode': 'tree', 'view_id': ref('bulk_attendance_view_tree')}),
                   (0, 0, {'view_mode': 'form'})
                   ]"/>
        </record>
        <record id="absence_action" model="ir.actions.act_window">
            <field name="name">Absence</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">bulk.attendance</field>
            <field name="domain">[('type', '=', 'absence')]</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                   (0, 0, {'view_mode': 'tree', 'view_id': ref('absence_view_tree')}),
                   (0, 0, {'view_mode': 'form'})
                   ]"/>
        </record>

        <menuitem id="bulk_attendance_root" name="Bulk Attendance" sequence="12"
            groups="care_attendance.group_bulk_attendance_approver,care_attendance.group_bulk_attendance_user"/>
        <menuitem id="bulk_attendance_action_menu"
                  name="Bulk Attendance"
                  parent="bulk_attendance_root"
                  action="bulk_attendance_action" sequence="1"
                  groups="care_attendance.group_bulk_attendance_approver,care_attendance.group_bulk_attendance_user"/>
        <menuitem id="wait_shift_request_menu" name="Bulk Attendance Waiting Approval"
                  parent="bulk_attendance_root"
                  action="wait_bulk_attendance_action" sequence="2"
                  groups="care_attendance.group_bulk_attendance_approver"/>
        <menuitem id="absent_menu" name="Absence"
                  parent="bulk_attendance_root"
                  action="absence_action" sequence="3"
                  groups="care_attendance.group_bulk_attendance_approver,care_attendance.group_bulk_attendance_user"/>

    </data>
</odoo>