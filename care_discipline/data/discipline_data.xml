<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- التسلسل -->
    <data noupdate="1">
        <record id="seq_care_complaint" model="ir.sequence">
            <field name="name">الشكاوى التأديبية</field>
            <field name="code">care.complaint</field>
            <field name="prefix">DISC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- أنواع المخالفات (بيانات أوّلية + عرض توضيحي) -->
    <data noupdate="1">
        <record id="cat_absence" model="care.complaint.category">
            <field name="name">غياب بدون إذن</field>
            <field name="name_en">Unauthorized Absence</field>
            <field name="sequence">10</field>
            <field name="default_severity">medium</field>
            <field name="suggested_penalty">deduction</field>
        </record>
        <record id="cat_late" model="care.complaint.category">
            <field name="name">تأخّر متكرّر</field>
            <field name="name_en">Repeated Tardiness</field>
            <field name="sequence">20</field>
            <field name="default_severity">low</field>
            <field name="suggested_penalty">warning</field>
        </record>
        <record id="cat_insubordination" model="care.complaint.category">
            <field name="name">رفض تنفيذ تعليمات العمل</field>
            <field name="name_en">Insubordination</field>
            <field name="sequence">30</field>
            <field name="default_severity">high</field>
            <field name="suggested_penalty">suspension</field>
        </record>
        <record id="cat_negligence" model="care.complaint.category">
            <field name="name">إهمال في أداء الواجب</field>
            <field name="name_en">Negligence of Duty</field>
            <field name="sequence">40</field>
            <field name="default_severity">medium</field>
            <field name="suggested_penalty">deduction</field>
        </record>
        <record id="cat_misconduct" model="care.complaint.category">
            <field name="name">سوء سلوك / اعتداء</field>
            <field name="name_en">Misconduct / Assault</field>
            <field name="sequence">50</field>
            <field name="default_severity">high</field>
            <field name="suggested_penalty">termination</field>
        </record>
        <record id="cat_property" model="care.complaint.category">
            <field name="name">إتلاف ممتلكات الشركة</field>
            <field name="name_en">Damage to Company Property</field>
            <field name="sequence">60</field>
            <field name="default_severity">high</field>
            <field name="suggested_penalty">deduction</field>
        </record>
        <record id="cat_safety" model="care.complaint.category">
            <field name="name">مخالفة اشتراطات السلامة</field>
            <field name="name_en">Safety Violation</field>
            <field name="sequence">70</field>
            <field name="default_severity">high</field>
            <field name="suggested_penalty">warning</field>
        </record>
        <record id="cat_other" model="care.complaint.category">
            <field name="name">أخرى (حدّد)</field>
            <field name="name_en">Other (specify)</field>
            <field name="sequence">900</field>
            <field name="default_severity">medium</field>
            <field name="suggested_penalty">warning</field>
            <field name="free_text" eval="True"/>
        </record>
    </data>
</odoo>
