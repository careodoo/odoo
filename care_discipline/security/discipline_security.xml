<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- فئة الصلاحيات -->
        <record id="module_category_discipline" model="ir.module.category">
            <field name="name">الشكاوى التأديبية</field>
            <field name="sequence">90</field>
        </record>

        <!-- مجموعة الموارد البشرية (تحقيق/استلام/تطبيق) -->
        <record id="group_discipline_hr" model="res.groups">
            <field name="name">الشكاوى التأديبية / الموارد البشرية</field>
            <field name="category_id" ref="module_category_discipline"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- مجموعة الإدارة القانونية (إقرار الجزاء) -->
        <record id="group_discipline_legal" model="res.groups">
            <field name="name">الشكاوى التأديبية / الإدارة القانونية</field>
            <field name="category_id" ref="module_category_discipline"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- أي مستخدم داخلي يقدّم شكوى ويرى شكاواه فقط -->
        <record id="rule_complaint_own" model="ir.rule">
            <field name="name">الشكاوى: الخاصة بالمستخدم (مُقدّم/مدير معتمِد)</field>
            <field name="model_id" ref="model_care_complaint"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('complainant_id', '=', user.id), ('manager_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- الموارد البشرية ترى الكل -->
        <record id="rule_complaint_hr_all" model="ir.rule">
            <field name="name">الشكاوى: الموارد البشرية (الكل)</field>
            <field name="model_id" ref="model_care_complaint"/>
            <field name="groups" eval="[(4, ref('group_discipline_hr'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- الإدارة القانونية ترى الكل -->
        <record id="rule_complaint_legal_all" model="ir.rule">
            <field name="name">الشكاوى: الإدارة القانونية (الكل)</field>
            <field name="model_id" ref="model_care_complaint"/>
            <field name="groups" eval="[(4, ref('group_discipline_legal'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
