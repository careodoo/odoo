<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- زر ذكي على ملف الموظف يعرض شكاواه التأديبية -->
    <record id="view_employee_form_discipline" model="ir.ui.view">
        <field name="name">hr.employee.form.discipline</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="action" name="%(action_complaint_from_employee)d"
                        class="oe_stat_button" icon="fa-gavel"
                        groups="care_discipline.group_discipline_hr,care_discipline.group_discipline_legal">
                    <field name="discipline_count" widget="statinfo" string="شكاوى تأديبية"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
