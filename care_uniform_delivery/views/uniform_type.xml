<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="uniform_type_view_tree" model="ir.ui.view">
            <field name="name">uniform_type_view_tree</field>
            <field name="model">uniform.type</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="uniform_type_action" model="ir.actions.act_window">
            <field name="name">Uniform Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">uniform.type</field>
            <field name="view_mode">tree</field>
        </record>
        <menuitem id="uniform_type_menu" name="Uniform Type" parent="uniform_delivery_root"
                  action="uniform_type_action" sequence="2"/>
    </data>
</odoo>