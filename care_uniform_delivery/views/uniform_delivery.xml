<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="uniform_delivery_view_form" model="ir.ui.view">
            <field name="name">uniform_delivery_view_form</field>
            <field name="model">uniform.delivery</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Name..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="active" invisible="1"/>
                                <field name="date"/>
                                <field name="uniform_type_id"/>
                                <field name="employee_id" invisible="context.get('show_employees', False)"/>
                            </group>
                            <group>
                                <field name="signature" widget="signature" required="1"/>
                                <field name="company_id"/>
                            </group>
                        </group>
                        <field name="employee_ids" invisible="context.get('show_employee', False)"/>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="uniform_delivery_view_tree" model="ir.ui.view">
            <field name="name">uniform_delivery_view_tree</field>
            <field name="model">uniform.delivery</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence" widget="handle"/>
                    <field name="active" invisible="1"/>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="employee_id" invisible="context.get('show_employees', False)"/>
                    <field name="uniform_type_id"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>
        <record id="uniform_delivery_action" model="ir.actions.act_window">
            <field name="name">Uniform Delivery</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">uniform.delivery</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'show_employee': True}</field>
            <field name="domain">[('employee_id', '!=', False)]</field>
        </record>

        <record id="bulk_uniform_delivery_action" model="ir.actions.act_window">
            <field name="name">Bulk Uniform Delivery</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">uniform.delivery</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'show_employees': True}</field>
            <field name="domain">[('employee_id', '=', False)]</field>
        </record>
        <menuitem id="uniform_delivery_root" name="Uniform Delivery" sequence="60"/>
        <menuitem id="uniform_delivery_menu" name="Uniform Delivery" parent="uniform_delivery_root"
                  action="uniform_delivery_action" sequence="1"/>
        <menuitem id="bulk_uniform_delivery_menu" name="Bulk Uniform Delivery" parent="uniform_delivery_root"
                  action="bulk_uniform_delivery_action" sequence="3"/>
    </data>
</odoo>