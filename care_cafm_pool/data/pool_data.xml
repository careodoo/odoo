<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="seq_pool_reading" model="ir.sequence">
      <field name="name">قراءة مياه مسبح</field>
      <field name="code">care.pool.reading</field>
      <field name="prefix">PLR/%(year)s/</field>
      <field name="padding">5</field>
    </record>
    <record id="cron_pool_missing" model="ir.cron">
      <field name="name">المسابح: تنبيه غياب القراءة اليومية</field>
      <field name="model_id" ref="model_care_pool_pool"/>
      <field name="state">code</field>
      <field name="code">model._cron_missing_reading()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
