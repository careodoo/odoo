<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.actions.report" id="action_scrap_report">
            <field name="name">Scrap</field>
            <field name="model">scrap.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">care_stock.scrap_report</field>
            <field name="report_file">care_stock.scrap_report</field>
        </record>
		<template id="scrap_report">
			<t t-call="web.html_container">
				<t t-call="care_stock.internal_layout">
                    <div class="page" style="font-family:Arial,Helvetica,sans-serif !important;">
                        <t t-foreach="docs" t-as="doc">
                            <h4 class="text-center">Scrap Order Report</h4>
                            <br/>
                            <p>
                                Date: <span t-field="doc.date_from"></span> To: <span t-field="doc.date_to"></span>
                            </p>
                            <br/>
                            <table class="table table-bordered table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Date</th>
                                        <th>Name</th>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th>Location</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sequence" t-value="0"/>
                                    <tr t-foreach="doc.order_ids" t-as="order">
                                        <t t-set="sequence" t-value="sequence + 1"/>
                                        <td>
                                            <span t-esc="sequence"/>
                                        </td>
                                        <td>
                                            <span style="white-space: nowrap;" t-esc="order.date_done.date()"/>
                                        </td>
                                        <td>
                                            <span t-field="order.name"/>
                                        </td>
                                        <td>
                                            <span t-field="order.product_id"/>
                                        </td>
                                        <td>
                                            <span t-field="order.scrap_qty"/>
                                            <span t-field="order.product_uom_id"/>
                                        </td>
                                        <td>
                                            <span t-field="order.location_id"/>
                                        </td>
                                        <td>
                                            <span t-field="order.reason_id"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <br/>
                            <div class="row">
                                <div class="col-4 text-center">
                                    <h5>Approver Sign</h5>
                                </div>
                                <div class="col-4 text-center">
                                    <h5>Accountant Sign</h5>
                                </div>
                                <div class="col-4 text-center">
                                    <h5>Store Keeper Sign</h5>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>