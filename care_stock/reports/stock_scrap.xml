<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.actions.report" id="action_stock_scrap_report">
            <field name="name">Scrap</field>
            <field name="model">stock.scrap</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">care_stock.stock_scrap_report</field>
            <field name="report_file">care_stock.stock_scrap_report</field>
            <field name="binding_model_id" ref="stock.model_stock_scrap"/>
            <field name="binding_type">report</field>
        </record>
		<template id="stock_scrap_report">
			<t t-call="web.html_container">
				<t t-call="care_stock.internal_layout">
                    <div class="page" style="font-family:Arial,Helvetica,sans-serif !important;">
                        <t t-foreach="docs" t-as="doc">
                            <div class="row">
                                <div class="col-4">
                                    <center>
                                        <img t-if="doc.barcode" t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %('Code128',doc.barcode,180,50)" />
                                        <div t-esc="doc.barcode"/>
                                    </center>
                                </div>
                                <div class="col-4">
                                    <center>
                                        <h4 class="text-center">Scrap Receipt</h4>
                                    </center>
                                </div>
                                <div class="col-4">
                                    <center>
                                        <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', doc.qr_url + str(doc.id), 600, 50)" style="width:100px;height:60px;"/>
                                    </center>
                                </div>
                            </div>
                            <br/>
                            <br/>
                            <table class="table table-bordered table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Name</th>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th>Location</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <span style="white-space: nowrap;" t-esc="doc.date_done.date()"/>
                                        </td>
                                        <td>
                                            <span t-field="doc.name"/>
                                        </td>
                                        <td>
                                            <span t-field="doc.product_id"/>
                                        </td>
                                        <td>
                                            <span t-field="doc.scrap_qty"/>
                                            <span t-field="doc.product_uom_id"/>
                                        </td>
                                        <td>
                                            <span t-field="doc.location_id"/>
                                        </td>
                                        <td>
                                            <span t-field="doc.reason_id"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <br/>
                            <div class="row">
                                <div class="col-4 text-center">
                                    <h5>Approver Sign</h5>
                                </div>
                                <div class="col-4 text-center">
                                    <h5>Accountant Sign</h5>
                                </div>
                                <div class="col-4 text-center">
                                    <h5>Store Keeper Sign</h5>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>