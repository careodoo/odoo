<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="seq_pest_visit" model="ir.sequence">
      <field name="name">Pest Control Visit</field>
      <field name="code">care.pest.visit</field>
      <field name="prefix">PST/%(year)s/</field>
      <field name="padding">5</field>
    </record>
    <record id="seq_pest_sighting" model="ir.sequence">
      <field name="name">Pest Sighting Report</field>
      <field name="code">care.pest.sighting</field>
      <field name="prefix">PSG/%(year)s/</field>
      <field name="padding">4</field>
    </record>

    <record id="cron_pest_due" model="ir.cron">
      <field name="name">مكافحة الحشرات: تنبيه الزيارات المستحقة</field>
      <field name="model_id" ref="model_care_pest_program"/>
      <field name="state">code</field>
      <field name="code">model._cron_due_reminder()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field name="active" eval="True"/>
    </record>

    <!-- the 'pest' portal section already ships with care_cafm -->
  </data>
</odoo>
