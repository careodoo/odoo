<odoo>

    <record id="purchase_order_form" model="ir.ui.view">
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="before">
                <field name="discount_type"/>
                <field name="discount_rate" attrs="{'invisible': [('discount_type', '!=', 'amount')]}"/>
                <label for="general_discount" attrs="{'invisible': [('discount_type', '!=', 'percent')]}"/>
                <div class="o_row" attrs="{'invisible': [('discount_type', '!=', 'percent')]}">
                    <field name="general_discount"/>
                    <button
                        name="action_update_general_discount"
                        class="oe_link oe_edit_only fa fa-refresh"
                        type="object"
                        help="Update general discounts"
                    />
                </div>
            </xpath>
        </field>
    </record>

</odoo>
