<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="module_category_hr_employee_allowance" model="ir.module.category">
    <field name="name">HR Employee Allowance</field>
    <field name="description">Helps you manage your employee allowances.</field>
    <field name="sequence">9</field>
  </record>

  <record id="group_hr_employee_allowance_manager" model="res.groups">
    <field name="name">Administrator</field>
    <field name="category_id" ref="module_category_hr_employee_allowance" />
    <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]" />
    <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
  </record>
</odoo>
