msgid ""
"الموظف: <b>%s</b><br/>المدة: <b>%s سنة و%s شهر</b> (من %s)<br/>الراتب "
"الأساسي: <b>%s %s</b><br/>المستحق (15 يوم/سنة أول 5 سنوات + شهر/سنة بعدها): "
"<b>%.0f %s</b><br/><span style=\"color:#64748b;font-size:12px;\">تقدير وفق "
"قانون العمل الكويتي — يُضاف بدل الإجازة المتبقية.</span>"
msgstr ""
"Employee: <b>%s</b><br/>Service: <b>%s years and %s months</b> (since "
"%s)<br/>Basic wage: <b>%s %s</b><br/>Entitlement (15 days/yr for first 5 "
"years + 1 month/yr after): <b>%.0f %s</b><br/><span "
"style=\"color:#64748b;font-size:12px;\">Estimate per Kuwait Labour Law — "
"remaining leave allowance is added.</span>"

