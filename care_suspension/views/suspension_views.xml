<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_care_suspension_form" model="ir.ui.view">
        <field name="name">care.suspension.request.form</field>
        <field name="model">care.suspension.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="إرسال للموارد البشرية"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="اعتماد"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="hr.group_hr_user"/>
                    <button name="action_reject" type="object" string="رفض"
                            invisible="state != 'submitted'" groups="hr.group_hr_user"/>
                    <button name="action_reset" type="object" string="إعادة لمسودة"
                            invisible="state not in ('submitted','rejected')"/>
                    <button name="action_print" type="object" string="طباعة الطلب" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="badge" readonly="1"/>
                            <field name="project_id"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="effective_date"/>
                            <field name="reason"/>
                            <field name="other_reason" invisible="reason != 'other'"/>
                        </group>
                    </group>
                    <group string="وضع العامل">
                        <group>
                            <field name="job_title" readonly="1"/>
                            <field name="wage" readonly="1"/>
                        </group>
                        <group>
                            <field name="has_allowance" readonly="1"/>
                            <field name="allowance_note" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="تفاصيل السبب / ملاحظات..."/>
                    <group>
                        <field name="requested_by" readonly="1"/>
                        <field name="approved_by" readonly="1"/>
                        <field name="approval_date" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_care_suspension_tree" model="ir.ui.view">
        <field name="name">care.suspension.request.tree</field>
        <field name="model">care.suspension.request</field>
        <field name="arch" type="xml">
            <tree decoration-success="state=='approved'" decoration-muted="state=='rejected'" decoration-info="state=='submitted'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="badge"/>
                <field name="project_id"/>
                <field name="reason"/>
                <field name="date"/>
                <field name="requested_by"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_care_suspension_search" model="ir.ui.view">
        <field name="name">care.suspension.request.search</field>
        <field name="model">care.suspension.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="badge"/>
                <field name="project_id"/>
                <filter name="draft" string="مسودة" domain="[('state','=','draft')]"/>
                <filter name="submitted" string="بانتظار الاعتماد" domain="[('state','=','submitted')]"/>
                <filter name="approved" string="معتمد" domain="[('state','=','approved')]"/>
                <group expand="0" string="تجميع">
                    <filter name="g_project" string="المشروع" context="{'group_by':'project_id'}"/>
                    <filter name="g_state" string="الحالة" context="{'group_by':'state'}"/>
                    <filter name="g_reason" string="السبب" context="{'group_by':'reason'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_care_suspension" model="ir.actions.act_window">
        <field name="name">طلبات الإيقاف عن العمل</field>
        <field name="res_model">care.suspension.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_care_suspension_search"/>
    </record>

    <menuitem id="menu_care_suspension_root" name="الإيقاف عن العمل"
              parent="hr.menu_hr_root" sequence="90"
              action="action_care_suspension"
              groups="base.group_user"/>
</odoo>
