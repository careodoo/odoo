<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sms_mail_server_twilio_formview" model="ir.ui.view">
            <field name="name">sms.mail.server.twilio.config</field>
            <field name="model">sms.mail.server</field>   
            <field name="inherit_id" ref="sms_notification.sms_mail_server_formview"/>                     
            <field name="arch" type="xml">
                <xpath expr="//group[@name='conn_info']" position="after">
                    <group string='Security And Authentication' invisible="gateway != 'twilio'">
                        <field name="twilio_number" placeholder="Twilio Phone Number(e.g. +12044993370)" required="gateway == 'twilio'"/>
                        <field name="account_sid" required="gateway == 'twilio'"/>
                        <field name="auth_token" required="gateway == 'twilio'"/>
                        <button name="test_conn_twilio" string="Test Connection" type="object"  />  
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
