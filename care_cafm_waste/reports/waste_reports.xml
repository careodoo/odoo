<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ORDER report -->
  <record id="action_report_waste_order" model="ir.actions.report">
    <field name="name">تقرير طلب النفايات</field>
    <field name="model">cafm.waste.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">care_cafm_waste.report_waste_order_doc</field>
    <field name="report_file">care_cafm_waste.report_waste_order_doc</field>
    <field name="print_report_name">'%s' % object.serial</field>
    <field name="binding_model_id" ref="model_cafm_waste_order"/>
    <field name="binding_type">report</field>
  </record>

  <template id="report_waste_order_doc">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <div class="page">
            <div style="border-bottom:3px solid #16A34A;padding-bottom:8px;margin-bottom:16px">
              <h2 style="color:#0E3A5F;margin:0">♻️ تقرير طلب نقل ومعالجة نفايات</h2>
              <div style="color:#64748b">الرقم: <strong t-esc="o.serial"/> · الحالة: <span t-field="o.states"/></div>
            </div>
            <table class="table table-sm">
              <tr><td><strong>العميل</strong></td><td t-esc="o.contact_id.name or ''"/><td><strong>المشروع</strong></td><td t-esc="o.project_id.name or ''"/></tr>
              <tr><td><strong>موقع الالتقاط</strong></td><td t-esc="o.pickup_location_id.name or ''"/><td><strong>تاريخ الطلب</strong></td><td t-esc="o.request_datetime"/></tr>
              <tr><td><strong>مدير العمليات</strong></td><td t-esc="o.ops_manager_id.name or ''"/><td><strong>السائق</strong></td><td t-esc="o.driver_id.name or ''"/></tr>
              <tr><td><strong>مستلم الكميات</strong></td><td t-esc="o.receiver_id.name or ''"/><td><strong>الوزن النهائي</strong></td><td><span t-esc="o.final_weight"/> كجم</td></tr>
            </table>
            <h4 style="color:#0E3A5F;margin-top:16px">الأصناف</h4>
            <t t-set="lines" t-value="o.order_line_ids or (o.trip_id.trip_line_ids if o.trip_id else o.order_line_ids)"/>
            <table class="table table-sm table-bordered">
              <thead style="background:#f1f5f9"><tr><th>الصنف</th><th>الكمية</th><th>وزن الوحدة</th><th>الوزن الكلي</th></tr></thead>
              <tbody>
                <tr t-foreach="lines" t-as="l">
                  <td t-esc="l.item_id.name"/><td t-esc="l.quantity"/><td t-esc="l.weight"/>
                  <td t-esc="round(l.quantity * l.weight, 2)"/>
                </tr>
              </tbody>
            </table>
            <div t-if="o.proof_image" style="margin-top:16px">
              <h4 style="color:#0E3A5F">صورة الإثبات</h4>
              <img t-att-src="image_data_uri(o.proof_image)" style="max-width:60%;max-height:250px;border-radius:8px"/>
            </div>
          </div>
        </t>
      </t>
    </t>
  </template>

  <!-- TRIP report -->
  <record id="action_report_waste_trip" model="ir.actions.report">
    <field name="name">تقرير رحلة النفايات</field>
    <field name="model">cafm.waste.trip</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">care_cafm_waste.report_waste_trip_doc</field>
    <field name="report_file">care_cafm_waste.report_waste_trip_doc</field>
    <field name="print_report_name">'%s' % (object.reference or object.sequence)</field>
    <field name="binding_model_id" ref="model_cafm_waste_trip"/>
    <field name="binding_type">report</field>
  </record>

  <template id="report_waste_trip_doc">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="t">
        <t t-call="web.external_layout">
          <div class="page">
            <div style="border-bottom:3px solid #0E3A5F;padding-bottom:8px;margin-bottom:16px">
              <h2 style="color:#0E3A5F;margin:0">🚛 تقرير رحلة نقل نفايات</h2>
              <div style="color:#64748b">المرجع: <strong t-esc="t.reference"/></div>
            </div>
            <table class="table table-sm">
              <tr><td><strong>المشروع</strong></td><td t-esc="t.project_id.name or ''"/><td><strong>مركز المعالجة</strong></td><td t-esc="t.center_id.name or ''"/></tr>
              <tr><td><strong>الالتقاط</strong></td><td t-esc="t.pickup_location_id.name or ''"/><td><strong>التاريخ</strong></td><td t-esc="t.trip_date"/></tr>
              <tr><td><strong>الوزن الكلي</strong></td><td><span t-esc="t.total_qty_weight"/> كجم</td><td><strong>الكمية</strong></td><td t-esc="t.total_quantity"/></tr>
            </table>
            <table class="table table-sm table-bordered">
              <thead style="background:#f1f5f9"><tr><th>الصنف</th><th>الكمية</th><th>الوزن</th></tr></thead>
              <tbody><tr t-foreach="t.trip_line_ids" t-as="l"><td t-esc="l.item_id.name"/><td t-esc="l.quantity"/><td t-esc="round(l.quantity*l.weight,2)"/></tr></tbody>
            </table>
          </div>
        </t>
      </t>
    </t>
  </template>

  <!-- ============ PERIOD SUMMARY REPORT (dashboard) ============ -->
  <record id="action_report_waste_period" model="ir.actions.report">
    <field name="name">تقرير النفايات الإجمالي</field>
    <field name="model">cafm.waste.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">care_cafm_waste.report_waste_period_doc</field>
    <field name="report_file">care_cafm_waste.report_waste_period_doc</field>
    <field name="binding_model_id" ref="model_cafm_waste_order"/>
    <field name="binding_type">report</field>
  </record>

  <template id="report_waste_period_doc">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <div class="page">
          <!-- title -->
          <div style="border-bottom:3px solid #16A34A;padding-bottom:6px;margin-bottom:10px">
            <h2 style="margin:0;color:#14532D">♻ تقرير نقل ومعالجة النفايات — الإجمالي</h2>
            <div style="color:#64748B;font-size:12px">
              <t t-if="date_from and date_to">
                الفترة من <strong t-esc="date_from"/> إلى <strong t-esc="date_to"/>
              </t>
              <t t-else="">كل الفترات</t>
            </div>
          </div>

          <!-- headline totals -->
          <table class="table table-sm" style="margin-bottom:14px">
            <tr>
              <td style="background:#F0FDF4;text-align:center;padding:10px">
                <div style="font-size:22px;font-weight:bold;color:#16A34A" t-esc="totals['orders']"/>
                <div style="font-size:11px;color:#64748B">عدد الأوامر</div>
              </td>
              <td style="background:#EEF2FF;text-align:center;padding:10px">
                <div style="font-size:22px;font-weight:bold;color:#4F46E5" t-esc="totals['qty']"/>
                <div style="font-size:11px;color:#64748B">إجمالي الكمية</div>
              </td>
              <td style="background:#ECFEFF;text-align:center;padding:10px">
                <div style="font-size:22px;font-weight:bold;color:#0891B2" t-esc="totals['weight']"/>
                <div style="font-size:11px;color:#64748B">إجمالي الوزن (كجم)</div>
              </td>
            </tr>
          </table>

          <!-- by status -->
          <h4 style="color:#14532D;margin-bottom:4px">التوزيع حسب الحالة</h4>
          <table class="table table-sm table-bordered" style="margin-bottom:14px">
            <thead style="background:#F1F5F9">
              <tr><th>الحالة</th><th class="text-end">الأوامر</th><th class="text-end">الكمية</th><th class="text-end">الوزن (كجم)</th></tr>
            </thead>
            <tbody>
              <tr t-foreach="by_state" t-as="s">
                <td t-esc="s['label']"/><td class="text-end" t-esc="s['orders']"/>
                <td class="text-end" t-esc="s['qty']"/><td class="text-end" t-esc="s['weight']"/>
              </tr>
            </tbody>
          </table>

          <!-- by project -->
          <h4 style="color:#14532D;margin-bottom:4px" t-if="len(by_project) &gt; 1">التوزيع حسب المشروع</h4>
          <table class="table table-sm table-bordered" style="margin-bottom:14px" t-if="len(by_project) &gt; 1">
            <thead style="background:#F1F5F9">
              <tr><th>المشروع</th><th class="text-end">الأوامر</th><th class="text-end">الكمية</th><th class="text-end">الوزن (كجم)</th></tr>
            </thead>
            <tbody>
              <tr t-foreach="by_project" t-as="p">
                <td t-esc="p['label']"/><td class="text-end" t-esc="p['orders']"/>
                <td class="text-end" t-esc="p['qty']"/><td class="text-end" t-esc="p['weight']"/>
              </tr>
            </tbody>
          </table>

          <!-- by item -->
          <h4 style="color:#14532D;margin-bottom:4px">الأصناف المنقولة</h4>
          <table class="table table-sm table-bordered" style="margin-bottom:14px">
            <thead style="background:#F1F5F9">
              <tr><th>الصنف</th><th class="text-end">الكمية</th><th class="text-end">الوزن الكلي (كجم)</th></tr>
            </thead>
            <tbody>
              <tr t-foreach="by_item" t-as="i">
                <td t-esc="i['label']"/><td class="text-end" t-esc="i['qty']"/><td class="text-end" t-esc="i['weight']"/>
              </tr>
              <tr style="background:#F0FDF4;font-weight:bold">
                <td>الإجمالي</td><td class="text-end" t-esc="totals['qty']"/><td class="text-end" t-esc="totals['weight']"/>
              </tr>
            </tbody>
          </table>

          <!-- order detail: ONE ROW each, not one page each -->
          <h4 style="color:#14532D;margin-bottom:4px">تفصيل الأوامر</h4>
          <table class="table table-sm table-bordered" style="font-size:11px">
            <thead style="background:#F1F5F9">
              <tr>
                <th>الرقم</th><th>المشروع</th><th>موقع الالتقاط</th><th>التاريخ</th>
                <th class="text-end">الكمية</th><th class="text-end">الوزن</th><th>الحالة</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="docs" t-as="o">
                <td><span t-field="o.serial"/></td>
                <td><span t-field="o.project_id.name"/></td>
                <td><span t-field="o.pickup_location_id.name"/></td>
                <td><span t-esc="o.request_datetime and str(o.request_datetime)[:10]"/></td>
                <td class="text-end" t-esc="o.total_quantity"/>
                <td class="text-end" t-esc="o.total_weight"/>
                <td t-esc="states.get(o.states, o.states)"/>
              </tr>
            </tbody>
          </table>
        </div>
      </t>
    </t>
  </template>
</odoo>
