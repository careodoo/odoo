                                    </div>
                                </div>
                                <!--3-->
                                <div class="row" style="margin-bottom:5px;">
                                    <div class="col-6"/>
                                    <div class="col-2"/>
                                    <div class="col-4 rtl-row">
                                        <span>اعتماد مدير العمليات بالموافقة:</span>
                                    </div>
                                </div>
                            </div>
                            <!--#4-->
                            <div style="border:1px solid black;padding-left:10px;padding-right:10px;">
                                <!--1-->
                                <div class="row" style="margin-top:15px;">
                                    <div class="col-4">
                                        <span>Personnel Supervisor Notes</span>
                                    </div>
                                    <div class="col-2"/>
                                    <div class="col-2"/>
                                    <div class="col-4 rtl-row">
                                        <span>ملاحظات مسئول شؤون العاملين:</span>
                                    </div>
                                </div>
                                <!--2-->
                                <div class="row" style="margin-bottom:20px;">
                                    <div class="col-6">.......................................................................................</div>
                                    <div class="col-6 rtl-row">.......................................................................................</div>
                                </div>
                                <!--3-->
                                <div class="row" style="margin-bottom:20px;">
                                    <div class="col-6">.......................................................................................</div>
                                    <div class="col-6 rtl-row">.......................................................................................</div>
                                </div>
                                <!--4-->
                                <div class="row" style="margin-bottom:20px;">
                                    <div class="col-4">
                                        <span>Date:</span>
                                    </div>
                                    <div class="col-4"/>
                                    <div class="col-4 rtl-row">
                                        <span>التاريخ:</span>
                                    </div>
                                </div>
                            </div>
                            <!--#5-->
                            <div style="border:1px solid black;padding-left:10px;padding-right:10px;">
                                <!--1-->
                                <div class="row" style="margin-top:15px;">
                                    <div class="col-4">
                                        <span>Human Resources Manager:</span>
                                    </div>
                                    <div class="col-2"/>
                                    <div class="col-2"/>
                                    <div class="col-4 rtl-row">
                                        <span>مدير إدارة الموارد البشرية:</span>
                                    </div>
                                </div>
                                <!--2-->
                                <div class="row" style="margin-bottom:20px;">
                                    <div class="col-6">.......................................................................................</div>
                                    <div class="col-6 rtl-row">.......................................................................................</div>
                                </div>
                                <!--3-->
                                <div class="row" style="margin-bottom:20px;">
                                    <div class="col-6">.......................................................................................</div>
                                    <div class="col-6 rtl-row">.......................................................................................</div>
                                </div>
                                <!--4-->
                                <div class="row" style="margin-bottom:20px;">
                                    <div class="col-4">
                                        <span>Date:</span>
                                    </div>
                                    <div class="col-4"/>
                                    <div class="col-4 rtl-row">
                                        <span>التاريخ:</span>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <div class="footer">
                            <center>
                                REF.: HR-FORMS 007
                            </center>
                        </div>
                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>