                                    </div>
                                    <div class="col-3 rtl-row">
                                        <span t-field="doc.employee_id.job_title"/>
                                    </div>
                                    <div class="col-3 rtl-row">
                                        <span>الوظيفة:</span>
                                    </div>
                                </div>
                                <!--7-->
                                <div class="row" style="margin-top:10px;">
                                    <div class="col-3">
                                        <span>Transfer period: </span>
                                    </div>
                                    <div class="col-3"/>
                                    <div class="col-3"/>
                                    <div class="col-3 rtl-row">
                                        <span>فترة النقل المطلوبة: </span>
                                    </div>
                                </div>
                                <!--8-->
                                <div class="row" style="margin-top:10px;">
                                    <div class="col-2"/>
                                    <div class="col-3 text-center">
                                        <h5>Date of transfer: </h5>
                                    </div>
                                    <div class="col-3 text-center">
                                        <h5 t-field="doc.date"/>
                                    </div>
                                    <div class="col-2 rtl-row text-center">
                                        <h5>تاريخ النقل:</h5>
                                    </div>
                                    <div class="col-2"/>
                                </div>
                            </div>
                            <!--#2-->
                            <div style="border:1px solid black;padding-left:10px;padding-right:10px;">
                                <!--1-->
                                <div class="row" style="margin-top:15px;">
                                    <div class="col-6">
                                        <span>Current Location Manager signature (from):</span>
                                    </div>
                                    <div class="col-2"/>
                                    <div class="col-4 rtl-row">
                                        <span>توقيع مسئول الموقع الحالي :</span>
                                    </div>
                                </div>
                                <!--2-->
                                <div class="row" style="margin-bottom:15px;">
                                    <div class="col-4">
                                        <span>Date:</span>
                                    </div>
                                    <div class="col-4"/>
                                    <div class="col-4 rtl-row">
                                        <span>التاريخ:</span>
                                    </div>
                                </div>
                            </div>
                            <!--#3-->
                            <div style="border:1px solid black;padding-left:10px;padding-right:10px;">
                                <!--1-->
                                <div class="row" style="margin-top:15px;">
                                    <div class="col-6">
                                        <span>New location Manager signature (to):</span>
                                    </div>
                                    <div class="col-2"/>
                                    <div class="col-4 rtl-row">
                                        <span>توقيع مسئول الموقع المنقول إليه: </span>
                                    </div>
                                </div>
                                <!--2-->
                                <div class="row" style="margin-bottom:20px;">
                                    <div class="col-4">
