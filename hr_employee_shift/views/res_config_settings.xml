<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.employee.shift</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="10"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="hr_employee_shift" string="Employee Shift Request" data-key="hr_employee_shift">
                        <h2>Approval List</h2>
                        <div class="row mt16 o_settings_container" name="approval_setting_container">
                            <div class="col-12 col-lg-6 o_setting_box" id="approval_list">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">First Approval of Employee Shift Request</span>
                                    <div class="text-muted">
                                        <field name="employee_shift_approval_1"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Second Approval of Employee Shift Request</span>
                                    <div class="text-muted">
                                        <field name="employee_shift_approval_2"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">Third Approval of Employee Shift Request</span>
                                    <div class="text-muted">
                                        <field name="employee_shift_approval_3"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </xpath>
            </field>
        </record>
        <record id="action_employee_shift_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'hr_employee_shift'}</field>
    </record>

    <menuitem id="menu_employee_shift_general_settings"
        name="Settings"
        parent="hr_employee_shift.employee_shift_request_root"
        sequence="20"
        action="action_employee_shift_config_settings"
        groups="base.group_system"/>
    </data>
</odoo>