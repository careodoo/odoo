<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.employee.shift</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="10"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Approval List" string="Approval List" name="hr_employee_shift">
                        <block title="Approval List" name="approval_setting_container">
                            <setting id="approval_list" string="First Approval of Employee Shift Request" title="First Approval of Employee Shift Request">
                                <field name="employee_shift_approval_1" class="o_light_label mt16" />
                            </setting>
                            <setting string="Second Approval of Employee Shift Request" title="Second Approval of Employee Shift Request">
                                <field name="employee_shift_approval_2" class="o_light_label mt16" />
                            </setting>
                            <setting string="Third Approval of Employee Shift Request" title="Third Approval of Employee Shift Request">
                                <field name="employee_shift_approval_3" class="o_light_label mt16" />
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
        <record id="action_employee_shift_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'hr_employee_shift'}</field>
    </record>

    <menuitem id="menu_employee_shift_general_settings"
        name="Settings"
        parent="hr_employee_shift.employee_shift_request_root"
        sequence="20"
        action="action_employee_shift_config_settings"
        groups="base.group_system"/>
    </data>
</odoo>