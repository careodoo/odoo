<odoo>
    <data>
        <record id="hr_kanban_view_shift_request" model="ir.ui.view">
           <field name="name">employee.shift.request.kanban</field>
           <field name="model">employee.shift.request</field>
           <field name="priority">10</field>
           <field name="arch" type="xml">
               <kanban class="o_hr_employee_kanban" sample="1">
                   <field name="id"/>
                   <field name="state"/>
                   <field name="employee_id"/>
                   <field name="current_department"/>
                   <field name="new_department"/>
                   <field name="date"/>
                   <field name="image_128" />
                   <templates>
                       <t t-name="kanban-box">
                       <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                           <field name="image_128" widget="image" class="o_kanban_image_fill_left" options="{'zoom': true, 'zoom_delay': 1000, 'background': true, 'preventClicks': false}"/>

                            <div class="oe_kanban_details">
                               <div class="o_kanban_record_top">
                                   <div class="o_kanban_record_headings">
                                       <strong class="o_kanban_record_title">
                                            <field name="employee_id" placeholder="Employee's Name"/>
                                       </strong>
                                   </div>
                               </div>
                               <ul>
                                   <li class="o_text_overflow">
                                       <strong class="o_kanban_record_title">
                                           From: <field name="current_department" />
                                       </strong>
                                   </li>
                                   <li class="o_force_ltr">
                                       <strong class="o_kanban_record_title">
                                            To: <field name="new_department" />
                                       </strong>
                                   </li>
                                   <li t-if="record.date.raw_value" class="o_force_ltr">
                                       <strong class="o_kanban_record_title">
                                            Date: <field name="date" />
                                       </strong>
                                   </li>
                                   <li>
                                       <strong class="o_kanban_record_title">
                                           <span class="badge badge-pill">
                                                <t t-esc="record.state.value"/>
                                           </span>
                                       </strong>
                                   </li>
                               </ul>
                           </div>
                       </div>
                       </t>
                   </templates>
               </kanban>
            </field>
        </record>
        <record id="employee_shift_request_view_form" model="ir.ui.view">
            <field name="name">employee_shift_request_view_form</field>
            <field name="model">employee.shift.request</field>
            <field name="arch" type="xml">
                <form string="employee_shift_request_form">
                    <header>
                        <button name="send_to_manager" type="object" string="Send to Manager" class="oe_highlight"
                                invisible="state != 'draft'" groups="hr_employee_shift.group_shift_request_user,hr_employee_shift.group_shift_request_manager,hr_employee_shift.group_shift_request_approver"/>
                        <button name="shift_confirm" type="object" string="Submit" class="oe_highlight"
                                invisible="old_department_manager != uid or state != 'sent'" groups="hr_employee_shift.group_shift_request_user,hr_employee_shift.group_shift_request_manager,hr_employee_shift.group_shift_request_approver"/>
                        <button name="first_approve" type="object" string="Approve" class="oe_highlight"
                                invisible="approver_1 != uid or state != 'confirm'"/>
                        <button name="second_approve" type="object" string="Approve" class="oe_highlight"
                                invisible="approver_2 != uid or state != 'approval_1'"/>
                        <button name="third_approve" type="object" string="Approve" class="oe_highlight"
                                invisible="approver_3 != uid or state != 'approval_2'"/>
                        <button name="shift_department" type="object" string="موافقة المدير الجديد" class="oe_highlight"
                                invisible="new_department_manager != uid or not show_shift_department"/>
                        <button name="action_hr_approve" type="object" string="✅ اعتماد الموارد البشرية النهائي" class="oe_highlight"
                                invisible="state != 'hr_review'" groups="hr.group_hr_manager"/>
                        <button name="action_hr_refuse" type="object" string="رفض HR" class="btn btn-danger"
                                invisible="state != 'hr_review'" groups="hr.group_hr_manager"/>
                        <button name="first_refuse" type="object" string="Refuse" class="btn btn-danger"
                                invisible="approver_1 != uid or state != 'confirm'"/>
                        <button name="first_refuse" type="object" string="Refuse" class="btn btn-danger"
                                invisible="approver_2 != uid or state != 'approval_1'"/>
                        <button name="first_refuse" type="object" string="Refuse" class="btn btn-danger"
                                invisible="approver_3 != uid or state != 'approval_2'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,sent,confirm,hr_review,done"/>
                    </header>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <field name="show_shift_department" invisible="1"/>
                        <widget name="web_ribbon" text="تم النقل" bg_color="bg-success" invisible="state != 'done'"/>
                        <widget name="web_ribbon" text="مرفوض" bg_color="bg-danger"
                                invisible="state not in ['refuse_1','refuse_2','refuse_3','hr_refuse']"/>
                        <div class="oe_title">
                            <h1><field name="employee_id" readonly="state != 'draft'" options="{'no_create': True}"/></h1>
                        </div>
                        <group>
                            <group string="بيانات النقل">
                                <field name="current_department" readonly="1" force_save="1"/>
                                <field name="new_department" readonly="state != 'draft'" options="{'no_create': True}"/>
                                <field name="date" readonly="state not in ['draft', 'sent']"/>
                                <field name="working_hours" invisible="working_hours_modifier != uid or state != 'confirm'"/>
                                <field name="refuse_reason" invisible="state not in ['refuse_1','refuse_2','refuse_3','hr_refuse']" readonly="1" force_save="1"/>
                            </group>
                            <group string="المعتمِدون">
                                <field name="old_department_manager" readonly="1"/>
                                <field name="new_department_manager" readonly="1"/>
                                <field name="approver_1" readonly="1"/>
                                <field name="approver_2" readonly="1"/>
                                <field name="approver_3" readonly="1"/>
                                <field name="hr_approved" readonly="1"/>
                                <field name="hr_approved_by" readonly="1" invisible="not hr_approved"/>
                                <field name="hr_approved_date" readonly="1" invisible="not hr_approved"/>
                            </group>
                        </group>
                        <field name="working_hours_modifier" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <notebook>
                            <page string="الأثر المالي" name="financial">
                                <field name="currency_id" invisible="1"/>
                                <group>
                                    <group string="الوضع الحالي">
                                        <field name="current_wage"/>
                                        <field name="total_allowance"/>
                                        <field name="allowance_count"/>
                                    </group>
                                    <group string="الأثر على الراتب/البدلات في المشروع الجديد">
                                        <field name="salary_same"/>
                                        <field name="new_wage" invisible="salary_same"
                                               required="not salary_same"/>
                                        <field name="allowances_same"/>
                                    </group>
                                </group>
                                <separator string="البدلات الحالية للعامل"/>
                                <field name="allowance_summary" readonly="1"/>
                                <field name="impact_notes" placeholder="ملاحظات على الأثر المالي للنقل..."/>
                                <div class="text-muted" style="font-size:12px;">
                                    ملاحظة: البدلات ذات النطاق «خاص بالمشروع» ستتوقف تلقائياً عند اعتماد النقل.
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="employee_shift_request_view_tree" model="ir.ui.view">
            <field name="name">employee_shift_request_view_tree</field>
            <field name="model">employee.shift.request</field>
            <field name="arch" type="xml">
                <tree string="employee_shift_request_tree">
                    <field name="active" invisible="1"/>
                    <field name="date"/>
                    <field name="employee_id"/>
                    <field name="current_department"/>
                    <field name="new_department"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    <field name="state" decoration-success="state == 'done'"
                           decoration-info="state in ['draft', 'sent', 'confirm', 'approval_1', 'approval_2', 'approval_3']"
                           decoration-warning="state == 'hr_review'"
                           decoration-danger="state in ['refuse_3', 'refuse_2', 'refuse_1', 'hr_refuse']" widget="badge" optional="show"/>
                </tree>
            </field>
        </record>
        <record id="employee_shift_request_action" model="ir.actions.act_window">
            <field name="name">Request for Shifting</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.shift.request</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>

        <record id="wait_shift_request_action" model="ir.actions.act_window">
            <field name="name">Waiting Approval</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.shift.request</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">["|", "|", "|", "|",
               "&amp;",
                 ('old_department_manager', '=', uid),
                 ('state', '=', 'sent'),
               "&amp;",
                 ('approver_1', '=', uid),
                 ('state', '=', 'confirm'),
               "&amp;",
                 ('approver_2', '=', uid),
                 ('state', '=', 'approval_1'),
               "&amp;",
                 ('approver_3', '=', uid),
                 ('state', '=', 'approval_2'),
               "&amp;",
                 ('new_department_manager', '=', uid),
                 ('state', '=', 'approval_3'),
            ]</field>
        </record>
        <!-- Nested inside the HR (Employees) app — not a separate top-level menu. -->
        <menuitem id="employee_shift_request_root" name="نقل العمالة (Shifting)" sequence="80"
            parent="hr.menu_hr_root"
            groups="hr_employee_shift.group_shift_request_user,hr_employee_shift.group_shift_request_manager,hr_employee_shift.group_shift_request_approver"/>
        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="employee_shift_request_menu" name="Request for Shifting" parent="employee_shift_request_root"
                  action="employee_shift_request_action" sequence="1"/>
        <menuitem id="wait_shift_request_menu" name="Waiting Approval" parent="employee_shift_request_root"
                  action="wait_shift_request_action" sequence="2"/>
    </data>
</odoo>