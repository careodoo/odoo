<odoo>
    <data>
        <record id="hr_kanban_view_shift_request" model="ir.ui.view">
           <field name="name">employee.shift.request.kanban</field>
           <field name="model">employee.shift.request</field>
           <field name="priority">10</field>
           <field name="arch" type="xml">
               <kanban class="o_hr_employee_kanban" sample="1">
                   <field name="id"/>
                   <field name="state"/>
                   <field name="employee_id"/>
                   <field name="current_department"/>
                   <field name="new_department"/>
                   <field name="date"/>
                   <field name="image_128" />
                   <templates>
                       <t t-name="kanban-box">
                       <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                           <field name="image_128" widget="image" class="o_kanban_image_fill_left" options="{'zoom': true, 'zoom_delay': 1000, 'background': true, 'preventClicks': false}"/>

                            <div class="oe_kanban_details">
                               <div class="o_kanban_record_top">
                                   <div class="o_kanban_record_headings">
                                       <strong class="o_kanban_record_title">
                                            <field name="employee_id" placeholder="Employee's Name"/>
                                       </strong>
                                   </div>
                               </div>
                               <ul>
                                   <li class="o_text_overflow">
                                       <strong class="o_kanban_record_title">
                                           From: <field name="current_department" />
                                       </strong>
                                   </li>
                                   <li class="o_force_ltr">
                                       <strong class="o_kanban_record_title">
                                            To: <field name="new_department" />
                                       </strong>
                                   </li>
                                   <li t-if="record.date.raw_value" class="o_force_ltr">
                                       <strong class="o_kanban_record_title">
                                            Date: <field name="date" />
                                       </strong>
                                   </li>
                                   <li>
                                       <strong class="o_kanban_record_title">
                                           <span class="badge badge-pill">
                                                <t t-esc="record.state.value"/>
                                           </span>
                                       </strong>
                                   </li>
                               </ul>
                           </div>
                       </div>
                       </t>
                   </templates>
               </kanban>
            </field>
        </record>
        <record id="employee_shift_request_view_form" model="ir.ui.view">
            <field name="name">employee_shift_request_view_form</field>
            <field name="model">employee.shift.request</field>
            <field name="arch" type="xml">
                <form string="employee_shift_request_form">
                    <header>
                        <button name="send_to_manager" type="object" string="Send to Manager" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'draft')]}" groups="hr_employee_shift.group_shift_request_user,hr_employee_shift.group_shift_request_manager,hr_employee_shift.group_shift_request_approver"/>
                        <button name="shift_confirm" type="object" string="Submit" class="oe_highlight"
                            attrs="{'invisible': &quot;['|', ('old_department_manager', '!=', uid), ('state', '!=', 'sent')]&quot;}"
                            groups="hr_employee_shift.group_shift_request_user,hr_employee_shift.group_shift_request_manager,hr_employee_shift.group_shift_request_approver"/>
                        <button name="first_approve" type="object" string="Approve" class="oe_highlight"
                            attrs="{'invisible': &quot;['|', ('approver_1', '!=', uid), ('state', '!=', 'confirm')]&quot;}"/>
                        <button name="second_approve" type="object" string="Approve" class="oe_highlight"
                            attrs="{'invisible': &quot;['|', ('approver_2', '!=', uid), ('state', '!=', 'approval_1')]&quot;}"/>
                        <button name="third_approve" type="object" string="Approve" class="oe_highlight"
                            attrs="{'invisible': &quot;['|', ('approver_3', '!=', uid), ('state', '!=', 'approval_2')]&quot;}"/>
                        <button name="shift_department" type="object" string="Shift" class="oe_highlight"
                            attrs="{'invisible': &quot;['|', ('new_department_manager', '!=', uid), ('show_shift_department', '=', False)]&quot;}"/>
                        <button name="first_refuse" type="object" string="Refuse" class="btn btn-danger"
                            attrs="{'invisible': &quot;['|', ('approver_1', '!=', uid), ('state', 'not in', ('confirm'))]&quot;}"/>
                        <button name="first_refuse" type="object" string="Refuse" class="btn btn-danger"
                            attrs="{'invisible': &quot;['|', ('approver_2', '!=', uid), ('state', 'not in', ('approval_1'))]&quot;}"/>
                        <button name="first_refuse" type="object" string="Refuse" class="btn btn-danger"
                            attrs="{'invisible': &quot;['|', ('approver_3', '!=', uid), ('state', 'not in', ('approval_2'))]&quot;}"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="show_shift_department" invisible="1"/>
                            <field name="employee_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="current_department" readonly="1" force_save="1"/>
                            <field name="new_department" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="date" attrs="{'readonly': [('state', 'not in', ['draft', 'sent'])]}"/>
                            <field name="refuse_reason" states="refuse_1,refuse_2,refuse_3" readonly="1" force_save="1"/>
                            <field name="working_hours" attrs="{'invisible': &quot;['|', ('working_hours_modifier', '!=', uid), ('state', '!=', 'confirm')]&quot;}"/>
                            <field name="approver_1" invisible="0"/>
                            <field name="approver_2" invisible="0"/>
                            <field name="approver_3" invisible="0"/>
                            <field name="working_hours_modifier" invisible="1"/>
                            <field name="old_department_manager" invisible="0"/>
                            <field name="new_department_manager" invisible="0"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="employee_shift_request_view_tree" model="ir.ui.view">
            <field name="name">employee_shift_request_view_tree</field>
            <field name="model">employee.shift.request</field>
            <field name="arch" type="xml">
                <tree string="employee_shift_request_tree">
                    <field name="active" invisible="1"/>
                    <field name="date"/>
                    <field name="employee_id"/>
                    <field name="current_department"/>
                    <field name="new_department"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    <field name="state" decoration-success="state in ['done', 'approval_1', 'approval_2', 'approval_3']"
                           decoration-info="state in ['draft', 'sent', 'confirm']"
                           decoration-danger="state in ['refuse_3', 'refuse_2', 'refuse_1']" widget="badge" optional="show"/>
                </tree>
            </field>
        </record>
        <record id="employee_shift_request_action" model="ir.actions.act_window">
            <field name="name">Request for Shifting</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.shift.request</field>
            <field name="view_mode">kanban,tree,form</field>
        </record>

        <record id="wait_shift_request_action" model="ir.actions.act_window">
            <field name="name">Waiting Approval</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.shift.request</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">["|", "|", "|", "|",
               "&amp;",
                 ('old_department_manager', '=', uid),
                 ('state', '=', 'sent'),
               "&amp;",
                 ('approver_1', '=', uid),
                 ('state', '=', 'confirm'),
               "&amp;",
                 ('approver_2', '=', uid),
                 ('state', '=', 'approval_1'),
               "&amp;",
                 ('approver_3', '=', uid),
                 ('state', '=', 'approval_2'),
               "&amp;",
                 ('new_department_manager', '=', uid),
                 ('state', '=', 'approval_3'),
            ]</field>
        </record>
        <menuitem id="employee_shift_request_root" name="Request for Shifting" sequence="11"
            groups="hr_employee_shift.group_shift_request_user,hr_employee_shift.group_shift_request_manager,hr_employee_shift.group_shift_request_approver"/>
        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="employee_shift_request_menu" name="Request for Shifting" parent="employee_shift_request_root"
                  action="employee_shift_request_action" sequence="1"/>
        <menuitem id="wait_shift_request_menu" name="Waiting Approval" parent="employee_shift_request_root"
                  action="wait_shift_request_action" sequence="2"/>
    </data>
</odoo>