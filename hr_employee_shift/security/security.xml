<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_direct_shift">
            <field name="name">Direct Employee Shifting</field>
        </record>

        <record id="group_direct_shift_user" model="res.groups">
            <field name="name">Direct Employee Shifting</field>
            <field name="category_id" ref="module_direct_shift"/>
        </record>

        <record model="ir.module.category" id="module_shift_request">
            <field name="name">Request for Shifting</field>
        </record>

        <record id="group_shift_request_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_shift_request"/>
        </record>

        <record id="group_shift_request_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="category_id" ref="module_shift_request"/>
        </record>

        <record id="group_shift_request_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_shift_request"/>
        </record>

        <record id="shift_request_rule_user_own" model="ir.rule">
            <field name="name">User own shift request</field>
            <field ref="hr_employee_shift.model_employee_shift_request" name="model_id"/>
            <!--            <field name="domain_force">[('user_id','=', user.id)]</field>-->
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_shift_request_user'))]"/>
        </record>

        <record id="ir_rule_shift_request_approver" model="ir.rule">
            <field name="name">Department Shift Approver</field>
            <field ref="hr_employee_shift.model_employee_shift_request" name="model_id"/>
            <field name="domain_force">['|', '|', '|','|','|',
                ('create_uid','=',user.id),
                ('old_department_manager', '=', user.id),
                ('new_department_manager', '=', user.id),
                ('approver_1', '=', user.id),
                ('approver_2', '=', user.id),
                ('approver_3', '=', user.id),
                ]</field>
            <field name="groups" eval="[(4, ref('group_shift_request_approver'))]"/>
        </record>


        <record id="shift_request_rule_manager" model="ir.rule">
            <field name="name">All shift request</field>
            <field ref="hr_employee_shift.model_employee_shift_request" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_shift_request_manager'))]"/>
        </record>

    </data>
</odoo>