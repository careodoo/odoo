<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_care_dms_category_tree" model="ir.ui.view">
        <field name="name">care.dms.category.tree</field>
        <field name="model">care.dms.category</field>
        <field name="arch" type="xml">
            <tree default_order="sequence" decoration-warning="state == 'review_disposal'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="document_count" string="العدد"/>
                <field name="retention_rule"/>
                <field name="access_scope"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'review_disposal'"/>
            </tree>
        </field>
    </record>

    <record id="view_care_dms_category_form" model="ir.ui.view">
        <field name="name">care.dms.category.form</field>
        <field name="model">care.dms.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents" type="object"
                                class="oe_stat_button" icon="fa-files-o">
                            <field name="document_count" widget="statinfo" string="وثائق"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="اسم التصنيف"/></h1></div>
                    <group>
                        <group>
                            <field name="retention_rule"/>
                            <field name="retention_years"/>
                            <field name="access_scope"/>
                        </group>
                        <group>
                            <field name="state"/>
                        </group>
                    </group>
                    <field name="legal_note" placeholder="الأساس القانوني لسياسة الاحتفاظ..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_care_dms_category" model="ir.actions.act_window">
        <field name="name">التصنيفات وسياسة الاحتفاظ</field>
        <field name="res_model">care.dms.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
