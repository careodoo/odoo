<odoo>
    <template id="outgoing_report_report_template">
        <t t-foreach="docs" t-as="o">
            <div class="page">
                <t t-call="web.html_container">
                    <p>
                        <strong>Date:</strong>
                        <span t-field="o.issue_date"/><br/>
                        <strong>REF:</strong>
                        <span t-field="o.ref"/><br/>
                    </p>
                </t>
            </div>
        </t>
    </template>

     <record id="outgoing_report_paperformat_id" model="report.paperformat">
        <field name="name">Outgoing Report Paperformat</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
         <field name="page_height">20</field>
        <field name="page_width">62</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">7</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="outgoing_report" model="ir.actions.report">
        <field name="name">Outgoing Report</field>
        <field name="model">letter.file</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sp_letter_v15.outgoing_report_report_template</field>
        <field name="report_file">sp_letter_v15.outgoing_report_report_template</field>
        <field name="paperformat_id" ref="sp_letter_v15.outgoing_report_paperformat_id"/>
        <field name="binding_model_id" ref="sp_letter_v15.model_letter_file"/>
        <field name="binding_type">report</field>
    </record>

</odoo>