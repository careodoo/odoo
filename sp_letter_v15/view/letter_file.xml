<?xml version="1.0" encoding="utf-8"?>

<odoo>
	<data>

		<record model="ir.ui.view" id="letter_file_form_view">
			<field name="name">letter file</field>
			<field name="model">letter.file</field>
			<field name="arch" type="xml">
				<form>
					<header>
						<field name="out_going_stage" widget="statusbar" clickable="1"/>
					</header>

					<sheet>
						  <field name="kanban_state" widget="state_selection"/>
						 <field class="oe_avatar" widget="image" name="image_letter"/>
						<div class="oe_title">
						             <h1>
                    					<field name="name" required="1" placeholder="Name..."/>
               						 </h1>
            				</div>
						<group>
							<group>
								<field name="ref"/>
								<field name="tag_id" widget="many2many_tags"/>
								<field name="partner_id"/>
								<field name="department_id"/>
								<field name="issue_date"/>
								<field name="deli_date"/>
							</group>
							<group>
								<field name="id"/>
								<field name="letter_contain"/>
								<field name="create_uid"/>
								<field name="write_date"/>
								<field name="write_uid"/>
							</group>
						</group>
					</sheet>
					 <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
				</form>
			</field>
		</record>

		<record model="ir.ui.view" id="letter_file_tree_view">
			<field name="name">letter file</field>
			<field name="model">letter.file</field>
			<field name="arch" type="xml">
				<tree>
					<field name="name"/>
					<field name="tag_id"/>
				</tree>
			</field>
		</record>

		  <record id="view_kanban_letter_file" model="ir.ui.view">
            <field name="name">letter.file.kanban</field>
            <field name="model">letter.file</field>
            <field name="arch" type="xml">
                <kanban default_group_by="out_going_stage">
					  <field name="color"/>
					  <progressbar field="kanban_state" colors="{&quot;normal&quot;: &quot;muted&quot;, &quot;done&quot;: &quot;success&quot;, &quot;blocked&quot;: &quot;danger&quot;}"/>
					  <templates>
						<t t-name="kanban-box">
						  <div class="o_kanban_record oe_kanban_global_click o_kanban_record_has_image_fill" color="color">
							<field class="o_kanban_image_fill_left" name="image_letter" widget="image" options="{&quot;zoom&quot;: true, &quot;background&quot;: true, &quot;preventClicks&quot;: false}"/>
							<div class="o_kanban_record_details">
							  <div class="o_kanban_record_top" name="studio_auto_kanban_top">
								<div class="o_kanban_record_headings" name="studio_auto_kanban_headings">
								  <strong class="o_kanban_record_title" name="studio_auto_kanban_title">
									<field name="name"/>
								  </strong>
								</div>
								<div class="o_dropdown_kanban dropdown">
								  <a role="button" class="dropdown-toggle o-no-caret btn" data-toggle="dropdown" data-display="static" href="#" aria-label="Dropdown Menu" title="Dropdown Menu">
									<span class="fa fa-ellipsis-v"/>
								  </a>
								  <div class="dropdown-menu" role="menu">
									<a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Edit</a>
									<a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
									<ul class="oe_kanban_colorpicker" data-field="color"/>
								  </div>
								</div>
							  </div>
							  <div class="o_kanban_record_body" name="studio_auto_kanban_body">
								<field name="tag_id" options="{'color_field': 'color'}"/>
							  </div>
							  <div class="o_kanban_record_bottom" name="studio_auto_kanban_bottom">
								<div class="oe_kanban_bottom_left" name="studio_auto_kanban_bottom_left"/>
								<div class="oe_kanban_bottom_right" name="studio_auto_kanban_bottom_right">
								  <field name="kanban_state" widget="state_selection"/>
								</div>
							  </div>
							</div>
						  </div>
						</t>
  				</templates>
</kanban>
            </field>
        </record>


		<record model="ir.actions.act_window" id="action_letter_file_id">
			<field name="name">letter file</field>
			<field name="res_model">letter.file</field>
			<field name="view_mode">kanban,form,tree</field>
		</record>



	</data>
</odoo>