<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_esign" model="ir.module.category">
        <field name="name">التوقيع الإلكتروني</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_esign_manager" model="res.groups">
        <field name="name">مدير منظومة التواقيع</field>
        <field name="category_id" ref="module_category_esign"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">يرى كل سجلات التواقيع الإلكترونية ويمكنه إلغاء توقيع (void).</field>
    </record>

    <!-- كل مستخدم داخلي يرى تواقيعه فقط -->
    <record id="rule_esign_own" model="ir.rule">
        <field name="name">التواقيع: الخاصة بالمستخدم</field>
        <field name="model_id" ref="model_care_esignature"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- مدير المنظومة يرى الكل -->
    <record id="rule_esign_all" model="ir.rule">
        <field name="name">التواقيع: كل السجلات (مدير)</field>
        <field name="model_id" ref="model_care_esignature"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_esign_manager'))]"/>
    </record>
</odoo>
