<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- paperformat مضغوط لضمان صفحة واحدة تملأ الورقة -->
    <record id="paperformat_esign_enrollment" model="report.paperformat">
        <field name="name">E-Signature Enrollment (compact)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_esign_enrollment" model="ir.actions.report">
        <field name="name">نموذج اعتماد التوقيع الإلكتروني</field>
        <field name="model">care.esign.enrollment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">care_esignature.report_esign_enrollment</field>
        <field name="report_file">care_esignature.report_esign_enrollment</field>
        <field name="binding_model_id" ref="model_care_esign_enrollment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_esign_enrollment"/>
    </record>

    <template id="report_esign_enrollment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- sudo للمستند كاملًا: الموظف/التوقيع قد يكونان على شركة مختلفة عن الطابع
                     (قاعدة تعدّد الشركات) فتُسبّب القراءة المباشرة AccessError عند الطباعة. -->
                <t t-set="doc" t-value="doc.sudo()"/>
                <!-- متغيّرات الهيدر/الفوتر المعتمد: العنوان في منتصف الهيدر + الباركود من رقم الاعتماد -->
                <t t-set="hco" t-value="doc.company_id or doc.env.company"/>
                <t t-set="rtitle">نموذج اعتماد التوقيع الإلكتروني</t>
                <t t-set="rtitle_en">E-Signature Authorization &amp; Consent Form</t>
                <t t-set="hrno" t-value="doc.name"/>
                <t t-set="sig" t-value="doc.user_id.sudo().esign_signature if doc.user_id else False"/>
                <div class="page article" dir="rtl" style="font-family:'Tajawal','DejaVu Sans',sans-serif;color:#000000;font-size:11px">
                    <!-- إزالة كلّ الحدود/الصناديق حول الهيدر والفوتر (لهذا التقرير فقط، دون جداول البيانات) -->
                    <style>
                        .care-hf, .care-hf *{border:0 !important;outline:0 !important;box-shadow:none !important;background-image:none !important}
                        .care-hf table, .care-hf td, .care-hf th, .care-hf tr{border:0 !important;border-collapse:collapse !important}
                        .care-hf .care-ttl-box{border:0 !important;background:transparent !important;border-radius:0 !important;padding:2px 8px !important}
                        .care-hf .care-sep{border-left:0 !important}
                        .care-hf div[style*="1f3a5f"]{background:#ffffff !important;height:0 !important;margin:0 !important}
                    </style>
                    <div class="care-hf"><t t-call="care_report_layout.lh_header_inner"/></div>

                    <!-- بيانات الموظف -->
                    <table style="width:100%;border-collapse:collapse;font-size:11px;margin:9px 0 9px;color:#000000">
                        <tr>
                            <td style="border:1px solid #000;padding:5px 8px;background:#f0f0f0;font-weight:700;width:18%">اسم الموظف</td>
                            <td style="border:1px solid #000;padding:5px 8px;width:32%"><t t-esc="doc.employee_id.name"/></td>
                            <td style="border:1px solid #000;padding:5px 8px;background:#f0f0f0;font-weight:700;width:18%">الرقم المدني</td>
                            <td style="border:1px solid #000;padding:5px 8px;width:32%;direction:ltr;text-align:right"><t t-esc="doc.employee_id.care_civilid_display or doc.employee_id.civil_code or doc.identification_id or '-'"/></td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;padding:5px 8px;background:#f0f0f0;font-weight:700">المسمّى الوظيفي</td>
                            <td style="border:1px solid #000;padding:5px 8px"><t t-esc="doc.job_id.name or '-'"/></td>
                            <td style="border:1px solid #000;padding:5px 8px;background:#f0f0f0;font-weight:700">القسم / المشروع</td>
                            <td style="border:1px solid #000;padding:5px 8px"><t t-esc="doc.department_id.name or '-'"/></td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;padding:5px 8px;background:#f0f0f0;font-weight:700">رقم البادج</td>
                            <td style="border:1px solid #000;padding:5px 8px;direction:ltr;text-align:right"><t t-esc="doc.employee_id.barcode or '-'"/></td>
                            <td style="border:1px solid #000;padding:5px 8px;background:#f0f0f0;font-weight:700">رقم الاعتماد</td>
                            <td style="border:1px solid #000;padding:5px 8px;direction:ltr;text-align:right"><t t-esc="doc.name"/></td>
                        </tr>
                        <tr>
                            <td style="border:1px solid #000;padding:5px 8px;background:#f0f0f0;font-weight:700">تاريخ النموذج</td>
                            <td style="border:1px solid #000;padding:5px 8px"><t t-esc="doc.effective_date or doc.approved_date or doc.request_date"/></td>
                            <td style="border:1px solid #000;padding:5px 8px;background:#f0f0f0;font-weight:700">إصدار السياسة</td>
                            <td style="border:1px solid #000;padding:5px 8px;direction:ltr;text-align:right"><t t-esc="doc.policy_version"/></td>
                        </tr>
                    </table>

                    <!-- جدول السياسة بالعربية -->
                    <table style="width:100%;border-collapse:collapse;font-size:10.3px;margin-bottom:8px;color:#000000">
                        <thead>
                            <tr><th colspan="2" style="border:1px solid #000;padding:5px;background:#e4e4e4;color:#000;font-weight:800;text-align:center;font-size:12.5px">سياسة وشروط استخدام التوقيع الإلكتروني</th></tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc._policy_clauses()" t-as="cl">
                                <tr>
                                    <td style="border:1px solid #000;padding:4px 8px;color:#000;width:22%;font-weight:700;vertical-align:top"><t t-esc="cl_index + 1"/>. <t t-esc="cl[0]"/></td>
                                    <td style="border:1px solid #000;padding:4px 8px;color:#000;line-height:1.5;vertical-align:top"><t t-esc="cl[1]"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- جدول السياسة بالإنجليزية -->
                    <table dir="ltr" style="width:100%;border-collapse:collapse;font-size:9.3px;margin-bottom:9px;color:#000000">
                        <thead>
                            <tr><th colspan="2" style="border:1px solid #000;padding:5px;background:#e4e4e4;color:#000;font-weight:800;text-align:center;font-size:11.5px">Usage Policy &amp; Terms</th></tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc._policy_clauses()" t-as="cl">
                                <tr>
                                    <td style="border:1px solid #000;padding:4px 8px;color:#000;width:22%;font-weight:700;vertical-align:top"><t t-esc="cl_index + 1"/>. <t t-esc="cl[2]"/></td>
                                    <td style="border:1px solid #000;padding:4px 8px;color:#000;line-height:1.4;vertical-align:top"><t t-esc="cl[3]"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- الإقرار -->
                    <div style="border:1px solid #000;padding:7px 12px;font-size:10.5px;margin:0 0 9px;color:#000000;line-height:1.45">
                        أُقِرّ أنا الموظف الموقّع أدناه بقراءة سياسة وشروط استخدام التوقيع الإلكتروني أعلاه وفهمها والموافقة على الالتزام بها، وأنّ توقيعي الإلكتروني يُعبّر عن إرادتي الحرّة.
                    </div>

                    <!-- خانتا التوقيع: الأولى نموذج التوقيع الإلكتروني (من ملف الموظف)، الثانية فارغة للتوقيع بالموافقة -->
                    <table style="width:100%;border-collapse:collapse;font-size:10.5px;color:#000000">
                        <tr>
                            <td style="width:50%;border:1px solid #000;padding:0;vertical-align:top">
                                <div style="background:#f0f0f0;padding:6px 12px;font-weight:800;color:#000;border-bottom:1px solid #000">نموذج التوقيع الإلكتروني · Electronic Signature</div>
                                <div style="height:95px;text-align:center;padding-top:8px">
                                    <img t-if="sig" t-att-src="doc.env['care.esignature'].transparent_datauri(sig)" style="max-height:80px;max-width:88%"/>
                                    <span t-else="" style="color:#000;font-size:10px">—</span>
                                </div>
                                <div style="border-top:1px solid #000;padding:5px 12px;font-size:9.5px;color:#000">الاسم: <t t-esc="doc.employee_id.name"/> — يُقرأ من ملف الموظف</div>
                            </td>
                            <td style="width:50%;border:1px solid #000;padding:0;vertical-align:top">
                                <div style="background:#f0f0f0;padding:6px 12px;font-weight:800;color:#000;border-bottom:1px solid #000">التوقيع بالموافقة · Signature of Consent</div>
                                <div style="height:95px"></div>
                                <div style="border-top:1px solid #000;padding:5px 12px;font-size:9.5px;color:#000">يوقّع الموظف هنا بالموافقة · Employee signs here</div>
                            </td>
                        </tr>
                    </table>

                    <p style="font-size:9px;color:#000000;margin-top:8px;direction:ltr;text-align:right">
                        الرقم التسلسلي: <span style="font-family:monospace"><t t-esc="doc.serial or '—'"/></span>
                    </p>

                    <div class="care-hf"><t t-call="care_report_layout.lh_footer_inner"/></div>
                </div>
            </t>
        </t>
    </template>
</odoo>
