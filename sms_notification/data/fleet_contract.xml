<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fleet_contract_remainder_cron" forcecreate='True' model="ir.cron">
            <field name="name">Fleet Contract Remainder Cron</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle_log_contract"/>
            <field name="state">code</field>
            <field name="code">model.remind_renew_contract()</field>
        </record>

    </data>
</odoo>