<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="sms_template_time_off" model="wk.sms.template">
            <field name="name">SMS notification to employee When approve time off</field>
            <field name="condition">time_off</field>
            <field name="auto_delete" eval="True"/>
            <field name="sms_body_html"><![CDATA[
              Dear {{object.partner_id.name}},
              Congratulation your Time Off request is approved.
                            ]]>
            </field>
        </record>
    </data>
</odoo>
