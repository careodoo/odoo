<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="sms_template_tender_create" model="wk.sms.template">
            <field name="name">SMS notification to organization when new tender created</field>
            <field name="condition">tender_create</field>
            <field name="auto_delete" eval="True"/>
            <field name="sms_body_html"><![CDATA[
              Dear {{object.partner_id.name}},
              Tender {{object.name}} Has been issued on {{ object.issue_date }}.
                            ]]>
            </field>
        </record>
        <record id="sms_template_tender_cancel" model="wk.sms.template">
            <field name="name">SMS notification to organization when tender cancelled</field>
            <field name="condition">tender_cancel</field>
            <field name="auto_delete" eval="True"/>
            <field name="sms_body_html"><![CDATA[
              Dear {{object.partner_id.name}},
              Tender {{object.name}} Has been cancelled.
                            ]]>
            </field>
        </record>
        <record id="sms_template_tender_postponed" model="wk.sms.template">
            <field name="name">SMS notification to organization when tender postponed</field>
            <field name="condition">tender_postponed</field>
            <field name="auto_delete" eval="True"/>
            <field name="sms_body_html"><![CDATA[
              Dear {{object.partner_id.name}},
              Tender {{object.name}} Has been postponed.
                            ]]>
            </field>
        </record>
    </data>
</odoo>
