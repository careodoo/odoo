<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sms_template_birthday_cron" model="wk.sms.template">
            <field name="name">SMS employee birthday</field>
            <field name="condition">employee_birthday</field>
            <field name="auto_delete" eval="True"/>
            <field name="sms_body_html"><![CDATA[
              Dear {{object.name}},
              May your memories today be awesome, your dreams become a reality and your joy last forever.
              Have a wonderful birthday..
                            ]]>
            </field>
        </record>
    </data>
</odoo>