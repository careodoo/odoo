<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="sms_template_crm" model="wk.sms.template">
            <field name="name">SMS notification to customer When create crm</field>
            <field name="condition">crm</field>
            <field name="auto_delete" eval="True"/>
            <field name="sms_body_html"><![CDATA[
              Dear {{object.partner_id.name}},
              Thank you for choosing our Services, we will contact you ASAP.
                            ]]>
            </field>
        </record>
    </data>
</odoo>
