<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CATALOG -->
    <record id="view_catalog_tree" model="ir.ui.view">
        <field name="name">catalog.item.tree</field><field name="model">care.cafm.catalog.item</field>
        <field name="arch" type="xml"><tree editable="bottom">
            <field name="icon"/><field name="name"/><field name="category"/><field name="product_id"/>
            <field name="uom_name"/><field name="price"/></tree></field>
    </record>
    <record id="action_catalog" model="ir.actions.act_window"><field name="name">الكتالوج</field>
        <field name="res_model">care.cafm.catalog.item</field><field name="view_mode">tree</field></record>

    <!-- REQUEST -->
    <record id="view_request_form" model="ir.ui.view">
        <field name="name">cafm.request.form</field><field name="model">care.cafm.request</field>
        <field name="arch" type="xml"><form><header>
            <button name="action_submit" type="object" string="تقديم" class="oe_highlight" invisible="state!='draft'"/>
            <button name="action_approve" type="object" string="اعتماد" class="oe_highlight" invisible="state!='submitted'"/>
            <button name="action_create_sale_order" type="object" string="← أمر بيع" invisible="state!='approved'"/>
            <button name="action_create_purchase" type="object" string="← أمر شراء" invisible="state!='approved'"/>
            <button name="action_delivered" type="object" string="مورّد للمخزن" invisible="state!='ordered'"/>
            <button name="action_issue" type="object" string="بدء الصرف" invisible="state!='delivered'"/>
            <button name="action_done" type="object" string="إكمال" invisible="state!='issued'"/>
            <button name="action_print" type="object" string="🖨️ طباعة الطلب"/>
            <button name="action_cancel" type="object" string="إلغاء" invisible="state in ('done','cancelled')"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,ordered,delivered,issued,done"/>
        </header><sheet>
            <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
            <group><group><field name="facility_id"/><field name="partner_id" readonly="1"/><field name="requested_by" readonly="1"/></group>
                <group><field name="date"/><field name="supplier_id"/><field name="amount_total"/>
                    <field name="sale_order_id" readonly="1"/><field name="purchase_order_id" readonly="1"/></group></group>
            <field name="line_ids"><tree editable="bottom">
                <field name="item_id"/><field name="name"/><field name="qty"/><field name="uom_name"/>
                <field name="price"/><field name="subtotal"/><field name="qty_received"/><field name="qty_issued"/>
                <field name="product_id" column_invisible="1"/></tree></field>
            <group class="oe_subtotal_footer"><field name="amount_total"/></group>
            <field name="note" placeholder="ملاحظات..."/>
        </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field>
    </record>
    <record id="view_request_tree" model="ir.ui.view">
        <field name="name">cafm.request.tree</field><field name="model">care.cafm.request</field>
        <field name="arch" type="xml"><tree decoration-success="state=='done'" decoration-info="state in ('ordered','delivered','issued')" decoration-muted="state=='cancelled'">
            <field name="name"/><field name="facility_id"/><field name="partner_id"/><field name="date"/>
            <field name="line_count"/><field name="amount_total"/><field name="state" widget="badge"/></tree></field>
    </record>
    <record id="action_request" model="ir.actions.act_window"><field name="name">طلبات مشتريات العميل</field>
        <field name="res_model">care.cafm.request</field><field name="view_mode">tree,form</field></record>

    <!-- MENUS -->
    <menuitem id="menu_procurement" name="مشتريات العميل" parent="care_cafm.menu_cafm_root" sequence="18"/>
    <menuitem id="menu_request" name="الطلبات" parent="menu_procurement" action="action_request" sequence="10"/>
    <menuitem id="menu_catalog" name="الكتالوج" parent="menu_procurement" action="action_catalog" sequence="20"/>
</odoo>
