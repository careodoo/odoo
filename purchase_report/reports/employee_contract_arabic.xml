<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- paperformat مخصّص لعقد العمل: بلا ترويسة كير ولا فوتر، هامش علوي صغير (أُزيلت المسافة
         التي كان يشغلها الهيدر). يتبقّى سطر هيدر مُصغَّر واحد (رقم البطاقة) فقط. مُعرّف قبل الـaction لأنه يشير إليه. -->
    <record id="paperformat_employee_contract_clean" model="report.paperformat">
        <field name="name">CARE Contract (no letterhead)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">33</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">4</field>
        <field name="dpi">90</field>
    </record>

    <record id="hr_employee_print_arabic_contract" model="ir.actions.report">
        <field name="name">Arabic Contract</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_report.print_employee_arabic_contract</field>
        <field name="report_file">purchase_report.print_employee_arabic_contract</field>
        <field name="print_report_name">'%s' % ((object.barcode or (object.identification_id if 'identification_id' in object._fields else False) or ('EMP-%s' % object.id))).replace('/', '-')</field>
        <field name="paperformat_id" ref="paperformat_employee_contract_clean"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
    </record>

    <template id="print_employee_arabic_contract_inner">
        <t t-set="employee" t-value="doc"/>
        <div class="page article" style="font-family:Arial,'Cairo',sans-serif;color:#313030">
            <style>
                .ct-tbl{width:100%;margin-top:10px;border:1px solid #b3adad;border-collapse:collapse;font-family:Arial !important;font-weight:bold;}
                .ct-tbl th{padding:6px;background:#f0f0f0;color:#313030;}
                .ct-tbl td{padding:9px;background:#ffffff;color:#313030;}
            </style>

            <table class="ct-tbl" style="text-align: right !important;direction: rtl !important;">
                <tbody>
                    <tr>
                        <th class="text-center fw-bold" style="font-size:18px;">
                            <u>نمـوذج عقـد عمل في القطاع الأهلى</u>
                        </th>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt>دولة الكـويت</dt>
                            <dt> الهيئة العامة للقوي العاملة ادارة عمل محافظة :- <span t-esc="employee.work_department"/></dt>
                            <dt>
                                 إنه في يوم :-
                                <span t-esc="employee.day_translated"/>
                                الموافق
                                <span t-esc="datetime.datetime.today().strftime('%Y-%m-%d')"/>
                                تحرر هذا
                                العقد بين كل من
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right" style="font-size:18px;">
                            <dt>١- شركة /
                                <span t-esc="employee.company_id.name"/>
                                ويمثلها فى التوقيع على
                                العقد
                            </dt>
                            <dt>الاسـم :
                                <t t-esc="employee.authorized_persons_id.name"/>
                            </dt>
                            <dt>رقم مدني :
                                <t t-esc="employee.authorized_persons_id.identification_id"/>
                            </dt>
                            <dt>" طرف أول "</dt>
                            <br/>
                            <dt>٢- الاسـم :
                                <t t-esc="employee.name"/>
                            </dt>
                            <dt>الجنسية :
                                <t t-esc="employee.country_id_translated"/>
                            </dt>
                            <dt>رقم المدني :
                                <t t-esc="employee.identification_id"/>
                            </dt>
                            <dt>الإقامة :
                                <t t-esc="employee.moi_number"/>
                            </dt>
                            <dt>" طرف ثاني "</dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">تهميد</dt>
                            <dt class="text-right">يمتلك الطرف الأول منشأة بإسم شركة الرعاية لمقاولات تنظيف
                                المبانى والمدن تعمل فـي مجال التنظيف ويرغب فـى التعـاقـد مـع الطــرف الثـانـي
                                للعمــل لديـه بمهنــة
                                <span t-esc="employee.social_affairs_title"/>
                                و بعد أن أقر الطرفان بأهليتهما في إبرام هذا العقد تم الإتفاق علي ما يلي
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد الأول</dt>
                            <dt class="text-right">يعتبـر التمهـيد السابق جزء لا يتجزأ من هذا العقـد</dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد الثـانـي</dt>
                            <dt class="text-center">"طبيـعـة العمـل"</dt>
                            <dt class="text-right">تعـاقـد الطـرف الأول مـع الطـرف الثـانـي للعمــل لديـه
                                <span t-esc="employee.social_affairs_title"/>
                                داخل دولـة الكــويـت
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد الثـالث</dt>
                            <dt class="text-center">"فترة التجربة"</dt>
                            <dt class="text-right">يخضع الطرف الثاني لفترة تجربة لمدة لا تزيد عن 100 يوم عمل ،
                                ويحق لكل طرف إنهاء العقد خلال تلك الفترة دون إخطار
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد الـرابـع</dt>
                            <dt class="text-center">"قيمـة الأجـر"</dt>
                            <dt class="text-right">يتقـاضـي الطــرف الثـانـي عـن تنفيـذ هـذا العقـد أجـراً
                                مقـداره
                                <span t-esc="int(employee.affairs_salary)"/>
                                دينـارا يـدفع فـي نهـاية كل شهر ولا يجـوز للطـرف الأول تخفيض الأجـر
                                أثنـاء سـريان هذا العقد
                            </dt>
                            <dt class="text-right">و لا يجـوز نقـل الطـرف الثـانـي إلـى الأجـر اليـومـى دون
                                موافقـة
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد الـخامس</dt>
                            <dt class="text-center">"نفاذ العقـد"</dt>
                            <dt class="text-right">يبدأ نفـاذ العقـد إعتبـارا من
                                <span t-esc="datetime.datetime.today().strftime('%Y-%m-%d')"/>
                                ويلتـزم الطـرف
                                الثـانـى بالقيـام بأداء عملـه طوال مدة نفاذه
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البند السادس</dt>
                            <dt class="text-center">"مدة العقـد"</dt>
                            <dt class="text-right">هـذا العقد غير محدد المـدة ويبدا إعتبـارة من
                                **********
                                ولمده ********* ويجوز تجـديـد العقـد بمـوافقـة الطرفيـن لمـدد مماثلة بحد
                                أقصـى خمس سنوات ميلاديـة
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد السابع</dt>
                            <dt class="text-center">"الأجازة السنوية"</dt>
                            <dt class="text-right">للطـرف الثـانـي الحق فـي أجازة سنوية مدفوعة الأجـر مـدتها 30
                                يومـا، ولا يستحقهـا عن السنة الأولـى إلا بعـد انقضـاء مـدة تسعة أشهر تحسب من
                                تاريخ نفاذ العقـد
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد الثامـن</dt>
                            <dt class="text-center">"عـدد ساعات العمــل"</dt>
                            <dt class="text-right">لا يجوز للطـرف الأول تشغيـل الطـرف الثـانـي لمـدة تزيد عن
                                ثمـانـي ساعات عمـل يوميـا تتخللهـا فترة راحـة لا تقل عن ساعة باستثنـاء الحـالات
                                المقـررة قـانـونـًا
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد التاسـع</dt>
                            <dt class="text-center">"قيمـة تـذكـرة السـفــر"</dt>
                            <dt class="text-right">يتحمـل الطـرف الأول مصـاريف عـودة الطـرف الثـانـي إلـي بلده
                                عند إنتهاء علاقة العمـل ومغادرته نهائيا للبلاد
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد العــاشـــر</dt>
                            <dt class="text-center">"التأمين ضـد إصابات وأمراض العمـل"</dt>
                            <dt class="text-right">يلتـزم الطـرف الأول بالتأمين علـى الطـرف الثانـى ضـد إصابات
                                وأمـراض العمـل، كمـا يلتـزم بقيمـة التأمين الصحـى طبقـا للقـانون رقم (1) لسنة
                                1999
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد الحادى عشـر</dt>
                            <dt class="text-center">"مكـافأة نهاية الخدمـة"</dt>
                            <dt class="text-right">يستحق الطـرف الثـانـي مكافأة نهاية الخـدمة المنصـوص عليها
                                بالقوانين المنظمة
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد الثانـى عشـر</dt>
                            <dt class="text-center">"القانون الواجب التطبيق"</dt>
                            <dt class="text-right">تسـري أحكـام قانون العمـل فى القطـاع الأهلـى رقم 6 لسنة 2010
                                والقرارات المنفـذة له فيما لم يرد بشأنه نص فى هـذا العقـد، ويقع باطلاً كل شرط تم
                                الإتفاق عليه بالمخالفة لأحكام القانون ، ما لم يكن فيه ميـزة أفضـل للعـامـــل
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد الثالث عشـر</dt>
                            <dt class="text-center">"شـروط خـاصـة"</dt>
                            <dt class="text-right">١- لا يوجد</dt>
                            <dt class="text-right">٢- لا يوجد</dt>
                            <dt class="text-right">٣- لا يوجد</dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد الـرابع عشـر</dt>
                            <dt class="text-center">"المحكمـة المختصـة"</dt>
                            <dt class="text-right">تختص المحكمـة الكلية ودوائرها العمـالية طبقا لأحكام القانون
                                رقم 46 لسنة 1987، بنظـر كافة المنازعات الناشئة عن تطبيق أو تفسيـر هـذا العقـد
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد الخامس عشـر</dt>
                            <dt class="text-center">"لغـة العقــد"</dt>
                            <dt class="text-right">حـرر هـذا العقـد باللغتين العربية والأنجليزية ، ويعتد بنصـوص
                                اللغـة العـربية عند وقوع أى تعارض بينهـمــا
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td style="font-size:18px;">
                            <dt class="text-center">البنـد السادس عشـر</dt>
                            <dt class="text-center">"نسـخ العقـــد"</dt>
                            <dt class="text-right">حـرر هذا العقـد من ثلاث نسخ بيد كل طرف نسخة للعمل بموجبها
                                والثالثة تودع لدي الهيئة العامة للقـوي العاملة
                            </dt>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <!-- توقيعا الطرفين — توقيع يدوي؛ النماذج الحكومية لا تخضع للتوقيع الإلكتروني -->
                            <table width="100%" style="border-collapse:separate;border-spacing:10px;table-layout:fixed"><tr>
                                <td style="width:50%;vertical-align:top">
                                    <div style="min-height:96px;padding:8px 10px 6px;text-align:center">
                                        <dt style="font-weight:bold;font-size:14px">الطرف الثاني · Second Party</dt>
                                        <div style="height:50px"></div>
                                        <div style="border-top:1px solid #b3adad;padding-top:4px;font-size:11px;color:#555">
                                            التوقيع · Signature &#160;&#160;&#160;&#160;&#160; التاريخ · Date
                                        </div>
                                    </div>
                                </td>
                                <td style="width:50%;vertical-align:top">
                                    <div style="min-height:96px;padding:8px 10px 6px;text-align:center">
                                        <dt style="font-weight:bold;font-size:14px">الطرف الأول · First Party</dt>
                                        <div style="height:50px"></div>
                                        <div style="border-top:1px solid #b3adad;padding-top:4px;font-size:11px;color:#555">
                                            التوقيع · Signature &#160;&#160;&#160;&#160;&#160; التاريخ · Date
                                        </div>
                                    </div>
                                </td>
                            </tr></table>
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>
    </template>

    <template id="print_employee_arabic_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- رقم البطاقة/الآي دي (بدل اسم الموظف): الباركود، وإلا الرقم المدني، وإلا معرّف السجل -->
                <t t-set="badge_id" t-value="doc.barcode or (doc.identification_id if 'identification_id' in doc._fields else False) or ('EMP-%s' % doc.id)"/>
                <!-- هيدر يتكرّر على الصفحتين: شعار دولة الكويت + الهيئة العامة للقوى العاملة + رقم البطاقة + رقم النموذج -->
                <div class="header" style="border:0;padding:0;margin:0">
                    <div style="position:relative;font-family:Arial,'Cairo',sans-serif;color:#313030">
                        <div dir="ltr" style="position:absolute;top:2px;right:0;text-align:right">
                            <span style="font-size:10px;font-weight:bold">Badge / بطاقة: <span style="font-size:14px;font-weight:800;color:#13294a;letter-spacing:.5px"><t t-esc="badge_id"/></span></span>
                        </div>
                        <div dir="rtl" style="position:absolute;top:2px;left:0;font-size:10px;color:#555">(عقد نموذج 2)</div>
                        <div style="text-align:center">
                            <img src="/purchase_report/static/src/img/Emblem_of_Kuwait.svg.png" alt="Emblem of Kuwait" style="width:52px;height:52px;object-fit:contain"/>
                            <div style="font-size:13px;font-weight:bold;line-height:1.25">دولة الكويت</div>
                            <div style="font-size:13px;font-weight:bold;line-height:1.25">الهيئة العامة للقوى العاملة</div>
                            <div style="font-size:11px;line-height:1.25">The Public Authority For Manpower</div>
                        </div>
                    </div>
                </div>
                <!-- فوتر يتكرّر على الصفحتين: شريط الملاحظة الاسترشادية -->
                <div class="footer" style="border:0;padding:0;margin:0">
                    <div style="border-top:1px solid #999;padding-top:3px;text-align:right;direction:rtl;font-size:10px;color:#444;line-height:1.4">
                        ملاحظة / هذا النموذج هو نموذج استرشادي بالشروط وأحكام عقد العمل في القطاع الأهلي، ويحق لكلٍّ إعداد نموذج مماثل له على مطبوعاته الخاصة بها، شرط أن يتضمّن كافة الأحكام والشروط الواردة بهذا النموذج.
                    </div>
                </div>
                <t t-call="purchase_report.print_employee_arabic_contract_inner"/>
            </t>
        </t>
    </template>
</odoo>
