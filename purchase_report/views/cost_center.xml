<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cost_center_view_form" model="ir.ui.view">
            <field name="name">cost_center_view_form</field>
            <field name="model">cost.center</field>
            <field name="arch" type="xml">
                <form string="cost_center_form">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="cost_center_view_tree" model="ir.ui.view">
            <field name="name">cost_center_view_tree</field>
            <field name="model">cost.center</field>
            <field name="arch" type="xml">
                <tree string="cost_center_tree">
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>
        <record id="cost_center_action" model="ir.actions.act_window">
            <field name="name">cost center</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">cost.center</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>