<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_pms_recurring" model="ir.cron">
            <field name="name">PMS: generate recurring tasks</field>
            <field name="model_id" ref="model_care_pms_task_template"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_recurring()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_pms_escalate" model="ir.cron">
            <field name="name">PMS: escalate overdue tasks &amp; pending forwards</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="state">code</field>
            <field name="code">model.cron_pms_escalate_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
