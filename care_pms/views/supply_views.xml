<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pms_supply_form" model="ir.ui.view">
        <field name="name">care.pms.supply.form</field>
        <field name="model">care.pms.supply</field>
        <field name="arch" type="xml">
            <form string="وارد مواد">
                <header>
                    <button name="action_send" type="object" string="إرسال (بالطريق)" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_receive" type="object" string="استلام ← المخزون" class="btn-success"
                            invisible="state != 'sent'"/>
                    <button name="action_draft" type="object" string="إلى مسودة" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="source"/>
                            <field name="request_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="received_date" invisible="state != 'received'"/>
                            <field name="receiver_name"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'received'">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="qty"/>
                            <field name="uom_name"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter"><field name="message_ids"/></div>
            </form>
        </field>
    </record>
    <record id="view_pms_supply_tree" model="ir.ui.view">
        <field name="name">care.pms.supply.tree</field>
        <field name="model">care.pms.supply</field>
        <field name="arch" type="xml">
            <tree string="واردات المواد">
                <field name="name"/>
                <field name="project_id"/>
                <field name="source"/>
                <field name="date"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'" decoration-info="state == 'sent'"
                       decoration-success="state == 'received'"/>
            </tree>
        </field>
    </record>
    <record id="action_pms_supply" model="ir.actions.act_window">
        <field name="name">واردات المواد</field>
        <field name="res_model">care.pms.supply</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Server action: Send to Project (from a Purchase Request) -->
    <record id="action_pr_send_to_project" model="ir.actions.server">
        <field name="name">إرسال إلى المشروع (مخزون)</field>
        <field name="model_id" ref="purchase_report.model_purchase_request"/>
        <field name="binding_model_id" ref="purchase_report.model_purchase_request"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_pms_send_to_project()</field>
    </record>

    <menuitem id="menu_pms_supply" name="واردات المواد" parent="menu_pms_ops"
              action="action_pms_supply" sequence="0"/>

    <!-- Purchasing-facing: remaining stock across all projects -->
    <record id="view_pms_material_search" model="ir.ui.view">
        <field name="name">care.pms.material.search</field>
        <field name="model">care.pms.material</field>
        <field name="arch" type="xml">
            <search string="مخزون المشاريع">
                <field name="name"/>
                <field name="project_id"/>
                <filter name="low" string="تحت الحد الأدنى" domain="[('is_low','=',True)]"/>
                <filter name="available" string="يوجد رصيد" domain="[('available_qty','&gt;',0)]"/>
                <group expand="1" string="تجميع">
                    <filter name="g_project" string="المشروع" context="{'group_by':'project_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_pms_stock_all" model="ir.actions.act_window">
        <field name="name">مخزون المشاريع (المتبقي)</field>
        <field name="res_model">care.pms.material</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_pms_material_search"/>
        <field name="context">{'search_default_g_project': 1, 'search_default_available': 1}</field>
    </record>
    <menuitem id="menu_pms_stock_all" name="مخزون المشاريع (المتبقي)" parent="menu_pms_ops"
              action="action_pms_stock_all" sequence="1"/>
</odoo>
