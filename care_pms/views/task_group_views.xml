<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_group_form" model="ir.ui.view">
        <field name="name">care.task.group.form</field>
        <field name="model">care.task.group</field>
        <field name="arch" type="xml">
            <form string="مجموعة تاسكات">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="تاسكات"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="اسم المجموعة..."/></h1></div>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                            <field name="is_private"/>
                        </group>
                        <group>
                            <field name="member_ids" widget="many2many_tags"/>
                            <field name="overdue_count"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_task_group_kanban" model="ir.ui.view">
        <field name="name">care.task.group.kanban</field>
        <field name="model">care.task.group</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/><field name="task_count"/><field name="overdue_count"/>
                <field name="is_private"/><field name="department_id"/><field name="member_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click" style="padding:12px;border-top:4px solid #7a5cf0;">
                            <strong style="font-size:14px;"><field name="name"/></strong>
                            <span t-if="record.is_private.raw_value" class="badge text-bg-secondary" style="margin-right:6px;">🔒 خاصة</span>
                            <div class="text-muted" style="font-size:12px;margin-top:4px;"><field name="department_id"/></div>
                            <div style="margin-top:8px;display:flex;justify-content:space-between;">
                                <span class="badge text-bg-primary"><field name="task_count"/> تاسك</span>
                                <span t-if="record.overdue_count.raw_value" class="badge text-bg-danger"><field name="overdue_count"/> متأخر</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_task_group" model="ir.actions.act_window">
        <field name="name">مجموعات التاسكات</field>
        <field name="res_model">care.task.group</field>
        <field name="view_mode">kanban,form</field>
    </record>
</odoo>
