<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Custom employee views for the PMS "workers" action — avoid HR-Officer-only
       fields (current_leave_id) so any project member can browse workers, and
       expose all the search methods (badge, civil id, English name, …). -->

  <record id="pms_employee_search" model="ir.ui.view">
    <field name="name">pms.hr.employee.search</field>
    <field name="model">hr.employee</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="الاسم" filter_domain="['|','|','|','|',('name','ilike',self),('english_name','ilike',self),('barcode','ilike',self),('identification_id','ilike',self),('passport_id','ilike',self)]"/>
        <field name="english_name" string="الاسم بالإنجليزية"/>
        <field name="barcode" string="رقم البادج (Badge)"/>
        <field name="identification_id" string="الرقم المدني"/>
        <field name="passport_id" string="جواز السفر"/>
        <field name="job_title" string="المسمى الوظيفي"/>
        <field name="department_id"/>
        <field name="mobile_phone" string="الجوال"/>
        <field name="work_phone" string="هاتف العمل"/>
        <separator/>
        <filter name="grp_dept" string="القسم" context="{'group_by':'department_id'}"/>
        <filter name="grp_job" string="الوظيفة" context="{'group_by':'job_id'}"/>
      </search>
    </field>
  </record>

  <record id="pms_employee_kanban" model="ir.ui.view">
    <field name="name">pms.hr.employee.kanban</field>
    <field name="model">hr.employee</field>
    <field name="arch" type="xml">
      <kanban class="o_hr_employee_kanban" sample="1">
        <field name="id"/>
        <field name="name"/>
        <field name="english_name"/>
        <field name="job_title"/>
        <field name="department_id"/>
        <field name="mobile_phone"/>
        <field name="barcode"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
              <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image:url('#{kanban_image('hr.employee', 'avatar_128', record.id.raw_value)}')"/>
              <div class="oe_kanban_details">
                <strong class="o_kanban_record_title"><field name="name"/></strong>
                <div t-if="record.english_name.value" class="text-muted"><field name="english_name"/></div>
                <ul>
                  <li t-if="record.job_title.value"><field name="job_title"/></li>
                  <li t-if="record.department_id.value"><field name="department_id"/></li>
                  <li t-if="record.barcode.value">🪪 <field name="barcode"/></li>
                  <li t-if="record.mobile_phone.value">📱 <field name="mobile_phone"/></li>
                </ul>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="pms_employee_tree" model="ir.ui.view">
    <field name="name">pms.hr.employee.tree</field>
    <field name="model">hr.employee</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="english_name" optional="show"/>
        <field name="barcode" string="البادج" optional="show"/>
        <field name="identification_id" string="الرقم المدني" optional="show"/>
        <field name="job_title" optional="show"/>
        <field name="department_id" optional="show"/>
        <field name="mobile_phone" optional="show"/>
        <field name="work_phone" optional="hide"/>
      </tree>
    </field>
  </record>
</odoo>
