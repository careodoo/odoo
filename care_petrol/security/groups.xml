<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_tank">
            <field name="name">Tank</field>
        </record>

        <record id="group_tank_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_tank"/>
        </record>

        <record id="group_tank_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_tank"/>
            <field name="implied_ids" eval="[(4, ref('care_petrol.group_tank_user'))]"/>
        </record>

        <record id="tank_rule_user_own" model="ir.rule">
            <field name="name">User own tank</field>
            <field ref="care_petrol.model_petrol_tank" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('care_petrol.group_tank_user'))]"/>
        </record>

        <record id="tank_rule_manager" model="ir.rule">
            <field name="name">All tanks</field>
            <field ref="care_petrol.model_petrol_tank" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('care_petrol.group_tank_manager'))]"/>
        </record>
        <record id="tank_stage_rule_user_own" model="ir.rule">
            <field name="name">User own tank stage</field>
            <field ref="care_petrol.model_petrol_tank_stage" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('care_petrol.group_tank_user'))]"/>
        </record>

        <record id="tank_stage_rule_manager" model="ir.rule">
            <field name="name">All tanks stages</field>
            <field ref="care_petrol.model_petrol_tank_stage" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('care_petrol.group_tank_manager'))]"/>
        </record>
        <record id="tank_charge_rule_user_own" model="ir.rule">
            <field name="name">User own tank charge</field>
            <field ref="care_petrol.model_petrol_tank_charge" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('care_petrol.group_tank_user'))]"/>
        </record>

        <record id="tank_charge_rule_manager" model="ir.rule">
            <field name="name">All tanks charges</field>
            <field ref="care_petrol.model_petrol_tank_charge" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('care_petrol.group_tank_manager'))]"/>
        </record>
        <record id="tank_use_rule_user_own" model="ir.rule">
            <field name="name">User own tank use</field>
            <field ref="care_petrol.model_petrol_tank_use" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('care_petrol.group_tank_user'))]"/>
        </record>

        <record id="tank_use_rule_manager" model="ir.rule">
            <field name="name">All tanks uses</field>
            <field ref="care_petrol.model_petrol_tank_use" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('care_petrol.group_tank_manager'))]"/>
        </record>
        <record id="tank_transfer_rule_user_own" model="ir.rule">
            <field name="name">User own tank transfer</field>
            <field ref="care_petrol.model_petrol_tank_transfer" name="model_id"/>
            <field name="domain_force">[('create_uid','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('care_petrol.group_tank_user'))]"/>
        </record>

        <record id="tank_transfer_rule_manager" model="ir.rule">
            <field name="name">All tanks transfers</field>
            <field ref="care_petrol.model_petrol_tank_transfer" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('care_petrol.group_tank_manager'))]"/>
        </record>
    </data>
</odoo>