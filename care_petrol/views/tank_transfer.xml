<odoo>
    <data>
        <record id="tank_transfer_view_tree" model="ir.ui.view">
            <field name="name">tank.transfer.view.tree</field>
            <field name="model">petrol.tank.transfer</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="from_tank_id"/>
                    <field name="to_tank_id"/>
                    <field name="quantity"/>
                    <field name="date"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    <field name="state" decoration-success="state in ['done']" decoration-info="state in ['draft']"
                           widget="badge"/>
                </tree>
            </field>
        </record>
        <record id="tank_transfer_view_form" model="ir.ui.view">
            <field name="name">tank.transfer.view.form</field>
            <field name="model">petrol.tank.transfer</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="button_transfer" type="object" string="Transfer" states="draft"
                                        class="oe_highlight"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="create_from" invisible="1"/>
                                <field name="tank_id" invisible="1"/>
                                <field name="from_tank_id" required="1" attrs="{'readonly': [('state', '=', 'done')]}"/>
                                <field name="to_tank_id" required="1" attrs="{'readonly': [('state', '=', 'done')]}"/>
                                <field name="quantity" required="1" attrs="{'readonly': [('state', '=', 'done')]}"/>
                                <field name="date" attrs="{'readonly': [('state', '=', 'done')]}"/>
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            </group>
                            <group/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="tank_transfer_action" model="ir.actions.act_window">
            <field name="name">Transfers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">petrol.tank.transfer</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_create_from':'transfer'}</field>
        </record>
        <menuitem id="tank_transfer_menu" name="Transfers" parent="care_petrol.petrol_root" sequence="2" action="tank_transfer_action"/>
    </data>
</odoo>