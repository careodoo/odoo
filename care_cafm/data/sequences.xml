<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_cafm_location" model="ir.sequence">
            <field name="name">CAFM Location Code</field>
            <field name="code">care.cafm.location</field>
            <field name="prefix">LOC-</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_cafm_workorder" model="ir.sequence">
            <field name="name">CAFM Work Order</field>
            <field name="code">care.cafm.workorder</field>
            <field name="prefix">WO-%(year)s-</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_cafm_observation" model="ir.sequence">
            <field name="name">CAFM Observation</field>
            <field name="code">care.cafm.observation</field>
            <field name="prefix">OBS-%(year)s-</field>
            <field name="padding">5</field>
        </record>
    </data>
    <record id="seq_cafm_shift" model="ir.sequence">
        <field name="name">CAFM Shift</field>
        <field name="code">care.cafm.shift</field>
        <field name="prefix">SH-%(year)s-</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_cafm_request" model="ir.sequence">
        <field name="name">CAFM Service Request</field>
        <field name="code">care.cafm.service.request</field>
        <field name="prefix">SR-%(year)s-</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_cafm_asset" model="ir.sequence">
        <field name="name">CAFM Asset</field>
        <field name="code">care.cafm.asset</field>
        <field name="prefix">AST-</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_cafm_client" model="ir.sequence">
        <field name="name">CAFM Client</field>
        <field name="code">care.cafm.client</field>
        <field name="prefix">CL-</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_cafm_project" model="ir.sequence">
        <field name="name">CAFM Project</field>
        <field name="code">care.cafm.project</field>
        <field name="prefix">PRJ-</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_cafm_schedule" model="ir.sequence">
        <field name="name">CAFM Work Schedule</field>
        <field name="code">care.cafm.schedule</field>
        <field name="prefix">WS-</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_cafm_offboard" model="ir.sequence">
        <field name="name">CAFM Offboard Request</field>
        <field name="code">care.cafm.offboard.request</field>
        <field name="prefix">OFB-</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_cafm_onboard" model="ir.sequence">
        <field name="name">CAFM Onboard Request</field>
        <field name="code">care.cafm.onboard.request</field>
        <field name="prefix">ONB-</field>
        <field name="padding">4</field>
    </record>
</odoo>
