<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
  <record id="seq_stock_count" model="ir.sequence">
    <field name="name">جرد مخزني</field><field name="code">care.cafm.stock.count</field>
    <field name="prefix">CNT/%(year)s/</field><field name="padding">4</field>
  </record>
  <record id="seq_stock_request" model="ir.sequence">
    <field name="name">طلب تعويض مخزون</field><field name="code">care.cafm.stock.request</field>
    <field name="prefix">REQ/%(year)s/</field><field name="padding">4</field>
  </record>
  <record id="cron_stock_low" model="ir.cron">
    <field name="name">المخزون: طلب تعويض لما تحت الحد الأدنى</field>
    <field name="model_id" ref="model_care_cafm_stock_request"/>
    <field name="state">code</field><field name="code">model._cron_low_stock()</field>
    <field name="interval_number">1</field><field name="interval_type">days</field>
    <field name="numbercall">-1</field><field name="active" eval="True"/>
  </record>
</data></odoo>
