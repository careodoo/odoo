<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Automation rules — kanban When/If/Then ===== -->
    <record id="care_automation_rule_kanban" model="ir.ui.view">
        <field name="name">care.automation.rule.kanban</field>
        <field name="model">care.automation.rule</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" default_order="sequence">
                <field name="category"/>
                <field name="is_live"/>
                <field name="enabled"/>
                <field name="cron_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card_content"
                             style="padding:14px; border-radius:12px; border:1px solid #e5e7eb; margin:6px;"
                             t-attf-style="{{ record.enabled.raw_value ? '' : 'opacity:0.55;' }}">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong style="font-size:15px;"><field name="name"/></strong>
                                <span t-attf-class="badge {{ record.enabled.raw_value ? 'text-bg-success' : 'text-bg-secondary' }}">
                                    <t t-if="record.enabled.raw_value">مفعّلة</t>
                                    <t t-else="">متوقفة</t>
                                </span>
                            </div>
                            <div class="mb-2">
                                <span class="badge text-bg-light me-1"><field name="category"/></span>
                                <span t-if="record.is_live.raw_value" class="badge text-bg-info">⚡ حيّة</span>
                            </div>
                            <div style="background:#eef2ff; border-radius:8px; padding:6px 10px; margin-bottom:5px;">
                                <span style="color:#4338ca; font-weight:600;">لقّا</span>
                                <span class="ms-2"><field name="trigger"/></span>
                            </div>
                            <div style="background:#fff7ed; border-radius:8px; padding:6px 10px; margin-bottom:5px;">
                                <span style="color:#c2410c; font-weight:600;">إذا</span>
                                <span class="ms-2"><field name="condition"/></span>
                            </div>
                            <div style="background:#ecfdf5; border-radius:8px; padding:6px 10px;">
                                <span style="color:#047857; font-weight:600;">بقّد</span>
                                <span class="ms-2"><field name="action_desc"/></span>
                            </div>
                            <div class="mt-2 text-end">
                                <button name="action_toggle" type="object" class="btn btn-sm btn-link">
                                    <t t-if="record.enabled.raw_value">إيقاف</t>
                                    <t t-else="">تشغيل</t>
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="care_automation_rule_tree" model="ir.ui.view">
        <field name="name">care.automation.rule.tree</field>
        <field name="model">care.automation.rule</field>
        <field name="arch" type="xml">
            <tree default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="trigger"/>
                <field name="condition"/>
                <field name="action_desc"/>
                <field name="is_live"/>
                <field name="enabled" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="care_automation_rule_form" model="ir.ui.view">
        <field name="name">care.automation.rule.form</field>
        <field name="model">care.automation.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="اسم القاعدة"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="enabled"/>
                        </group>
                        <group>
                            <field name="cron_id"/>
                            <field name="is_live"/>
                        </group>
                    </group>
                    <group string="القاعدة">
                        <field name="trigger"/>
                        <field name="condition"/>
                        <field name="action_desc"/>
                    </group>
                    <field name="note" placeholder="ملاحظات..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="care_automation_rule_action" model="ir.actions.act_window">
        <field name="name">الأتمتة (بدون كود)</field>
        <field name="res_model">care.automation.rule</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>
