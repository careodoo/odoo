<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ===== Automation rules (No-Code) — mockup 55 ===== -->
        <record id="auto_residency" model="care.automation.rule">
            <field name="sequence">10</field>
            <field name="name">تجديد الإقامة قبل الانتهاء</field>
            <field name="category">gov</field>
            <field name="trigger">إقامة عامل تنتهي خلال 30 يوم</field>
            <field name="condition">القطاع = حكومي</field>
            <field name="action_desc">إنشاء معاملة تجديد + تنبيه المندوب</field>
            <field name="cron_id" ref="care_expiry_alerts.cron_document_expiry"/>
            <field name="enabled" eval="True"/>
        </record>
        <record id="auto_timesheet" model="care.automation.rule">
            <field name="sequence">20</field>
            <field name="name">ترحيل التايم شيت للرواتب</field>
            <field name="category">payroll</field>
            <field name="trigger">تايم شيت يُعتمد من مدير العقد</field>
            <field name="condition">—</field>
            <field name="action_desc">ترحيل تلقائي إلى work entries / الرواتب</field>
            <field name="enabled" eval="True"/>
        </record>
        <record id="auto_absence" model="care.automation.rule">
            <field name="sequence">30</field>
            <field name="name">غياب متكرر بدون إذن</field>
            <field name="category">discipline</field>
            <field name="trigger">غياب 3 أيام متتالية بدون إذن</field>
            <field name="condition">الموظف ليس في إجازة</field>
            <field name="action_desc">إنشاء إجراء تأديبي (مسودة) + تنبيه المشرف</field>
            <field name="enabled" eval="True"/>
        </record>
        <record id="auto_deploy" model="care.automation.rule">
            <field name="sequence">40</field>
            <field name="name">منع نشر بدون تصريح أمني</field>
            <field name="category">deploy</field>
            <field name="trigger">نشر عامل لموقع حساس</field>
            <field name="condition">بدون تصريح أمني ساري</field>
            <field name="action_desc">منع النشر + تنبيه + طلب تصريح</field>
            <field name="enabled" eval="True"/>
        </record>

        <!-- ===== Smart approval rules — mockup 57 ===== -->
        <record id="appr_leave_ok" model="care.approval.rule">
            <field name="sequence">10</field>
            <field name="name">إجازة سنوية ≥ الرصيد</field>
            <field name="route">auto</field><field name="doc_type">leave</field>
            <field name="example">Bir · 3 أيام</field>
        </record>
        <record id="appr_loan_ok" model="care.approval.rule">
            <field name="sequence">20</field>
            <field name="name">سلفة ≤ 50% الراتب</field>
            <field name="route">auto</field><field name="doc_type">loan</field>
            <field name="example">Gita · 50.000</field>
        </record>
        <record id="appr_leave_over" model="care.approval.rule">
            <field name="sequence">30</field>
            <field name="name">إجازة تتجاوز الرصيد</field>
            <field name="route">escalate_manager</field><field name="doc_type">leave</field>
            <field name="example">Ramesh · 35 يوم</field>
        </record>
        <record id="appr_loan_over" model="care.approval.rule">
            <field name="sequence">40</field>
            <field name="name">سلفة تتجاوز السقف</field>
            <field name="route">finance</field><field name="doc_type">loan</field>
            <field name="example">Anil · 200.000</field>
        </record>
        <record id="appr_sla" model="care.approval.rule">
            <field name="sequence">50</field>
            <field name="name">موافقة تجاوزت 48 ساعة</field>
            <field name="route">escalate_up</field><field name="doc_type">any</field>
            <field name="example">Kamal · قرض</field>
        </record>
        <record id="appr_stat_main" model="care.approval.stat">
            <field name="name">Impact</field>
        </record>

        <!-- ===== Integrations — mockup 59 ===== -->
        <record id="int_gov" model="care.integration">
            <field name="sequence">10</field><field name="name">البوابات الحكومية (PACI/PAM/MOI)</field>
            <field name="icon">🏛️</field><field name="status">connected</field>
            <field name="description">جلب/تحديث تواريخ الإقامة والإذن + المعاملات</field>
        </record>
        <record id="int_wps" model="care.integration">
            <field name="sequence">20</field><field name="name">حماية الأجور (WPS) / البنك</field>
            <field name="icon">🏦</field><field name="status">connected</field>
            <field name="description">متابعة حالة الدفع + توليد ملف WPS</field>
        </record>
        <record id="int_acc" model="care.integration">
            <field name="sequence">30</field><field name="name">المحاسبة</field>
            <field name="icon">💰</field><field name="status">connected</field>
            <field name="description">قيود الرواتب + العهد + مراكز تكلفة المشاريع</field>
        </record>
        <record id="int_tender" model="care.integration">
            <field name="sequence">40</field><field name="name">العروض / التندر</field>
            <field name="icon">📊</field><field name="status">linked</field>
            <field name="description">عقد جديد فائز → خطة عمالة + تأهيل تلقائي</field>
        </record>
        <record id="int_crm" model="care.integration">
            <field name="sequence">50</field><field name="name">CRM</field>
            <field name="icon">🤝</field><field name="status">linked</field>
            <field name="description">العميل والعقد والموقع</field>
        </record>
        <record id="int_zk" model="care.integration">
            <field name="sequence">60</field><field name="name">أجهزة البصمة (ZKTeco)</field>
            <field name="icon">🕒</field><field name="status">connected</field>
            <field name="description">تايم شيت → hr.attendance بصمة</field>
        </record>
    </data>

    <data noupdate="0">
        <!-- Delegation (mockup 82): sequence + auto-expire cron -->
        <record id="seq_care_delegation" model="ir.sequence">
            <field name="name">Care Delegation</field>
            <field name="code">care.delegation</field>
            <field name="prefix">DEL-</field>
            <field name="padding">3</field>
        </record>

        <record id="cron_care_delegation_expire" model="ir.cron">
            <field name="name">CARE: Expire Authority Delegations</field>
            <field name="model_id" ref="model_care_delegation"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
