<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_care_item_request_category" model="ir.module.category">
        <field name="name">Request Items</field>
    </record>

    <record id="group_item_user" model="res.groups">
        <field name="name">طلب الأصناف</field>
        <field name="category_id" ref="module_care_item_request_category"/>
    </record>

    <record id="group_item_manager" model="res.groups">
        <field name="name">اعتماد الأصناف</field>
        <field name="category_id" ref="module_care_item_request_category"/>
        <field name="implied_ids" eval="[(4, ref('group_item_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_erp_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('care_item_request.group_item_manager'))]"/>
    </record>
</odoo>
