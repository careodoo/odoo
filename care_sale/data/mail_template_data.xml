<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mail_act_sale_sign_create" model="mail.activity.type">
            <field name="name">Sale Sign</field>
            <field name="icon">fa-sun-o</field>
            <field name="res_model">sale.sign</field>
        </record>

        <record id="sale_sign_template" model="mail.template">
            <field name="name">Ask To Sign Sale Order</field>
            <field name="model_id" ref="care_sale.model_sale_sign"/>
            <field name="model">sale.sign</field>
            <field name="subject">Ask To Sign Sale Order {{object.sale_order_id.name}}</field>
            <field name="auto_delete" eval="0" />
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{object.employee_id.work_email}}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.employee_id.name"></t><br/><br/>
                        Kindly Sign <t t-out="object.sale_order_id.name"/>.<br/>
                        Do not hesitate to contact us if you have any questions.
                        <br/><br/>
                        Best regards,
                        <t t-if="user.signature">
                            <br/>
                            <t t-out="user.signature">--<br/></t>
                        </t>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>