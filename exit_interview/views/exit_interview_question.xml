<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="exit_interview_question_view_tree" model="ir.ui.view">
            <field name="name">exit_interview_question_view_tree</field>
            <field name="model">interview.question</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                    <field name="yes_no"/>
                </tree>
            </field>
        </record>
        <record id="exit_interview_question_action" model="ir.actions.act_window">
            <field name="name">Questions</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">interview.question</field>
            <field name="view_mode">tree</field>
        </record>
        <menuitem id="exit_interview_question_menu" name="Questions"
                  parent="exit_interview_config" action="exit_interview_question_action" sequence="4"/>
    </data>
</odoo>