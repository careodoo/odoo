<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="resignation_reason_view_tree" model="ir.ui.view">
            <field name="name">resignation_reason_view_tree</field>
            <field name="model">resignation.reason</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="resignation_reason_action" model="ir.actions.act_window">
            <field name="name">Resignation Reasons</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">resignation.reason</field>
            <field name="view_mode">tree</field>
        </record>
        <menuitem id="resignation_reason_menu" name="Resignation Reasons" parent="exit_interview_config" action="resignation_reason_action" sequence="1"/>
    </data>
</odoo>