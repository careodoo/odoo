<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="supervisor_rate_view_tree" model="ir.ui.view">
            <field name="name">supervisor_rate_view_tree</field>
            <field name="model">supervisor.rate</field>
            <field name="arch" type="xml">
                <tree editable="bottom">
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="supervisor_rate_action" model="ir.actions.act_window">
            <field name="name">Supervisor Rate</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">supervisor.rate</field>
            <field name="view_mode">tree</field>
        </record>
        <menuitem id="supervisor_rate_menu" name="Supervisor Rate" parent="exit_interview_config" action="supervisor_rate_action" sequence="3"/>
    </data>
</odoo>