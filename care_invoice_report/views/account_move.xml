<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
    
        <record id="view_move_form_inherit_add_additional_fields" model="ir.ui.view">
            <field name="name">account.move.view.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button string="Print Care" name="action_print_care" type="object" class="oe_highlight"/>
                </xpath>
                <xpath expr="//div[@name='journal_div']" position="after">
                    <label for="date_from" invisible="not labor_service"/>
                    <div name="date_div" class="d-flex" invisible="not labor_service">
                        <field name="date_from"/>
                        <span class="oe_inline o_form_label mx-3"> To </span>
                        <field name="date_to" />
                    </div>
                </xpath>
                <xpath expr="//group[@id='header_left_group']" position="inside">
                    <field name="labor_service"/>
                </xpath>
                <xpath expr="//page[@name='invoice_tab']//tree//field[@name='product_id']" position="after">
                    <field name="date_from" column_invisible="not parent.labor_service" />
                    <field name="date_to" column_invisible="not parent.labor_service" />
                </xpath>
                <xpath expr="//page[@name='invoice_tab']//tree//field[@name='quantity']" position="before">
                    <field name="days" column_invisible="not parent.labor_service"/>
                </xpath>

                <xpath expr="//group[@id='header_right_group']//field[@name='payment_reference']" position="after">
                    <field name="internal_ref"/>
                    <field name="barcode"/>
                </xpath>
            </field>
        </record>
    
    </data>
    
</odoo>