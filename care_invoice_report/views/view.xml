<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
    
        <record id="view_move_form_inherit_add_additional_fields" model="ir.ui.view">
            <field name="name">account.move.view.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='journal_div']" position="after">
                    <label for="date_from" />
                    <div name="date_div" class="d-flex">
                        <field name="date_from"/>
                        <span class="oe_inline o_form_label mx-3"> To </span>
                        <field name="date_to" />
                    </div>
                </xpath>

                <xpath expr="//page[@name='invoice_tab']//tree//field[@name='quantity']" position="after">
                    <field name="unit_no" />
                </xpath>

                <xpath expr="//group[@id='header_right_group']//field[@name='payment_reference']" position="after">
                    <field name="internal_ref" />
                </xpath>
            </field>
        </record>
    
    </data>
    
</odoo>