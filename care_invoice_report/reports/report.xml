<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="invoice_internal_layout">
            <t t-if="not o" t-set="o" t-value="doc"/>
                <div class="header">
                    <!-- <img src="/care_hr/static/src/img/header.png" atl="header.png" class="w-100"/> -->
                </div>
            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
              <t t-out="0"/>
            </div>
            <div t-attf-class="footer o_standard_footer">
                <div class="row">
                    <!-- <img src="/care_hr/static/src/img/footer.png" atl="header.png" class="w-100"/> -->
                </div>
            </div>
        </template>
        <template id="invoice_internal_layout_w_header">
            <t t-if="not o" t-set="o" t-value="doc"/>
                <div class="header">
                    <img src="/care_hr/static/src/img/header.png" atl="header.png" class="w-100"/>
                </div>
            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
              <t t-out="0"/>
            </div>
            <div t-attf-class="footer o_standard_footer">
                <div class="row">
                    <img src="/care_hr/static/src/img/footer.png" atl="header.png" class="w-100"/>
                </div>
            </div>
        </template>
        <record model="ir.actions.report" id="action_joining_header_report">
            <field name="name">Care Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">care_invoice_report.joining_header_report</field>
            <field name="report_file">care_invoice_report.joining_header_report</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
			<field name="binding_type">report</field>
			<field name="binding_view_types">form</field>
        </record>
        <template id="report_invoice_document" inherit_id="account.report_invoice_document">
            <xpath expr="//t[@t-call='web.external_layout']" position="replace">
                <t t-call="web.html_container">
                    <t t-call="care_invoice_report.invoice_internal_layout_w_header">
                        <div class="page rtl" style="font-family:Arial,Helvetica,sans-serif !important;">
                            <style>
                            table.GeneratedTable {
                                background-color: #ffffff;
                                border-collapse: collapse;
                                border-width: 2px;
                                border-color: #000000;
                                border-style: solid;
                                font-size: 14px;
                                color: #000000;
                                justify-content: center;
                            }

                            table.GeneratedTable td, table.GeneratedTable th {
                                border-width: 1px;
                                border-color: #000000;
                                border-style: solid;
                                padding: 10px;
                                font-weight: bold;
                                margin:10px;
                            }

                            .bordered-row{
                                border-bottom:1px solid black;padding-left:10px;padding-right:10px;
                            }
                            .rtl-row{
                                text-align: right !important;direction: rtl !important;
                            }
                        </style>
                            <t t-foreach="docs" t-as="doc">
                                <br />
                                <div class="justify-content-center" width="100%">
                                    <div class="d-flex justify-content-between" style="width: 100%;">
                                        <div style="flex: 1;">
                                            <center>
                                                <div class="justify-content-center">
                                                    <table class="GeneratedTable justify-content-center" style="text-align: center; width: 60% !important;">
                                                        <tbody class="justify-content-center" style="text-align: center; width: 100% !important;">
                                                            <tr class="justify-content-center text-center">
                                                                <td><h5>Invoice No.</h5>
                                                                <h5><span t-field="doc.internal_ref"/> فاتورة رقم </h5></td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </center>
                                        </div>
                                        <div class="justify-content-end" style="text-align: end; flex: 0; padding: 40px;">
                                            <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', doc._compute_access_url(), 150, 150)"/>
                                        </div>
                                    </div>
                                </div>
                                <br />
                                <table class="GeneratedTable justify-content-end" style="text-align: end; width: 100% !important;">
                                    <thead>
                                        <tr>
                                            <th width="50%"><span>CUSTOMER NAME:</span><span style="margin-left: 150px;">:اسم العميل</span></th>                                        
                                            <!-- <th width="50%"><span>CUSTOMER NO:</span><span style="margin-left: 230px;">:رقم العميل</span></th>                                         -->
                                            <td><span style="margin-right: 50px;">CUSTOMER NO: </span><span style="margin-left: 50px;" t-field="doc.partner_id.id"/><span style="margin-left: 50px;"> :رقم العميل</span></td>
                                        </tr>
                                    </thead>
                                <center>
                                    <tbody class="justify-content-end rtl" style="text-align: end; width: 50% !important; min-height: 100px !important;">
                                        <tr style="height: 20px;">
                                            <td class="rtl"> السادة/ <span t-field="doc.partner_id.name"/> المحترمين </td>
                                            <td><span style="margin-right: 50px;">Date: </span><span style="margin-left: 50px;" t-field="doc.invoice_date"/><span style="margin-left: 100px;"> :التاريخ</span></td>
                                        </tr>
                                    </tbody>
                                </center>
                                </table>
                                <br />
                                <table class="GeneratedTable justify-content-center" style="text-align: center; width: 100% !important;">
                                    <thead>
                                        <tr>
                                            <th width="15%" colspan="2">التاريخ Date</th>
                                            <th width="40%">البيان</th>
                                            <th width="5%">الوحدة</th>
                                            <th width="10%">ايام العمل</th>
                                            <th width="15%">سعر الوحدة</th>
                                            <th width="15%">القيمة الاجمالية</th>
                                        </tr>
                                        <tr style="height: 10px;">
                                            <th>الي To</th>
                                            <th>من From</th>
                                            <th>Description</th>
                                            <th>Unit</th>
                                            <th>Workdays</th>
                                            <th>Unit Price</th>
                                            <th>Total Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody class="justify-content-center" style="text-align: center; width: 50% !important;">
                                        <t t-foreach="doc.invoice_line_ids" t-as="line">
                                            <tr>
                                                <td><span t-field="doc.date_to"/></td>
                                                <td><span t-field="doc.date_from"/></td>
                                                <td><span t-field="line.name"/></td>
                                                <td><span t-field="line.unit_no"/></td>
                                                <td><span t-field="line.quantity"/></td>
                                                <td><span t-field="line.price_unit"/></td>
                                                <td><span t-field="line.price_subtotal"/></td>
                                            </tr>
                                        </t>
                                        <tr>
                                            <td>Total</td>
                                            <td colspan="4" style="direction:rtl !important;"><span t-esc="doc.number_to_arabic(doc.amount_total)"/></td>
                                            <td>الاجمالي</td>
                                            <td><span t-field="doc.amount_total"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <br />
                                <center>
                                <table class="GeneratedTable justify-content-end" style="text-align: end; width: 100% !important;">
                                    <tbody class="justify-content-end" style="text-align: end; width: 100% !important;">
                                        <center>
                                        <tr>
                                            <center>
                                            <td class="rtl-row" width="50%" rowspan="3" style="text-align: center !important;margin-left:100px !important;">
                                                يرجي سداد الفاتورة خلال <span t-esc="doc.invoice_payment_term_id.name" /> يوما من اصدارها<br/>
                                                Invoice to settled within 15 days from the date of issue<br/>
                                                ماعدا السهو والخطأ<br/>
                                                E &amp; O E
                                            </td>
                                            </center>
                                            <td width="30%"></td>
                                            <td width="20%">/ المستلم</td>
                                        </tr>
                                        </center>
                                        <tr>
                                            <td width="30%"></td>
                                            <td>/ التوقيع</td>
                                        </tr>
                                        <tr>
                                            <td width="30%"></td>
                                            <td>/ التاريخ</td>
                                        </tr>
                                    </tbody>
                                </table>
                                </center>
                            </t>
                        </div>
                    </t>
                </t>
            </xpath>
        </template>
