<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="print_type_wizard_view_form" model="ir.ui.view">
            <field name="name">print.type.wizard.view.form</field>
            <field name="model">print.type.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            
                        <field name="lang"/>
                        <field name="headering"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Confirm" type="object"
                            name="action_confirm" class="btn-primary"
                            data-hotkey="q" invisible="not context.get('refuse')"/>

                        <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>