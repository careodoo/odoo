<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- portal/app section so the Maintenance console is visible to clients -->
        <record id="section_maintenance" model="care.cafm.portal.section">
            <field name="name">الصيانة</field>
            <field name="code">maintenance</field>
            <field name="always_on" eval="True"/>
        </record>

        <!-- fault reference sequence -->
        <record id="seq_maint_fault" model="ir.sequence">
            <field name="name">بلاغ عطل صيانة</field>
            <field name="code">care.cafm.maint.fault</field>
            <field name="prefix">FLT/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <!-- default maintenance departments -->
        <record id="dept_electrical" model="care.cafm.maint.department">
            <field name="name">قسم الكهرباء</field><field name="code">ELE</field><field name="trade">electrician</field><field name="color">1</field>
        </record>
        <record id="dept_plumbing" model="care.cafm.maint.department">
            <field name="name">قسم السباكة</field><field name="code">PLM</field><field name="trade">plumber</field><field name="color">4</field>
        </record>
        <record id="dept_hvac" model="care.cafm.maint.department">
            <field name="name">قسم التكييف والتبريد</field><field name="code">HVC</field><field name="trade">hvac</field><field name="color">6</field>
        </record>
        <record id="dept_mechanical" model="care.cafm.maint.department">
            <field name="name">قسم الميكانيكا</field><field name="code">MEC</field><field name="trade">mechanic</field><field name="color">3</field>
        </record>
        <record id="dept_civil" model="care.cafm.maint.department">
            <field name="name">قسم الأعمال المدنية والنجارة</field><field name="code">CIV</field><field name="trade">carpenter</field><field name="color">9</field>
        </record>
        <record id="dept_general" model="care.cafm.maint.department">
            <field name="name">الصيانة العامة</field><field name="code">GEN</field><field name="trade">technician</field><field name="color">5</field>
        </record>
    </data>
</odoo>
