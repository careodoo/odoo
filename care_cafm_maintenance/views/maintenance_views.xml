<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Fault reports ===== -->
    <record id="view_maint_fault_tree" model="ir.ui.view">
        <field name="name">maint.fault.tree</field>
        <field name="model">care.cafm.maint.fault</field>
        <field name="arch" type="xml">
            <tree decoration-danger="severity=='critical'" decoration-warning="severity=='high'">
                <field name="name"/><field name="title"/><field name="facility_id"/>
                <field name="asset_id"/><field name="department_id"/><field name="trade"/>
                <field name="severity"/><field name="assignee_id"/>
                <field name="reported_date"/><field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_maint_fault_form" model="ir.ui.view">
        <field name="name">maint.fault.form</field>
        <field name="model">care.cafm.maint.fault</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_make_workorder" type="object" string="تحويل إلى أمر عمل" class="btn-primary"
                            invisible="workorder_id != False or state in ('closed','cancelled')"/>
                    <button name="action_resolve" type="object" string="تم الإصلاح"
                            invisible="state in ('resolved','closed','cancelled')"/>
                    <button name="action_close" type="object" string="إغلاق" invisible="state=='closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="title"/><field name="facility_id"/><field name="location_id"/>
                            <field name="asset_id"/><field name="department_id"/><field name="trade"/>
                        </group>
                        <group>
                            <field name="severity"/><field name="assignee_id"/>
                            <field name="reported_by"/><field name="reported_date"/>
                            <field name="workorder_id"/>
                            <field name="down_since"/><field name="restored_at"/><field name="downtime_hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الوصف والتشخيص">
                            <field name="description" placeholder="وصف العطل…"/>
                            <field name="diagnosis" placeholder="التشخيص…"/>
                            <field name="resolution" placeholder="الإجراء التصحيحي…"/>
                        </page>
                        <page string="قطع الغيار">
                            <field name="part_line_ids">
                                <tree editable="bottom">
                                    <field name="part_id"/><field name="quantity"/><field name="unit_cost"/><field name="subtotal"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer"><field name="parts_cost"/></group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter"><field name="message_ids"/><field name="activity_ids"/></div>
            </form>
        </field>
    </record>
    <record id="action_maint_fault" model="ir.actions.act_window">
        <field name="name">بلاغات الأعطال</field>
        <field name="res_model">care.cafm.maint.fault</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ===== Spare parts ===== -->
    <record id="view_maint_part_tree" model="ir.ui.view">
        <field name="name">maint.part.tree</field>
        <field name="model">care.cafm.maint.part</field>
        <field name="arch" type="xml">
            <tree editable="bottom" decoration-danger="low_stock==True">
                <field name="code"/><field name="name"/><field name="category"/><field name="department_id"/>
                <field name="on_hand"/><field name="uom_name"/><field name="min_qty"/><field name="low_stock"/>
                <field name="unit_cost"/><field name="stock_value"/><field name="location"/>
            </tree>
        </field>
    </record>
    <record id="action_maint_part" model="ir.actions.act_window">
        <field name="name">مخزن قطع الغيار</field>
        <field name="res_model">care.cafm.maint.part</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ===== Inspections ===== -->
    <record id="view_maint_inspection_tree" model="ir.ui.view">
        <field name="name">maint.inspection.tree</field>
        <field name="model">care.cafm.maint.inspection</field>
        <field name="arch" type="xml">
            <tree decoration-warning="is_due==True">
                <field name="name"/><field name="facility_id"/><field name="asset_id"/>
                <field name="department_id"/><field name="frequency"/><field name="last_date"/>
                <field name="next_date"/><field name="is_due"/><field name="last_result"/>
            </tree>
        </field>
    </record>
    <record id="view_maint_inspection_form" model="ir.ui.view">
        <field name="name">maint.inspection.form</field>
        <field name="model">care.cafm.maint.inspection</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="facility_id"/><field name="location_id"/><field name="asset_id"/><field name="department_id"/><field name="assignee_id"/></group>
                        <group><field name="frequency"/><field name="last_date"/><field name="next_date"/><field name="is_due"/><field name="last_result"/></group>
                    </group>
                    <field name="checklist_ids">
                        <tree editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="result"/><field name="note"/></tree>
                    </field>
                    <field name="notes" placeholder="ملاحظات…"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_maint_inspection" model="ir.actions.act_window">
        <field name="name">الفحوصات الدورية</field>
        <field name="res_model">care.cafm.maint.inspection</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ===== Departments ===== -->
    <record id="view_maint_department_tree" model="ir.ui.view">
        <field name="name">maint.department.tree</field>
        <field name="model">care.cafm.maint.department</field>
        <field name="arch" type="xml">
            <tree><field name="code"/><field name="name"/><field name="trade"/><field name="head_id"/><field name="tech_count"/><field name="fault_count"/></tree>
        </field>
    </record>
    <record id="action_maint_department" model="ir.actions.act_window">
        <field name="name">أقسام الصيانة</field>
        <field name="res_model">care.cafm.maint.department</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ===== Menu ===== -->
    <menuitem id="menu_maint_root" name="الصيانة" sequence="45"/>
    <menuitem id="menu_maint_faults" name="بلاغات الأعطال" parent="menu_maint_root" action="action_maint_fault" sequence="10"/>
    <menuitem id="menu_maint_inspections" name="الفحوصات الدورية" parent="menu_maint_root" action="action_maint_inspection" sequence="20"/>
    <menuitem id="menu_maint_parts" name="قطع الغيار" parent="menu_maint_root" action="action_maint_part" sequence="30"/>
    <menuitem id="menu_maint_departments" name="الأقسام" parent="menu_maint_root" action="action_maint_department" sequence="40"/>
</odoo>
