<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fleet_damage_view_tree" model="ir.ui.view">
            <field name="name">fleet_damage_view_tree</field>
            <field name="model">fleet.damage</field>
            <field name="arch" type="xml">
                <tree string="fleet_damage_tree" editable="bottom">
                    <field name="vehicle_id"/>
                    <field name="name"/>
                    <field name="state"/>
                    <field name="state_description"/>
                    <field name="cause"/>
                    <field name="attachment_ids" widget="many2many_binary" string="Attach a file"/>
<!--                    <field name="attachment_ids" widget="many2many_binary" string="Attach a file" nolabel="1" colspan="2"/>-->
                </tree>
            </field>
        </record>
    </data>
</odoo>